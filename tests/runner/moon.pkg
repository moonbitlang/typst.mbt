  "moonbitlang/pdflite/core" @pdfcore,
  "moonbitlang/pdflite/syntax" @pdfsyntax,
  "moonbitlang/pdflite/content" @pdfcontent,
  "moonbitlang/pdflite/geometry" @pdfgeometry,
  "moonbitlang/pdflite/export" @pdfexport,
  "moonbitlang/core/buffer",
  "moonbitlang/core/cmp",
  "moonbitlang/typst/otf",
