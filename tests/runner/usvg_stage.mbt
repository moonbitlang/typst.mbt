// The `usvg` stage: tests the usvg port (SVG simplification and writing)
// against the real crate. The goldens are generated by
// `oracle/src/bin/gen_usvg_golden.rs` into `tests/golden/usvg/`:
//
// - `trees.jsonl`: SVG files of `typst-dev-assets` and the cases of
//   `oracle/src/bin/usvg_corpus.txt`, parsed like Typst's `SvgImage::new`
//   and written back with `Tree::to_string`.
// - `glyphs.jsonl`: the SVG-table glyphs of the test fonts, processed like
//   Typst's `draw_svg_glyph` (before `fixup_svg`).

///|
/// Typst's `base_options` for SVG images.
fn usvg_base_options() -> @usvg.Options {
  {
    ..@usvg.Options::default(),
    font_family: "",
    image_href_resolver: {
      resolve_data: @usvg.ImageHrefResolver::default_data_resolver(),
      resolve_string: (_, _) => None,
    },
  }
}

///|
fn f32_bits(x : Float) -> String {
  let h = x.reinterpret_as_uint().to_string(radix=16)
  String::make(8 - h.length(), '0') + h
}

///|
fn usvg_rect_bits(r : @tiny_skia_path.Rect) -> Array[String] {
  [f32_bits(r.left()), f32_bits(r.top()), f32_bits(r.right()), f32_bits(r.bottom())]
}

///|
fn usvg_error_string(e : @usvg.UsvgError) -> String {
  match e {
    NotAnUtf8Str => "NotAnUtf8Str"
    MalformedGZip => "MalformedGZip"
    ElementsLimitReached => "ElementsLimitReached"
    InvalidSize => "InvalidSize"
    ParsingFailed(e) => "ParsingFailed: \{e.to_string()}"
  }
}

///|
fn json_string_field(obj : Map[String, Json], key : String) -> String? {
  match obj.get(key) {
    Some(String(s)) => Some(s)
    _ => None
  }
}

///|
fn json_strings(obj : Map[String, Json], key : String) -> Array[String] {
  match obj.get(key) {
    Some(Array(items)) =>
      items.filter_map(i => match i {
        String(s) => Some(s)
        _ => None
      })
    _ => []
  }
}

///|
/// Compares one field and records the first difference.
fn usvg_check(
  diffs : Array[String],
  field : String,
  expected : String,
  actual : String,
) -> Unit {
  if expected != actual {
    diffs.push("\{field}:\n  expected: \{expected}\n  actual:   \{actual}")
  }
}

///|
fn run_usvg_stage(filter : String?, verbose : Bool) -> Unit {
  let mut passed = 0
  let mut failed = 0
  let assets = dev_assets_root()
  let actual_dump = StringBuilder::new()
  for line in read(golden_dir + "/usvg/trees.jsonl").split("\n") {
    if line.is_empty() {
      continue
    }
    let obj = match (try? @json.parse(line.to_string())) {
      Ok(Object(obj)) => obj
      _ => continue
    }
    let name = json_string_field(obj, "name").unwrap_or("")
    if filter is Some(f) && !name.contains(f) {
      continue
    }
    let data = match obj.get("source") {
      Some(Object(src)) =>
        match (json_string_field(src, "file"), json_string_field(src, "text")) {
          (Some(file), _) =>
            @fs.read_file_to_bytes(assets + "/" + file) catch {
              _ => b""
            }
          (_, Some(text)) => @utf8.encode(text)
          _ => b""
        }
      _ => b""
    }
    let diffs = []
    match (try? @usvg.Tree::from_data(data, usvg_base_options())) {
      Ok(tree) => {
        usvg_check(diffs, "error", json_string_field(obj, "error").unwrap_or(""), "")
        let size = [
          f32_bits(tree.size().width()),
          f32_bits(tree.size().height()),
        ]
        usvg_check(diffs, "size", json_strings(obj, "size").join(" "), size.join(" "))
        usvg_check(
          diffs,
          "bbox",
          json_strings(obj, "bbox").join(" "),
          usvg_rect_bits(tree.root().bounding_box()).join(" "),
        )
        usvg_check(
          diffs,
          "abs_bbox",
          json_strings(obj, "abs_bbox").join(" "),
          usvg_rect_bits(tree.root().abs_bounding_box()).join(" "),
        )
        usvg_check(
          diffs,
          "stroke_bbox",
          json_strings(obj, "stroke_bbox").join(" "),
          usvg_rect_bits(tree.root().stroke_bounding_box()).join(" "),
        )
        let svg = tree.to_string(@usvg.WriteOptions::default())
        usvg_check(diffs, "svg", json_string_field(obj, "svg").unwrap_or(""), svg)
        actual_dump.write_string("=== \{name}\n\{svg}\n")
      }
      Err(e) => {
        usvg_check(
          diffs,
          "error",
          json_string_field(obj, "error").unwrap_or(""),
          usvg_error_string(e),
        )
        actual_dump.write_string("=== \{name}\n\{usvg_error_string(e)}\n")
      }
    }
    if diffs.is_empty() {
      passed += 1
    } else {
      failed += 1
      println("FAIL usvg tree \{name}")
      if verbose {
        for d in diffs {
          println(d)
        }
      }
    }
  }

  // Glyphs.
  let fonts : Map[String, @otf.Face] = {}
  let mut glyph_passed = 0
  let mut glyph_failed = 0
  for line in read(golden_dir + "/usvg/glyphs.jsonl").split("\n") {
    if line.is_empty() {
      continue
    }
    let obj = match (try? @json.parse(line.to_string())) {
      Ok(Object(obj)) => obj
      _ => continue
    }
    let font = json_string_field(obj, "font").unwrap_or("")
    let gid = match obj.get("glyph") {
      Some(Number(n, ..)) => n.to_int()
      _ => continue
    }
    let name = "\{font}#\{gid}"
    if filter is Some(f) && !name.contains(f) {
      continue
    }
    let face = match fonts.get(font) {
      Some(face) => face
      None => {
        let bytes = @fs.read_file_to_bytes(assets + "/fonts/" + font) catch {
          _ => b""
        }
        let face = @otf.Face::parse(bytes[:], 0) catch {
          _ => continue
        }
        fonts[font] = face
        face
      }
    }
    let diffs = []
    let result = usvg_glyph(face, gid)
    match result {
      Some((svg, bbox)) => {
        usvg_check(diffs, "svg", json_string_field(obj, "svg").unwrap_or(""), svg)
        usvg_check(
          diffs,
          "bbox",
          json_strings(obj, "bbox").join(" "),
          usvg_rect_bits(bbox).join(" "),
        )
      }
      None =>
        if obj.get("error") is None {
          diffs.push("unexpected error")
        }
    }
    if diffs.is_empty() {
      glyph_passed += 1
    } else {
      glyph_failed += 1
      println("FAIL usvg glyph \{name}")
      if verbose {
        for d in diffs {
          println(d)
        }
      }
    }
  }
  if dump_actual.val {
    let out = "_build/actual/usvg/trees.txt"
    ensure_parent_dir(out)
    @fs.write_string_to_file(out, actual_dump.to_string()) catch {
      _ => ()
    }
  }
  println("usvg trees: \{passed} passed, \{failed} failed")
  println("usvg glyphs: \{glyph_passed} passed, \{glyph_failed} failed")
}

///|
/// Typst's `draw_svg_glyph` up to the bounding box (before `fixup_svg`).
fn usvg_glyph(face : @otf.Face, gid : Int) -> (String, @tiny_skia_path.Rect)? {
  let doc = face.glyph_svg_image(@otf.GlyphId(gid.to_uint16()))?
  let mut data = doc.data.to_bytes()
  if data.length() >= 2 && data[0] == b'\x1f' && data[1] == b'\x8b' {
    data = @codecs.gzip_decompress(data[:]) catch { _ => return None }
  }
  let xml = (try? @utf8.decode(data[:])).to_option()?
  let document = (try? @xml.Document::parse(xml)).to_option()?
  let tree = (try? @usvg.Tree::from_xmltree(document, @usvg.Options::default())).to_option()?
  let svg = tree.to_string({
    ..@usvg.WriteOptions::default(),
    indent: None,
    attributes_indent: None,
  })
  Some((svg, tree.root().bounding_box()))
}
