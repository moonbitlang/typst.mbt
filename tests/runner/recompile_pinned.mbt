// The sequences of the `recompile` stage that are pinned to what the
// upstream binary's `typst watch` gives (`tests/recompile/README.md`, "As
// upstream's watch").
//
// The stage requires every recompilation to give what a compilation from
// scratch gives. One kind of difference is upstream's own, and the port
// follows upstream in it (the owner's decision of 2026-10-11): a module
// compares by the identity of its inner data, memoized calls are found by
// the hashes of their arguments, and so a call that is found again can
// return the module of an earlier evaluation, which `==` tells from the
// module of the same file evaluated now. After a comment in an imported
// file, `get() == m` is `false` in a watching process and `true` in a fresh
// one.
//
// That difference is accepted in one place and nowhere else: at a step of a
// sequence that is a fixture of `tests/recompile/upstream/`, generated by
// `scripts/gen_recompile_upstream.py` from the upstream binary, if what the
// watch loop gave there is what upstream's watch wrote there
// ([pinned_verdict]). A fixture is a project and a fixed list of edits,
// with the SVG of a fresh `typst compile` for every step and, where it is
// another, the SVG that the watching process wrote. The documents draw
// boxes and no text: their SVG is the same bytes in upstream's CLI and
// here, whatever the fonts of the world.
//
// What a pinned sequence checks, in every run:
//
// - a fresh compilation of every step gives upstream's fresh SVG (the
//   fixture is of these files, and the port's from-scratch answer is
//   upstream's);
// - the watch loop gives what a fresh compilation gives, or, where
//   upstream's watch does not either, exactly what upstream's watch gave,
//   with the dependencies and the diagnostics of a fresh compilation, and
//   with page images and a PDF that are those of the document it made
//   (the other outputs have no reference at such a step but that
//   document itself).
//
// Anything else fails, and every accepted step is counted and printed.
// The count is part of the verdict ([pinned_as_upstream_expected]): while
// nothing is kept across compilations the loop gives what a fresh
// compilation gives at every step, and one accepted step would mean that
// something is kept.

///|
/// Where the fixtures are.
let pinned_dir : String = "tests/recompile/upstream"

///|
/// The number of steps at which a run of all pinned sequences must find
/// the watch loop giving upstream's watch output instead of a fresh
/// compilation's. Zero: nothing is kept from one compilation to the next,
/// so every recompilation is a fresh compilation. The step that keeps the
/// closure calls (step 5 of slice 1 of `docs/incremental-design.md`) sets
/// this to the number of steps at which upstream's watch differs from a
/// fresh compilation, which the run prints (13 with the fixtures of
/// today): the acceptance is then exercised, or the stage fails.
let pinned_as_upstream_expected : Int = 0

///|
/// A step of a pinned sequence.
priv struct PinnedStep {
  /// What the step does, for the trace.
  edit : String
  /// The files it writes: text, and files that are no text (a plugin),
  /// which a fixture holds as hexadecimal digits.
  files : Array[(String, Bytes)]
  /// The SVG of the first page of a fresh compilation by upstream.
  fresh : String
  /// What upstream's watching process wrote, if that is something else.
  watch : String?
}

///|
/// A pinned sequence: a fixture.
priv struct Pinned {
  name : String
  steps : Array[PinnedStep]
}

///|
/// A fixture that is not one.
fn[T] pinned_bad(name : String, what : String) -> T {
  abort("recompile: \{pinned_dir}/\{name}.json: \{what}")
}

///|
/// Reads a fixture.
fn pinned_parse(name : String, text : String) -> Pinned {
  let json = @json.parse(text) catch { _ => pinned_bad(name, "not JSON") }
  guard json is Object({ "steps": Array(list), .. }) else {
    pinned_bad(name, "no steps")
  }
  let steps = []
  for item in list {
    guard item is Object(fields) &&
      fields.get("edit") is Some(String(edit)) &&
      fields.get("files") is Some(Object(files)) &&
      fields.get("fresh") is Some(String(fresh)) else {
      pinned_bad(name, "a step without an edit, files or a fresh SVG")
    }
    let written = []
    for path, content in files {
      guard content is String(content) else {
        pinned_bad(name, "a file that is no text")
      }
      written.push((path, @utf8.encode(content)))
    }
    if fields.get("binary") is Some(binary) {
      guard binary is Object(binary) else {
        pinned_bad(name, "binary files that are no object")
      }
      for path, content in binary {
        guard content is String(digits) && pinned_hex(digits) is Some(bytes) else {
          pinned_bad(name, "a binary file that is not hexadecimal digits")
        }
        written.push((path, bytes))
      }
    }
    let watch = match fields.get("watch") {
      Some(String(svg)) => Some(svg)
      Some(Null) | None => None
      Some(_) => pinned_bad(name, "a watch SVG that is no text")
    }
    steps.push({ edit, files: written, fresh, watch, })
  }
  guard steps.length() > 1 else { pinned_bad(name, "no edits") }
  { name, steps, }
}

///|
/// The bytes that hexadecimal digits spell.
fn pinned_hex(digits : String) -> Bytes? {
  guard digits.length() % 2 == 0 else { return None }
  let digit = (c : UInt16) => {
    let c = c.to_int()
    if c >= '0' && c <= '9' {
      c - '0'
    } else if c >= 'a' && c <= 'f' {
      c - 'a' + 10
    } else {
      -1
    }
  }
  let bytes : Array[Byte] = []
  for i in 0..<(digits.length() / 2) {
    let hi = digit(digits.unsafe_get(2 * i))
    let lo = digit(digits.unsafe_get(2 * i + 1))
    guard hi >= 0 && lo >= 0 else { return None }
    bytes.push((hi * 16 + lo).to_byte())
  }
  Some(Bytes::from_array(bytes))
}

///|
/// The fixtures, by name.
fn pinned_sequences() -> Array[Pinned] {
  let entries = (@fs.read_dir(pinned_dir) catch { _ => [][:] }).to_owned()
  entries.sort_by(@library.compare_str)
  let out = []
  for entry in entries {
    guard entry.has_suffix(".json") else { continue }
    let name = entry.unsafe_substring(start=0, end=entry.length() - 5)
    let text = @fs.read_file_to_string("\{pinned_dir}/\{entry}") catch {
      _ => abort("recompile: cannot read \{pinned_dir}/\{entry}")
    }
    out.push(pinned_parse(name, text))
  }
  out
}

///|
/// The document of a pinned sequence: the files of its first step, in
/// memory, with the library of the CLI.
fn Pinned::document(self : Pinned) -> Document {
  {
    name: "upstream/\{self.name}",
    flavor: Plain,
    main: project_file("main.typ"),
    base: id => raise @library.FileError::NotFound(file_path(id)),
    files: self.steps[0].files.map(file => (project_file(file.0), file.1)),
  }
}

///|
/// The SVG of a document of one page as `typst compile main.typ out.svg`
/// writes it (`export_image` in `cli/compile.mbt`), which is what a
/// fixture holds. A document with another number of pages has none: the
/// SVG of one page would not say all that the document shows.
fn pinned_svg(doc : @layout.PagedDocument) -> String? {
  let options : @svg.SvgOptions = {
    render_bleed: false,
    format: { pretty: None, },
  }
  let options = options.resolve(@svg.SvgFormatOptions::get(doc.options()))
  match doc.pages() {
    [page] => Some(@svg.svg(page, options))
    _ => None
  }
}

///|
/// What a step of a pinned sequence is.
priv enum PinnedVerdict {
  /// The watch loop gave what a fresh compilation gives.
  Same
  /// The watch loop gave what upstream's watch gives, which is not what a
  /// fresh compilation gives: accepted, and counted.
  AsUpstream
  /// Neither: a failure, and why.
  Fails(String)
}

///|
/// The parts of a compilation that a difference of the pages does not
/// touch: at a step that is accepted as upstream's watch's they must be
/// those of a fresh compilation.
let pinned_untouched : ReadOnlyArray[String] = [
  "dependencies", "diagnostics", "pdf diagnostics",
]

///|
/// Compares what the watch loop gave at a pinned step (`actual`) with a
/// fresh compilation of the step (`expected`) and with the fixture. This
/// is the only place where a recompilation that differs from a fresh
/// compilation passes, and it does under four conditions that all must
/// hold:
///
/// 1. the fresh compilation gives upstream's fresh SVG (checked for every
///    step, differing or not);
/// 2. upstream's watch gave something else than its fresh compilation at
///    this step (the fixture has a `watch` SVG);
/// 3. the watch loop's SVG is that SVG, byte for byte;
/// 4. the dependencies, the diagnostics and the diagnostics of the PDF
///    export are those of the fresh compilation;
/// 5. the page images that the loop left (it writes a page only if its
///    hash changed) are the images of the document it made, and its PDF
///    is what that document exports to with memoization off. At such a
///    step there is no other reference for them: what must hold is that
///    they are of the pages whose SVG was just compared.
fn pinned_verdict(
  step : PinnedStep,
  expected : Compiled,
  actual : Compiled,
) -> PinnedVerdict {
  if expected.cli_svg != Some(step.fresh) {
    return Fails(
      "a fresh compilation does not give the SVG of upstream's fresh compilation",
    )
  }
  guard expected.difference(actual) is Some((parts, _)) else { return Same }
  guard step.watch is Some(watch) else {
    return Fails(
      "\{parts.join(", ")} differ from a fresh compilation, where upstream's watch gives what a fresh compilation gives",
    )
  }
  if actual.cli_svg != Some(watch) {
    return Fails(
      "\{parts.join(", ")} differ from a fresh compilation, and the pages are not what upstream's watch gives either",
    )
  }
  for part in parts {
    if pinned_untouched[:].contains(part) {
      return Fails(
        "the pages are what upstream's watch gives, but the \{part} differ from a fresh compilation",
      )
    }
  }
  if actual.own_images != Some(actual.parts[part_images]) {
    return Fails(
      "the pages are what upstream's watch gives, but the page images of the watch loop are not those of its document",
    )
  }
  if actual.own_pdf != Some(actual.pdf) {
    return Fails(
      "the pages are what upstream's watch gives, but the PDF of the watch loop is not what its document exports to",
    )
  }
  AsUpstream
}
