// The `resvg` stage: tests the resvg port (SVG rendering) against the real
// crate over resvg's own regression suite (`.repos/resvg/crates/resvg/tests`,
// fetched by `scripts/upstream.sh`). The goldens are generated by
// `oracle/src/bin/gen_resvg_golden.rs` into `tests/golden/resvg/cases.jsonl`
// (size and SHA-256 of the premultiplied pixmap of each case, rendered like
// resvg's integration tests).

///|
let resvg_tests_dir = ".repos/resvg/crates/resvg/tests"

///|
/// Where to dump the raw RGBA of each case (`--raw=<dir>`).
let resvg_raw_dir : Ref[String?] = Ref(None)

///|
/// Rust's `str` ordering (by code points).
fn resvg_str_lt(a : String, b : String) -> Int {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  for i in 0..<n {
    let c = a.code_unit_at(i).to_int() - b.code_unit_at(i).to_int()
    if c != 0 {
      return c
    }
  }
  a.length() - b.length()
}

///|
/// The fonts of `tests/fonts`, loaded in sorted file name order, with the
/// generic families of resvg's test harness.
fn resvg_fontdb() -> @usvg.FontDatabase {
  let db = @usvg.FontDatabase::new()
  let dir = resvg_tests_dir + "/fonts"
  let files = (@fs.read_dir(dir) catch { _ => [] }).filter(f => {
    f.has_suffix(".ttf") ||
    f.has_suffix(".otf") ||
    f.has_suffix(".ttc") ||
    f.has_suffix(".otc")
  })
  files.sort_by(resvg_str_lt)
  for f in files {
    let bytes = @fs.read_file_to_bytes(dir + "/" + f) catch { _ => continue }
    db.load_font_data(bytes)
  }
  db.set_serif_family("Noto Serif")
  db.set_sans_serif_family("Noto Sans")
  db.set_cursive_family("Yellowtail")
  db.set_fantasy_family("Sedgwick Ave Display")
  db.set_monospace_family("Noto Mono")
  db
}

///|
/// usvg's default string resolver: treats the string as a file path
/// relative to `resources_dir`.
fn resvg_string_resolver(
  href : String,
  opts : @usvg.Options,
) -> @usvg.ImageKind? {
  let path = if href.has_prefix("/") {
    href
  } else {
    match opts.resources_dir {
      Some(dir) => dir + "/" + href
      None => href
    }
  }
  let data = @fs.read_file_to_bytes(path) catch { _ => return None }
  let name = match path.rev_find("/") {
    Some(i) => path.unsafe_substring(start=i + 1, end=path.length())
    None => path
  }
  let ext = match name.rev_find(".") {
    Some(i) if i > 0 =>
      name.unsafe_substring(start=i + 1, end=name.length()).to_lower()
    _ => return None
  }
  if ext == "svg" || ext == "svgz" {
    let tree = @usvg.Tree::from_data_nested(data, opts) catch {
      _ => return None
    }
    return Some(SVG(tree))
  }
  match image_magic(data) {
    Some("jpeg") => Some(JPEG(data))
    Some("png") => Some(PNG(data))
    Some("gif") => Some(GIF(data))
    Some("webp") => Some(WEBP(data))
    _ => None
  }
}

///|
/// The formats of `imagesize::image_type` that usvg accepts.
fn image_magic(data : Bytes) -> String? {
  let n = data.length()
  if n >= 3 && data[0] == 0xFF && data[1] == 0xD8 && data[2] == 0xFF {
    Some("jpeg")
  } else if n >= 4 &&
    data[0] == 0x89 &&
    data[1] == b'P' &&
    data[2] == b'N' &&
    data[3] == b'G' {
    Some("png")
  } else if n >= 4 &&
    data[0] == b'G' &&
    data[1] == b'I' &&
    data[2] == b'F' &&
    data[3] == b'8' {
    Some("gif")
  } else if n >= 12 &&
    data[0] == b'R' &&
    data[1] == b'I' &&
    data[2] == b'F' &&
    data[3] == b'F' &&
    data[8] == b'W' &&
    data[9] == b'E' &&
    data[10] == b'B' &&
    data[11] == b'P' {
    Some("webp")
  } else {
    None
  }
}

///|
fn resvg_render_case(
  tree : @usvg.Tree,
  mode : String,
  scale : Float,
  id : String,
) -> @skia.Pixmap? {
  match mode {
    "normal" => {
      guard tree.size().to_int_size().scale_to_width(300) is Some(size) else {
        return None
      }
      guard @skia.Pixmap::new(size.width(), size.height()) is Some(pixmap) else {
        return None
      }
      let ts = @tiny_skia_path.Transform::from_scale(
        @skia.u32_to_f32(size.width()) / tree.size().width(),
        @skia.u32_to_f32(size.height()) / tree.size().height(),
      )
      @resvg.render(tree, ts, pixmap)
      Some(pixmap)
    }
    "extra" => {
      guard tree.size().to_int_size().scale_by(scale) is Some(size) else {
        return None
      }
      guard @skia.Pixmap::new(size.width(), size.height()) is Some(pixmap) else {
        return None
      }
      @resvg.render(
        tree,
        @tiny_skia_path.Transform::from_scale(scale, scale),
        pixmap,
      )
      Some(pixmap)
    }
    _ => {
      guard tree.node_by_id(id) is Some(node) else { return None }
      guard node.abs_layer_bounding_box() is Some(bbox) else { return None }
      let size = bbox.size().to_int_size()
      guard @skia.Pixmap::new(size.width(), size.height()) is Some(pixmap) else {
        return None
      }
      @resvg.render_node(node, @tiny_skia_path.Transform::identity(), pixmap)
      |> ignore
      Some(pixmap)
    }
  }
}

///|
fn run_resvg_stage(filter : String?, verbose : Bool) -> Unit {
  let mut passed = 0
  let mut failed = 0
  let db = resvg_fontdb()
  let failures = []
  for line in read(golden_dir + "/resvg/cases.jsonl").split("\n") {
    if line.is_empty() {
      continue
    }
    let obj = match (try? @json.parse(line.to_owned())) {
      Ok(Object(obj)) => obj
      _ => continue
    }
    let name = json_string_field(obj, "name").unwrap_or("")
    if filter is Some(f) && !name.contains(f) {
      continue
    }
    let mode = json_string_field(obj, "mode").unwrap_or("normal")
    let scale : Float = match obj.get("scale") {
      Some(Number(n, ..)) => Float::from_double(n)
      _ => 1.0
    }
    let id = json_string_field(obj, "id").unwrap_or("")
    let expected = match (obj.get("error"), obj.get("none"), obj.get("size")) {
      (Some(String(e)), _, _) => "error: \{e}"
      (_, Some(_), _) => "none"
      (_, _, Some(Array(s))) =>
        "\{s.map(v => v.stringify()).join("x")} \{json_string_field(obj, "sha256").unwrap_or("")}"
      _ => "?"
    }
    let svg_path = resvg_tests_dir + "/" + name + ".svg"
    let dir = match svg_path.rev_find("/") {
      Some(i) => svg_path.unsafe_substring(start=0, end=i)
      None => "."
    }
    let opts : @usvg.Options = {
      ..@usvg.Options::default(),
      fontdb: db,
      resources_dir: Some(dir),
      image_href_resolver: {
        resolve_data: @usvg.ImageHrefResolver::default_data_resolver(),
        resolve_string: resvg_string_resolver,
      },
    }
    let data = @fs.read_file_to_bytes(svg_path) catch { _ => b"" }
    let actual = match (try? @usvg.Tree::from_data(data, opts)) {
      Err(e) => "error: \{e}"
      Ok(tree) =>
        match resvg_render_case(tree, mode, scale, id) {
          None => "none"
          Some(pixmap) => {
            if resvg_raw_dir.val is Some(raw) {
              @fs.write_bytes_to_file(
                raw + "/" + name.replace_all(old="/", new="_") + ".rgba",
                pixmap.data(),
              ) catch {
                _ => ()
              }
            }
            "\{pixmap.width()}x\{pixmap.height()} \{sha256_hex(pixmap.data()[:])}"
          }
        }
    }
    let label = if mode == "normal" { name } else { "\{name} (\{mode})" }
    if actual == expected {
      passed += 1
      if verbose {
        println("PASS \{label}")
      }
    } else {
      failed += 1
      failures.push(label)
      println("FAIL \{label}")
      if verbose {
        println("  expected: \{expected}\n  actual:   \{actual}")
      }
    }
  }
  println("resvg: \{passed} passed, \{failed} failed")
}
