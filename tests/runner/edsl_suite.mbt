// The conversion of the upstream suite to the EDSL (docs/edsl-convert.md,
// sections 7 and 8):
//
// - `edsl-convert [filter] [--baseline] [--failed=<file>]` translates every
//   test of the suite with `doc/convert` and writes the generated MoonBit
//   into the shard packages `tests/edsl_gen/s*` and the manifest
//   `tests/edsl_gen/manifest.tsv`;
// - `edsl-suite [filter]` runs each converted case against the Typst path
//   in the test world and writes `tests/edsl_gen/results.tsv`.
//
// A case is numbered by its position in the enumeration of the suite
// (files in order, tests in order), the same in both commands. The
// examples of upstream's documentation (`scripts/edsl_docs_examples.py`
// extracts them to `tests/edsl_gen/docs`, in the suite's format) follow
// the suite as the directories `docs/typ` and `docs/rs`.

///|
let edsl_gen_dir = "tests/edsl_gen"

///|
/// The number of shard packages (`tests/edsl_gen/s00` ...).
let edsl_shards : Int = 16

///|
/// The cases of the suite in order: number, suite file, test, and whether
/// upstream compiles it to a paged document.
priv struct SuiteCase {
  number : Int
  rel : String
  tc : TestCase
  paged : Bool
}

///|
fn suite_cases() -> Array[SuiteCase] {
  let cases : Array[SuiteCase] = []
  for file in typ_files(suite_dir) {
    let rel = file.unsafe_substring(
      start=suite_dir.length() + 1,
      end=file.length(),
    )
    let text = read(file)
    let skipped = text.has_prefix("// SKIP")
    for tc in split_tests(text) {
      cases.push({
        number: cases.length(),
        rel,
        tc,
        paged: !skipped && is_paged(tc.attrs),
      })
    }
  }
  let docs_dir = edsl_gen_dir + "/docs"
  for file in typ_files(docs_dir) {
    let rel = "docs/" +
      file.unsafe_substring(start=docs_dir.length() + 1, end=file.length())
    for tc in split_tests(read(file)) {
      cases.push({ number: cases.length(), rel, tc, paged: true, })
    }
  }
  cases
}

///|
/// The path of the main file of a case: the suite file, or for an example
/// of the documentation a file of the virtual directory `docs-examples`,
/// whose other files are the dev assets by name (see `test_files_load`).
fn case_path(rel : String) -> String {
  if rel.has_prefix("docs/") {
    "docs-examples/" + rel.unsafe_substring(start=5, end=rel.length())
  } else {
    "tests/suite/" + rel
  }
}

///|
/// The types of `doc` that generated code may name.
fn edsl_using() -> String {
  let names = @convert.api_type_names()
  names.append([
    "Document", "Seq", "Lit", "Labelled", "Keyed", "Space", "Symbol", "Quoted", "Markup",
    "Equation", "Call", "Set", "Show", "ShowSet", "ShowWith", "Select", "Context",
    "Value", "NoneValue", "AutoValue", "Paint", "Stroke", "Sides", "Corners", "Cells",
    "Sizing", "Numbering", "Supplement", "Counter", "CounterStep", "CounterUpdate",
    "Prose",
  ])
  let out = StringBuilder()
  out.write_string("///|\nusing @doc {\n")
  for name in names {
    out.write_string("  type \{name},\n")
  }
  out.write_string("}\n")
  out.to_string()
}

///|
/// One line of a TSV file: tabs and newlines of the fields are escaped.
fn tsv_line(fields : Array[String]) -> String {
  fields
  .map(field => {
    field
    .replace_all(old="\\", new="\\\\")
    .replace_all(old="\t", new="\\t")
    .replace_all(old="\n", new="\\n")
    .replace_all(old="\r", new="\\r")
  })
  .join("\t") +
  "\n"
}

///|
/// `--failed=<file>`: the cases whose generated code did not type-check
/// (lines `number<TAB>message`), which are regenerated as whole-document
/// fragments and recorded as compile errors.
fn read_failed(path : String) -> Map[Int, String] {
  let failed : Map[Int, String] = Map([])
  for line in read(path).split("\n") {
    let line = line.to_owned()
    match line.find("\t") {
      Some(i) =>
        try @string.parse_int(line.view(end_offset=i).to_owned()) catch {
          _ => ()
        } noraise {
          number => failed[number] = line.view(start_offset=i + 1).to_owned()
        }
      None => ()
    }
  }
  failed
}

///|
fn run_edsl_convert(
  filter : String?,
  baseline : Bool,
  prose : Bool,
  failed : Map[Int, String],
) -> Unit {
  let library = test_library()
  let shards : Array[StringBuilder] = Array::makei(edsl_shards, _ => {
    StringBuilder()
  })
  let registrations : Array[StringBuilder] = Array::makei(edsl_shards, _ => {
    StringBuilder()
  })
  // The line of the next function in each shard file (for mapping
  // compiler messages to cases).
  let using_ = edsl_using()
  let header = "// Generated by `tests/runner edsl-convert`. DO NOT EDIT.\n\n" +
    using_ +
    "\n"
  let header_lines = header.split("\n").count() - 1
  let lines : Array[Int] = Array::make(edsl_shards, header_lines + 1)
  let manifest = StringBuilder()
  manifest.write_string(
    tsv_line([
      "number", "shard", "file", "name", "attrs", "paged", "tier", "math_only", "typed",
      "source_bytes", "fallback_bytes", "fallbacks", "first_line", "last_line", "compile",
    ]),
  )
  let mut converted = 0
  for case_ in suite_cases() {
    if filter is Some(f) &&
      !(case_.tc.name.contains(f) || case_.rel.contains(f)) {
      continue
    }
    let path = case_path(case_.rel)
    let compile_error = failed.get(case_.number)
    let translation = @convert.translate(
      case_.tc.body,
      path,
      library,
      baseline=baseline || compile_error is Some(_),
      prose~,
    )
    let shard = case_.number % edsl_shards
    let function = StringBuilder()
    function.write_string("///|\n")
    function.write_string(
      "/// \{case_.rel} :: \{case_.tc.name} (\{translation.tier})\n",
    )
    function.write_string(
      "fn case_\{case_.number}() -> @doc.Document {\n\{translation.body}\n}\n\n",
    )
    let text = function.to_string()
    let first = lines[shard]
    let count = text.split("\n").count() - 1
    lines[shard] = first + count
    shards[shard].write_string(text)
    registrations[shard].write_string(
      "  @registry.register(\{case_.number}, case_\{case_.number})\n",
    )
    manifest.write_string(
      tsv_line([
        case_.number.to_string(),
        shard.to_string(),
        case_.rel,
        case_.tc.name,
        case_.tc.attrs,
        case_.paged.to_string(),
        translation.tier.to_string(),
        translation.math_only.to_string(),
        translation.typed.to_string(),
        translation.source_bytes.to_string(),
        translation.fallback_bytes.to_string(),
        translation.fallbacks
        .map(f => "\{f.construct}:\{f.kind}:\{f.bytes}")
        .join(";"),
        first.to_string(),
        (first + count - 1).to_string(),
        match compile_error {
          Some(message) => "compile-error: " + message
          None => "ok"
        },
      ]),
    )
    converted += 1
  }
  for shard in 0..<edsl_shards {
    let name = if shard < 10 { "s0\{shard}" } else { "s\{shard}" }
    let text = header +
      shards[shard].to_string() +
      "///|\nfn init {\n" +
      registrations[shard].to_string() +
      "  ()\n}\n"
    @fs.write_string_to_file("\{edsl_gen_dir}/\{name}/gen_cases.mbt", text) catch {
      _ => {
        println("edsl-convert: cannot write the shard \{name}")
        @sys.exit(1)
      }
    }
  }
  @fs.write_string_to_file("\{edsl_gen_dir}/manifest.tsv", manifest.to_string()) catch {
    _ => {
      println("edsl-convert: cannot write the manifest")
      @sys.exit(1)
    }
  }
  println(
    "edsl-convert: \{converted} cases in \{edsl_shards} shards (\{failed.length()} regenerated after compile errors)",
  )
}

///|
/// Make the runner link the shard packages.
fn touch_shards() -> Unit {
  @s00.touch()
  @s01.touch()
  @s02.touch()
  @s03.touch()
  @s04.touch()
  @s05.touch()
  @s06.touch()
  @s07.touch()
  @s08.touch()
  @s09.touch()
  @s10.touch()
  @s11.touch()
  @s12.touch()
  @s13.touch()
  @s14.touch()
  @s15.touch()
}

///|
/// The checks of one case: (check, first difference); an empty difference
/// is a pass.
priv struct CaseChecks {
  checks : Array[(String, String)]
}

///|
fn CaseChecks::add(
  self : CaseChecks,
  check : String,
  edsl : String,
  typst : String,
) -> Unit {
  if edsl == typst {
    self.checks.push((check, ""))
  } else {
    self.checks.push((check, first_difference(edsl, typst)))
    if edsl_dump_dir.val is Some(dir) {
      @fs.write_string_to_file("\{dir}/\{check}.edsl.txt", edsl) catch {
        _ => ()
      }
      @fs.write_string_to_file("\{dir}/\{check}.typst.txt", typst) catch {
        _ => ()
      }
    }
  }
}

///|
/// The normalized frames of a document for the suite: spans and glyph span
/// offsets erased, the elements of tags in the structural dump.
fn suite_frames(doc : @layout.PagedDocument, dumper : StructDumper) -> String {
  let enc = FrameEncoder::new(
    _ => "null",
    zero_span_offsets=true,
    struct_tags=dumper,
  )
  enc.document(doc)
  enc.out.to_string()
}

///|
/// Compare a converted case with its original (docs/edsl-convert.md,
/// section 7).
fn check_case(document : @doc.Document, case_ : SuiteCase) -> CaseChecks {
  let checks : CaseChecks = { checks: [], }
  let source = TestWorld::main_source(case_path(case_.rel), case_.tc.body)
  let library = test_library()
  let library = match parse_features(case_.tc.attrs) {
    Some(f) => { ..library, features: f, }
    None => library
  }
  let world : TestWorld = { main: source, library, }
  let status = (ok : Bool) => if ok { "ok" } else { "error" }

  // 1. Evaluation.
  let dumper : StructDumper = { elems: [], locations: None, }
  let lowered = document.lower(world)
  let sink = @library.Sink::new()
  let evaluated = try
    @eval.eval_source(
      world,
      library,
      @library.Traced::new(),
      sink,
      @library.Route::root(),
      source,
    )
  catch {
    @library.SourceError(errors) => Err(errors)
  } noraise {
    module_ => Ok(module_.content())
  }
  let edsl_diags = diagnostic_lines(lowered.errors.map(e => e.raw)) +
    diagnostic_lines(lowered.warnings.map(w => w.raw))
  let typst_diags = (match evaluated {
      Ok(_) => ""
      Err(errors) => diagnostic_lines(errors)
    }) +
    diagnostic_lines(sink.warnings())
  checks.add(
    "eval-status",
    status(lowered.output() is Some(_)),
    status(evaluated is Ok(_)),
  )
  checks.add("eval-diagnostics", edsl_diags, typst_diags)
  if lowered.output() is Some(edsl) && evaluated is Ok(typst) {
    checks.add("structure", dumper.content(edsl), dumper.content(typst))
  }
  guard case_.paged else { return checks }

  // 2. Layout, with memoization on and off; 3. export.
  let frames_edsl : Array[String?] = []
  let frames_typst : Array[String?] = []
  for memo in [true, false] {
    @library.set_layout_memo_enabled(memo)
    let mode = if memo { "" } else { "-memo-off" }
    let edsl = document.compile_paged(world)
    let typst : @library.Warned[
      Result[@layout.PagedDocument, Array[@library.SourceDiagnostic]],
    ] = @typst.compile(world)
    @library.set_layout_memo_enabled(true)
    checks.add(
      "compile-status" + mode,
      status(edsl.output() is Some(_)),
      status(typst.output is Ok(_)),
    )
    checks.add(
      "compile-diagnostics" + mode,
      diagnostic_lines(edsl.errors.map(e => e.raw)) +
      diagnostic_lines(edsl.warnings.map(w => w.raw)),
      (match typst.output {
        Ok(_) => ""
        Err(errors) => diagnostic_lines(errors)
      }) +
      diagnostic_lines(typst.warnings),
    )
    guard edsl.output() is Some(a) && typst.output is Ok(b) else {
      frames_edsl.push(None)
      frames_typst.push(None)
      continue
    }
    // The element numbering is shared by the two documents, the location
    // numbering is each document's own.
    let elems : Array[@library.Element] = []
    let frames_a = suite_frames(a, { elems, locations: Some(Map([])), })
    let frames_b = suite_frames(b, { elems, locations: Some(Map([])), })
    frames_edsl.push(Some(frames_a))
    frames_typst.push(Some(frames_b))
    checks.add("frames" + mode, frames_a, frames_b)
    if !memo {
      continue
    }
    let svg_options = @svg.SvgOptions::default().resolve(
      @svg.SvgFormatOptions::get(b.options()),
    )
    let svg = (doc : @layout.PagedDocument) => {
      doc.pages().map(page => @svg.svg(page, svg_options)).join("\n")
    }
    checks.add("svg", svg(a), svg(b))
    let pdf = (doc : @layout.PagedDocument) => {
      let warned = @pdf.pdf(doc, @pdf.PdfOptions::default())
      let result = match warned.output {
        Ok(bytes) => "ok \{bytes.length()} bytes \{sha256_hex(bytes[:])}\n"
        Err(errors) => "error\n" + diagnostic_lines(errors)
      }
      result + diagnostic_lines(warned.warnings)
    }
    checks.add("pdf", pdf(a), pdf(b))
    let png_options : @render.RenderOptions = {
      render_bleed: false,
      format: { ppi: None, },
    }
    let png_options = png_options.resolve(
      @render.PngFormatOptions::get(b.options()),
    )
    let png = (doc : @layout.PagedDocument) => {
      let out = StringBuilder()
      for page in doc.pages() {
        let line = try {
          let pixmap = @render.render(page, png_options)
          "\{pixmap.width()}x\{pixmap.height()} \{sha256_hex(pixmap.data()[:])}"
        } catch {
          @render.RenderPanic(message) => "panic \{message}"
        }
        out.write_string(line + "\n")
      }
      out.to_string()
    }
    checks.add("png", png(a), png(b))
  }
  // Each side against itself across the memoization modes.
  if frames_edsl is [Some(on), Some(off)] {
    checks.add("edsl-memo", on, off)
  }
  if frames_typst is [Some(on), Some(off)] {
    checks.add("typst-memo", on, off)
  }
  checks
}

///|
fn run_edsl_suite(filter : String?, verbose : Bool) -> Unit {
  touch_shards()
  let registry = @registry.all()
  if registry.is_empty() {
    println(
      "edsl-suite: no converted cases; run scripts/edsl_convert.sh first (docs/edsl-convert.md, section 8)",
    )
    @sys.exit(1)
    return
  }
  let results = StringBuilder()
  results.write_string(tsv_line(["number", "file", "name", "failed", "detail"]))
  let mut passed = 0
  let mut failed = 0
  let mut missing = 0
  for case_ in suite_cases() {
    if filter is Some(f) &&
      !(case_.tc.name.contains(f) || case_.rel.contains(f)) {
      continue
    }
    guard registry.get(case_.number) is Some(entry) else {
      missing += 1
      continue
    }
    if trace_tests.val {
      println("TRACE \{case_.rel} :: \{case_.tc.name}")
    }
    let checks = check_case((entry.build)(), case_)
    let failures = checks.checks.filter(check => check.1 != "")
    if failures.is_empty() {
      passed += 1
      if verbose {
        println("ok   \{case_.rel} :: \{case_.tc.name}")
      }
    } else {
      failed += 1
      println(
        "FAIL \{case_.rel} :: \{case_.tc.name}: \{failures.map(f => f.0).join(" ")}",
      )
      if verbose {
        println("    \{failures[0].0}: \{failures[0].1}")
      }
    }
    results.write_string(
      tsv_line([
        case_.number.to_string(),
        case_.rel,
        case_.tc.name,
        failures.map(f => f.0).join(" "),
        if failures.is_empty() {
          ""
        } else {
          failures[0].1
        },
      ]),
    )
  }
  @fs.write_string_to_file("\{edsl_gen_dir}/results.tsv", results.to_string()) catch {
    _ => ()
  }
  println(
    "edsl-suite: \{passed} passed, \{failed} failed" +
    (if missing > 0 { ", \{missing} not converted" } else { "" }),
  ) // A selected case without a builder is a failure of the conversion
  // (the registry must cover the enumeration, section 8).
  if failed > 0 || missing > 0 {
    @sys.exit(1)
  }
}
