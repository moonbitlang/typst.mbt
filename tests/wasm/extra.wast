;; Extra WebAssembly tests for the wasmi port (`wasm-spec` stage), covering
;; behavior the official test suite's newer revisions no longer exercise with
;; wasmi's feature set (their main modules use typed function references),
;; and wasmi-specific limits such as the recursion depth.

(module
  ;; Recursion depth: wasmi traps with "call stack exhausted" when the call
  ;; stack reaches 1000 frames.
  (func $rec (export "rec") (param i32) (result i32)
    (if (result i32) (i32.eqz (local.get 0))
      (then (i32.const 0))
      (else (i32.add (i32.const 1) (call $rec (i32.sub (local.get 0) (i32.const 1)))))))
  ;; A frame with many locals to exhaust the value stack.
  (func $big (export "big") (param i32) (result i32)
    (local i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64)
    (local i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64)
    (if (result i32) (i32.eqz (local.get 0))
      (then (i32.const 0))
      (else (i32.add (i32.const 1) (call $big (i32.sub (local.get 0) (i32.const 1)))))))
  ;; Tail recursion never exhausts the call stack.
  (func $tail (export "tail") (param i32 i32) (result i32)
    (if (result i32) (i32.eqz (local.get 0))
      (then (local.get 1))
      (else (return_call $tail (i32.sub (local.get 0) (i32.const 1)) (i32.add (local.get 1) (i32.const 2))))))
  (func (export "br_table") (param i32) (result i32)
    (block $d
      (block $c
        (block $b
          (block $a
            (br_table $a $b $c $d (local.get 0)))
          (return (i32.const 10)))
        (return (i32.const 20)))
      (return (i32.const 30)))
    (i32.const 40))
  (func (export "br_table_values") (param i32) (result i32 i32)
    (block $outer (result i32 i32)
      (block $inner (result i32 i32)
        (i32.const 1) (i32.const 2)
        (br_table $inner $outer (local.get 0)))
      (drop) (i32.const 100)))
  (type $t (func (param i32) (result i32)))
  (table 4 funcref)
  (elem (i32.const 0) $double $inc)
  (func $double (type $t) (i32.mul (local.get 0) (i32.const 2)))
  (func $inc (type $t) (i32.add (local.get 0) (i32.const 1)))
  (func (export "indirect") (param i32 i32) (result i32)
    (call_indirect (type $t) (local.get 1) (local.get 0)))
  (func (export "indirect_tail") (param i32 i32) (result i32)
    (return_call_indirect (type $t) (local.get 1) (local.get 0)))
  (memory 1 3)
  (func (export "grow") (param i32) (result i32) (memory.grow (local.get 0)))
  (func (export "size") (result i32) (memory.size))
  (func (export "fill_sum") (param i32 i32 i32) (result i32)
    (local $i i32) (local $s i32)
    (memory.fill (local.get 0) (local.get 1) (local.get 2))
    (block $done
      (loop $l
        (br_if $done (i32.ge_u (local.get $i) (local.get 2)))
        (local.set $s (i32.add (local.get $s) (i32.load8_u (i32.add (local.get 0) (local.get $i)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $l)))
    (local.get $s))
  (func (export "copy_overlap") (result i64)
    (i64.store (i32.const 0) (i64.const 0x0807060504030201))
    (memory.copy (i32.const 1) (i32.const 0) (i32.const 7))
    (i64.load (i32.const 0)))
  (func (export "simd") (param i32) (result i32)
    (i32x4.extract_lane 2
      (i32x4.add (i32x4.splat (local.get 0)) (v128.const i32x4 1 2 3 4))))
  (func (export "simd_mul") (param f32) (result f32)
    (f32x4.extract_lane 3
      (f32x4.mul (f32x4.splat (local.get 0)) (v128.const f32x4 1.5 2.5 3.5 4.5))))
  (func (export "select") (param i32 i32 i32) (result i32)
    (select (local.get 0) (local.get 1) (i32.lt_s (local.get 2) (i32.const 5))))
  (func (export "div") (param i32 i32) (result i32) (i32.div_s (local.get 0) (local.get 1)))
  (func (export "rem_u") (param i64 i64) (result i64) (i64.rem_u (local.get 0) (local.get 1)))
  (func (export "trunc") (param f64) (result i32) (i32.trunc_f64_s (local.get 0)))
  (func (export "unreachable") (unreachable))
  (func (export "oob") (param i32) (result i32) (i32.load offset=8 (local.get 0)))
)

(assert_return (invoke "rec" (i32.const 10)) (i32.const 10))
(assert_return (invoke "rec" (i32.const 997)) (i32.const 997))
(assert_return (invoke "rec" (i32.const 998)) (i32.const 998))
(assert_exhaustion (invoke "rec" (i32.const 999)) "call stack exhausted")
(assert_exhaustion (invoke "rec" (i32.const 1000)) "call stack exhausted")
(assert_exhaustion (invoke "rec" (i32.const 100000)) "call stack exhausted")
(assert_return (invoke "big" (i32.const 10)) (i32.const 10))
(assert_return (invoke "big" (i32.const 900)) (i32.const 900))
(assert_return (invoke "tail" (i32.const 100000) (i32.const 0)) (i32.const 200000))
(assert_return (invoke "br_table" (i32.const 0)) (i32.const 10))
(assert_return (invoke "br_table" (i32.const 1)) (i32.const 20))
(assert_return (invoke "br_table" (i32.const 2)) (i32.const 30))
(assert_return (invoke "br_table" (i32.const 3)) (i32.const 40))
(assert_return (invoke "br_table" (i32.const 99)) (i32.const 40))
(assert_return (invoke "br_table_values" (i32.const 0)) (i32.const 1) (i32.const 100))
(assert_return (invoke "br_table_values" (i32.const 1)) (i32.const 1) (i32.const 2))
(assert_return (invoke "indirect" (i32.const 0) (i32.const 21)) (i32.const 42))
(assert_return (invoke "indirect" (i32.const 1) (i32.const 21)) (i32.const 22))
(assert_trap (invoke "indirect" (i32.const 2) (i32.const 21)) "uninitialized element")
(assert_trap (invoke "indirect" (i32.const 9) (i32.const 21)) "undefined element")
(assert_return (invoke "indirect_tail" (i32.const 0) (i32.const 5)) (i32.const 10))
(assert_return (invoke "size") (i32.const 1))
(assert_return (invoke "grow" (i32.const 1)) (i32.const 1))
(assert_return (invoke "grow" (i32.const 2)) (i32.const -1))
(assert_return (invoke "grow" (i32.const 1)) (i32.const 2))
(assert_return (invoke "size") (i32.const 3))
(assert_return (invoke "fill_sum" (i32.const 100) (i32.const 3) (i32.const 10)) (i32.const 30))
(assert_trap (invoke "fill_sum" (i32.const 196600) (i32.const 3) (i32.const 10)) "out of bounds memory access")
(assert_return (invoke "copy_overlap") (i64.const 0x0706050403020101))
(assert_return (invoke "simd" (i32.const 10)) (i32.const 13))
(assert_return (invoke "simd_mul" (f32.const 2)) (f32.const 9))
(assert_return (invoke "select" (i32.const 1) (i32.const 2) (i32.const 3)) (i32.const 1))
(assert_return (invoke "select" (i32.const 1) (i32.const 2) (i32.const 7)) (i32.const 2))
(assert_trap (invoke "div" (i32.const 1) (i32.const 0)) "integer divide by zero")
(assert_trap (invoke "div" (i32.const 0x80000000) (i32.const -1)) "integer overflow")
(assert_return (invoke "rem_u" (i64.const -1) (i64.const 7)) (i64.const 1))
(assert_trap (invoke "trunc" (f64.const nan)) "invalid conversion to integer")
(assert_trap (invoke "trunc" (f64.const 3e9)) "integer overflow")
(assert_trap (invoke "unreachable") "unreachable")
(assert_trap (invoke "oob" (i32.const -4)) "out of bounds memory access")

;; Instantiation: element segment does not fit, start function traps.
(assert_trap
  (module (table 1 funcref) (func $f) (elem (i32.const 1) $f))
  "out of bounds table access")
(assert_trap
  (module (func $s (unreachable)) (start $s))
  "unreachable")
;; Validation errors.
(assert_invalid (module (func (result i32) (i64.const 0))) "type mismatch")
(assert_invalid (module (func (local.get 3))) "unknown local")
(assert_invalid (module (memory 1) (func (i32.load align=8 (i32.const 0)) drop)) "alignment")
