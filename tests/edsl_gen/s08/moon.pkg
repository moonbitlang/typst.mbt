import {
  "moonbitlang/typst/doc",
  "moonbitlang/typst/tests/edsl_gen/registry",
}

supported_targets = "native"

// The imports are for the generated `gen_cases.mbt` (scripts/edsl_convert.sh,
// not committed); the committed package is only `shard.mbt`, which names
// neither. With the whole suite converted (3792 cases) the shards check
// without a warning, so nothing else is switched off here.

warnings = "-unused_package"
