// Differential tests of the `cbrt` port (`cbrt.mbt`) against the `libm`
// crate. The expected results (bit-exact f64s, or FNV-1a-64 hashes of them)
// are in `cbrt_cases_wbtest.mbt`, generated by
// `oracle/src/bin/gen_libm_cbrt_tests.rs` (see there for the cases and the
// regeneration command).

///|
/// The bits of a result; every NaN counts as the same value.
fn cbrt_test_canon(r : Double) -> UInt64 {
  if r.is_nan() {
    0x7ff8000000000000UL
  } else {
    r.reinterpret_as_uint64()
  }
}

///|
fn cbrt_test_hex(v : UInt64) -> String {
  let digits = "0123456789abcdef"
  let buf = StringBuilder()
  for i = 15; i >= 0; i = i - 1 {
    buf.write_char(digits[((v >> (i * 4)) & 0xfUL).to_int()].unsafe_to_char())
  }
  buf.to_string()
}

///|
/// FNV-1a-64 over the result words (`Hash` in the generator).
fn cbrt_test_hash(h : UInt64, r : Double) -> UInt64 {
  (h ^ cbrt_test_canon(r)) * 0x100000001b3UL
}

///|
const CBRT_TEST_HASH_INIT : UInt64 = 0xcbf29ce484222325UL

///|
/// SplitMix64 (`Rng` in the generator).
priv struct CbrtTestRng {
  mut state : UInt64
}

///|
fn CbrtTestRng::next(self : CbrtTestRng) -> UInt64 {
  self.state = self.state + 0x9E3779B97F4A7C15UL
  let mut z = self.state
  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9UL
  z = (z ^ (z >> 27)) * 0x94D049BB133111EBUL
  z ^ (z >> 31)
}

///|
/// `sample` in the generator: a double with a uniformly distributed biased
/// exponent in `lo..=hi`; the low mantissa bits are cleared for some samples.
fn cbrt_test_sample(
  rng : CbrtTestRng,
  lo : Int,
  hi : Int,
  signed : Bool,
) -> Double {
  let e = lo.to_uint64() + (rng.next() >> 11) % (hi - lo + 1).to_uint64()
  let mut mant = rng.next() & 0x000fffffffffffffUL
  let t = rng.next()
  match (t & 7UL).to_int() {
    0 => mant = mant & 0xffffffff00000000UL
    1 => mant = mant & 0xfffff00000000000UL
    2 => mant = 0UL
    _ => ()
  }
  let sign = if signed { t >> 63 } else { 0UL }
  ((sign << 63) | (e << 52) | mant).reinterpret_as_double()
}

///|
/// The mismatches of `cbrt` on recorded inputs.
fn cbrt_test_failures(
  inputs : ReadOnlyArray[UInt64],
  expected : ReadOnlyArray[UInt64],
) -> Array[String] {
  let failures = []
  for i in 0..<inputs.length() {
    let bits = inputs[i]
    let got = cbrt_test_canon(cbrt(bits.reinterpret_as_double()))
    if got != expected[i] {
      failures.push(
        "cbrt(\{cbrt_test_hex(bits)}) = \{cbrt_test_hex(got)}, expected \{cbrt_test_hex(expected[i])}",
      )
    }
  }
  failures
}

///|
test "cbrt: special values" {
  assert_eq(cbrt_special_expected.length(), cbrt_special_inputs.length())
  assert_eq(cbrt_test_failures(cbrt_special_inputs, cbrt_special_expected), [])
}

///|
test "cbrt: hard cases" {
  assert_eq(cbrt_hard_expected.length(), cbrt_hard_inputs.length())
  assert_eq(cbrt_test_failures(cbrt_hard_inputs, cbrt_hard_expected), [])
}

///|
/// `cube_inputs` in the generator. The cube root of a cube is exact.
test "cbrt: cubes" {
  let mut h = CBRT_TEST_HASH_INIT
  for n in 1..<=CBRT_CUBES {
    let x = (n.to_int64() * n.to_int64() * n.to_int64()).to_double()
    let bits = x.reinterpret_as_uint64()
    let r = cbrt(x)
    assert_eq(r, n.to_double())
    h = cbrt_test_hash(h, r)
    h = cbrt_test_hash(h, cbrt((bits - 1).reinterpret_as_double()))
    h = cbrt_test_hash(h, cbrt((bits + 1).reinterpret_as_double()))
  }
  assert_eq(h, CBRT_CUBES_HASH)
}

///|
/// `pow2_inputs` in the generator.
test "cbrt: powers of two" {
  let mut h = CBRT_TEST_HASH_INIT
  for k in -1074..<=1023 {
    let x = if k < -1022 {
      (1UL << (k + 1074)).reinterpret_as_double()
    } else {
      ((k + 1023).to_uint64() << 52).reinterpret_as_double()
    }
    h = cbrt_test_hash(h, cbrt(x))
    h = cbrt_test_hash(h, cbrt(-x))
  }
  assert_eq(h, CBRT_POW2_HASH)
}

///|
/// `grid_inputs` in the generator.
test "cbrt: grid" {
  let mut h = CBRT_TEST_HASH_INIT
  for i in -80000..<=80000 {
    h = cbrt_test_hash(h, cbrt(i.to_double() / 16.0))
  }
  assert_eq(h, CBRT_GRID_HASH)
}

///|
test "cbrt: sweeps" {
  let failures = []
  for entry in cbrt_sweeps[:] {
    let (seed, count, lo, hi, signed, expected) = entry
    let rng = CbrtTestRng::{ state: seed, }
    let mut h = CBRT_TEST_HASH_INIT
    for _ in 0..<count {
      h = cbrt_test_hash(h, cbrt(cbrt_test_sample(rng, lo, hi, signed)))
    }
    if h != expected {
      failures.push("\{lo} \{hi} \{signed}")
    }
  }
  assert_eq(failures, [])
}

///|
/// The example of `cbrt.rs`'s own test (`spot_checks`).
test "cbrt: spot checks" {
  // Exposes a rounding mode problem. Ignored on i586 because of inaccurate FMA.
  assert_eq(
    cbrt(0xf7f792b28f600000UL.reinterpret_as_double()).reinterpret_as_uint64(),
    0xd29ce68655d962f3UL,
  )
}
