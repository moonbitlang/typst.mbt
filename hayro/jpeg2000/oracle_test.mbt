// Differential tests against the real `hayro-jpeg2000` crate:
// `testdata/oracle.tsv` is recorded by
// `oracle/src/bin/gen_hayro_codec_tests.rs jpx` from the files in
// `testdata/files/` (generated by `scripts/gen_jpx_test_files.py`). Each file
// is decoded under five `DecodeSettings`; a line records the image info, the
// component bit depths and FNV-1a hashes of all `f32` samples and of
// `data_u8()`, or the error.

///|
fn jpx_module_root() -> String? {
  for prefix in ["", "../", "../../", "../../../"] {
    if @fs.path_exists(prefix + "moon.mod") {
      return Some(prefix)
    }
  }
  None
}

///|
/// FNV-1a (64 bit).
fn jpx_fnv(h : UInt64, data : BytesView) -> UInt64 {
  let mut h = h
  for b in data {
    h = (h ^ b.to_uint64()) * 0x100000001b3UL
  }
  h
}

///|
fn jpx_hex16(v : UInt64) -> String {
  let s = v.to_string(radix=16)
  String::make(16 - s.length(), '0') + s
}

///|
fn jpx_oracle_line(data : Bytes, settings_name : String) -> String {
  let (palette, strict, div) = match settings_name {
    "p1 s0 d0" => (true, false, 0U)
    "p0 s0 d0" => (false, false, 0U)
    "p1 s1 d0" => (true, true, 0U)
    "p1 s0 d2" => (true, false, 2U)
    _ => (true, false, 5U)
  }
  let settings : @jpeg2000.DecodeSettings = {
    resolve_palette_indices: palette,
    strict,
    target_resolution: None,
  }
  let out = StringBuilder()
  let image = @jpeg2000.Image::new(data[:], settings) catch {
    e => {
      out.write_string("E \{e}")
      return out.to_string()
    }
  }
  let image = if div > 0 {
    let settings = {
      ..settings,
      target_resolution: Some((image.width() / div, image.height() / div)),
    }
    @jpeg2000.Image::new(data[:], settings) catch {
      _ => abort("second decode failed")
    }
  } else {
    image
  }
  let cs = match image.color_space() {
    Gray => "gray"
    RGB => "rgb"
    CMYK => "cmyk"
    Unknown(num_channels~) => "unknown\{num_channels}"
    Icc(profile~, num_channels~) =>
      "icc\{num_channels}:\{profile.length()}:\{jpx_hex16(jpx_fnv(0xcbf29ce484222325UL, profile[:]))}"
  }
  out.write_string(
    "\{image.width()} \{image.height()} \{cs} a\{if image.has_alpha() { 1 } else { 0 }} b\{image.original_bit_depth()}",
  )
  let ctx = @jpeg2000.DecoderContext::default()
  let decoded = image.decode(ctx) catch {
    e => {
      out.write_string(" E \{e}")
      return out.to_string()
    }
  }
  let comps = decoded.components().map(c => c.bit_depth().to_string())
  let mut h = 0xcbf29ce484222325UL
  for c in decoded.components() {
    for v in c.samples() {
      let bits = v.reinterpret_as_uint()
      for i in 0..<4 {
        h = (h ^ ((bits >> (8 * i)) & 0xFF).to_uint64()) * 0x100000001b3UL
      }
    }
  }
  let bytes = decoded.data_u8()
  out.write_string(
    " c\{comps.join(",")} f\{jpx_hex16(h)} \{bytes.length()}:\{jpx_hex16(jpx_fnv(0xcbf29ce484222325UL, bytes[:]))}",
  )
  out.to_string()
}

///|
test "jpx oracle" {
  guard jpx_module_root() is Some(root) else { return }
  let expected = @fs.read_file_to_string(
    root + "hayro/jpeg2000/testdata/oracle.tsv",
  )
  let mismatches = []
  let mut checked = 0
  let mut cur_path = ""
  let mut cur_data = b""
  for line in expected.split("\n") {
    let line = line.to_owned()
    if line.is_empty() || line.has_prefix("#") {
      continue
    }
    let parts = line.split("\t").map(p => p.to_owned()).collect()
    if parts[0] != cur_path {
      cur_path = parts[0]
      cur_data = @fs.read_file_to_bytes(root + cur_path)
    }
    let actual = jpx_oracle_line(cur_data, parts[1])
    if actual != parts[2] {
      mismatches.push(
        "\{parts[0]} \{parts[1]}:\n  expected \{parts[2]}\n  got      \{actual}",
      )
    }
    checked += 1
  }
  if mismatches.length() > 0 {
    fail(
      "\{mismatches.length()}/\{checked} mismatches:\n" + mismatches.join("\n"),
    )
  }
  assert_true(checked > 0)
}
