// Helpers for `oracle_test.mbt` (generated by
// oracle/src/bin/gen_hayro_syntax_tests.rs): the canonical summary of a PDF
// file, computed like the generator does with the real crate.

///|
fn checkout_dir(prefix : String) -> String? {
  let home = @env.get_env_vars().get("HOME").unwrap_or("")
  let base = home + "/.cargo/git/checkouts"
  let dirs = (@fs.read_dir(base) catch { _ => [][:] }).to_owned()
  for d in dirs {
    if d.has_prefix(prefix) {
      let revs = (@fs.read_dir(base + "/" + d) catch { _ => [][:] }).to_owned()
      for r in revs {
        return Some(base + "/" + d + "/" + r)
      }
    }
  }
  None
}

///|
fn oracle_file(name : String) -> Bytes? {
  let path = if name.has_prefix("assets/") {
    guard checkout_dir("typst-dev-assets-") is Some(dir) else { return None }
    dir + "/files/images/" + name.unsafe_substring(start=7, end=name.length())
  } else {
    guard checkout_dir("hayro-") is Some(dir) else { return None }
    dir + "/hayro-tests/pdfs/" + name
  }
  Some(@fs.read_file_to_bytes(path)) catch {
    _ => None
  }
}

///|
fn fnv(data : BytesView) -> UInt64 {
  let mut h = 0xcbf29ce484222325UL
  for b in data {
    h = (h ^ b.to_uint64()) * 0x100000001b3UL
  }
  h
}

///|
fn hex_u64(v : UInt64) -> String {
  v.to_string(radix=16)
}

///|
fn hex_bytes(data : BytesView) -> String {
  let sb = StringBuilder()
  for b in data {
    let s = b.to_int().to_string(radix=16)
    if s.length() == 1 {
      sb.write_char('0')
    }
    sb.write_string(s)
  }
  sb.to_string()
}

///|
fn dump_maybe_ref(
  o : @syntax.MaybeRef[@syntax.Object],
  out : StringBuilder,
) -> Unit {
  match o {
    Ref(r) => out.write_string("R\{r.obj_number}.\{r.gen_number}")
    NotRef(o) => dump_object(o, out)
  }
}

///|
fn dump_object(o : @syntax.Object, out : StringBuilder) -> Unit {
  match o {
    Null => out.write_char('n')
    Boolean(b) => out.write_char(if b { 't' } else { 'f' })
    Number(n) =>
      out.write_string("d" + hex_u64(n.as_f64().reinterpret_as_uint64()))
    String(s) => out.write_string("s" + hex_bytes(s.as_bytes()[:]))
    Name(n) => out.write_string("/" + hex_bytes(n.as_bytes()[:]))
    Array(a) => {
      out.write_char('[')
      for i, item in a.raw_iter().collect() {
        if i > 0 {
          out.write_char(' ')
        }
        dump_maybe_ref(item, out)
      }
      out.write_char(']')
    }
    Dict(d) => {
      out.write_string("<<")
      for entry in d.entries() {
        out.write_string("/" + hex_bytes(entry.0.as_bytes()[:]) + " ")
        dump_maybe_ref(entry.1, out)
        out.write_char(' ')
      }
      out.write_string(">>")
    }
    Stream(s) => {
      out.write_char('S')
      dump_object(Dict(s.dict()), out)
      let raw = s.raw_data()
      out.write_string("{\{raw.length()}:\{hex_u64(fnv(raw))}")
      let image = s
        .filters()
        .iter()
        .any(f => f is (DctDecode | JpxDecode | Jbig2Decode | CcittFaxDecode))
      if image {
        out.write_string(" I}")
        return
      }
      match s.decoded() {
        Ok(d) => out.write_string(" \{d.length()}:\{hex_u64(fnv(d))}}")
        Err(_) => out.write_string(" E}")
      }
    }
  }
}

///|
fn version_debug(v : @syntax.PdfVersion) -> String {
  "Pdf" + v.as_str().replace(old=".", new="")
}

///|
fn f64_hex(v : Double) -> String {
  hex_u64(v.reinterpret_as_uint64())
}

///|
fn f32_hex(v : Float) -> String {
  v.reinterpret_as_uint().to_uint64() |> hex_u64
}

///|
fn summary(data : Bytes) -> String {
  let out = StringBuilder()
  let pdf = match @syntax.Pdf::new(data) {
    Ok(pdf) => pdf
    Err(Invalid) => return "load invalid\n"
    Err(Decryption(_)) => return "load decryption\n"
  }
  out.write_string("version \{version_debug(pdf.version())}\n")
  out.write_string("objects \{pdf.len()}\n")
  // Objects at the same position are yielded in hash map order, so the
  // lines are sorted.
  let lines = []
  for o in pdf.objects() {
    let line = StringBuilder()
    dump_object(o, line)
    lines.push(line.to_string())
  }
  // The lines are ASCII, so code unit order is byte order.
  lines.sort_by((a, b) => @syntax.compare_latin1(a, b))
  let count = lines.length()
  let dump = StringBuilder()
  for l in lines {
    dump.write_string(l)
    dump.write_char('\n')
  }
  let dump = @utf8.encode(dump.to_string())
  out.write_string("objhash \{count} \{hex_u64(fnv(dump[:]))}\n")
  out.write_string("ocgs \{pdf.xref().has_optional_content_groups()}\n")
  for i, page in pdf.pages().iter().collect() {
    let r = (r : @syntax.Rect) => {
      "\{f64_hex(r.x0)} \{f64_hex(r.y0)} \{f64_hex(r.x1)} \{f64_hex(r.y1)}"
    }
    let rot = match page.rotation() {
      NoRotation => 0
      Horizontal => 90
      Flipped => 180
      FlippedHorizontal => 270
    }
    let (w, h) = page.render_dimensions()
    out.write_string(
      "page \{i} media \{r(page.media_box())} crop \{r(page.crop_box())} rot \{rot} dims \{f32_hex(w)} \{f32_hex(h)}\n",
    )
    for invert in [false, true] {
      let t = page.initial_transform(invert).as_coeffs()
      let parts = t.iter().map(f64_hex).collect()
      out.write_string("  transform \{parts.join(" ")}\n")
    }
    match page.page_stream() {
      Some(s) => out.write_string("  stream \{s.length()}:\{hex_u64(fnv(s))}\n")
      None => out.write_string("  stream none\n")
    }
    let ops = page.typed_operations()
    let names = StringBuilder()
    let mut n = 0
    while ops.next() is Some(op) {
      names.write_string(op.name())
      names.write_char(' ')
      n += 1
    }
    let names = @utf8.encode(names.to_string())
    out.write_string("  ops \{n} \{hex_u64(fnv(names[:]))}\n")
  }
  out.to_string()
}

///|
/// Debugging: with `HAYRO_ORACLE_DUMP=<name>:<out path>`, write the object
/// dump of that file (compare with `gen_hayro_syntax_tests <file>`).
test "oracle dump" {
  guard @env.get_env_vars().get("HAYRO_ORACLE_DUMP") is Some(spec) else {
    return
  }
  guard spec.split(":").collect() is [name, out] else { return }
  guard oracle_file(name.to_owned()) is Some(data) else { return }
  guard @syntax.Pdf::new(data) is Ok(pdf) else { return }
  let dump = StringBuilder()
  for o in pdf.objects() {
    dump_object(o, dump)
    dump.write_char('\n')
  }
  @fs.write_string_to_file(out.to_owned(), dump.to_string())
}

///|
fn check_pdf(name : String, expected : String) -> Unit raise {
  guard oracle_file(name) is Some(data) else { return }
  let actual = summary(data)
  if actual.trim_end(chars="\n") != expected.trim_end(chars="\n") {
    fail("summary mismatch for \{name}:\n\{actual}\nexpected:\n\{expected}")
  }
}
