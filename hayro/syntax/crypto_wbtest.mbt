///|
test "crypto aes256 cbc encryption decryption" {
  crypto_test_aes_cbc(
    AESCipher::new_aes256(
      b"\x60\x3d\xeb\x10\x15\xca\x71\xbe\x2b\x73\xae\xf0\x85\x7d\x77\x81\x1f\x35\x2c\x07\x3b\x61\x08\xd7\x2d\x98\x10\xa3\x09\x14\xdf\xf4"[:],
    ).unwrap(),
    b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f",
    b"\x48\x65\x6c\x6c\x6f\x2c\x20\x57\x6f\x72\x6c\x64\x21",
    "481290912e8cdf083258ddb453f24db8",
  )
  crypto_test_aes_cbc(
