  crypto_test_aes_cbc(
    AESCipher::new_aes128(
      b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f"[:],
    ).unwrap(),
    b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff",
    b"\x54\x68\x65\x20\x71\x75\x69\x63\x6b\x20\x62\x72\x6f\x77\x6e\x20\x66\x6f\x78\x20\x6a\x75\x6d\x70\x73\x20\x6f\x76\x65\x72\x20\x74\x68\x65\x20\x6c\x61\x7a\x79\x20\x64\x6f\x67",
    "fa2ea8e2a4b7c077654dd6b6593a2aa4cda51da1b32b608addf20c31783976e6be6588bae169c04aed58407d6f17b71c",
  )
  crypto_test_aes_cbc(
    AESCipher::new_aes128(
      b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"[:],
    ).unwrap(),
    b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\x41\x45\x53\x2d\x31\x32\x38\x20\x65\x6e\x63\x72\x79\x70\x74\x69\x6f\x6e\x20\x74\x65\x73\x74\x20\x76\x65\x63\x74\x6f\x72\x20\x66\x6f\x72\x20\x43\x42\x43\x20\x6d\x6f\x64\x65\x20\x77\x69\x74\x68\x20\x50\x4b\x43\x53\x37\x20\x70\x61\x64\x64\x69\x6e\x67",
    "adcd1d937bdf4eec37bebb47468b6c243ddb5b05c9e701c9e6ae546689d2906d9c4064630eb05d25c94b6e97a4e3f8985abdc357a06244206d3e4d148510b0f0",
  )
  crypto_test_aes_cbc(
    AESCipher::new_aes128(
      b"\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa"[:],
    ).unwrap(),
