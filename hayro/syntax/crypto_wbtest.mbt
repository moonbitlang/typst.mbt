///|
test "crypto aes invalid key lengths" {
  assert_true(AESCipher::new_aes128(Bytes::make(15, 0)[:]) is None)
  assert_true(AESCipher::new_aes128(Bytes::make(17, 0)[:]) is None)
  assert_true(AESCipher::new_aes256(Bytes::make(31, 0)[:]) is None)
  assert_true(AESCipher::new_aes256(Bytes::make(33, 0)[:]) is None)
}
