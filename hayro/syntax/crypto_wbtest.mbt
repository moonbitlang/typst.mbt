// Unit tests for the crypto primitives, ported from the upstream module tests
// (`crypto/{md5,sha256,sha384,sha512,rc4,aes}.rs`). Upstream compares against
// external crates (`md5`, `sha2`, `aes`, `cbc`); the expected values here were
// generated with Python's `hashlib` and `cryptography`.

///|
fn crypto_test_hex(data : Bytes) -> String {
  let sb = StringBuilder::new()
  for b in data {
    let s = b.to_int()
    sb.write_char("0123456789abcdef"[s >> 4].unsafe_to_char())
    sb.write_char("0123456789abcdef"[s & 15].unsafe_to_char())
  }
  sb.to_string()
}

///|
test "crypto md5 correctness" {
  assert_eq(
    crypto_test_hex(
      md5_calculate(b"\x48\x65\x6c\x6c\x6f\x2c\x20\x57\x6f\x72\x6c\x64\x21"[:]),
    ),
    "65a8e27d8879283831b664bd8b7f0ad4",
  )
  assert_eq(
    crypto_test_hex(
      md5_calculate(
        b"\x54\x68\x65\x20\x71\x75\x69\x63\x6b\x20\x62\x72\x6f\x77\x6e\x20\x66\x6f\x78\x20\x6a\x75\x6d\x70\x73\x20\x6f\x76\x65\x72\x20\x74\x68\x65\x20\x6c\x61\x7a\x79\x20\x64\x6f\x67"[:],
      ),
    ),
    "9e107d9d372bb6826bd81d3542a419d6",
  )
  assert_eq(
    crypto_test_hex(
      md5_calculate(
        b"\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a"[:],
      ),
    ),
    "c3fcd3d76192e4007dfb496cca67e13b",
  )
  assert_eq(
    crypto_test_hex(md5_calculate(b""[:])),
    "d41d8cd98f00b204e9800998ecf8427e",
  )
  assert_eq(
    crypto_test_hex(
      md5_calculate(
        b"\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61\x61"[:],
      ),
    ),
    "887f30b43b2867f4a9accceee7d16e6c",
  )
}

///|
test "crypto sha256 correctness" {
  assert_eq(
    crypto_test_hex(sha256_calculate(b""[:])),
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  )
  assert_eq(
    crypto_test_hex(sha256_calculate(b"\x61"[:])),
    "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb",
  )
  assert_eq(
    crypto_test_hex(sha256_calculate(b"\x61\x62\x63"[:])),
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
  )
  assert_eq(
    crypto_test_hex(
      sha256_calculate(
        b"\x48\x65\x6c\x6c\x6f\x2c\x20\x57\x6f\x72\x6c\x64\x21"[:],
      ),
    ),
    "dffd6021bb2bd5b0af676290809ec3a53191dd81c7f70a4b28688a362182986f",
  )
  assert_eq(
    crypto_test_hex(sha256_calculate(b"\xde\xad\xbe\xef"[:])),
    "5f78c33274e43fa9de5659265c1d917e25c03722dcb0b8d27db8d5feaa813953",
  )
  assert_eq(
    crypto_test_hex(
