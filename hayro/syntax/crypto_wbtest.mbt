    "f1721f49518ee462a3d81def26d81037cd474b4254b85ad7c8f1509594d0177bbb996ee9625813852bacac108c2a72c83a8587050fec1dcda64730d6470953e6",
  )
}

///|
fn crypto_test_rc4_decrypt(key : Bytes, input : Bytes) -> Bytes {
  let cipher = Rc4::new(key[:])
  cipher.decrypt(input[:])
}

///|
test "crypto rc4 correctness" {
  assert_eq(crypto_test_rc4_decrypt(b"\x61", b"\x68"), b"\x78")
  assert_eq(
    crypto_test_rc4_decrypt(b"\x6b\x65\x79", b"\x7f\x09\x47\x99"),
    b"\x74\x65\x73\x74",
  )
  assert_eq(
    crypto_test_rc4_decrypt(b"\x68\x65\x6c\x6c\x6f", b"\x78\x3e\xcd\x96\xcf"),
    b"\x77\x6f\x72\x6c\x64",
  )
  assert_eq(
    crypto_test_rc4_decrypt(b"\x01\x02", b"\x0c\x74\xb9"),
    b"\x48\x69\x21",
  )
  assert_eq(
    crypto_test_rc4_decrypt(b"\x73\x65\x63\x72\x65\x74", b"\x80\x45\xb5"),
    b"\x6d\x73\x67",
  )
  assert_eq(
    crypto_test_rc4_decrypt(
      b"\x65\x6e\x63\x72\x79\x70\x74\x69\x6f\x6e", b"\x8a\x36\x3f\x85\xdb\x9a\x62\x7c\x6c\x56\x81\x89",
    ),
    b"\x48\x65\x6c\x6c\x6f\x20\x57\x6f\x72\x6c\x64\x21",
  )
  assert_eq(
    crypto_test_rc4_decrypt(
      b"\x6d\x79\x5f\x73\x65\x63\x72\x65\x74\x5f\x6b\x65\x79", b"\x1d\xe2\xce\x64\x4c\x88\x1c\x42\x7d\x94\x7b\x1c\x49\xcd\x62\x3f\xca\x90\x99",
    ),
    b"\x54\x68\x65\x20\x71\x75\x69\x63\x6b\x20\x62\x72\x6f\x77\x6e\x20\x66\x6f\x78",
  )
  assert_eq(
    crypto_test_rc4_decrypt(
      b"\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70", b"\xf8\xa8\x2a\xae\x92\x2f\x8c\x3b\x13\xc7\x4b\x99\xdb\x41\x2c\x9f\x92\x59\xc2\xe5\x62\x2c",
    ),
    b"\x54\x68\x69\x73\x20\x69\x73\x20\x61\x20\x74\x65\x73\x74\x20\x6d\x65\x73\x73\x61\x67\x65",
  )
  assert_eq(
    crypto_test_rc4_decrypt(
      b"\x70\x61\x73\x73\x77\x6f\x72\x64\x31\x32\x33", b"\xdb\xc3\xa3\x21\x7e\x55\x0b\x65\xa2\x3f\x0e\xb7\x58\x7c\x28\xee\xd6\x92\x05\xbc\x6c",
    ),
    b"\x44\x65\x63\x72\x79\x70\x74\x69\x6f\x6e\x20\x73\x75\x63\x63\x65\x73\x73\x66\x75\x6c",
  )
  assert_eq(
    crypto_test_rc4_decrypt(
      b"\x76\x65\x72\x79\x5f\x6c\x6f\x6e\x67\x5f\x6b\x65\x79", b"\xc6\xd2\x00\x3b\x8c\x18\x49\x2c\xd0\x5c\x8a\x34\xec\xfe\xed\x62\xc0\x3c\x80\x81\x7e\x4e\xe1\x7d\xbd",
    ),
    b"\x50\x44\x46\x20\x75\x73\x65\x73\x20\x52\x43\x34\x20\x66\x6f\x72\x20\x73\x65\x63\x75\x72\x69\x74\x79",
  )
}

///|
fn crypto_test_aes_block(
  cipher : AESCipher,
  plaintext : Bytes,
) -> (Bytes, Bytes) {
  let state = FixedArray::makei(16, i => plaintext[i])
  cipher.encrypt_block(state)
  let encrypted = Bytes::makei(16, i => state[i])
  cipher.decrypt_block(state)
  (encrypted, Bytes::makei(16, i => state[i]))
}

///|
test "crypto aes128 block operations" {
  {
    let cipher = AESCipher::new_aes128(
      b"\x2b\x7e\x15\x16\x28\xae\xd2\xa6\xab\xf7\x15\x88\x09\xcf\x4f\x3c"[:],
    ).unwrap()
    let (encrypted, decrypted) = crypto_test_aes_block(
      cipher, b"\x32\x43\xf6\xa8\x88\x5a\x30\x8d\x31\x31\x98\xa2\xe0\x37\x07\x34",
    )
    assert_eq(crypto_test_hex(encrypted), "3925841d02dc09fbdc118597196a0b32")
    assert_eq(
      decrypted, b"\x32\x43\xf6\xa8\x88\x5a\x30\x8d\x31\x31\x98\xa2\xe0\x37\x07\x34",
    )
  }
  {
    let cipher = AESCipher::new_aes128(
      b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f"[:],
    ).unwrap()
    let (encrypted, decrypted) = crypto_test_aes_block(
      cipher, b"\x00\x11\x22\x33\x44\x55\x66\x77\x88\x99\xaa\xbb\xcc\xdd\xee\xff",
    )
    assert_eq(crypto_test_hex(encrypted), "69c4e0d86a7b0430d8cdb78070b4c55a")
    assert_eq(
      decrypted, b"\x00\x11\x22\x33\x44\x55\x66\x77\x88\x99\xaa\xbb\xcc\xdd\xee\xff",
    )
  }
  {
    let cipher = AESCipher::new_aes128(
      b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"[:],
    ).unwrap()
    let (encrypted, decrypted) = crypto_test_aes_block(
      cipher, b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    )
    assert_eq(crypto_test_hex(encrypted), "a1f6258c877d5fcd8964484538bfc92c")
    assert_eq(
      decrypted, b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    )
  }
  let cipher = AESCipher::new_aes128(
    b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"[:],
  ).unwrap()
  let (encrypted, decrypted) = crypto_test_aes_block(
    cipher, b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff",
  )
  assert_eq(crypto_test_hex(encrypted), "3f5b8cc9ea855a0afa7347d23e8d664e")
  assert_eq(
    decrypted, b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff",
  )
}

///|
test "crypto aes256 block operations" {
  {
    let cipher = AESCipher::new_aes256(
      b"\x60\x3d\xeb\x10\x15\xca\x71\xbe\x2b\x73\xae\xf0\x85\x7d\x77\x81\x1f\x35\x2c\x07\x3b\x61\x08\xd7\x2d\x98\x10\xa3\x09\x14\xdf\xf4"[:],
    ).unwrap()
    let (encrypted, decrypted) = crypto_test_aes_block(
      cipher, b"\x6b\xc1\xbe\xe2\x2e\x40\x9f\x96\xe9\x3d\x7e\x11\x73\x93\x17\x2a",
    )
    assert_eq(crypto_test_hex(encrypted), "f3eed1bdb5d2a03c064b5a7e3db181f8")
    assert_eq(
      decrypted, b"\x6b\xc1\xbe\xe2\x2e\x40\x9f\x96\xe9\x3d\x7e\x11\x73\x93\x17\x2a",
    )
  }
  {
    let cipher = AESCipher::new_aes256(
      b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f"[:],
    ).unwrap()
    let (encrypted, decrypted) = crypto_test_aes_block(
      cipher, b"\x00\x11\x22\x33\x44\x55\x66\x77\x88\x99\xaa\xbb\xcc\xdd\xee\xff",
    )
    assert_eq(crypto_test_hex(encrypted), "8ea2b7ca516745bfeafc49904b496089")
    assert_eq(
      decrypted, b"\x00\x11\x22\x33\x44\x55\x66\x77\x88\x99\xaa\xbb\xcc\xdd\xee\xff",
    )
  }
  {
    let cipher = AESCipher::new_aes256(
      b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"[:],
    ).unwrap()
    let (encrypted, decrypted) = crypto_test_aes_block(
      cipher, b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    )
    assert_eq(crypto_test_hex(encrypted), "4bf85f1b5d54adbc307b0a048389adcb")
    assert_eq(
      decrypted, b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    )
  }
  let cipher = AESCipher::new_aes256(
    b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"[:],
  ).unwrap()
  let (encrypted, decrypted) = crypto_test_aes_block(
    cipher, b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff",
  )
  assert_eq(crypto_test_hex(encrypted), "acdace8078a32b1a182bfa4987ca1347")
  assert_eq(
    decrypted, b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff",
  )
}

///|
fn crypto_test_aes_cbc(
  cipher : AESCipher,
  iv : Bytes,
  plaintext : Bytes,
  expected : String,
) -> Unit raise {
  let ciphertext = cipher.encrypt_cbc(plaintext[:], iv[:])
  assert_eq(crypto_test_hex(ciphertext), expected)
  assert_eq(cipher.decrypt_cbc(ciphertext[:], iv[:], true), plaintext)
}

///|
test "crypto aes128 cbc encryption decryption" {
  crypto_test_aes_cbc(
    AESCipher::new_aes128(
      b"\x2b\x7e\x15\x16\x28\xae\xd2\xa6\xab\xf7\x15\x88\x09\xcf\x4f\x3c"[:],
    ).unwrap(),
    b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f",
    b"\x48\x65\x6c\x6c\x6f\x2c\x20\x57\x6f\x72\x6c\x64\x21",
    "73591223788e116d0593254421262658",
