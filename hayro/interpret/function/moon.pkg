import {
  "moonbitlang/typst/hayro/syntax" @hayro_syntax,
  "moonbitlang/core/math",
  "moonbitlang/core/cmp",
}

import {
  "moonbitlang/x/fs",
  "moonbitlang/core/float",
  "moonbitlang/core/string",
} for "wbtest"

// Outside the tests, `core/math` is only used by `libm_nonnative.mbt` (the
// non-native targets; native calls the C library), and moon.pkg has no
// per-target imports.

warnings = "-unused_package"

options(
  targets: {
    "libm_native.mbt": [ "native" ],
    "libm_nonnative.mbt": [ "not", "native" ],
  },
)
