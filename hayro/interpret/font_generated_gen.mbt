///|
fn glyph_names_get_reverse(unicode : Char) -> String? {
  let table = reverse_glyph_names_table
  match table.binary_search_by(e => e.0.compare(unicode)) {
    Ok(i) => Some(table[i].1)
    Err(_) => None
  }
}

