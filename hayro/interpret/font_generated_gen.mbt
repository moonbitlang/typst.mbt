  ("guilsinglleft", 220),
  ("quotedblright", 211),
  ("guillemotright", 200),
  ("guilsinglright", 221),
  ("periodcentered", 225),
  ("quotesinglbase", 226),
]

///|
fn mac_roman_get_inverse(name : String) -> Byte? {
  sorted_table_get(mac_roman_inverse_table, name).map(v => v.to_byte())
}

///|
/// The Mac OS Roman additions to MacRoman. (`""` = no entry)
let mac_os_roman_table : ReadOnlyArray[String] = [
  "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
  "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
  "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
  "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
  "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
  "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
  "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
  "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
  "", "", "", "", "", "", "", "", "", "", "", "", "", "notequal", "", "", "infinity",
  "", "lessequal", "greaterequal", "", "", "partialdiff", "summation", "product",
  "pi", "integral", "", "", "Omega", "", "", "", "", "", "radical", "", "approxequal",
  "Delta", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "lozenge",
  "", "", "", "Euro", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
  "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
  "",
]

///|
fn mac_os_roman_get(code : Byte) -> String? {
  let name = mac_os_roman_table[code.to_int()]
  if name == "" {
    None
  } else {
    Some(name)
  }
}

///|
/// Inverse of the mac_os_roman table.
/// Sorted by key in MoonBit `String` order (for binary search).
let mac_os_roman_inverse_table : ReadOnlyArray[(String, Int)] = [
  ("pi", 0),
  ("Euro", 0),
  ("Delta", 0),
  ("Omega", 0),
  ("apple", 0),
  ("lozenge", 0),
  ("product", 0),
  ("radical", 0),
  ("infinity", 0),
  ("integral", 0),
  ("notequal", 0),
  ("lessequal", 0),
  ("summation", 0),
  ("approxequal", 0),
  ("partialdiff", 0),
  ("greaterequal", 0),
]

///|
fn mac_os_roman_get_inverse(name : String) -> Byte? {
  sorted_table_get(mac_os_roman_inverse_table, name).map(v => v.to_byte())
}

