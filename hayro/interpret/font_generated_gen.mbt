///|
/// Looks up `key` in a table sorted by key in `String` order (upstream's
/// `phf` maps: a sorted table is static data, a `Map` would be built at
/// startup).
fn[V] sorted_table_get(table : ReadOnlyArray[(String, V)], key : String) -> V? {
  match table.binary_search_by(e => e.0.compare(key)) {
    Ok(i) => Some(table[i].1)
    Err(_) => None
  }
}
