// Port of `hayro-jbig2/src/huffman_table.rs`: Huffman table decoding,
// described in Annex B.
//
// (The standard tables of `huffman_tables_generated.rs` are in
// `huffman_tables_gen.mbt`, generated by
// `scripts/gen_jbig2_huffman_tables.py`.)

// (`INLINE_TABLE_SIZE`, the maximum number of nodes in an inline Huffman
// table, is 43; the generator checks it.)

///|
/// A queryable Huffman table.
///
/// (Upstream's `Rc<InnerHuffmanTable>` with an inline array for the standard
/// tables and a `Vec` for custom ones; both are a node array here.)
priv struct HuffmanTable {
  nodes : FixedArray[HuffmanNode]
}

///|
/// Create a new inline Huffman table from a fixed-size node array.
fn HuffmanTable::from_inline(nodes : FixedArray[HuffmanNode]) -> HuffmanTable {
  { nodes, }
}

///|
/// Create a new dynamic Huffman table from a vector of nodes.
fn HuffmanTable::from_dynamic(nodes : Array[HuffmanNode]) -> HuffmanTable {
  { nodes: FixedArray::from_array(nodes), }
}

///|
/// Decode a value from the bit reader using this Huffman table
/// (B.4 "Using a Huffman table").
///
/// Returns `None` for out-of-band (OOB) values, `Some(value)` for decoded values.
fn HuffmanTable::decode(
  self : HuffmanTable,
  reader : Reader,
) -> Int? raise DecodeError {
  HuffmanNode::decode_from(self.nodes, 0, reader)
}

///|
/// Decode a value using the huffman table, erroring out in case an OOB
/// was encountered.
fn HuffmanTable::decode_no_oob(
  self : HuffmanTable,
  reader : Reader,
) -> Int raise DecodeError {
  ok_or(self.decode(reader), Huffman(UnexpectedOob))
}

///|
/// Build a Huffman table from table line definitions (B.3 "Assigning
/// the prefix codes").
fn HuffmanTable::build(
  lines : Array[TableLine],
) -> HuffmanTable raise DecodeError {
  // `NTEMP` - Number of table lines.
  let line_count = lines.length()

  // Step 1: "Build a histogram in the array LENCOUNT counting the number of times
  // each prefix length value occurs in PREFLEN: LENCOUNT[I] is the number of times
  // that the value I occurs in the array PREFLEN."
  // `LENMAX` - Maximum prefix length.
  let mut max_prefix_length = 0
  for line in lines {
    if line.prefix_length > max_prefix_length {
      max_prefix_length = line.prefix_length
    }
  }
  if max_prefix_length > 32 {
    raise Huffman(PrefixLengthTooLarge)
  }

  // `LENCOUNT` - Histogram of prefix lengths.
  let length_counts = FixedArray::make(max_prefix_length + 1, 0U)
  for line in lines {
    length_counts[line.prefix_length] += 1
  }

  // Step 2: "Let LENMAX be the largest value for which LENCOUNT[LENMAX] > 0. Set:
  // CURLEN = 1, FIRSTCODE[0] = 0, LENCOUNT[0] = 0"
  // `FIRSTCODE` - First code value for each length.
  let first_code_per_length = FixedArray::make(max_prefix_length + 1, 0U)
  // `CODES` - Assigned prefix codes for each line.
  let assigned_codes = FixedArray::make(line_count, 0U)
  length_counts[0] = 0

  // Step 3: "While CURLEN ≤ LENMAX, perform the following operations:"
  // `CURLEN` - Current length being processed.
  for current_length in 1..<=max_prefix_length {
    // a) "Set: FIRSTCODE[CURLEN] = (FIRSTCODE[CURLEN − 1] + LENCOUNT[CURLEN − 1]) × 2
    //         CURCODE = FIRSTCODE[CURLEN]
    //         CURTEMP = 0"
    let sum = first_code_per_length[current_length - 1] +
      length_counts[current_length - 1]
    // (`checked_mul(2)`)
    if sum >= 0x80000000 {
      raise Huffman(InvalidCode)
    }
    first_code_per_length[current_length] = sum * 2
    // `CURCODE` - Current code value being assigned.
    let mut current_code = first_code_per_length[current_length]

    // b) "While CURTEMP < NTEMP, perform the following operations:"
    // `CURTEMP` - Current line index.
    for line_index in 0..<line_count {
      // i) "If PREFLEN[CURTEMP] = CURLEN, then set:
      //        CODES[CURTEMP] = CURCODE
      //        CURCODE = CURCODE + 1"
      if lines[line_index].prefix_length == current_length {
        assigned_codes[line_index] = current_code
        // (`checked_add(1)`)
        if current_code == 0xFFFFFFFF {
          raise Huffman(InvalidCode)
        }
        current_code = current_code + 1
      }
      // ii) "Set CURTEMP = CURTEMP + 1" (implicit in for loop)
    }
    // c) "Set CURLEN = CURLEN + 1" (implicit in for loop)
  }

  // Build tree from assigned codes.
  let nodes = [HuffmanNode::new_intermediate()]
  for i, line in lines {
    // "Note that the PREFLEN value 0 indicates that the table line is never used."
    if line.prefix_length == 0 {
      continue
    }
    HuffmanTable::insert_code(
      nodes,
      0, // root index
      assigned_codes[i],
      line.prefix_length,
      line.range_low,
      line.range_length,
      line.is_lower,
      line.is_out_of_band,
    )
  }
  HuffmanTable::from_dynamic(nodes)
}

///|
/// Build a uniform Huffman table where all symbols have the same code length.
///
/// This is used for symbol ID encoding (6.5.8.2.3): "For each value of i from
/// 0 to SDNUMINSYMS + NSYMSDECODED – 1, set SBSYMCODES[i] to the binary
/// representation of i using a SBSYMCODELEN-bit string."
fn HuffmanTable::build_uniform(
  num_symbols : UInt,
  code_length : UInt,
) -> HuffmanTable raise DecodeError {
  let lines = []
  for i in 0U..<num_symbols {
    lines.push(
      TableLine::new(
        i.reinterpret_as_int(),
        code_length.reinterpret_as_int() & 0xFF,
        0,
      ),
    )
  }
  HuffmanTable::build(lines)
}

///|
/// Insert a code into the Huffman tree.
fn HuffmanTable::insert_code(
  nodes : Array[HuffmanNode],
  node_index : Int,
  code : UInt,
  prefix_length : Int,
  range_low : Int,
  range_length : Int,
  is_lower : Bool,
  is_out_of_band : Bool,
) -> Unit raise DecodeError {
  let mut node_index = node_index
  let mut code = code
  let mut prefix_length = prefix_length
  // (Upstream recurses; this is the same walk as a loop.)
  while prefix_length != 0 {
    // Get the next bit (MSB first).
    let bit = (code >> (prefix_length - 1)) & 1
    let remaining_code = code & ((1U << (prefix_length - 1)) - 1)
    let child_index = match nodes[node_index].get_child(bit == 0) {
      Some(idx) => idx
      None => {
        let new_idx = nodes.length()
        nodes.push(HuffmanNode::new_intermediate())
        nodes[node_index] = nodes[node_index].set_child(bit == 0, new_idx)
        new_idx
      }
    }
    node_index = child_index
    code = remaining_code
    prefix_length = prefix_length - 1
  }
  // We've consumed all bits, this should be a leaf.
  nodes[node_index] = HuffmanNode::new_leaf(
    range_low, range_length, is_lower, is_out_of_band,
  )
}

///|
/// Read a custom Huffman table from the bitstream (B.2 "Decoding a code table").
fn HuffmanTable::read_custom(reader : Reader) -> HuffmanTable raise DecodeError {
  // 1) "Decode the code table flags field as described in B.2.1. This sets the values
  //    HTOOB, HTPS and HTRS."
  let flags = ok_or(reader.read_byte(), eof).to_int()

  // `HTOOB`
  let has_out_of_band = (flags & 1) != 0
  // `HTPS`
  let prefix_length_bits = ((flags >> 1) & 7) + 1
  // `HTRS`
  let range_length_bits = ((flags >> 4) & 7) + 1

  // 2) "Decode the code table lowest value field as described in B.2.2. Let HTLOW be
  //    the value decoded."
  // `HTLOW`
  let minimum_value = ok_or(reader.read_i32(), eof)

  // 3) "Decode the code table highest value field as described in B.2.3. Let HTHIGH be
  //    the value decoded."
  // `HTHIGH`
  let maximum_value = ok_or(reader.read_i32(), eof)

  // 4) "Set: CURRANGELOW = HTLOW, NTEMP = 0"
  let lines = []
  // `CURRANGELOW`
  let mut current_range_low = minimum_value

  // 5) "Decode each table line as follows:"
  //    d) "If CURRANGELOW ≥ HTHIGH then proceed to step 6."
  while current_range_low < maximum_value {
    // a) "Read HTPS bits. Set PREFLEN[NTEMP] to the value decoded."
    let prefix_length = ok_or(
        reader.read_bits(prefix_length_bits),
        Huffman(InvalidCode),
      ).reinterpret_as_int() &
      0xFF
    // b) "Read HTRS bits. Let RANGELEN[NTEMP] be the value decoded."
    let range_length = ok_or(
        reader.read_bits(range_length_bits),
        Huffman(InvalidCode),
      ).reinterpret_as_int() &
      0xFF

    // c) "Set: RANGELOW[NTEMP] = CURRANGELOW
    //         CURRANGELOW = CURRANGELOW + 2^RANGELEN[NTEMP]
    //         NTEMP = NTEMP + 1"
    lines.push(TableLine::new(current_range_low, prefix_length, range_length))

    // (`1_i64.checked_shl(range_length)` fails only for shifts >= 64.)
    if range_length >= 64 {
      raise Huffman(InvalidCode)
    }
    let range_size = 1L << range_length
    let next_range_low = current_range_low.to_int64() + range_size
    // (`range_size` is at most `1 << 63`, which is `i64::MIN`: the
    // `checked_add` can't overflow, but the sum may be negative.)
    if next_range_low < -0x80000000L || next_range_low > 0x7FFFFFFFL {
      raise Huffman(InvalidCode)
    }
    current_range_low = next_range_low.to_int()
  }

  // 6) "Read HTPS bits. Let LOWPREFLEN be the value read."
  // 7) "Set: PREFLEN[NTEMP] = LOWPREFLEN, RANGELEN[NTEMP] = 32,
  //         RANGELOW[NTEMP] = HTLOW − 1, NTEMP = NTEMP + 1
  //    This is the lower range table line for this table."
  if minimum_value == -0x80000000 {
    raise Huffman(InvalidCode)
  }
  let low_range = minimum_value - 1
  lines.push(
    TableLine::lower(
      low_range,
      ok_or(reader.read_bits(prefix_length_bits), Huffman(InvalidCode)).reinterpret_as_int() &
      0xFF,
      32,
    ),
  )

  // 8) "Read HTPS bits. Let HIGHPREFLEN be the value read."
  // 9) "Set: PREFLEN[NTEMP] = HIGHPREFLEN, RANGELEN[NTEMP] = 32,
  //         RANGELOW[NTEMP] = HTHIGH, NTEMP = NTEMP + 1
  //    This is the upper range table line for this table."
  lines.push(
    TableLine::upper(
      current_range_low,
      ok_or(reader.read_bits(prefix_length_bits), Huffman(InvalidCode)).reinterpret_as_int() &
      0xFF,
      32,
    ),
  )

  // 10) "If HTOOB is 1, then:
  //     a) Read HTPS bits. Let OOBPREFLEN be the value read.
  //     b) Set: PREFLEN[NTEMP] = OOBPREFLEN, NTEMP = NTEMP + 1
  //     This is the out-of-band table line for this table."
  if has_out_of_band {
    lines.push(
      TableLine::oob(
        ok_or(reader.read_bits(prefix_length_bits), Huffman(InvalidCode)).reinterpret_as_int() &
        0xFF,
      ),
    )
  }

  // 11) "Create the prefix codes using the algorithm described in B.3."
  HuffmanTable::build(lines)
}

///|
/// A table line definition used to build the Huffman tree.
priv struct TableLine {
  /// `RANGELOW` - The base value for computing the decoded value.
  /// For normal/upper lines: value = `range_low` + offset
  /// For lower lines: value = `range_low` - offset
  range_low : Int
  /// `PREFLEN` - Prefix code length.
  prefix_length : Int
  /// `RANGELEN` - Number of additional bits.
  range_length : Int
  /// True if this is a lower range line (uses subtraction).
  is_lower : Bool
  /// `OOB` - True if this is the out-of-band marker.
  is_out_of_band : Bool
}

///|
/// Create a normal table line.
fn TableLine::new(
  range_low : Int,
  prefix_length : Int,
  range_length : Int,
) -> TableLine {
  {
    range_low,
    prefix_length,
    range_length,
    is_lower: false,
    is_out_of_band: false,
  }
}

///|
/// Create a lower range line (-∞...`range_high`).
fn TableLine::lower(
  range_high : Int,
  prefix_length : Int,
  range_length : Int,
) -> TableLine {
  {
    range_low: range_high,
    prefix_length,
    range_length,
    is_lower: true,
    is_out_of_band: false,
  }
}

///|
/// Create an upper range line (`range_low`...+∞).
fn TableLine::upper(
  range_low : Int,
  prefix_length : Int,
  range_length : Int,
) -> TableLine {
  {
    range_low,
    prefix_length,
    range_length,
    is_lower: false,
    is_out_of_band: false,
  }
}

///|
/// Create an out-of-band marker line.
fn TableLine::oob(prefix_length : Int) -> TableLine {
  {
    range_low: 0,
    prefix_length,
    range_length: 0,
    is_lower: false,
    is_out_of_band: true,
  }
}

///|
/// A node in the Huffman tree.
///
/// (Child indices are upstream's `Option<NonZeroU32>`; `0` is `None`.)
priv enum HuffmanNode {
  /// Intermediate node.
  Intermediate(zero~ : Int, one~ : Int)
  /// Leaf node.
  Leaf(LeafData)
  /// Empty node (padding to fill fixed-size arrays in inline tables).
  Empty
}

///|
fn HuffmanNode::new_intermediate() -> HuffmanNode {
  Intermediate(zero=0, one=0)
}

///|
fn HuffmanNode::new_leaf(
  range_low : Int,
  range_length : Int,
  is_lower : Bool,
  is_out_of_band : Bool,
) -> HuffmanNode {
  Leaf({ range_low, range_length, is_lower, is_out_of_band, })
}

///|
/// Get the child index for a given bit (0 or 1).
fn HuffmanNode::get_child(self : HuffmanNode, child_zero : Bool) -> Int? {
  match self {
    Intermediate(zero~, one~) => {
      let idx = if child_zero { zero } else { one }
      if idx == 0 {
        None
      } else {
        Some(idx)
      }
    }
    _ => None
  }
}

///|
/// Set the child index for a given bit (0 or 1).
///
/// (Returns the updated node; upstream mutates it in place.)
fn HuffmanNode::set_child(
  self : HuffmanNode,
  child_zero : Bool,
  index : Int,
) -> HuffmanNode raise DecodeError {
  match self {
    Intermediate(zero~, one~) =>
      if child_zero {
        Intermediate(zero=index, one~)
      } else {
        Intermediate(zero~, one=index)
      }
    _ => raise Huffman(ConflictingCodes)
  }
}

///|
/// Implements B.4 "Using a Huffman table".
fn HuffmanNode::decode_from(
  nodes : FixedArray[HuffmanNode],
  node_index : Int,
  reader : Reader,
) -> Int? raise DecodeError {
  let mut node_index = node_index
  // 1) "Read one bit at a time until the bit string read matches the code assigned to
  //    one of the table lines."
  while true {
    match nodes[node_index] {
      Intermediate(zero~, one~) => {
        let bit = ok_or(reader.read_bit(), eof)
        let child_index = if bit == 0 { zero } else { one }
        if child_index == 0 {
          raise Huffman(InvalidCode)
        }
        node_index = child_index
      }
      Leaf(leaf) => {
        // 3) "If HTOOB is 1 for this table, and table line I is the out-of-band
        //    table line for this table, then set: HTVAL = OOB"
        if leaf.is_out_of_band {
          return None
        }

        // 2) "Read RANGELEN[I] bits. Let HTOFFSET be the value read."
        // `HTOFFSET`
        let range_offset = ok_or(
          reader.read_bits(leaf.range_length),
          Huffman(InvalidCode),
        ).reinterpret_as_int()

        // 4) "Otherwise, if table line I is the lower range table line for this
        //    table, then set: HTVAL = RANGELOW[I] − HTOFFSET"
        // 5) "Otherwise, set: HTVAL = RANGELOW[I] + HTOFFSET"
        // `HTVAL`
        let value = if leaf.is_lower {
          leaf.range_low - range_offset
        } else {
          leaf.range_low + range_offset
        }
        return Some(value)
      }
      Empty => raise Huffman(InvalidCode)
    }
  }
  None
}

///|
/// Information stored at a leaf node of the Huffman tree.
priv struct LeafData {
  /// `RANGELOW` - The base value for computing the decoded value.
  range_low : Int
  /// `RANGELEN` - Number of additional bits to read.
  range_length : Int
  /// True if this is a lower range line (uses subtraction).
  is_lower : Bool
  /// `OOB` - True if this is the out-of-band marker.
  is_out_of_band : Bool
}

///|
/// Standard Huffman tables (`TABLE_A` through `TABLE_O`).
///
/// (Each table is built lazily, as upstream's `Lazy<HuffmanTable>`.)
priv struct StandardHuffmanTables {
  tables : FixedArray[HuffmanTable?]
}

///|
/// Create a new instance.
fn StandardHuffmanTables::new() -> StandardHuffmanTables {
  { tables: FixedArray::make(15, None), }
}

///|
fn StandardHuffmanTables::get(
  self : StandardHuffmanTables,
  idx : Int,
  nodes : FixedArray[HuffmanNode],
) -> HuffmanTable {
  match self.tables[idx] {
    Some(t) => t
    None => {
      let t = HuffmanTable::from_inline(nodes)
      self.tables[idx] = Some(t)
      t
    }
  }
}

///|
/// Get Table B.1 (`TABLE_A`).
fn StandardHuffmanTables::table_a(self : StandardHuffmanTables) -> HuffmanTable {
  self.get(0, table_a_nodes)
}

///|
/// Get Table B.2 (`TABLE_B`).
fn StandardHuffmanTables::table_b(self : StandardHuffmanTables) -> HuffmanTable {
  self.get(1, table_b_nodes)
}

///|
/// Get Table B.3 (`TABLE_C`).
fn StandardHuffmanTables::table_c(self : StandardHuffmanTables) -> HuffmanTable {
  self.get(2, table_c_nodes)
}

///|
/// Get Table B.4 (`TABLE_D`).
fn StandardHuffmanTables::table_d(self : StandardHuffmanTables) -> HuffmanTable {
  self.get(3, table_d_nodes)
}

///|
/// Get Table B.5 (`TABLE_E`).
fn StandardHuffmanTables::table_e(self : StandardHuffmanTables) -> HuffmanTable {
  self.get(4, table_e_nodes)
}

///|
/// Get Table B.6 (`TABLE_F`).
fn StandardHuffmanTables::table_f(self : StandardHuffmanTables) -> HuffmanTable {
  self.get(5, table_f_nodes)
}

///|
/// Get Table B.7 (`TABLE_G`).
fn StandardHuffmanTables::table_g(self : StandardHuffmanTables) -> HuffmanTable {
  self.get(6, table_g_nodes)
}

///|
/// Get Table B.8 (`TABLE_H`).
fn StandardHuffmanTables::table_h(self : StandardHuffmanTables) -> HuffmanTable {
  self.get(7, table_h_nodes)
}

///|
/// Get Table B.9 (`TABLE_I`).
fn StandardHuffmanTables::table_i(self : StandardHuffmanTables) -> HuffmanTable {
  self.get(8, table_i_nodes)
}

///|
/// Get Table B.10 (`TABLE_J`).
fn StandardHuffmanTables::table_j(self : StandardHuffmanTables) -> HuffmanTable {
  self.get(9, table_j_nodes)
}

///|
/// Get Table B.11 (`TABLE_K`).
fn StandardHuffmanTables::table_k(self : StandardHuffmanTables) -> HuffmanTable {
  self.get(10, table_k_nodes)
