    "(\n  (left: 0% + 1pt, right: 0% + 1pt),\n  (top: 0% + 1pt, bottom: 0% + 1pt),\n)",
    "(\n  (left: 0% + 1pt, right: 0% + 1pt),\n  (top: 0% + 1pt, bottom: 0% + 1pt),\n)",
