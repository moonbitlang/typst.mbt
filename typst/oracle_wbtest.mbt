    #|#metadata(repr((it.fields(),)))
    #|]
    #|#metadata("== element: the value of metadata")
    #|#[
    #|#let m = metadata(((1, 2), (k: (3,))))
    #|#{
    #|  let _ = (array.pop)(m.value)
    #|  let _ = (array.push)(m.value, 0)
