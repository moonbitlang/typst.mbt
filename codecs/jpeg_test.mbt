// Decoding tests of small JPEGs; the expected values (color type,
// dimensions and an FNV-1a hash of the pixels, or the error message) were
// obtained with the `image` crate (v0.25.10, zune-jpeg 0.5.15) on aarch64.

///|
fn fnv1a(data : Bytes) -> UInt64 {
  let mut h = 0xcbf29ce484222325UL
  for b in data {
    h = h ^ b.to_uint64()
    h = h * 0x100000001b3UL
  }
  h
}

///|
fn jpeg_summary(data : Bytes) -> String {
  let (info, pixels) = @codecs.decode_jpeg(data[:]) catch {
    ImageError(msg) => return "ERR \{msg}"
  }
  let color = match info.color {
    L8 => "L8"
    Rgb8 => "Rgb8"
    _ => "?"
  }
  "OK \{color} \{info.width} \{info.height} \{fnv1a(pixels).to_string(radix=16)}"
}

