import {
  "moonbit-community/flate",
  "moonbit-community/flate/zlib",
  "moonbit-community/flate/gzip",
  "moonbitlang/core/cmp",
  "moonbitlang/core/math",
  "moonbitlang/core/v128",
}

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/codec/base64",
  "moonbitlang/typst/codecs",
} for "test"

import {
  "moonbitlang/core/bench",
} for "wbtest"

// `@v128` is experimental, and unused on wasm-gc/js, which select the
// `*_scalar.mbt` files (see AGENTS.md: v128 kernels).

warnings = "-alert_experimental-unused_package"

options(
  targets: {
    "imageops_libm_native.mbt": [ "native" ],
    "imageops_libm_other.mbt": [ "not", "native" ],
    "zlib_v128.mbt": [ "native", "wasm" ],
    "zlib_scalar.mbt": [ "wasm-gc", "js" ],
    "png_filter_v128.mbt": [ "native", "wasm" ],
    "png_filter_scalar.mbt": [ "wasm-gc", "js" ],
    "jpeg_v128.mbt": [ "native", "wasm" ],
    "jpeg_scalar.mbt": [ "wasm-gc", "js" ],
    "imageops_v128.mbt": [ "native", "wasm" ],
    "imageops_scalar.mbt": [ "wasm-gc", "js" ],
  },
)
