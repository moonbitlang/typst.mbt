///|
test "image/webp/icc-lossless" {
  assert_eq(
    image_case(
      "webp", "UklGRkYAAABXRUJQVlA4WAoAAAAwAAAAAQAAAQAASUNDUBEAAABpY2MtcHJvZmlsZS1ieXRlcwBWUDhMDQAAAC8BQAAQBxAREYiI/gcA",
    ),
    "2x2 Rgba8 88201fb960ff6465 icc=17",
  )
}

///|
test "image/webp/icc-lossy" {
  assert_eq(
    image_case(
      "webp", "",
    ),
    "37x23 Rgb8 1754ae2d73e322e8 icc=17",
  )
}

///|
test "image/webp/icc-empty" {
  assert_eq(
    image_case(
      "webp", "",
    ),
    "37x23 Rgb8 1754ae2d73e322e8 icc=none",
  )
}

///|
test "image/webp/icc-unflagged" {
  assert_eq(
    image_case(
      "webp", "",
    ),
    "37x23 Rgb8 1754ae2d73e322e8 icc=17",
  )
}

///|
test "image/webp/riff-only" {
  assert_eq(
    image_case("webp", "UklGRg=="),
    "error: failed to fill whole buffer",
  )
}

///|
test "image/webp/bad-signature" {
  assert_eq(
    image_case("webp", "UklGRgQAAABXRUJR"),
    "error: Format error decoding WebP: Invalid WebP signature: [57, 45, 42, 51]",
  )
}

///|
test "image/webp/no-chunk" {
  assert_eq(
    image_case("webp", "UklGRgQAAABXRUJQ"),
    "error: failed to fill whole buffer",
  )
}

///|
test "image/webp/bad-chunk" {
  assert_eq(
    image_case("webp", "UklGRg4AAABXRUJQQUJDRAIAAAB4eA=="),
    "error: Format error decoding WebP: Invalid Chunk header: [41, 42, 43, 44]",
  )
}

///|
test "image/webp/truncated-lossy" {
  assert_eq(
    image_case(
      "webp", "UklGRtACAABXRUJQVlA4IMQCAACwDwCdASolABcAPpE6l0iloyIhKqwAsBIJbACdMoRwN7d5glOfn33e",
    ),
    "error: failed to fill whole buffer",
  )
}

