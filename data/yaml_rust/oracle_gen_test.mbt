///|
test "yaml_rust/sublime/5" {
  assert_eq(
    load_dump(
      "%YAML 1.2\n---\nname: With Prototype\nscope: source.wp\ncontexts:\n  main:\n    - match: (?=<script)\n      push: [script-close, script-open]\n      with_prototype:\n        - match: (?=</script)\n          pop: true\n    - match: \"\\\"(?:[^\\\"\\\\\\\\]|\\\\\\\\.)*\\\"\"\n      scope: string.quoted.double.wp\n    - match: '\\b(if|else|for|while)\\b'\n      scope: keyword.control.wp\n    - match: '#.*$'\n      scope: comment.line.number-sign.wp\n    - match: (\\$)([a-zA-Z_]\\w*)\n      captures:\n        1: punctuation.definition.variable.wp\n        2: variable.other.wp\n    - match: '\\{\\{'\n      push:\n        - clear_scopes: 1\n        - meta_content_scope: meta.interpolation.wp\n        - match: '\\}\\}'\n          pop: true\n  script-open:\n    - match: <script\n      set: [ script-body ]\n  script-close:\n    - match: </script>\n      pop: true\n  script-body:\n    - match: '>'\n      embed: scope:source.js\n      escape: (?i)(?=</script)\n",
    ),
    "Ok([Hash({String(\"name\"): String(\"With Prototype\"), String(\"scope\"): String(\"source.wp\"), String(\"contexts\"): Hash({String(\"main\"): Array([Hash({String(\"match\"): String(\"(?=<script)\"), String(\"push\"): Array([String(\"script-close\"), String(\"script-open\")]), String(\"with_prototype\"): Array([Hash({String(\"match\"): String(\"(?=</script)\"), String(\"pop\"): Boolean(true)})])}), Hash({String(\"match\"): String(\"\\\"(?:[^\\\"\\\\\\\\]|\\\\\\\\.)*\\\"\"), String(\"scope\"): String(\"string.quoted.double.wp\")}), Hash({String(\"match\"): String(\"\\\\b(if|else|for|while)\\\\b\"), String(\"scope\"): String(\"keyword.control.wp\")}), Hash({String(\"match\"): String(\"#.*$\"), String(\"scope\"): String(\"comment.line.number-sign.wp\")}), Hash({String(\"match\"): String(\"(\\\\$)([a-zA-Z_]\\\\w*)\"), String(\"captures\"): Hash({Integer(1): String(\"punctuation.definition.variable.wp\"), Integer(2): String(\"variable.other.wp\")})}), Hash({String(\"match\"): String(\"\\\\{\\\\{\"), String(\"push\"): Array([Hash({String(\"clear_scopes\"): Integer(1)}), Hash({String(\"meta_content_scope\"): String(\"meta.interpolation.wp\")}), Hash({String(\"match\"): String(\"\\\\}\\\\}\"), String(\"pop\"): Boolean(true)})])})]), String(\"script-open\"): Array([Hash({String(\"match\"): String(\"<script\"), String(\"set\"): Array([String(\"script-body\")])})]), String(\"script-close\"): Array([Hash({String(\"match\"): String(\"</script>\"), String(\"pop\"): Boolean(true)})]), String(\"script-body\"): Array([Hash({String(\"match\"): String(\">\"), String(\"embed\"): String(\"scope:source.js\"), String(\"escape\"): String(\"(?i)(?=</script)\")})])})})])",
  )
}

///|
test "yaml_rust/sublime/6" {
  assert_eq(
    load_dump(
      "name: x\nscope: source.x\ncontexts:\n  main:\n    - match: 'unterminated\n      scope: a\n",
    ),
    "Err(while scanning a quoted scalar, found unexpected end of stream at line 5 column 14 @ 55:5:13)",
  )
}

