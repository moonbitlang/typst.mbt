    load_dump("literal: |2\n  value\nfolded:\n   !foo\n  >1\n value\n"),
    "Ok([Hash({String(\"literal\"): String(\"value\\n\"), String(\"folded\"): String(\"value\\n\")})])",
  )
}

///|
test "yaml_rust/spec/ex8_22" {
  assert_eq(
    load_dump(
      "sequence: !!seq\n- entry\n- !!seq\n - nested\nmapping: !!map\n foo: bar\n",
    ),
    "Ok([Hash({String(\"sequence\"): Array([String(\"entry\"), Array([String(\"nested\")])]), String(\"mapping\"): Hash({String(\"foo\"): String(\"bar\")})})])",
