  assert_eq(
    load_dump("- sun: yellow\n- ? #earth: blue\n  : moon: white\n"),
    "Ok([Array([Hash({String(\"sun\"): String(\"yellow\")}), Hash({Null: Hash({String(\"moon\"): String(\"white\")})})])])",
  )
}

///|
test "yaml_rust/mutations/596" {
  assert_eq(
    load_dump("- sun: yellow\n- ? earth: blue\n "),
    "Ok([Array([Hash({String(\"sun\"): String(\"yellow\")}), Hash({Hash({String(\"earth\"): String(\"blue\")}): Null})])])",
  )
}

///|
test "yaml_rust/mutations/597" {
  assert_eq(
    load_dump("- sun: yellow\n ? earth: blue\n  : moon: white\n"),
    "Err(while parsing a block collection, did not find expected '-' indicator at line 2 column 2 @ 15:2:1)",
  )
}

///|
test "yaml_rust/mutations/598" {
  assert_eq(
    load_dump("sequence: !!seq\n- entr"),
    "Ok([Hash({String(\"sequence\"): Array([String(\"entr\")])})])",
  )
}

///|
test "yaml_rust/mutations/599" {
  assert_eq(
    load_dump("sequence: !!seq\n- entry\n- !!seq\n - nested\nmapping: !!"),
    "Err(while parsing a tag, did not find expected tag URI at line 5 column 10 @ 51:5:9)",
  )
}

///|
test "yaml_rust/mutations/600" {
  assert_eq(
    load_dump(
      "sequence: !!seq\n- entry\n- !!seq\n - nested\nmappin[g: !!map\n foo: bar\n",
    ),
    "Ok([Hash({String(\"sequence\"): Array([String(\"entry\"), Array([String(\"nested\")])]), String(\"mappin[g\"): Hash({String(\"foo\"): String(\"bar\")})})])",
  )
}

///|
test "yaml_rust/mutations/601" {
  assert_eq(
    load_dump("sequence: !!seq\n-"),
    "Ok([Hash({String(\"sequence\"): Array([Null])})])",
  )
}
