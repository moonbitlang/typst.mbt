test "yaml_rust/spec/ex6_13" {
  assert_eq(
    load_dump(
      "%FOO  bar baz # Should be ignored\n               # with a warning.\n--- \"foo\"",
    ),
    "Ok([String(\"foo\")])",
  )
}

///|
test "yaml_rust/spec/ex6_14" {
  assert_eq(
    load_dump(
      "%YAML 1.3 # Attempt parsing\n           # with a warning\n---\n\"foo\"",
    ),
    "Ok([String(\"foo\")])",
  )
}

///|
test "yaml_rust/spec/ex6_15" {
  assert_eq(
    load_dump("%YAML 1.2\n%YAML 1.1\nfoo"),
    "Err(did not find expected <document start> at line 3 column 1 @ 20:3:0)",
  )
}

///|
test "yaml_rust/spec/ex6_16" {
  assert_eq(
    load_dump("%TAG !yaml! tag:yaml.org,2002:\n---\n!yaml!str \"foo\""),
    "Ok([String(\"foo\")])",
  )
}

///|
test "yaml_rust/spec/ex6_17" {
  assert_eq(
    load_dump("%TAG ! !foo\n%TAG ! !foo\nbar"),
    "Err(did not find expected <document start> at line 3 column 1 @ 24:3:0)",
  )
}

///|
test "yaml_rust/spec/ex6_18" {
  assert_eq(
    load_dump(
      "# Private\n!foo \"bar\"\n...\n# Global\n%TAG ! tag:example.com,2000:app/\n---\n!foo \"bar\"",
    ),
    "Ok([String(\"bar\"), String(\"bar\")])",
  )
}

///|
test "yaml_rust/spec/ex6_19" {
  assert_eq(
    load_dump(
      "%TAG !! tag:example.com,2000:app/\n---\n!!int 1 - 3 # Interval, not integer",
    ),
    "Ok([BadValue])",
  )
}

///|
test "yaml_rust/spec/ex6_20" {
  assert_eq(
    load_dump("%TAG !e! tag:example.com,2000:app/\n---\n!e!foo \"bar\""),
    "Ok([String(\"bar\")])",
  )
}

///|
test "yaml_rust/spec/ex6_21" {
  assert_eq(
    load_dump(
      "%TAG !m! !my-\n--- # Bulb here\n!m!light fluorescent\n...\n%TAG !m! !my-\n--- # Color here\n!m!light green",
    ),
    "Ok([String(\"fluorescent\"), String(\"green\")])",
  )
}

///|
test "yaml_rust/spec/ex6_22" {
  assert_eq(
    load_dump("%TAG !e! tag:example.com,2000:app/\n---\n- !e!foo \"bar\""),
    "Ok([Array([String(\"bar\")])])",
  )
}

///|
test "yaml_rust/spec/ex6_23" {
  assert_eq(
    load_dump("!!str &a1 \"foo\":\n  !!str bar\n&a2 baz : *a1"),
    "Ok([Hash({String(\"foo\"): String(\"bar\"), String(\"baz\"): String(\"foo\")})])",
  )
}

///|
test "yaml_rust/spec/ex6_24" {
  assert_eq(
    load_dump("!<tag:yaml.org,2002:str> foo :\n  !<!bar> baz"),
    "Ok([Hash({String(\"foo\"): String(\"baz\")})])",
  )
}

///|
test "yaml_rust/spec/ex6_25" {
  assert_eq(
    load_dump("- !<!> foo\n- !<$:?> bar\n"),
    "Ok([Array([String(\"foo\"), String(\"bar\")])])",
  )
}

///|
test "yaml_rust/spec/ex6_26" {
  assert_eq(
    load_dump(
      "%TAG !e! tag:example.com,2000:app/\n---\n- !local foo\n- !!str bar\n- !e!tag%21 baz\n",
    ),
    "Ok([Array([String(\"foo\"), String(\"bar\"), String(\"baz\")])])",
  )
}

