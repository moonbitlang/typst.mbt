  assert_eq(
    load_dump(
      "null_key: [null, ~]\n\"string\": text\ninteger: 5\nfloat: 1.12\nmapping: { '1': \"one\", '2': \"two\"}\nseq: [1, 2, 3, 4]\nbool: false\ntrue: bool\n1: ok\n",
    ),
    "Ok([Hash({String(\"null_key\"): Array([Null, Null]), String(\"string\"): String(\"text\"), String(\"integer\"): Integer(5), String(\"float\"): Real(\"1.12\"), String(\"mapping\"): Hash({String(\"1\"): String(\"one\"), String(\"2\"): String(\"two\")}), String(\"seq\"): Array([Integer(1), Integer(2), Integer(3), Integer(4)]), String(\"bool\"): Boolean(false), Boolean(true): String(\"bool\"), Integer(1): String(\"ok\")})])",
  )
}

