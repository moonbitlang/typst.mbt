test "yaml_rust/mutations/150" {
  assert_eq(
    load_dump(
      "%YAML 1.2\n---\n# See http://www.sublimetext.com/docs/syntax.html\nname: Mini Rust\nfile_extensions:\n  - rs\n  - rlib\nfirst_line_match: ^#!\\s*/usr/bin/env\\s+run-cargo-script\nscope: source.rust\nversion: 2\n\nvariables:\n  non_raw_ident: '[[:alpha:]][_[:alnum:]]*|_[_[:alnum:]]+'\n  identifier: '(?:(?:r\\#)?{{non_raw_ident}})'\n  escaped_byte: '\\\\([nrt0\\\"''\\\\]|x\\h{2})'\n  int_suffixes: '[iu](?:8|16|32|64|128|size)'\n\ncontexts:\n  main:\n    - include: statements\n\n  prototype:\n    - include: comments\n\n  statements:\n    - match: '(''){{identifier}}(?=\\:\\s*(?:for|while|loop)\\b)'\n      scope: entity.name.label.rust\n      captures:\n        1: punctuation.definition.label.rust\n    - match: \\b(fn)\\s+({{identifier}})\n      captures:\n        1: storage.type.function.rust keyword.declaration.function.rust\n        2: entity.name.function.rust\n      push: fn-parameters\n    - match: '\"'\n      scope: punctuation.definition.string.begin.rust\n      push: string\n    - match: '\\b0x[\\h_]+{{int_suffixes}}?\\b'\n      scope: constant.numeric.integer.hexadecimal.rust\n    - match: \\b(true|false)\\b\n      scope: constant.language.boolean.rust\n\n  fn-parameters:\n    - meta_scope: meta.function.parameters.rust\n    - match: \\)\n      pop: true\n    - match: '[{};]'\n      pop: 2\n\n  string:\n    - meta_include_prototype: false\n    - meta_scope: string.quoted.double.rust\n    - match: '{{escaped_byte}}'\n      scope: constant.character.escape.rust\n    - match: '\"'\n      scope: punctuation.definition.string.end.rust\n      pop: true\n\n  comments:\n    - match: /\\*\n      scope: punctuation.definition.comment.rust\n      push:\n        - meta_scope: comment.block.rust\n        - match: \\*/\n          pop: true\n    - match: //\n      scope: punctuation.definition.comment.rust\n  ",
    ),
    "Ok([Hash({String(\"name\"): String(\"Mini Rust\"), String(\"file_extensions\"): Array([String(\"rs\"), String(\"rlib\")]), String(\"first_line_match\"): String(\"^#!\\\\s*/usr/bin/env\\\\s+run-cargo-script\"), String(\"scope\"): String(\"source.rust\"), String(\"version\"): Integer(2), String(\"variables\"): Hash({String(\"non_raw_ident\"): String(\"[[:alpha:]][_[:alnum:]]*|_[_[:alnum:]]+\"), String(\"identifier\"): String(\"(?:(?:r\\\\#)?{{non_raw_ident}})\"), String(\"escaped_byte\"): String(\"\\\\\\\\([nrt0\\\\\\\"'\\\\\\\\]|x\\\\h{2})\"), String(\"int_suffixes\"): String(\"[iu](?:8|16|32|64|128|size)\")}), String(\"contexts\"): Hash({String(\"main\"): Array([Hash({String(\"include\"): String(\"statements\")})]), String(\"prototype\"): Array([Hash({String(\"include\"): String(\"comments\")})]), String(\"statements\"): Array([Hash({String(\"match\"): String(\"('){{identifier}}(?=\\\\:\\\\s*(?:for|while|loop)\\\\b)\"), String(\"scope\"): String(\"entity.name.label.rust\"), String(\"captures\"): Hash({Integer(1): String(\"punctuation.definition.label.rust\")})}), Hash({String(\"match\"): String(\"\\\\b(fn)\\\\s+({{identifier}})\"), String(\"captures\"): Hash({Integer(1): String(\"storage.type.function.rust keyword.declaration.function.rust\"), Integer(2): String(\"entity.name.function.rust\")}), String(\"push\"): String(\"fn-parameters\")}), Hash({String(\"match\"): String(\"\\\"\"), String(\"scope\"): String(\"punctuation.definition.string.begin.rust\"), String(\"push\"): String(\"string\")}), Hash({String(\"match\"): String(\"\\\\b0x[\\\\h_]+{{int_suffixes}}?\\\\b\"), String(\"scope\"): String(\"constant.numeric.integer.hexadecimal.rust\")}), Hash({String(\"match\"): String(\"\\\\b(true|false)\\\\b\"), String(\"scope\"): String(\"constant.language.boolean.rust\")})]), String(\"fn-parameters\"): Array([Hash({String(\"meta_scope\"): String(\"meta.function.parameters.rust\")}), Hash({String(\"match\"): String(\"\\\\)\"), String(\"pop\"): Boolean(true)}), Hash({String(\"match\"): String(\"[{};]\"), String(\"pop\"): Integer(2)})]), String(\"string\"): Array([Hash({String(\"meta_include_prototype\"): Boolean(false)}), Hash({String(\"meta_scope\"): String(\"string.quoted.double.rust\")}), Hash({String(\"match\"): String(\"{{escaped_byte}}\"), String(\"scope\"): String(\"constant.character.escape.rust\")}), Hash({String(\"match\"): String(\"\\\"\"), String(\"scope\"): String(\"punctuation.definition.string.end.rust\"), String(\"pop\"): Boolean(true)})]), String(\"comments\"): Array([Hash({String(\"match\"): String(\"/\\\\*\"), String(\"scope\"): String(\"punctuation.definition.comment.rust\"), String(\"push\"): Array([Hash({String(\"meta_scope\"): String(\"comment.block.rust\")}), Hash({String(\"match\"): String(\"\\\\*/\"), String(\"pop\"): Boolean(true)})])}), Hash({String(\"match\"): String(\"//\"), String(\"scope\"): String(\"punctuation.definition.comment.rust\")})])})})])",
