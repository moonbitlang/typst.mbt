  )
}

///|
test "yaml_rust/syntect/1" {
  assert_eq(
    load_dump(
      "\n        name: C\n        scope: source.c\n        file_extensions: [c, h]\n        hidden_file_extensions: [k, l]\n        hidden: true\n        variables:\n          ident: '[QY]+'\n        contexts:\n          prototype:\n            - match: lol\n              scope: source.php\n          main:\n            - match: \\b(if|else|for|while|{{ident}})\\b\n              scope: keyword.control.c keyword.looping.c\n              captures:\n                  1: meta.preprocessor.c++\n                  2: keyword.control.include.c++\n              push: [string, 'scope:source.c#main', 'CSS.sublime-syntax#rule-list-body']\n              with_prototype:\n                - match: wow\n                  pop: true\n            - match: '\"'\n              push: string\n          string:\n            - meta_scope: string.quoted.double.c\n            - meta_include_prototype: false\n            - match: \\\\.\n              scope: constant.character.escape.c\n            - match: '\"'\n              pop: true\n        ",
    ),
    "Ok([Hash({String(\"name\"): String(\"C\"), String(\"scope\"): String(\"source.c\"), String(\"file_extensions\"): Array([String(\"c\"), String(\"h\")]), String(\"hidden_file_extensions\"): Array([String(\"k\"), String(\"l\")]), String(\"hidden\"): Boolean(true), String(\"variables\"): Hash({String(\"ident\"): String(\"[QY]+\")}), String(\"contexts\"): Hash({String(\"prototype\"): Array([Hash({String(\"match\"): String(\"lol\"), String(\"scope\"): String(\"source.php\")})]), String(\"main\"): Array([Hash({String(\"match\"): String(\"\\\\b(if|else|for|while|{{ident}})\\\\b\"), String(\"scope\"): String(\"keyword.control.c keyword.looping.c\"), String(\"captures\"): Hash({Integer(1): String(\"meta.preprocessor.c++\"), Integer(2): String(\"keyword.control.include.c++\")}), String(\"push\"): Array([String(\"string\"), String(\"scope:source.c#main\"), String(\"CSS.sublime-syntax#rule-list-body\")]), String(\"with_prototype\"): Array([Hash({String(\"match\"): String(\"wow\"), String(\"pop\"): Boolean(true)})])}), Hash({String(\"match\"): String(\"\\\"\"), String(\"push\"): String(\"string\")})]), String(\"string\"): Array([Hash({String(\"meta_scope\"): String(\"string.quoted.double.c\")}), Hash({String(\"meta_include_prototype\"): Boolean(false)}), Hash({String(\"match\"): String(\"\\\\\\\\.\"), String(\"scope\"): String(\"constant.character.escape.c\")}), Hash({String(\"match\"): String(\"\\\"\"), String(\"pop\"): Boolean(true)})])})})])",
  )
}

///|
test "yaml_rust/syntect/2" {
  assert_eq(
    load_dump(
      "\n        name: C\n        scope: source.c\n        file_extensions: [c, h]\n        variables:\n          ident: '[QY]+'\n        contexts:\n          main:\n            - match: '(>)\\s*'\n              captures:\n                1: meta.tag.style.begin.html punctuation.definition.tag.end.html\n              push:\n                - [{ meta_include_prototype: false }, { meta_content_scope: 'source.css.embedded.html' }, { match: '(?i)(?=</style)', pop: true }]\n                - scope:source.css\n              with_prototype:\n                - match: (?=(?i)(?=</style))\n                  pop: true\n        ",
    ),
    "Ok([Hash({String(\"name\"): String(\"C\"), String(\"scope\"): String(\"source.c\"), String(\"file_extensions\"): Array([String(\"c\"), String(\"h\")]), String(\"variables\"): Hash({String(\"ident\"): String(\"[QY]+\")}), String(\"contexts\"): Hash({String(\"main\"): Array([Hash({String(\"match\"): String(\"(>)\\\\s*\"), String(\"captures\"): Hash({Integer(1): String(\"meta.tag.style.begin.html punctuation.definition.tag.end.html\")}), String(\"push\"): Array([Array([Hash({String(\"meta_include_prototype\"): Boolean(false)}), Hash({String(\"meta_content_scope\"): String(\"source.css.embedded.html\")}), Hash({String(\"match\"): String(\"(?i)(?=</style)\"), String(\"pop\"): Boolean(true)})]), String(\"scope:source.css\")]), String(\"with_prototype\"): Array([Hash({String(\"match\"): String(\"(?=(?i)(?=</style))\"), String(\"pop\"): Boolean(true)})])})])})})])",
  )
}

