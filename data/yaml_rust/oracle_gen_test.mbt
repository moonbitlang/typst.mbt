  )
}

///|
test "yaml_rust/spec/ex7_10" {
  assert_eq(
    load_dump(
      "# Outside flow collection:\n- ::vector\n- \": - ()\"\n- Up, up, and away!\n- -123\n- http://example.com/foo#bar\n# Inside flow collection:\n- [ ::vector,\n  \": - ()\",\n  \"Up, up, and away!\",\n  -123,\n  http://example.com/foo#bar ]",
    ),
    "Ok([Array([String(\"::vector\"), String(\": - ()\"), String(\"Up, up, and away!\"), Integer(-123), String(\"http://example.com/foo#bar\"), Array([String(\"::vector\"), String(\": - ()\"), String(\"Up, up, and away!\"), Integer(-123), String(\"http://example.com/foo#bar\")])])])",
  )
}

///|
test "yaml_rust/spec/ex7_11" {
  assert_eq(
    load_dump("implicit block key : [\n  implicit flow key : value,\n ]"),
    "Ok([Hash({String(\"implicit block key\"): Array([Hash({String(\"implicit flow key\"): String(\"value\")})])})])",
  )
}

///|
test "yaml_rust/spec/ex7_12" {
  assert_eq(
    load_dump("1st non-empty\n\n 2nd non-empty \n\t3rd non-empty"),
    "Ok([String(\"1st non-empty\\n2nd non-empty 3rd non-empty\")])",
  )
}

///|
test "yaml_rust/spec/ex7_13" {
  assert_eq(
    load_dump("- [ one, two, ]\n- [three ,four]"),
    "Ok([Array([Array([String(\"one\"), String(\"two\")]), Array([String(\"three\"), String(\"four\")])])])",
  )
}

///|
test "yaml_rust/spec/ex7_14" {
  assert_eq(
    load_dump(
      "[\n\"double\n quoted\", 'single\n           quoted',\nplain\n text, [ nested ],\nsingle: pair,\n]",
    ),
    "Ok([Array([String(\"double quoted\"), String(\"single quoted\"), String(\"plain text\"), Array([String(\"nested\")]), Hash({String(\"single\"): String(\"pair\")})])])",
  )
}

///|
test "yaml_rust/spec/ex7_15" {
  assert_eq(
    load_dump("- { one : two , three: four , }\n- {five: six,seven : eight}"),
    "Ok([Array([Hash({String(\"one\"): String(\"two\"), String(\"three\"): String(\"four\")}), Hash({String(\"five\"): String(\"six\"), String(\"seven\"): String(\"eight\")})])])",
  )
}

///|
test "yaml_rust/spec/ex7_16" {
  assert_eq(
    load_dump("{\n? explicit: entry,\nimplicit: entry,\n?\n}"),
    "Ok([Hash({String(\"explicit\"): String(\"entry\"), String(\"implicit\"): String(\"entry\"), Null: Null})])",
  )
}

///|
test "yaml_rust/spec/ex7_17" {
  assert_eq(
    load_dump(
      "{\nunquoted : \"separate\",\nhttp://foo.com,\nomitted value:,\n: omitted key,\n}",
    ),
    "Ok([Hash({String(\"unquoted\"): String(\"separate\"), String(\"http://foo.com\"): Null, String(\"omitted value\"): Null, Null: String(\"omitted key\")})])",
  )
}

///|
test "yaml_rust/spec/ex7_18" {
  assert_eq(
    load_dump("{\n\"adjacent\":value,\n\"readable\":value,\n\"empty\":\n}"),
    "Ok([Hash({String(\"adjacent\"): String(\"value\"), String(\"readable\"): String(\"value\"), String(\"empty\"): Null})])",
  )
}

///|
test "yaml_rust/spec/ex7_19" {
  assert_eq(
    load_dump("[\nfoo: bar\n]"),
    "Ok([Array([Hash({String(\"foo\"): String(\"bar\")})])])",
  )
}

///|
test "yaml_rust/spec/ex7_20" {
  assert_eq(
    load_dump("[\n? foo\n bar : baz\n]"),
    "Ok([Array([Hash({String(\"foo bar\"): String(\"baz\")})])])",
  )
}

///|
test "yaml_rust/spec/ex7_21" {
  assert_eq(
    load_dump(
      "- [ YAML : separate ]\n- [ : empty key entry ]\n- [ {JSON: like}:adjacent ]",
    ),
    "Err(while parsing a node, did not find expected node content at line 2 column 5 @ 26:2:4)",
  )
}

///|
test "yaml_rust/spec/ex7_22" {
  assert_eq(
    load_dump("[ foo\n bar: invalid,"),
    "Err(while parsing a flow sequence, expected ',' or ']' at line 2 column 5 @ 10:2:4)",
  )
}

///|
test "yaml_rust/spec/ex7_23" {
  assert_eq(
    load_dump("- [ a, b ]\n- { a: b }\n- \"a\"\n- 'b'\n- c"),
    "Ok([Array([Array([String(\"a\"), String(\"b\")]), Hash({String(\"a\"): String(\"b\")}), String(\"a\"), String(\"b\"), String(\"c\")])])",
  )
}

///|
test "yaml_rust/spec/ex7_24" {
  assert_eq(
    load_dump("- !!str \"a\"\n- 'b'\n- &anchor \"c\"\n- *anchor\n- !!str"),
    "Ok([Array([String(\"a\"), String(\"b\"), String(\"c\"), String(\"c\"), String(\"\")])])",
  )
}

///|
test "yaml_rust/spec/ex8_1" {
  assert_eq(
    load_dump(
      "- | # Empty header\n literal\n- >1 # Indentation indicator\n  folded\n- |+ # Chomping indicator\n keep\n\n- >1- # Both indicators\n  strip\n",
    ),
    "Ok([Array([String(\"literal\\n\"), String(\" folded\\n\"), String(\"keep\\n\\n\"), String(\" strip\")])])",
  )
}

///|
test "yaml_rust/spec/ex8_2" {
  assert_eq(
    load_dump(
      "- |\n detected\n- >\n \n  \n  # detected\n- |1\n  explicit\n- >\n \t\n detected\n",
    ),
    "Err(while scanning a block scalar, found a tab character where an indentation space is expected at line 10 column 2 @ 57:10:1)",
  )
}

///|
test "yaml_rust/spec/ex8_3a" {
  assert_eq(
    load_dump("- |\n  \n text"),
    "Err(while parsing a block collection, did not find expected '-' indicator at line 3 column 2 @ 8:3:1)",
  )
}

///|
test "yaml_rust/spec/ex8_3b" {
  assert_eq(
    load_dump("- >\n  text\n text"),
    "Err(while parsing a block collection, did not find expected '-' indicator at line 3 column 2 @ 12:3:1)",
  )
}

///|
test "yaml_rust/spec/ex8_3c" {
  assert_eq(
    load_dump("- |2\n text"),
    "Err(while parsing a block collection, did not find expected '-' indicator at line 2 column 2 @ 6:2:1)",
  )
}

