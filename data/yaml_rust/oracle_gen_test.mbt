}

///|
test "yaml_rust/spec/ex2_23" {
  assert_eq(
    load_dump(
      "---\nnot-date: !!str 2002-04-28\n\npicture: !!binary |\n R0lGODlhDAAMAIQAAP//9/X\n 17unp5WZmZgAAAOfn515eXv\n Pz7Y6OjuDg4J+fn5OTk6enp\n 56enmleECcgggoBADs=\n\napplication specific tag: !something |\n The semantics of the tag\n above may be different for\n different documents.",
    ),
    "Ok([Hash({String(\"not-date\"): String(\"2002-04-28\"), String(\"picture\"): String(\"R0lGODlhDAAMAIQAAP//9/X\\n17unp5WZmZgAAAOfn515eXv\\nPz7Y6OjuDg4J+fn5OTk6enp\\n56enmleECcgggoBADs=\\n\"), String(\"application specific tag\"): String(\"The semantics of the tag\\nabove may be different for\\ndifferent documents.\")})])",
  )
}

///|
test "yaml_rust/spec/ex2_24" {
  assert_eq(
    load_dump(
      "%TAG ! tag:clarkevans.com,2002:\n--- !shape\n  # Use the ! handle for presenting\n  # tag:clarkevans.com,2002:circle\n- !circle\n  center: &ORIGIN {x: 73, y: 129}\n  radius: 7\n- !line\n  start: *ORIGIN\n  finish: { x: 89, y: 102 }\n- !label\n  start: *ORIGIN\n  color: 0xFFEEBB\n  text: Pretty vector drawing.",
    ),
    "Ok([Array([Hash({String(\"center\"): Hash({String(\"x\"): Integer(73), String(\"y\"): Integer(129)}), String(\"radius\"): Integer(7)}), Hash({String(\"start\"): Hash({String(\"x\"): Integer(73), String(\"y\"): Integer(129)}), String(\"finish\"): Hash({String(\"x\"): Integer(89), String(\"y\"): Integer(102)})}), Hash({String(\"start\"): Hash({String(\"x\"): Integer(73), String(\"y\"): Integer(129)}), String(\"color\"): Integer(16772795), String(\"text\"): String(\"Pretty vector drawing.\")})])])",
  )
}

///|
test "yaml_rust/spec/ex2_25" {
  assert_eq(
    load_dump(
      "# Sets are represented as a\n# Mapping where each key is\n# associated with a null value\n--- !!set\n? Mark McGwire\n? Sammy Sosa\n? Ken Griffey",
    ),
    "Ok([Hash({String(\"Mark McGwire\"): Null, String(\"Sammy Sosa\"): Null, String(\"Ken Griffey\"): Null})])",
  )
}

///|
test "yaml_rust/spec/ex2_26" {
