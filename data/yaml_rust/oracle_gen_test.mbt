    ),
    "Ok([Hash({String(\"name\"): String(\"S Expressions\"), String(\"file_extensions\"): Array([String(\"sexp\")]), String(\"scope\"): String(\"source.sexpr\"), String(\"contexts\"): Hash({String(\"main\"): Array([Hash({String(\"match\"): String(\"(;+).*$\"), String(\"scope\"): String(\"comment.line.sexpr\"), String(\"captures\"): Hash({Integer(1): String(\"punctuation.definition.comment.sexpr\")})}), Hash({String(\"match\"): String(\"#;\"), String(\"scope\"): String(\"punctuation.definition.comment.sexpr\"), String(\"push\"): String(\"comment\")}), Hash({String(\"match\"): String(\"#\\\\|\"), String(\"scope\"): String(\"punctuation.definition.comment.sexpr\"), String(\"push\"): String(\"block_comment\")}), Hash({String(\"match\"): String(\"\\\"\"), String(\"scope\"): String(\"punctuation.definition.string.begin.sexpr\"), String(\"push\"): String(\"string_unquote\")}), Hash({String(\"match\"): String(\"\\\\d+\\\\.\\\\d+\"), String(\"scope\"): String(\"constant.numeric.float.sexpr\")}), Hash({String(\"match\"): String(\"\\\\d+\"), String(\"scope\"): String(\"constant.numeric.integer.sexpr\")}), Hash({String(\"match\"): String(\"\\\\w+\"), String(\"scope\"): String(\"constant.other\")})])})})])",
