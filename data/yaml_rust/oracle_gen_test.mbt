    "Ok([Hash({String(\"name\"): String(\"JSON-ish\"), String(\"scope\"): String(\"source.json\"), String(\"contexts\"): Hash({String(\"main\"): Array([Hash({String(\"match\"): String(\"\\\\{\"), String(\"scope\"): String(\"punctuation.section.mapping.begin.json\"), String(\"push\"): String(\"object\")}), Hash({String(\"match\"): String(\"\\\"\"), String(\"push\"): Array([Hash({String(\"meta_scope\"): String(\"string.quoted.double.json\")}), Hash({String(\"match\"): String(\"\\\\\\\\(?:[\\\"\\\\\\\\/bfnrt]|u[0-9a-fA-F]{4})\"), String(\"scope\"): String(\"constant.character.escape.json\")}), Hash({String(\"match\"): String(\"\\\\\\\\.\"), String(\"cope\"): String(\"invalid.illegal.unrecognized-string-escape.json\")}), Hash({String(\"match\"): String(\"\\\"\"), String(\"pop\"): Boolean(true)})])}), Hash({String(\"match\"): String(\"-?(?:0|[1-9]\\\\d*)(?:(?:\\\\.\\\\d+)?(?:[eE][+-]?\\\\d+)?)?\"), String(\"scope\"): String(\"constant.numeric.json\")}), Hash({String(\"match\"): String(\"\\\\b(?:true|false|null)\\\\b\"), String(\"scope\"): String(\"constant.language.json\")})]), String(\"object\"): Array([Hash({String(\"match\"): String(\"\\\\}\"), String(\"pop\"): Boolean(true)}), Hash({String(\"match\"): String(\":\"), String(\"scope\"): String(\"punctuation.separator.mapping.key-value.json\")}), Hash({String(\"match\"): String(\",\"), String(\"scope\"): String(\"punctuation.separator.mapping.pair.json\")})])})})])",
  )
}

