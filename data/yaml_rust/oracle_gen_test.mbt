///|
test "yaml_rust/spec/ex8_16" {
  assert_eq(
    load_dump("block mapping:\n key: value\n"),
    "Ok([Hash({String(\"block mapping\"): Hash({String(\"key\"): String(\"value\")})})])",
  )
}

///|
test "yaml_rust/spec/ex8_17" {
  assert_eq(
    load_dump(
      "? explicit key # Empty value\n? |\n  block key\n: - one # Explicit compact\n  - two # block value\n",
    ),
    "Ok([Hash({String(\"explicit key\"): Null, String(\"block key\\n\"): Array([String(\"one\"), String(\"two\")])})])",
  )
}

///|
test "yaml_rust/spec/ex8_18" {
  assert_eq(
    load_dump(
      "plain key: in-line value\n:  # Both empty\n\"quoted key\":\n- entry\n",
    ),
    "Ok([Hash({String(\"plain key\"): String(\"in-line value\"), Null: Null, String(\"quoted key\"): Array([String(\"entry\")])})])",
  )
}

///|
test "yaml_rust/spec/ex8_19" {
  assert_eq(
    load_dump("- sun: yellow\n- ? earth: blue\n  : moon: white\n"),
    "Ok([Array([Hash({String(\"sun\"): String(\"yellow\")}), Hash({Hash({String(\"earth\"): String(\"blue\")}): Hash({String(\"moon\"): String(\"white\")})})])])",
  )
}

///|
test "yaml_rust/spec/ex8_20" {
  assert_eq(
    load_dump(
      "-\n  \"flow in block\"\n- >\n Block scalar\n- !!map # Block collection\n  foo : bar\n",
    ),
    "Ok([Array([String(\"flow in block\"), String(\"Block scalar\\n\"), Hash({String(\"foo\"): String(\"bar\")})])])",
  )
}

///|
test "yaml_rust/spec/ex8_21" {
