test "yaml_rust/spec/ex5_11" {
  assert_eq(
    load_dump("|\n  Line break (no glyph)\n  Line break (glyphed)\n"),
    "Ok([String(\"Line break (no glyph)\\nLine break (glyphed)\\n\")])",
  )
}

///|
test "yaml_rust/spec/ex5_12" {
  assert_eq(
    load_dump(
      "# Tabs and spaces\nquoted: \"Quoted\t\"\nblock:\t|\n  void main() {\n  \tprintf(\"Hello, world!\\n\");\n  }",
    ),
    "Ok([Hash({String(\"quoted\"): String(\"Quoted\\t\"), String(\"block\"): String(\"void main() {\\n\\tprintf(\\\"Hello, world!\\\\n\\\");\\n}\")})])",
  )
}

///|
test "yaml_rust/spec/ex5_13" {
  assert_eq(
    load_dump(
      "\"Fun with \\\\\n\\\" \\a \\b \\e \\f \\\n\\n \\r \\t \\v \\0 \\\n\\  \\_ \\N \\L \\P \\\n\\x41 \\u0041 \\U00000041\"",
    ),
    "Ok([String(\"Fun with \\\\ \\\" \\u{7} \\u{8} \\u{1b} \\u{c} \\n \\r \\t \\u{b} \\0   \\u{a0} \\u{85} \\u{2028} \\u{2029} A A A\")])",
  )
}

///|
test "yaml_rust/spec/ex5_14" {
  assert_eq(
    load_dump("Bad escapes:\n  \"\\c\n  \\xq-\""),
    "Err(while parsing a quoted scalar, found unknown escape character at line 2 column 3 @ 15:2:2)",
  )
}

///|
test "yaml_rust/spec/ex6_1" {
  assert_eq(
    load_dump(
      "  # Leading comment line spaces are\n   # neither content nor indentation.\n    \nNot indented:\n By one space: |\n    By four\n      spaces\n Flow style: [    # Leading spaces\n   By two,        # in flow style\n  Also by two,    # are neither\n  \tStill by two   # content nor\n    ]             # indentation.",
    ),
    "Ok([Hash({String(\"Not indented\"): Hash({String(\"By one space\"): String(\"By four\\n  spaces\\n\"), String(\"Flow style\"): Array([String(\"By two\"), String(\"Also by two\"), String(\"Still by two\")])})})])",
  )
}

///|
test "yaml_rust/spec/ex6_2" {
  assert_eq(
    load_dump("? a\n: -\tb\n  -  -\tc\n     - d"),
    "Ok([Hash({String(\"a\"): Array([String(\"\\tb\"), Array([String(\"\\tc\"), String(\"d\")])])})])",
  )
}

///|
test "yaml_rust/spec/ex6_3" {
  assert_eq(
    load_dump("- foo:\t bar\n- - baz\n  -\tbaz"),
    "Ok([Array([Hash({String(\"foo\"): String(\"bar\")}), Array([String(\"baz\"), String(\"\\tbaz\")])])])",
  )
}

///|
test "yaml_rust/spec/ex6_4" {
  assert_eq(
    load_dump(
      "plain: text\n  lines\nquoted: \"text\n  \tlines\"\nblock: |\n  text\n   \tlines\n",
    ),
    "Ok([Hash({String(\"plain\"): String(\"text lines\"), String(\"quoted\"): String(\"text lines\"), String(\"block\"): String(\"text\\n \\tlines\\n\")})])",
  )
}

///|
test "yaml_rust/spec/ex6_5" {
  assert_eq(
    load_dump(
      "Folding:\n  \"Empty line\n   \t\n  as a line feed\"\nChomping: |\n  Clipped empty lines\n ",
    ),
    "Ok([Hash({String(\"Folding\"): String(\"Empty line\\nas a line feed\"), String(\"Chomping\"): String(\"Clipped empty lines\\n\")})])",
  )
}

