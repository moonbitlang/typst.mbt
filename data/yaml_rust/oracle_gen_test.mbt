    load_dump(
      "{ first: Sammy, last: Sosa }:\n# Statistics:\n  hr:  # Home !runs\n     65\n  avg: # Average\n   0.278",
    ),
    "Ok([Hash({Hash({String(\"first\"): String(\"Sammy\"), String(\"last\"): String(\"Sosa\")}): Hash({String(\"hr\"): Integer(65), String(\"avg\"): Real(\"0.278\")})})])",
  )
}

