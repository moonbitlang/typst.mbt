  )
}

///|
test "yaml_rust/sublime/0" {
  assert_eq(
    load_dump(
      "%YAML 1.2\n---\n# See http://www.sublimetext.com/docs/syntax.html\nname: Mini Rust\nfile_extensions:\n  - rs\n  - rlib\nfirst_line_match: ^#!\\s*/usr/bin/env\\s+run-cargo-script\nscope: source.rust\nversion: 2\n\nvariables:\n  non_raw_ident: '[[:alpha:]][_[:alnum:]]*|_[_[:alnum:]]+'\n  identifier: '(?:(?:r\\#)?{{non_raw_ident}})'\n  escaped_byte: '\\\\([nrt0\\\"''\\\\]|x\\h{2})'\n  int_suffixes: '[iu](?:8|16|32|64|128|size)'\n\ncontexts:\n  main:\n    - include: statements\n\n  prototype:\n    - include: comments\n\n  statements:\n    - match: '(''){{identifier}}(?=\\:\\s*(?:for|while|loop)\\b)'\n      scope: entity.name.label.rust\n      captures:\n        1: punctuation.definition.label.rust\n    - match: \\b(fn)\\s+({{identifier}})\n      captures:\n        1: storage.type.function.rust keyword.declaration.function.rust\n        2: entity.name.function.rust\n      push: fn-parameters\n    - match: '\"'\n      scope: punctuation.definition.string.begin.rust\n      push: string\n    - match: '\\b0x[\\h_]+{{int_suffixes}}?\\b'\n      scope: constant.numeric.integer.hexadecimal.rust\n    - match: \\b(true|false)\\b\n      scope: constant.language.boolean.rust\n\n  fn-parameters:\n    - meta_scope: meta.function.parameters.rust\n    - match: \\)\n      pop: true\n    - match: '[{};]'\n      pop: 2\n\n  string:\n    - meta_include_prototype: false\n    - meta_scope: string.quoted.double.rust\n    - match: '{{escaped_byte}}'\n      scope: constant.character.escape.rust\n    - match: '\"'\n      scope: punctuation.definition.string.end.rust\n      pop: true\n\n  comments:\n    - match: /\\*\n      scope: punctuation.definition.comment.rust\n      push:\n        - meta_scope: comment.block.rust\n        - match: \\*/\n          pop: true\n    - match: //\n      scope: punctuation.definition.comment.rust\n      push:\n        - meta_scope: comment.line.double-slash.rust\n        - match: $\\n?\n          pop: true\n",
    ),
    "Ok([Hash({String(\"name\"): String(\"Mini Rust\"), String(\"file_extensions\"): Array([String(\"rs\"), String(\"rlib\")]), String(\"first_line_match\"): String(\"^#!\\\\s*/usr/bin/env\\\\s+run-cargo-script\"), String(\"scope\"): String(\"source.rust\"), String(\"version\"): Integer(2), String(\"variables\"): Hash({String(\"non_raw_ident\"): String(\"[[:alpha:]][_[:alnum:]]*|_[_[:alnum:]]+\"), String(\"identifier\"): String(\"(?:(?:r\\\\#)?{{non_raw_ident}})\"), String(\"escaped_byte\"): String(\"\\\\\\\\([nrt0\\\\\\\"'\\\\\\\\]|x\\\\h{2})\"), String(\"int_suffixes\"): String(\"[iu](?:8|16|32|64|128|size)\")}), String(\"contexts\"): Hash({String(\"main\"): Array([Hash({String(\"include\"): String(\"statements\")})]), String(\"prototype\"): Array([Hash({String(\"include\"): String(\"comments\")})]), String(\"statements\"): Array([Hash({String(\"match\"): String(\"('){{identifier}}(?=\\\\:\\\\s*(?:for|while|loop)\\\\b)\"), String(\"scope\"): String(\"entity.name.label.rust\"), String(\"captures\"): Hash({Integer(1): String(\"punctuation.definition.label.rust\")})}), Hash({String(\"match\"): String(\"\\\\b(fn)\\\\s+({{identifier}})\"), String(\"captures\"): Hash({Integer(1): String(\"storage.type.function.rust keyword.declaration.function.rust\"), Integer(2): String(\"entity.name.function.rust\")}), String(\"push\"): String(\"fn-parameters\")}), Hash({String(\"match\"): String(\"\\\"\"), String(\"scope\"): String(\"punctuation.definition.string.begin.rust\"), String(\"push\"): String(\"string\")}), Hash({String(\"match\"): String(\"\\\\b0x[\\\\h_]+{{int_suffixes}}?\\\\b\"), String(\"scope\"): String(\"constant.numeric.integer.hexadecimal.rust\")}), Hash({String(\"match\"): String(\"\\\\b(true|false)\\\\b\"), String(\"scope\"): String(\"constant.language.boolean.rust\")})]), String(\"fn-parameters\"): Array([Hash({String(\"meta_scope\"): String(\"meta.function.parameters.rust\")}), Hash({String(\"match\"): String(\"\\\\)\"), String(\"pop\"): Boolean(true)}), Hash({String(\"match\"): String(\"[{};]\"), String(\"pop\"): Integer(2)})]), String(\"string\"): Array([Hash({String(\"meta_include_prototype\"): Boolean(false)}), Hash({String(\"meta_scope\"): String(\"string.quoted.double.rust\")}), Hash({String(\"match\"): String(\"{{escaped_byte}}\"), String(\"scope\"): String(\"constant.character.escape.rust\")}), Hash({String(\"match\"): String(\"\\\"\"), String(\"scope\"): String(\"punctuation.definition.string.end.rust\"), String(\"pop\"): Boolean(true)})]), String(\"comments\"): Array([Hash({String(\"match\"): String(\"/\\\\*\"), String(\"scope\"): String(\"punctuation.definition.comment.rust\"), String(\"push\"): Array([Hash({String(\"meta_scope\"): String(\"comment.block.rust\")}), Hash({String(\"match\"): String(\"\\\\*/\"), String(\"pop\"): Boolean(true)})])}), Hash({String(\"match\"): String(\"//\"), String(\"scope\"): String(\"punctuation.definition.comment.rust\"), String(\"push\"): Array([Hash({String(\"meta_scope\"): String(\"comment.line.double-slash.rust\")}), Hash({String(\"match\"): String(\"$\\\\n?\"), String(\"pop\"): Boolean(true)})])})])})})])",
  )
}

///|
test "yaml_rust/sublime/1" {
  assert_eq(
    load_dump(
      "%YAML 1.2\n---\nname: Mini Markdown\nscope: text.html.markdown\nfile_extensions: [md, mdown, markdown]\nhidden: false\nvariables:\n  fenced_code_block_start: |-\n    (?x:\n      ([ \\t]*)\n      (\n        (`){3,}    # 3 or more backticks\n        (?![^`]*`) # not followed by any more backticks on the same line\n      |            # or\n        (~){3,}    # 3 or more tildas\n      )\n    )\n  indented_code_block: (?:\\s{4}|\\t)\ncontexts:\n  main:\n    - match: '{{fenced_code_block_start}}(?i:(python|py))\\s*$'\n      captures:\n        0: meta.code-fence.definition.begin.python.markdown-gfm\n        2: punctuation.definition.raw.code-fence.begin.markdown\n        5: constant.other.language-name.markdown\n      embed: scope:source.python\n      embed_scope: markup.raw.code-fence.python.markdown-gfm\n      escape: ^\\1\\2\\s*$\n      escape_captures:\n        0: meta.code-fence.definition.end.python.markdown-gfm\n    - match: ^(#{1,6})\\s+(.*?)\\s*(#*)$\\n?\n      scope: markup.heading.markdown\n      captures: {1: punctuation.definition.heading.begin.markdown, 2: entity.name.section.markdown}\n    - match: (\\*\\*|__)(?=\\S)\n      push: bold\n    - match: '\\\\[-`*_#+.!(){}\\[\\]\\\\>|~<]'\n      scope: constant.character.escape.markdown\n  bold:\n    - meta_scope: markup.bold.markdown\n    - match: \\1\n      pop: true\n    - include: main\n",
    ),
    "Ok([Hash({String(\"name\"): String(\"Mini Markdown\"), String(\"scope\"): String(\"text.html.markdown\"), String(\"file_extensions\"): Array([String(\"md\"), String(\"mdown\"), String(\"markdown\")]), String(\"hidden\"): Boolean(false), String(\"variables\"): Hash({String(\"fenced_code_block_start\"): String(\"(?x:\\n  ([ \\\\t]*)\\n  (\\n    (`){3,}    # 3 or more backticks\\n    (?![^`]*`) # not followed by any more backticks on the same line\\n  |            # or\\n    (~){3,}    # 3 or more tildas\\n  )\\n)\"), String(\"indented_code_block\"): String(\"(?:\\\\s{4}|\\\\t)\")}), String(\"contexts\"): Hash({String(\"main\"): Array([Hash({String(\"match\"): String(\"{{fenced_code_block_start}}(?i:(python|py))\\\\s*$\"), String(\"captures\"): Hash({Integer(0): String(\"meta.code-fence.definition.begin.python.markdown-gfm\"), Integer(2): String(\"punctuation.definition.raw.code-fence.begin.markdown\"), Integer(5): String(\"constant.other.language-name.markdown\")}), String(\"embed\"): String(\"scope:source.python\"), String(\"embed_scope\"): String(\"markup.raw.code-fence.python.markdown-gfm\"), String(\"escape\"): String(\"^\\\\1\\\\2\\\\s*$\"), String(\"escape_captures\"): Hash({Integer(0): String(\"meta.code-fence.definition.end.python.markdown-gfm\")})}), Hash({String(\"match\"): String(\"^(#{1,6})\\\\s+(.*?)\\\\s*(#*)$\\\\n?\"), String(\"scope\"): String(\"markup.heading.markdown\"), String(\"captures\"): Hash({Integer(1): String(\"punctuation.definition.heading.begin.markdown\"), Integer(2): String(\"entity.name.section.markdown\")})}), Hash({String(\"match\"): String(\"(\\\\*\\\\*|__)(?=\\\\S)\"), String(\"push\"): String(\"bold\")}), Hash({String(\"match\"): String(\"\\\\\\\\[-`*_#+.!(){}\\\\[\\\\]\\\\\\\\>|~<]\"), String(\"scope\"): String(\"constant.character.escape.markdown\")})]), String(\"bold\"): Array([Hash({String(\"meta_scope\"): String(\"markup.bold.markdown\")}), Hash({String(\"match\"): String(\"\\\\1\"), String(\"pop\"): Boolean(true)}), Hash({String(\"include\"): String(\"main\")})])})})])",
  )
}

///|
test "yaml_rust/sublime/2" {
  assert_eq(
    load_dump(
      "name: JSON-ish\nscope: source.json\ncontexts:\n  main:\n    - match: '\\{'\n      scope: punctuation.section.mapping.begin.json\n      push: object\n    - match: '\"'\n      push:\n        - meta_scope: string.quoted.double.json\n        - match: '\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})'\n          scope: constant.character.escape.json\n        - match: '\\\\.'\n          scope: invalid.illegal.unrecognized-string-escape.json\n        - match: '\"'\n          pop: true\n    - match: '-?(?:0|[1-9]\\d*)(?:(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)?'\n      scope: constant.numeric.json\n    - match: \\b(?:true|false|null)\\b\n      scope: constant.language.json\n  object:\n    - match: '\\}'\n      pop: true\n    - match: ':'\n      scope: punctuation.separator.mapping.key-value.json\n    - match: ','\n      scope: punctuation.separator.mapping.pair.json\n",
    ),
    "Ok([Hash({String(\"name\"): String(\"JSON-ish\"), String(\"scope\"): String(\"source.json\"), String(\"contexts\"): Hash({String(\"main\"): Array([Hash({String(\"match\"): String(\"\\\\{\"), String(\"scope\"): String(\"punctuation.section.mapping.begin.json\"), String(\"push\"): String(\"object\")}), Hash({String(\"match\"): String(\"\\\"\"), String(\"push\"): Array([Hash({String(\"meta_scope\"): String(\"string.quoted.double.json\")}), Hash({String(\"match\"): String(\"\\\\\\\\(?:[\\\"\\\\\\\\/bfnrt]|u[0-9a-fA-F]{4})\"), String(\"scope\"): String(\"constant.character.escape.json\")}), Hash({String(\"match\"): String(\"\\\\\\\\.\"), String(\"scope\"): String(\"invalid.illegal.unrecognized-string-escape.json\")}), Hash({String(\"match\"): String(\"\\\"\"), String(\"pop\"): Boolean(true)})])}), Hash({String(\"match\"): String(\"-?(?:0|[1-9]\\\\d*)(?:(?:\\\\.\\\\d+)?(?:[eE][+-]?\\\\d+)?)?\"), String(\"scope\"): String(\"constant.numeric.json\")}), Hash({String(\"match\"): String(\"\\\\b(?:true|false|null)\\\\b\"), String(\"scope\"): String(\"constant.language.json\")})]), String(\"object\"): Array([Hash({String(\"match\"): String(\"\\\\}\"), String(\"pop\"): Boolean(true)}), Hash({String(\"match\"): String(\":\"), String(\"scope\"): String(\"punctuation.separator.mapping.key-value.json\")}), Hash({String(\"match\"): String(\",\"), String(\"scope\"): String(\"punctuation.separator.mapping.pair.json\")})])})})])",
  )
}

