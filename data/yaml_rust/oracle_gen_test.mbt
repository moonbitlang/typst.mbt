///|
test "yaml_rust/syntect/6" {
  assert_eq(
    load_dump(
      "\n        name: LaTeX\n        scope: text.tex.latex\n        contexts:\n          main:\n            - match: '((\\\\)(?:framebox|makebox))\\b'\n              captures:\n                1: support.function.box.latex\n                2: punctuation.definition.backslash.latex\n              push:\n                - [{meta_scope: meta.function.box.latex}, {match: '', pop: true}]\n                - argument\n                - optional-arguments\n          argument:\n            - match: '\\{'\n              scope: punctuation.definition.group.brace.begin.latex\n            - match: '(?=\\S)'\n              pop: true\n          optional-arguments:\n            - match: '(?=\\S)'\n              pop: true\n        ",
    ),
    "Ok([Hash({String(\"name\"): String(\"LaTeX\"), String(\"scope\"): String(\"text.tex.latex\"), String(\"contexts\"): Hash({String(\"main\"): Array([Hash({String(\"match\"): String(\"((\\\\\\\\)(?:framebox|makebox))\\\\b\"), String(\"captures\"): Hash({Integer(1): String(\"support.function.box.latex\"), Integer(2): String(\"punctuation.definition.backslash.latex\")}), String(\"push\"): Array([Array([Hash({String(\"meta_scope\"): String(\"meta.function.box.latex\")}), Hash({String(\"match\"): String(\"\"), String(\"pop\"): Boolean(true)})]), String(\"argument\"), String(\"optional-arguments\")])})]), String(\"argument\"): Array([Hash({String(\"match\"): String(\"\\\\{\"), String(\"scope\"): String(\"punctuation.definition.group.brace.begin.latex\")}), Hash({String(\"match\"): String(\"(?=\\\\S)\"), String(\"pop\"): Boolean(true)})]), String(\"optional-arguments\"): Array([Hash({String(\"match\"): String(\"(?=\\\\S)\"), String(\"pop\"): Boolean(true)})])})})])",
  )
}

///|
test "yaml_rust/syntect/7" {
  assert_eq(
    load_dump(
      "\n            scope: source.c\n            contexts:\n              main:\n                - match: a\n                  push: a\n              a:\n                - meta_scope: a\n                - match: x\n                  push:\n                    - meta_scope: anonymous_x\n                    - match: anything\n                      push:\n                        - meta_scope: anonymous_x_2\n                - match: y\n                  push:\n                    - meta_scope: anonymous_y\n                - match: z\n                  escape: 'test'\n            ",
    ),
    "Ok([Hash({String(\"scope\"): String(\"source.c\"), String(\"contexts\"): Hash({String(\"main\"): Array([Hash({String(\"match\"): String(\"a\"), String(\"push\"): String(\"a\")})]), String(\"a\"): Array([Hash({String(\"meta_scope\"): String(\"a\")}), Hash({String(\"match\"): String(\"x\"), String(\"push\"): Array([Hash({String(\"meta_scope\"): String(\"anonymous_x\")}), Hash({String(\"match\"): String(\"anything\"), String(\"push\"): Array([Hash({String(\"meta_scope\"): String(\"anonymous_x_2\")})])})])}), Hash({String(\"match\"): String(\"y\"), String(\"push\"): Array([Hash({String(\"meta_scope\"): String(\"anonymous_y\")})])}), Hash({String(\"match\"): String(\"z\"), String(\"escape\"): String(\"test\")})])})})])",
  )
}

