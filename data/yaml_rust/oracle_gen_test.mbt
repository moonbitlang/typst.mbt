test "yaml_rust/spec/ex6_10" {
  assert_eq(load_dump("  # Comment\n   \n\n"), "Ok([])")
}

///|
test "yaml_rust/spec/ex6_11" {
  assert_eq(
    load_dump("key:    # Comment\n        # lines\n  value\n\n"),
    "Ok([Hash({String(\"key\"): String(\"value\")})])",
  )
}

///|
