    load_dump("strip: |-\n  text\nclip: |\n  text\nkeep: |+\n  text\n"),
    "Ok([Hash({String(\"strip\"): String(\"text\"), String(\"clip\"): String(\"text\\n\"), String(\"keep\"): String(\"text\\n\")})])",
  )
}

