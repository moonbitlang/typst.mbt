///|
test "yaml_rust/assets/syntaxes_SExpressions_sublime-syntax" {
  assert_eq(
    load_dump(
      "%YAML 1.2\n---\nname: S Expressions\nfile_extensions: [\"sexp\"]\nscope: source.sexpr\n\ncontexts:\n  main:\n    - match: '(;+).*$'\n      scope: comment.line.sexpr\n      captures:\n        1: punctuation.definition.comment.sexpr\n    - match: '#;'\n      scope: punctuation.definition.comment.sexpr\n      push: comment\n    - match: '#\\|'\n      scope: punctuation.definition.comment.sexpr\n      push: block_comment\n\n    - match: '\"'\n      scope: punctuation.definition.string.begin.sexpr\n      push: string_unquote\n    - match: '\\d+\\.\\d+'\n      scope: constant.numeric.float.sexpr\n    - match: '\\d+'\n      scope: constant.numeric.integer.sexpr\n    - match: '\\w+'\n      scope: constant.other.sexpr\n    - match: '\\('\n      scope: punctuation.section.parens.begin.sexpr\n      push: main_rparen\n    - match: '\\)'\n      scope: invalid.illegal.stray-paren-end\n\n  string_unquote:\n    - meta_scope: string.quoted.double.sexpr\n    - match: '\"\"'\n      scope: constant.character.escape.sexpr\n    - match: '\"'\n      scope: punctuation.definition.string.end.sexpr\n      pop: true\n\n  main_rparen:\n    - match: '\\)'\n      scope: punctuation.section.parens.end.sexpr\n      pop: true\n    - include: main\n\n  comment:\n    - meta_scope: comment.block.sexpr\n    - match: '\\('\n      set: comment_rparen\n\n  comment_lparen:\n    - meta_scope: comment.block.sexpr\n    - match: '\\('\n      push: comment_rparen\n    - match: '\\)'\n      scope: invalid.illegal.stray-paren-end\n\n  comment_rparen:\n    - meta_scope: comment.block.sexpr\n    - match: '\\)'\n      pop: true\n    - include: comment\n\n  block_comment:\n    - meta_scope: comment.block.sexpr\n    - match: '#\\|'\n      push: block_comment\n    - match: '\\|#'\n      scope: punctuation.definition.comment.sexpr\n      pop: true\n",
    ),
    "Ok([Hash({String(\"name\"): String(\"S Expressions\"), String(\"file_extensions\"): Array([String(\"sexp\")]), String(\"scope\"): String(\"source.sexpr\"), String(\"contexts\"): Hash({String(\"main\"): Array([Hash({String(\"match\"): String(\"(;+).*$\"), String(\"scope\"): String(\"comment.line.sexpr\"), String(\"captures\"): Hash({Integer(1): String(\"punctuation.definition.comment.sexpr\")})}), Hash({String(\"match\"): String(\"#;\"), String(\"scope\"): String(\"punctuation.definition.comment.sexpr\"), String(\"push\"): String(\"comment\")}), Hash({String(\"match\"): String(\"#\\\\|\"), String(\"scope\"): String(\"punctuation.definition.comment.sexpr\"), String(\"push\"): String(\"block_comment\")}), Hash({String(\"match\"): String(\"\\\"\"), String(\"scope\"): String(\"punctuation.definition.string.begin.sexpr\"), String(\"push\"): String(\"string_unquote\")}), Hash({String(\"match\"): String(\"\\\\d+\\\\.\\\\d+\"), String(\"scope\"): String(\"constant.numeric.float.sexpr\")}), Hash({String(\"match\"): String(\"\\\\d+\"), String(\"scope\"): String(\"constant.numeric.integer.sexpr\")}), Hash({String(\"match\"): String(\"\\\\w+\"), String(\"scope\"): String(\"constant.other.sexpr\")}), Hash({String(\"match\"): String(\"\\\\(\"), String(\"scope\"): String(\"punctuation.section.parens.begin.sexpr\"), String(\"push\"): String(\"main_rparen\")}), Hash({String(\"match\"): String(\"\\\\)\"), String(\"scope\"): String(\"invalid.illegal.stray-paren-end\")})]), String(\"string_unquote\"): Array([Hash({String(\"meta_scope\"): String(\"string.quoted.double.sexpr\")}), Hash({String(\"match\"): String(\"\\\"\\\"\"), String(\"scope\"): String(\"constant.character.escape.sexpr\")}), Hash({String(\"match\"): String(\"\\\"\"), String(\"scope\"): String(\"punctuation.definition.string.end.sexpr\"), String(\"pop\"): Boolean(true)})]), String(\"main_rparen\"): Array([Hash({String(\"match\"): String(\"\\\\)\"), String(\"scope\"): String(\"punctuation.section.parens.end.sexpr\"), String(\"pop\"): Boolean(true)}), Hash({String(\"include\"): String(\"main\")})]), String(\"comment\"): Array([Hash({String(\"meta_scope\"): String(\"comment.block.sexpr\")}), Hash({String(\"match\"): String(\"\\\\(\"), String(\"set\"): String(\"comment_rparen\")})]), String(\"comment_lparen\"): Array([Hash({String(\"meta_scope\"): String(\"comment.block.sexpr\")}), Hash({String(\"match\"): String(\"\\\\(\"), String(\"push\"): String(\"comment_rparen\")}), Hash({String(\"match\"): String(\"\\\\)\"), String(\"scope\"): String(\"invalid.illegal.stray-paren-end\")})]), String(\"comment_rparen\"): Array([Hash({String(\"meta_scope\"): String(\"comment.block.sexpr\")}), Hash({String(\"match\"): String(\"\\\\)\"), String(\"pop\"): Boolean(true)}), Hash({String(\"include\"): String(\"comment\")})]), String(\"block_comment\"): Array([Hash({String(\"meta_scope\"): String(\"comment.block.sexpr\")}), Hash({String(\"match\"): String(\"#\\\\|\"), String(\"push\"): String(\"block_comment\")}), Hash({String(\"match\"): String(\"\\\\|#\"), String(\"scope\"): String(\"punctuation.definition.comment.sexpr\"), String(\"pop\"): Boolean(true)})])})})])",
  )
}

