    "err:mapping values are not allowed in this context at line 2 column 2 at 2:2",
  )
}

///|
test "parse simple_key_too_long" {
  assert_eq(
    show_parse(
      b": v",
    ),
    "err:mapping values are not allowed in this context at line 1 column 1101 at 1:1101",
  )
}

///|
test "parse simple_key_1024" {
  assert_eq(
    show_parse(
      b": v",
    ),
    "ok:{\"\": \"v\"}",
  )
}

///|
test "parse simple_key_required" {
