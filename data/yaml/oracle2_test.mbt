// Generated by the differential harness from the upstream Typst oracle.

///|
test "parse alias_basic" {
  assert_eq(show_parse(b"a: &x 1\x0ab: *x\x0a"), "ok:{\"a\": 1, \"b\": 1}")
}

///|
test "parse alias_map" {
  assert_eq(
    show_parse(b"a: &m {k: v}\x0ab: *m\x0a"),
    "ok:{\"a\": {\"k\": \"v\"}, \"b\": {\"k\": \"v\"}}",
  )
}

///|
test "parse alias_seq" {
  assert_eq(show_parse(b"- &s [1, 2]\x0a- *s\x0a"), "ok:[[1, 2], [1, 2]]")
}

///|
test "parse alias_redefined" {
  assert_eq(show_parse(b"- &a 1\x0a- &a 2\x0a- *a\x0a"), "ok:[1, 2, 2]")
}

///|
test "parse alias_id_reuse" {
  assert_eq(
    show_parse(b"- &a 1\x0a- &a 2\x0a- &b 3\x0a- *a\x0a- *b\x0a"),
    "ok:[1, 2, 3, 3, 3]",
  )
}

///|
test "parse alias_unknown" {
  assert_eq(show_parse(b"- *x"), "err:unknown anchor at line 1 column 3 at 1:3")
}

///|
test "parse alias_unknown_later" {
  assert_eq(
    show_parse(b"a: 1\x0ab: [1, *nope]"),
    "err:unknown anchor at line 2 column 8 at 2:8",
  )
}

///|
test "parse alias_key" {
  assert_eq(show_parse(b"&k a: 1\x0a*k : 2\x0a"), "ok:{\"a\": 2}")
}

///|
test "parse alias_key_seq" {
  assert_eq(
    show_parse(b"- &k [1]\x0a- {*k : 2}\x0a"),
    "err:.[1]: invalid type: sequence, expected a string at line 1 column 3 at 1:3",
  )
}

///|
test "parse alias_recursive" {
  assert_eq(show_parse(b"&a [*a]"), "err:recursion limit exceeded at 1:1")
}

///|
test "parse alias_recursive_map" {
  assert_eq(show_parse(b"&a {k: *a}"), "err:recursion limit exceeded at 1:1")
}

///|
test "parse alias_value_error" {
  assert_eq(
    show_parse(b"a: &t !foo x\x0ab: *t\x0a"),
    "err:a: invalid type: enum, expected a Typst value at line 1 column 4 at 1:4",
  )
}

///|
test "parse alias_in_key_path" {
  assert_eq(
    show_parse(b"x:\x0a  &a k: !foo v\x0a"),
    "err:x.k: invalid type: enum, expected a Typst value at line 2 column 9 at 2:9",
  )
}

///|
test "parse anchor_empty" {
  assert_eq(
    show_parse(b"& a"),
    "err:did not find expected alphabetic or numeric character at line 1 column 2, while scanning an anchor at 1:2",
  )
}

///|
test "parse alias_empty" {
  assert_eq(
    show_parse(b"* a"),
    "err:did not find expected alphabetic or numeric character at line 1 column 2, while scanning an alias at 1:2",
  )
}

///|
test "parse anchor_bad_char" {
  assert_eq(
    show_parse(b"&a. x"),
    "err:did not find expected alphabetic or numeric character at line 1 column 3, while scanning an anchor at 1:3",
  )
}

///|
test "parse anchor_then_tag" {
  assert_eq(show_parse(b"&a !!str 1"), "ok:\"1\"")
}

///|
test "parse tag_then_anchor" {
  assert_eq(show_parse(b"!!str &a 1"), "ok:\"1\"")
}

///|
test "parse anchor_only" {
  assert_eq(show_parse(b"&a"), "ok:none")
}

///|
test "parse anchor_only_in_seq" {
  assert_eq(show_parse(b"- &a\x0a- *a"), "ok:[none, none]")
}

///|
test "parse billion_laughs" {
  assert_eq(
    show_parse(
      b"a: &a [x, x, x, x, x, x, x, x, x]\x0ab: &b [*a, *a, *a, *a, *a, *a, *a, *a, *a]\x0ac: &c [*b, *b, *b, *b, *b, *b, *b, *b, *b]\x0ad: &d [*c, *c, *c, *c, *c, *c, *c, *c, *c]\x0ae: &e [*d, *d, *d, *d, *d, *d, *d, *d, *d]\x0a",
    ),
    "err:repetition limit exceeded",
  )
}

///|
test "parse tag_str" {
  assert_eq(
    show_parse(b"[!!str 1, !!str true, !!str ~, !!str, !!str '']"),
    "ok:[\"1\", \"true\", \"~\", \"\", \"\"]",
  )
}

///|
test "parse tag_int" {
  assert_eq(
    show_parse(b"[!!int 1, !!int 0x10, !!int '12', !!int \"-3\"]"),
    "ok:[1, 16, 12, -3]",
  )
}

///|
test "parse tag_int_bad" {
  assert_eq(
    show_parse(b"!!int 1.5"),
    "err:invalid value: string \"1.5\", expected an integer at 1:1",
  )
}

///|
test "parse tag_float" {
  assert_eq(
    show_parse(b"[!!float 1, !!float 1.5, !!float .inf, !!float '2']"),
    "ok:[f1.0, f1.5, ffloat.inf, f2.0]",
  )
}

///|
test "parse tag_float_bad" {
  assert_eq(
    show_parse(b"!!float abc"),
    "err:invalid value: string \"abc\", expected a float at 1:1",
  )
}

///|
test "parse tag_bool" {
  assert_eq(show_parse(b"[!!bool true, !!bool False]"), "ok:[true, false]")
}

///|
test "parse tag_bool_bad" {
  assert_eq(
    show_parse(b"!!bool yes"),
    "err:invalid value: string \"yes\", expected a boolean at 1:1",
  )
}

///|
test "parse tag_null" {
  assert_eq(show_parse(b"[!!null null, !!null ~]"), "ok:[none, none]")
}

///|
test "parse tag_null_empty" {
  assert_eq(
    show_parse(b"!!null"),
    "err:invalid value: string \"\", expected null at 1:1",
  )
}

///|
test "parse tag_null_bad" {
  assert_eq(
    show_parse(b"!!null x"),
    "err:invalid value: string \"x\", expected null at 1:1",
  )
}

///|
test "parse tag_null_quoted" {
  assert_eq(
    show_parse(b"!!null ''"),
    "err:invalid value: string \"\", expected null at 1:1",
  )
}

///|
test "parse tag_custom_scalar" {
  assert_eq(
    show_parse(b"!foo bar"),
    "err:invalid type: enum, expected a Typst value at 1:1",
  )
}

///|
test "parse tag_custom_seq" {
  assert_eq(
    show_parse(b"!foo [1]"),
    "err:invalid type: enum, expected a Typst value at 1:1",
  )
}

///|
test "parse tag_custom_map" {
  assert_eq(
    show_parse(b"!foo {a: 1}"),
    "err:invalid type: enum, expected a Typst value at 1:1",
