  assert_eq(show_parse(b"a: 1\x0a...\x0a"), "ok:{\"a\": 1}")
}

///|
test "parse doc_end_twice" {
  assert_eq(show_parse(b"a: 1\x0a...\x0a...\x0a"), "ok:{\"a\": 1}")
}

///|
test "parse doc_empty_explicit" {
  assert_eq(show_parse(b"---\x0a"), "ok:none")
}

///|
test "parse doc_empty_explicit_end" {
  assert_eq(show_parse(b"---\x0a...\x0a"), "ok:none")
}

///|
test "parse doc_only_end" {
  assert_eq(
    show_parse(b"...\x0a"),
    "err:did not find expected node content, while parsing a block node at 1:1",
  )
}

///|
test "parse doc_two" {
  assert_eq(
    show_parse(b"a\x0a---\x0ab"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

