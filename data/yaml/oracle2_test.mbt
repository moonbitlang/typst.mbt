  )
}

///|
test "parse map_then_seq" {
  assert_eq(
    show_parse(b"a: 1\x0a- b"),
    "err:did not find expected key at line 2 column 1, while parsing a block mapping at 2:1",
  )
}

///|
test "parse bad_indent" {
  assert_eq(
    show_parse(b"a:\x0a  b: 1\x0a c: 2"),
    "err:did not find expected key at line 3 column 2, while parsing a block mapping at 3:2",
  )
}

///|
test "parse bad_indent_seq" {
