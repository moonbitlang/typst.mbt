    show_parse(b"a\x0ab: c"),
    "err:mapping values are not allowed in this context at line 2 column 2 at 2:2",
  )
}

///|
test "parse block_entries_not_allowed" {
  assert_eq(
    show_parse(b"a: - b"),
    "err:block sequence entries are not allowed in this context at line 1 column 4 at 1:4",
  )
}

