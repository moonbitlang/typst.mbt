  )
}

///|
test "parse at_sign" {
  assert_eq(
    show_parse(b"@foo"),
    "err:found character that cannot start any token, while scanning for the next token at 1:1",
  )
}

///|
test "parse backtick" {
  assert_eq(
    show_parse(b"`foo"),
    "err:found character that cannot start any token, while scanning for the next token at 1:1",
  )
}

///|
test "parse percent_plain" {
  assert_eq(show_parse(b"a %b"), "ok:\"a %b\"")
}

///|
test "parse plain_colon_flow_err" {
  assert_eq(
    show_parse(b"[a:, b]"),
    "err:found unexpected ':' at line 1 column 3, while scanning a plain scalar at line 1 column 2 at 1:3",
  )
}

///|
test "parse plain_colon_flow_err2" {
  assert_eq(
    show_parse(b"{a:[b]}"),
    "err:found unexpected ':' at line 1 column 3, while scanning a plain scalar at line 1 column 2 at 1:3",
  )
}

///|
test "parse flow_question" {
  assert_eq(show_parse(b"[? x]"), "ok:[{\"x\": none}]")
}

///|
test "parse flow_key_value" {
  assert_eq(show_parse(b"{? : x}"), "ok:{\"\": \"x\"}")
}

///|
test "parse question_plain" {
  assert_eq(show_parse(b"?x"), "ok:\"?x\"")
}

///|
test "parse question_block" {
  assert_eq(show_parse(b"? x"), "ok:{\"x\": none}")
}

///|
test "parse colon_start" {
  assert_eq(show_parse(b":x"), "ok:\":x\"")
}

///|
test "parse dash_start" {
  assert_eq(show_parse(b"-x"), "ok:\"-x\"")
}

///|
test "parse dash_dash" {
  assert_eq(show_parse(b"--x"), "ok:\"--x\"")
}

///|
test "parse comment_after_value_no_space" {
  assert_eq(show_parse(b"a: 'b'#c"), "ok:{\"a\": \"b\"}")
}

///|
test "parse quoted_then_junk" {
  assert_eq(
    show_parse(b"'a' b"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse quoted_key_then_colon" {
  assert_eq(show_parse(b"'a' : b"), "ok:{\"a\": \"b\"}")
}

///|
test "parse seq_entry_after_quoted" {
  assert_eq(show_parse(b"- 'a'\x0a- \"b\"\x0a"), "ok:[\"a\", \"b\"]")
}

///|
test "parse tab_after_dash" {
  assert_eq(
    show_parse(b"-\x09a"),
    "err:found character that cannot start any token at line 1 column 2, while scanning for the next token at 1:2",
  )
}

///|
test "parse tab_separation_map" {
  assert_eq(show_parse(b"a:\x091\x0ab:\x09\x092"), "ok:{\"a\": 1, \"b\": 2}")
}

///|
test "parse deep_flow" {
  assert_eq(
    show_parse(
      b"[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]",
    ),
    "err:recursion limit exceeded at line 1 column 129 at 1:129",
  )
}

///|
test "parse deep_map_flow" {
  assert_eq(
    show_parse(
      b"{a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: {a: x}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}",
    ),
    "err:recursion limit exceeded at line 1 column 513 at 1:513",
  )
}

///|
test "parse deep_mixed" {
  assert_eq(
    show_parse(b"a:\x0a- b\x0a  - b\x0a    - b\x0a"),
    "ok:{\"a\": [\"b - b - b\"]}",
  )
}

///|
test "parse invalid_leading" {
  assert_eq(
    show_parse(b"abc: \xff"),
    "err:invalid leading UTF-8 octet at position 5 at 1:1",
  )
}

///|
test "parse invalid_leading_first" {
  assert_eq(show_parse(b"\xff"), "err:invalid leading UTF-8 octet at 1:1")
}

///|
test "parse incomplete" {
  assert_eq(
    show_parse(b"abc: \xc3"),
    "err:incomplete UTF-8 octet sequence at position 5 at 1:1",
  )
}

///|
test "parse invalid_trailing" {
  assert_eq(
    show_parse(b"abc: \xc3("),
    "err:invalid trailing UTF-8 octet at position 6 at 1:1",
  )
}

///|
test "parse overlong" {
  assert_eq(
    show_parse(b"a: \xc0\xaf"),
    "err:invalid length of a UTF-8 sequence at position 3 at 1:1",
  )
}

///|
test "parse overlong3" {
  assert_eq(
    show_parse(b"a: \xe0\x80\xaf"),
    "err:invalid length of a UTF-8 sequence at position 3 at 1:1",
  )
}

///|
test "parse surrogate" {
  assert_eq(
    show_parse(b"a: \xed\xa0\x80"),
    "err:invalid Unicode character at position 3 at 1:1",
  )
}

///|
test "parse too_big" {
  assert_eq(
    show_parse(b"a: \xf4\x90\x80\x80"),
    "err:invalid Unicode character at position 3 at 1:1",
  )
}

///|
test "parse five_byte" {
  assert_eq(
    show_parse(b"a: \xf8\x88\x80\x80\x80"),
    "err:invalid leading UTF-8 octet at position 3 at 1:1",
  )
}

///|
test "parse control" {
  assert_eq(
    show_parse(b"a: \x01"),
    "err:control characters are not allowed at position 3 at 1:1",
  )
}

///|
test "parse control_nul" {
  assert_eq(
    show_parse(b"a: \x00"),
    "err:control characters are not allowed at position 3 at 1:1",
  )
}

///|
test "parse control_del" {
  assert_eq(
    show_parse(b"a: \x7f"),
    "err:control characters are not allowed at position 3 at 1:1",
  )
}

///|
test "parse control_c1" {
  assert_eq(
    show_parse(b"a: \xc2\x80"),
    "err:control characters are not allowed at position 3 at 1:1",
  )
}

///|
test "parse nel_allowed" {
  assert_eq(show_parse(b"a: \xc2\x85"), "ok:{\"a\": none}")
}

///|
test "parse fffe" {
  assert_eq(
    show_parse(b"a: \xef\xbf\xbe"),
    "err:control characters are not allowed at position 3 at 1:1",
  )
}

///|
test "parse fffd" {
  assert_eq(show_parse(b"a: \xef\xbf\xbd"), "ok:{\"a\": \"\u{fffd}\"}")
}

///|
test "parse private_use" {
  assert_eq(show_parse(b"a: \xee\x80\x80"), "ok:{\"a\": \"\\u{e000}\"}")
}

///|
test "parse chunk_reader_error_first" {
  assert_eq(
    show_parse(b"- y\x0a- !foo x\x0a\xff"),
    "err:invalid leading UTF-8 octet at position 13 at 1:1",
  )
}
