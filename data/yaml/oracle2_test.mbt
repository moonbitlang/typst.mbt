}

///|
test "parse tag_custom_in_map" {
  assert_eq(
    show_parse(b"a:\x0a  b: !foo x"),
    "err:a.b: invalid type: enum, expected a Typst value at line 2 column 6 at 2:6",
  )
}

///|
test "parse tag_nonspecific" {
  assert_eq(
    show_parse(b"! a"),
    "err:invalid type: enum, expected a Typst value at 1:1",
  )
}

///|
test "parse tag_nonspecific_quoted" {
  assert_eq(
    show_parse(b"! 'a'"),
    "err:invalid type: enum, expected a Typst value at 1:1",
  )
}

///|
test "parse tag_verbatim" {
  assert_eq(show_parse(b"!<tag:yaml.org,2002:int> 5"), "ok:5")
}

///|
test "parse tag_verbatim_local" {
  assert_eq(
    show_parse(b"!<!foo> 5"),
    "err:invalid type: enum, expected a Typst value at 1:1",
  )
}

///|
test "parse tag_verbatim_unterminated" {
  assert_eq(
    show_parse(b"!<foo 5"),
    "err:did not find the expected '>' at line 1 column 6, while scanning a tag at 1:6",
  )
}

///|
test "parse tag_verbatim_empty" {
  assert_eq(
    show_parse(b"!<> 5"),
    "err:did not find expected tag URI at line 1 column 3, while parsing a tag at 1:3",
  )
}

///|
test "parse tag_secondary_other" {
  assert_eq(show_parse(b"!!binary aGk="), "ok:\"aGk=\"")
}

///|
test "parse tag_named_handle_undefined" {
  assert_eq(
    show_parse(b"!e!foo bar"),
    "err:found undefined tag handle, while parsing a node at 1:1",
  )
}

///|
test "parse tag_directive" {
  assert_eq(
    show_parse(b"%TAG !e! tag:yaml.org,2002:\x0a---\x0a!e!int 7"),
    "ok:7",
  )
}

///|
test "parse tag_directive_local" {
  assert_eq(
    show_parse(b"%TAG !e! !my-\x0a---\x0a!e!int 7"),
    "err:invalid type: enum, expected a Typst value at line 3 column 1 at 3:1",
  )
}

///|
test "parse tag_directive_dup" {
  assert_eq(
    show_parse(b"%TAG !e! a\x0a%TAG !e! b\x0a---\x0ax"),
    "err:found duplicate %TAG directive at line 2 column 1 at 2:1",
  )
}

///|
test "parse tag_directive_override" {
  assert_eq(show_parse(b"%TAG ! tag:yaml.org,2002:\x0a---\x0a!int 7"), "ok:7")
}

///|
test "parse tag_directive_bad_handle" {
  assert_eq(
    show_parse(b"%TAG e! a\x0a---\x0ax"),
