///|
test "encode rand194" {
  assert_eq(
    show_encode(
      Map([
        (":-\u{feff}%", Str("?~+\u{2028}")),
        ("3...\\ |+", Str("a")),
        (
          "*[",
          Map([
            ("\u{a}\u{a}0\u{feff}  ", Str("@")),
            (
              "]",
              Seq([
                Map([("", Str("\u{2028}\u{e9}"))]),
                Seq([]),
                Map([
                  ("7[\u{85}\"", Str("-\u{d}")),
                  ("6\u{1}\u{d}069\u{1}", Str("67,\u{0}")),
                ]),
              ]),
            ),
            (
              "\u{85}\u{a}]\u{85}e.---1",
              Map([("!2-", Int(-452L)), ("+\u{1}\u{2028}", Str(".\u{2028},"))]),
            ),
          ]),
        ),
      ]),
    ),
    "ok:\":-\\uFEFF%\": '?~+\u{2028}  '\n3...\\ |+: a\n'*[':\n  ? \"\\n\\n0\\uFEFF  \"\n  : '@'\n  ']':\n  - '': '\u{2028}      \u{e9}'\n  - []\n  - ? \"7[\\N\\\"\"\n    : \"-\\r\"\n    ? \"6\\x01\\r069\\x01\"\n    : \"67,\\0\"\n  ? \"\\N\\n]\\Ne.---1\"\n  : '!2-': -452\n    ? \"+\\x01\\L\"\n    : '.\u{2028}      ,'\n",
  )
}

