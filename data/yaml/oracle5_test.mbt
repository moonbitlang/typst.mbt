///|
test "encode rand204" {
  assert_eq(
    show_encode(
      Seq([
        Seq([Seq([Bool(true)]), Str(".\u{85},"), Str("'05b")]),
        Map([
          ("'\u{1}27}*\\\\", Str("+\u{a}%\"~']#")),
          (
            "\u{a}%\"`e7",
            Seq([
              Seq([None, Str("}}\"%&"), Bool(true)]),
              Str("8\u{feff}\u{a}2\u{e9}"),
            ]),
          ),
          (
            "-\u{a}",
            Seq([
              Str("!,,6\u{a}\u{0}*\u{1}"),
              Seq([Str("5"), Str("'9,[b"), Bool(true)]),
              Map([("+", None)]),
            ]),
          ),
        ]),
      ]),
    ),
    "ok:- - - true\n  - \".\\N,\"\n  - '''05b'\n- \"'\\x0127}*\\\\\\\\\": |-\n    +\n    %\"~']#\n  ? |2-\n\n    %\"`e7\n  : - - null\n      - '}}\"%&'\n      - true\n    - \"8\\uFEFF\\n2\u{e9}\"\n  ? |\n    -\n  : - \"!,,6\\n\\0*\\x01\"\n    - - '5'\n      - '''9,[b'\n      - true\n    - +: null\n",
  )
}

