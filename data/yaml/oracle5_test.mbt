          (
            "\u{9}[\u{9}~]",
            Map([
              ("3*]%\u{9}", Str("\u{a}~...")),
              ("---`1&>.\u{9}!", Str("\u{0}&")),
            ]),
          ),
          ("*[\u{0}a#6\u{a}", Bool(false)),
        ]),
        Map([
          (
            "@!2\u{a}{",
            Seq([Seq([]), Map([("\u{a}e~?*\u{a}", Str(""))]), Seq([])]),
          ),
          ("~}'8", Str("")),
        ]),
        Str("[%1\u{d}"),
      ]),
    ),
    "ok:- '*': \"\\n[\\r\\nE\"\n  \"\\t[\\t~]\":\n    \"3*]%\\t\": |2-\n\n      ~...\n    \"---`1&>.\\t!\": \"\\0&\"\n  ? \"*[\\0a#6\\n\"\n  : false\n- ? |-\n    @!2\n    {\n  : - []\n    - ? |2\n\n        e~?*\n      : ''\n    - []\n  ~}'8: ''\n- \"[%1\\r\"\n",
  )
}

