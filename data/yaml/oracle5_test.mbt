///|
test "encode rand000" {
  assert_eq(
    show_encode(
      Map([
        (
          "|&...",
          Map([
            (
              "E\u{a}|{E\u{a}\u{d}",
              Seq([Bool(true), Map([("0#`@[:E\u{a0}", Str("&?:"))])]),
            ),
            ("\u{85}E4", Seq([])),
          ]),
        ),
        ("---", Map([(":,+5...", Int(101L))])),
      ]),
    ),
    "ok:'|&...':\n  ? \"E\\n|{E\\n\\r\"\n  : - true\n    - 0#`@[:E\u{a0}: '&?:'\n  ? \"\\NE4\"\n  : []\n'---':\n  :,+5...: 101\n",
  )
}

