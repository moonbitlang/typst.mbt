///|
test "encode rand202" {
  assert_eq(
    show_encode(
      Map([
        (
          "\u{a0}9\u{e9}#7|+\u{1}",
          Seq([
            Map([
              (
                "",
                Map([
                  ("`\"", Bool(false)),
                  ("\u{feff}7\u{feff}%\u{d}@&", None),
                  ("b|5!?", None),
                ]),
              ),
              ("...~50  ", Str("\u{1}\u{a0}>-\u{0}|0")),
            ]),
            Map([]),
            Str("\u{85} 7}3\u{a0}"),
          ]),
        ),
        ("77\"~a", Seq([])),
        ("{e\u{a}>[---", Seq([])),
      ]),
    ),
    "ok:\"\u{a0}9\u{e9}#7|+\\x01\":\n- '':\n    '`\"': false\n    ? \"\\uFEFF7\\uFEFF%\\r@&\"\n    : null\n    b|5!?: null\n  '...~50  ': \"\\x01\u{a0}>-\\0|0\"\n- {}\n- \"\\N 7}3\u{a0}\"\n77\"~a: []\n? |-\n  {e\n  >[---\n: []\n",
  )
}

