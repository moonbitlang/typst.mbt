// Generated by the differential harness from the upstream Typst oracle.

///|
test "parse empty" {
  assert_eq(show_parse(b""), "ok:none")
}

///|
test "parse only_comment" {
  assert_eq(show_parse(b"# hello\x0a"), "ok:none")
}

///|
test "parse only_ws" {
  assert_eq(show_parse(b"   \x0a\x0a  "), "ok:none")
}

///|
test "parse null_words" {
  assert_eq(
    show_parse(b"[null, Null, NULL, ~, nULL, '', \"\", nul]"),
    "ok:[none, none, none, none, \"nULL\", \"\", \"\", \"nul\"]",
  )
}

///|
test "parse bools" {
  assert_eq(
    show_parse(
      b"[true, True, TRUE, false, False, FALSE, tRue, yes, no, on, off, y, n]",
    ),
    "ok:[true, true, true, false, false, false, \"tRue\", \"yes\", \"no\", \"on\", \"off\", \"y\", \"n\"]",
  )
}

///|
test "parse ints_basic" {
  assert_eq(
    show_parse(b"[0, 1, -1, +1, 42, -0, +0, 007, -007, +007, 00, 0_1, 1_000]"),
    "ok:[0, 1, -1, 1, 42, 0, 0, \"007\", \"-007\", \"+007\", \"00\", \"0_1\", \"1_000\"]",
  )
}

///|
test "parse ints_hex" {
  assert_eq(
    show_parse(
      b"[0x1F, 0X1F, 0x1f, +0x1F, -0x1F, 0x, 0x+1, 0x-1, -0x+1, -0x-1, 0xFFFFFFFFFFFFFFFF, 0x8000000000000000, -0x8000000000000000, -0x8000000000000001]",
    ),
    "ok:[31, \"0X1F\", 31, 31, -31, \"0x\", \"0x+1\", \"0x-1\", \"-0x+1\", \"-0x-1\", f1.8446744073709552e19, f9.223372036854776e18, -9223372036854775808, f-9.223372036854776e18]",
  )
}

///|
test "parse ints_oct" {
  assert_eq(
    show_parse(b"[0o17, 0O17, +0o17, -0o17, 0o8, 0o, 0o+7, -0o-7]"),
    "ok:[15, \"0O17\", 15, -15, \"0o8\", \"0o\", \"0o+7\", \"-0o-7\"]",
  )
}

///|
test "parse ints_bin" {
  assert_eq(
    show_parse(b"[0b101, -0b101, +0b101, 0b2, 0b]"),
    "ok:[5, -5, 5, \"0b2\", \"0b\"]",
  )
}

///|
test "parse ints_big" {
  assert_eq(
    show_parse(
      b"[9223372036854775807, 9223372036854775808, -9223372036854775808, -9223372036854775809, 18446744073709551615, 18446744073709551616, 340282366920938463463374607431768211455, 340282366920938463463374607431768211456, -170141183460469231731687303715884105728, -170141183460469231731687303715884105729]",
    ),
    "ok:[9223372036854775807, f9.223372036854776e18, -9223372036854775808, f-9.223372036854776e18, f1.8446744073709552e19, f1.8446744073709552e19, f3.402823669209385e38, f3.402823669209385e38, f-1.7014118346046923e38, f-1.7014118346046923e38]",
  )
}

///|
test "parse ints_big_hex" {
  assert_eq(
    show_parse(
      b"[0x10000000000000000, 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF, 0x100000000000000000000000000000000, -0x10000000000000000, 0o7777777777777777777777777, 0b11111111111111111111111111111111111111111111111111111111111111111]",
    ),
    "ok:[f1.8446744073709552e19, f3.402823669209385e38, \"0x100000000000000000000000000000000\", f-1.8446744073709552e19, f3.777893186295716e22, f3.6893488147419103e19]",
  )
}

///|
test "parse ints_round" {
  assert_eq(
    show_parse(
      b"[18446744073709551617, 36893488147419103231, 36893488147419105279, 36893488147419105280, 36893488147419107327]",
    ),
    "ok:[f1.8446744073709552e19, f3.6893488147419103e19, f3.6893488147419103e19, f3.6893488147419103e19, f3.6893488147419103e19]",
  )
}

///|
test "parse floats" {
  assert_eq(
    show_parse(
      b"[1.5, -1.5, +1.5, .5, -.5, 1., 1e3, 1E3, 1e+3, 1e-3, 1.5e3, -1.5E-3, 1e, e3, ., +., 1.2.3, 1e400, -1e400, 1e-400, 0.1, 3.14159265358979323846]",
    ),
    "ok:[f1.5, f-1.5, f1.5, f0.5, f-0.5, f1.0, f1000.0, f1000.0, f1000.0, f0.001, f1500.0, f-0.0015, \"1e\", \"e3\", \".\", \"+.\", \"1.2.3\", \"1e400\", \"-1e400\", f0.0, f0.1, f3.141592653589793]",
  )
}

///|
test "parse floats_special" {
  assert_eq(
    show_parse(
      b"[.inf, .Inf, .INF, -.inf, -.Inf, -.INF, +.inf, +.Inf, .nan, .NaN, .NAN, -.nan, +.nan, .iNf, inf, -inf, nan, NaN, infinity, Infinity]",
    ),
    "ok:[ffloat.inf, ffloat.inf, ffloat.inf, f-float.inf, f-float.inf, f-float.inf, ffloat.inf, ffloat.inf, ffloat.nan, ffloat.nan, ffloat.nan, \"-.nan\", \"+.nan\", \".iNf\", \"inf\", \"-inf\", \"nan\", \"NaN\", \"infinity\", \"Infinity\"]",
  )
}

///|
test "parse floats_zero" {
  assert_eq(
    show_parse(b"[0.0, -0.0, +0.0, 00.5, 01.5, -01.5, 0e0, 00e0, 0., 1_0.5]"),
    "ok:[f0.0, f-0.0, f0.0, f0.5, f1.5, f-1.5, f0.0, f0.0, f0.0, \"1_0.5\"]",
  )
}

///|
test "parse floats_plus" {
  assert_eq(
    show_parse(b"[+-1, -+1, ++1, --1, +-.5]"),
    "ok:[\"+-1\", \"-+1\", \"++1\", \"--1\", \"+-.5\"]",
  )
}

///|
test "parse plain_strings" {
  assert_eq(
    show_parse(
      b"[hello world, a b  c, 'single', \"double\", x:y, -a, ?a, a?b, a#b, a #b]",
    ),
    "err:did not find expected ',' or ']' at line 2 column 1, while parsing a flow sequence at 2:1",
  )
}

///|
test "parse plain_multiline" {
  assert_eq(show_parse(b"a\x0a  b\x0a\x0a  c\x0a"), "ok:\"a b\\nc\"")
}

///|
test "parse plain_multiline_key" {
  assert_eq(show_parse(b"k: a\x0a  b\x0a  c\x0a"), "ok:{\"k\": \"a b c\"}")
}

///|
test "parse plain_colon_flow" {
  assert_eq(
    show_parse(b"[a:b, a: b, http://x]"),
    "ok:[\"a:b\", {\"a\": \"b\"}, \"http://x\"]",
  )
}

///|
test "parse single_quoted" {
  assert_eq(show_parse(b"'it''s' "), "ok:\"it's\"")
}

///|
test "parse single_multiline" {
  assert_eq(show_parse(b"'a\x0a  b\x0a\x0a  c\x0a  d '"), "ok:\"a b\\nc d \"")
}

///|
test "parse double_escapes" {
  assert_eq(
    show_parse(
      b"\"\\0\\a\\b\\t\\\x09\\n\\v\\f\\r\\e\\ \\\"\\/\\\\\\N\\_\\L\\P\"",
    ),
    "ok:\"\\u{0}\\u{7}\\u{8}\\t\\t\\n\\u{b}\\u{c}\\r\\u{1b} \\\"/\\\\\\u{85}\\u{a0}\\u{2028}\\u{2029}\"",
  )
}

///|
test "parse double_hex" {
  assert_eq(
    show_parse(b"\"\\x41\\u00e9\\u263A\\U0001F600\\xff\""),
    "ok:\"A\u{e9}\u{263a}\u{1f600}\u{ff}\"",
  )
}

///|
test "parse double_line_cont" {
  assert_eq(show_parse(b"\"a\\\x0a  b\\\x0a\x0a  c\""), "ok:\"ab\\nc\"")
}

///|
test "parse double_multiline" {
  assert_eq(
    show_parse(b"\"a\x0a  b\x0a\x0a\x0a  c  \x0a  d\""),
    "ok:\"a b\\n\\nc d\"",
  )
}

///|
test "parse double_unknown_escape" {
  assert_eq(
    show_parse(b"\"\\q\""),
    "err:found unknown escape character at line 1 column 2, while parsing a quoted scalar at 1:2",
  )
}

///|
test "parse double_bad_hex" {
  assert_eq(
    show_parse(b"\"\\x4g\""),
    "err:did not find expected hexadecimal number at line 1 column 4, while parsing a quoted scalar at 1:4",
  )
}

///|
test "parse double_surrogate" {
  assert_eq(
    show_parse(b"\"\\uD800\""),
    "err:found invalid Unicode character escape code at line 1 column 4, while parsing a quoted scalar at 1:4",
  )
}

///|
test "parse double_too_big" {
  assert_eq(
    show_parse(b"\"\\U00110000\""),
    "err:found invalid Unicode character escape code at line 1 column 4, while parsing a quoted scalar at 1:4",
  )
}

///|
test "parse double_huge" {
  assert_eq(
    show_parse(b"\"\\UFFFFFFFF\""),
    "err:found invalid Unicode character escape code at line 1 column 4, while parsing a quoted scalar at 1:4",
  )
}

///|
test "parse unterminated_double" {
  assert_eq(
    show_parse(b"\"abc"),
    "err:found unexpected end of stream at line 1 column 5, while scanning a quoted scalar at 1:5",
  )
}

///|
test "parse unterminated_single" {
  assert_eq(
    show_parse(b"'abc\x0a"),
    "err:found unexpected end of stream at line 2 column 1, while scanning a quoted scalar at 2:1",
  )
}

///|
test "parse quoted_doc_indicator" {
  assert_eq(
    show_parse(b"'a\x0a--- b'"),
    "err:found unexpected document indicator at line 2 column 1, while scanning a quoted scalar at 2:1",
  )
}

///|
test "parse quoted_doc_end_indicator" {
  assert_eq(
    show_parse(b"\"a\x0a... b\""),
    "err:found unexpected document indicator at line 2 column 1, while scanning a quoted scalar at 2:1",
  )
}

///|
test "parse utf8_strings" {
  assert_eq(
    show_parse(
      b"[\xc3\xa9t\xc3\xa9, \xe4\xb8\xad\xe6\x96\x87, \xf0\x9f\x98\x80, '\xc3\xa9']",
    ),
    "ok:[\"\u{e9}t\u{e9}\", \"\u{4e2d}\u{6587}\", \"\u{1f600}\", \"\u{e9}\"]",
  )
}

///|
test "parse nel_ls_ps" {
  assert_eq(
    show_parse(b"a\xc2\x85b\xe2\x80\xa8c\xe2\x80\xa9d"),
    "ok:\"a b\\u{2028}c\\u{2029}d\"",
  )
}

///|
test "parse crlf" {
  assert_eq(show_parse(b"a: 1\x0d\x0ab: 2\x0d\x0a"), "ok:{\"a\": 1, \"b\": 2}")
}

///|
test "parse cr_only" {
  assert_eq(show_parse(b"a: 1\x0db: 2\x0d"), "ok:{\"a\": 1, \"b\": 2}")
}

///|
test "parse bom" {
  assert_eq(show_parse(b"\xef\xbb\xbfa: 1"), "ok:{\"a\": 1}")
}

///|
test "parse bom_twice" {
  assert_eq(
    show_parse(b"\xef\xbb\xbf\xef\xbb\xbfa: 1"),
    "ok:{\"\\u{feff}a\": 1}",
  )
}

///|
test "parse bom_middle" {
  assert_eq(show_parse(b"a: \xef\xbb\xbfb"), "ok:{\"a\": \"\\u{feff}b\"}")
}

///|
test "parse tab_in_value" {
  assert_eq(show_parse(b"a:\x09b"), "ok:{\"a\": \"b\"}")
}

///|
test "parse tab_indent" {
  assert_eq(
    show_parse(b"a:\x0a\x09b: c"),
    "err:found character that cannot start any token at line 2 column 1, while scanning for the next token at 2:1",
  )
}

///|
test "parse tab_plain_continuation" {
  assert_eq(show_parse(b"a\x0a\x09b"), "ok:\"a b\"")
}

///|
test "parse tab_plain_continuation2" {
  assert_eq(show_parse(b"k:\x0a  a\x0a \x09b"), "ok:{\"k\": \"a b\"}")
}

///|
test "parse literal" {
  assert_eq(show_parse(b"|\x0a  a\x0a  b\x0a"), "ok:\"a\\nb\\n\"")
}

///|
test "parse literal_strip" {
  assert_eq(show_parse(b"|-\x0a  a\x0a  b\x0a\x0a"), "ok:\"a\\nb\"")
}

///|
test "parse literal_keep" {
  assert_eq(show_parse(b"|+\x0a  a\x0a  b\x0a\x0a"), "ok:\"a\\nb\\n\\n\"")
}

///|
test "parse literal_clip" {
  assert_eq(show_parse(b"|\x0a  a\x0a  b\x0a\x0a\x0a"), "ok:\"a\\nb\\n\"")
}

///|
test "parse literal_indent" {
  assert_eq(show_parse(b"|2\x0a   a\x0a  b\x0a"), "ok:\" a\\nb\\n\"")
}

///|
test "parse literal_indent_chomp" {
  assert_eq(show_parse(b"|2-\x0a   a\x0a  b\x0a"), "ok:\" a\\nb\"")
}

///|
test "parse literal_chomp_indent" {
  assert_eq(show_parse(b"|-2\x0a   a\x0a  b\x0a"), "ok:\" a\\nb\"")
}

///|
test "parse literal_indent0" {
  assert_eq(
    show_parse(b"|0\x0a a\x0a"),
    "err:found an indentation indicator equal to 0 at line 1 column 2, while scanning a block scalar at 1:2",
  )
}

///|
test "parse literal_chomp_indent0" {
  assert_eq(
    show_parse(b"|-0\x0a a\x0a"),
    "err:found an indentation indicator equal to 0 at line 1 column 3, while scanning a block scalar at 1:3",
  )
}

///|
test "parse literal_comment" {
  assert_eq(show_parse(b"| # c\x0a  a\x0a"), "ok:\"a\\n\"")
}

///|
test "parse literal_junk" {
  assert_eq(
    show_parse(b"| x\x0a  a\x0a"),
    "err:did not find expected comment or line break at line 1 column 3, while scanning a block scalar at 1:3",
  )
}

///|
test "parse literal_leading_empty" {
  assert_eq(show_parse(b"|\x0a\x0a\x0a  a\x0a"), "ok:\"\\n\\na\\n\"")
}

///|
test "parse literal_more_indented" {
  assert_eq(
    show_parse(b"|\x0a  a\x0a    b\x0a  c\x0a"),
    "ok:\"a\\n  b\\nc\\n\"",
  )
}

///|
test "parse literal_tab" {
  assert_eq(
    show_parse(b"|\x0a\x09a\x0a"),
    "err:found a tab character where an indentation space is expected at line 2 column 1, while scanning a block scalar at 2:1",
  )
}

///|
test "parse literal_empty" {
  assert_eq(show_parse(b"|\x0a"), "ok:\"\"")
}

///|
test "parse literal_empty_keep" {
  assert_eq(show_parse(b"|+\x0a\x0a"), "ok:\"\\n\"")
}

///|
test "parse folded" {
  assert_eq(show_parse(b">\x0a  a\x0a  b\x0a\x0a  c\x0a"), "ok:\"a b\\nc\\n\"")
}

///|
test "parse folded_more" {
  assert_eq(
    show_parse(b">\x0a  a\x0a    b\x0a  c\x0a  d\x0a"),
    "ok:\"a\\n  b\\nc d\\n\"",
  )
}

///|
test "parse folded_strip" {
  assert_eq(show_parse(b">-\x0a  a\x0a  b\x0a"), "ok:\"a b\"")
}

///|
test "parse folded_keep" {
  assert_eq(show_parse(b">+\x0a  a\x0a\x0a"), "ok:\"a\\n\\n\"")
}

///|
test "parse literal_in_map" {
  assert_eq(
    show_parse(b"a: |\x0a  x\x0a  y\x0ab: >\x0a  z\x0a  w\x0a"),
    "ok:{\"a\": \"x\\ny\\n\", \"b\": \"z w\\n\"}",
  )
}

///|
test "parse literal_in_seq" {
  assert_eq(
    show_parse(b"- |\x0a  x\x0a- >-\x0a  y\x0a"),
    "ok:[\"x\\n\", \"y\"]",
  )
}

///|
test "parse literal_less_indented" {
  assert_eq(
    show_parse(b"a:\x0a  b: |\x0a    x\x0a   y\x0a"),
    "err:did not find expected key at line 4 column 4, while parsing a block mapping at line 2 column 3 at 4:4",
  )
}

///|
test "parse block_in_flow" {
  assert_eq(
    show_parse(b"[|\x0a a]"),
    "err:found character that cannot start any token at line 1 column 2, while scanning for the next token at 1:2",
  )
}

///|
test "parse block_seq" {
  assert_eq(
    show_parse(b"- a\x0a- b\x0a- - c\x0a  - d\x0a-\x0a- e\x0a"),
    "ok:[\"a\", \"b\", [\"c\", \"d\"], none, \"e\"]",
  )
}

///|
test "parse block_map" {
  assert_eq(
    show_parse(b"a: 1\x0ab:\x0a  c: 2\x0a  d: [3, 4]\x0ae:\x0a"),
    "ok:{\"a\": 1, \"b\": {\"c\": 2, \"d\": [3, 4]}, \"e\": none}",
  )
}

///|
test "parse indentless_seq" {
  assert_eq(
    show_parse(b"a:\x0a- 1\x0a- 2\x0ab: 3"),
    "ok:{\"a\": [1, 2], \"b\": 3}",
  )
}

///|
test "parse flow_seq" {
  assert_eq(
    show_parse(b"[a, [b, c], {d: e}, , ]"),
    "err:did not find expected node content at line 1 column 21, while parsing a flow node at 1:21",
  )
}

///|
test "parse flow_seq_trailing" {
  assert_eq(show_parse(b"[a, b, ]"), "ok:[\"a\", \"b\"]")
}

///|
test "parse flow_map" {
  assert_eq(
    show_parse(b"{a: 1, b, c: , ? d, e: {f: g}}"),
    "ok:{\"a\": 1, \"b\": none, \"c\": none, \"d\": none, \"e\": {\"f\": \"g\"}}",
  )
}

///|
test "parse flow_map_trailing" {
  assert_eq(show_parse(b"{a: 1,}"), "ok:{\"a\": 1}")
}

///|
test "parse flow_seq_pairs" {
  assert_eq(
    show_parse(b"[a: 1, b: 2, c]"),
    "ok:[{\"a\": 1}, {\"b\": 2}, \"c\"]",
  )
}

///|
test "parse flow_seq_key_bug" {
  assert_eq(show_parse(b"[? a : b]"), "ok:[{\"a\": \"b\"}]")
}

///|
test "parse flow_seq_empty_key" {
  assert_eq(
    show_parse(b"[: b]"),
    "err:did not find expected node content at line 1 column 2, while parsing a flow node at 1:2",
  )
}

///|
test "parse flow_nested_empty" {
  assert_eq(
    show_parse(b"[[], {}, [[]], {a: []}]"),
    "ok:[[], {}, [[]], {\"a\": []}]",
  )
}

///|
test "parse complex_key_scalar" {
  assert_eq(
    show_parse(b"? a\x0a: b\x0a? c\x0a"),
    "ok:{\"a\": \"b\", \"c\": none}",
  )
}

///|
test "parse complex_key_seq" {
  assert_eq(
    show_parse(b"? - a\x0a: b\x0a"),
    "err:invalid type: sequence, expected a string at line 1 column 3 at 1:3",
  )
}

///|
test "parse complex_key_map" {
  assert_eq(
    show_parse(b"? a: 1\x0a: b\x0a"),
    "err:invalid type: map, expected a string at line 1 column 3 at 1:3",
  )
}

///|
test "parse flow_key_seq" {
  assert_eq(
    show_parse(b"{[a]: b}"),
    "err:invalid type: sequence, expected a string at line 1 column 2 at 1:2",
  )
}

///|
test "parse flow_key_map" {
  assert_eq(
    show_parse(b"{{a: 1}: b}"),
    "err:invalid type: map, expected a string at line 1 column 2 at 1:2",
  )
}

///|
test "parse scalar_keys" {
  assert_eq(
    show_parse(
      b"1: a\x0atrue: b\x0a~: c\x0anull: d\x0a1.5: e\x0a0x10: f\x0a'q': g\x0a\"dq\": h\x0a? \x0a: i\x0a",
    ),
    "ok:{\"1\": \"a\", \"true\": \"b\", \"~\": \"c\", \"null\": \"d\", \"1.5\": \"e\", \"0x10\": \"f\", \"q\": \"g\", \"dq\": \"h\", \"\": \"i\"}",
  )
}

///|
test "parse empty_key" {
  assert_eq(
    show_parse(b": v"),
    "err:did not find expected key, while parsing a block mapping at 1:1",
  )
}

///|
test "parse duplicate_keys" {
  assert_eq(show_parse(b"a: 1\x0ab: 2\x0aa: 3\x0a"), "ok:{\"a\": 3, \"b\": 2}")
}

///|
test "parse tagged_keys" {
  assert_eq(
    show_parse(b"!!int 1: a\x0a!foo k: b\x0a"),
    "ok:{\"1\": \"a\", \"k\": \"b\"}",
  )
}

///|
test "parse multiline_flow" {
  assert_eq(show_parse(b"[\x0a  a,\x0a  b\x0a]"), "ok:[\"a\", \"b\"]")
}

///|
test "parse multiline_flow_map" {
  assert_eq(
    show_parse(b"{\x0a  a: 1,\x0a  b: 2\x0a}"),
    "ok:{\"a\": 1, \"b\": 2}",
  )
}

///|
test "parse map_in_seq" {
  assert_eq(
    show_parse(b"- a: 1\x0a  b: 2\x0a- c: 3"),
    "ok:[{\"a\": 1, \"b\": 2}, {\"c\": 3}]",
  )
}

///|
test "parse seq_of_seq_inline" {
  assert_eq(
    show_parse(b"- [a, b]\x0a- {c: d}"),
    "ok:[[\"a\", \"b\"], {\"c\": \"d\"}]",
  )
}

///|
test "parse nested_deep" {
  assert_eq(
    show_parse(b"a:\x0a  b:\x0a    c:\x0a      d: [1, {e: f}]"),
    "ok:{\"a\": {\"b\": {\"c\": {\"d\": [1, {\"e\": \"f\"}]}}}}",
  )
}

///|
test "parse comment_everywhere" {
  assert_eq(
    show_parse(b"# c\x0aa: 1 # c\x0a# c\x0ab: # c\x0a  - 2 # c\x0a"),
    "ok:{\"a\": 1, \"b\": [2]}",
  )
}

///|
test "parse hash_no_space" {
  assert_eq(show_parse(b"a: b#c"), "ok:{\"a\": \"b#c\"}")
}
