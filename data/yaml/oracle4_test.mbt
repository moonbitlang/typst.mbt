  assert_eq(show_parse(b"#true"), "ok:none")
}

///|
test "parse fuzz342" {
  assert_eq(
    show_parse(b"%~~? !{&a ?"),
    "err:could not find expected directive name at line 1 column 2, while scanning a directive at 1:2",
  )
}

///|
test "parse fuzz343" {
  assert_eq(show_parse(b"b@-- "), "ok:\"b@--\"")
}

///|
test "parse fuzz344" {
