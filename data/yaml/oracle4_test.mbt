  )
}

///|
test "parse struct001" {
  assert_eq(
    show_parse(b"    o:  \x0a  text\x0ag: &a h\x0a o:  \x0a    i: *a\x0a  ? k"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct002" {
  assert_eq(
    show_parse(b"c: [1, 2\x0a"),
    "err:did not find expected ',' or ']' at line 2 column 1, while parsing a flow sequence at line 1 column 4 at 2:1",
  )
}

///|
test "parse struct003" {
  assert_eq(
    show_parse(
      b"    d: {e: f}\x0a  d: {e: f}\x0a ? k\x0aa: 1\x0a  # note\x0a    c: [1, 2\x0a",
    ),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct004" {
  assert_eq(
    show_parse(b"? k\x0a  b:\x0a    i: *a\x0a  - |\x0a  : v\x0a  b:\x0a"),
    "err:mapping values are not allowed in this context at line 2 column 4 at 2:4",
  )
}

///|
test "parse struct005" {
  assert_eq(show_parse(b"g: &a h\x0a? k"), "ok:{\"g\": \"h\", \"k\": none}")
}

///|
test "parse struct006" {
  assert_eq(
    show_parse(b"  a: 1\x0a  d: {e: f}\x0ag: &a h"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct007" {
  assert_eq(show_parse(b"? k"), "ok:{\"k\": none}")
}

///|
