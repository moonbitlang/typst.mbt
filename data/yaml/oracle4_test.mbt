test "parse struct051" {
  assert_eq(
    show_parse(b"- ? p\x0a  - |\x0a  d: {e: f}\x0a    a: 1\x0a- |\x0a"),
    "err:did not find expected key at line 2 column 3, while parsing a block mapping at line 1 column 3 at 2:3",
  )
}

///|
test "parse struct052" {
  assert_eq(
    show_parse(
      b"  text\x0a    text\x0a - ? p\x0a  ? k\x0a    o:  \x0ai: *a\x0a",
    ),
    "err:mapping values are not allowed in this context at line 5 column 6 at 5:6",
  )
}

///|
test "parse struct053" {
  assert_eq(
    show_parse(b"c: [1, 2\x0a"),
    "err:did not find expected ',' or ']' at line 2 column 1, while parsing a flow sequence at line 1 column 4 at 2:1",
  )
}

///|
test "parse struct054" {
  assert_eq(show_parse(b"'q': \"r\"\x0a"), "ok:{\"q\": \"r\"}")
}

///|
test "parse struct055" {
  assert_eq(show_parse(b" - |\x0a  o:  "), "ok:[\"o:  \"]")
}

///|
test "parse struct056" {
  assert_eq(
    show_parse(b"      text\x0a  j: !t k\x0ad: {e: f}"),
    "err:mapping values are not allowed in this context at line 2 column 4 at 2:4",
  )
}

///|
test "parse struct057" {
  assert_eq(show_parse(b"  - ? p\x0a"), "ok:[{\"p\": none}]")
}

///|
test "parse struct058" {
  assert_eq(
    show_parse(b"g: &a h\x0ag: &a h\x0a: v\x0a'q': \"r\"\x0ad: {e: f}"),
    "err:did not find expected key at line 3 column 1, while parsing a block mapping at 3:1",
  )
}

///|
test "parse struct059" {
  assert_eq(show_parse(b"    - x\x0a  # note\x0a    - x"), "ok:[\"x\", \"x\"]")
}

///|
test "parse struct060" {
  assert_eq(
    show_parse(b"  - |\x0a    - |\x0a - >-\x0a- x"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct061" {
  assert_eq(
    show_parse(b" g: &a h\x0a - >-\x0a  - >-\x0a"),
    "err:did not find expected key at line 2 column 2, while parsing a block mapping at line 1 column 2 at 2:2",
  )
}

///|
test "parse struct062" {
  assert_eq(
    show_parse(b"g: &a h\x0a- ? p"),
    "err:did not find expected key at line 2 column 1, while parsing a block mapping at 2:1",
  )
}

///|
test "parse struct063" {
  assert_eq(
    show_parse(b"? k\x0a'q': \"r\"\x0a    # note\x0a 'q': \"r\""),
    "err:did not find expected key at line 4 column 2, while parsing a block mapping at 4:2",
  )
}

///|
test "parse struct064" {
  assert_eq(
    show_parse(b"  ? k\x0ai: *a\x0a   text\x0a: v\x0a  - x\x0a"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct065" {
  assert_eq(
    show_parse(b"  # note\x0aj: !t k\x0a - x\x0a  i: *a\x0a'q': \"r\""),
    "err:j: invalid type: enum, expected a Typst value at line 2 column 4 at 2:4",
  )
}

///|
test "parse struct066" {
  assert_eq(show_parse(b"- - y\x0a# note"), "ok:[[\"y\"]]")
}

///|
test "parse struct067" {
  assert_eq(
    show_parse(b"d: {e: f}\x0a    - |\x0a- x\x0a"),
    "err:did not find expected key at line 2 column 5, while parsing a block mapping at 2:5",
  )
}

///|
test "parse struct068" {
  assert_eq(
    show_parse(
      b"l: m n\x0a    - - y\x0a  a: 1\x0aa: 1\x0a  g: &a h\x0a    o:  \x0a",
    ),
    "err:mapping values are not allowed in this context at line 3 column 4 at 3:4",
  )
}

///|
test "parse struct069" {
  assert_eq(show_parse(b"    a: 1\x0a"), "ok:{\"a\": 1}")
}

///|
test "parse struct070" {
  assert_eq(
    show_parse(b" - >-\x0aj: !t k"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct071" {
  assert_eq(
    show_parse(b"j: !t k\x0ad: {e: f}\x0a- - y"),
    "err:j: invalid type: enum, expected a Typst value at line 1 column 4 at 1:4",
  )
}

///|
test "parse struct072" {
  assert_eq(
    show_parse(b"  o:  \x0a  text\x0a  d: {e: f}\x0a"),
    "err:could not find expected ':' at line 3 column 3, while scanning a simple key at line 2 column 3 at 3:3",
  )
}

///|
test "parse struct073" {
  assert_eq(show_parse(b"  l: m n\x0a"), "ok:{\"l\": \"m n\"}")
}

///|
test "parse struct074" {
  assert_eq(
    show_parse(b"  b:\x0a # note\x0a  g: &a h\x0a"),
    "ok:{\"b\": none, \"g\": \"h\"}",
  )
}

///|
test "parse struct075" {
  assert_eq(
    show_parse(b"    l: m n\x0a   text\x0a- ? p\x0a: v\x0aj: !t k\x0a    - - y"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct076" {
  assert_eq(show_parse(b" l: m n\x0a"), "ok:{\"l\": \"m n\"}")
}

///|
test "parse struct077" {
  assert_eq(show_parse(b" - |"), "ok:[\"\"]")
}

///|
test "parse struct078" {
  assert_eq(
    show_parse(b"- x\x0a- |\x0a    : v\x0a  # note\x0a"),
    "ok:[\"x\", \": v\\n\"]",
  )
}

///|
test "parse struct079" {
  assert_eq(
    show_parse(b" ? k\x0a    o:  \x0a  text"),
    "err:mapping values are not allowed in this context at line 2 column 6 at 2:6",
  )
}

///|
test "parse struct080" {
  assert_eq(
    show_parse(b"    o:  \x0a  j: !t k\x0a    : v\x0a  l: m n\x0a"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct081" {
  assert_eq(
    show_parse(
      b" d: {e: f}\x0a  text\x0a  i: *a\x0a- ? p\x0aa: 1\x0a  'q': \"r\"",
    ),
    "err:did not find expected key at line 2 column 3, while parsing a block mapping at line 1 column 2 at 2:3",
  )
}

///|
test "parse struct082" {
  assert_eq(
    show_parse(b"    - x\x0a  j: !t k\x0a  b:\x0a"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct083" {
  assert_eq(
    show_parse(b" g: &a h\x0ac: [1, 2"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct084" {
  assert_eq(
    show_parse(b"  l: m n\x0a  i: *a\x0a    - x\x0a  - ? p"),
    "err:unknown anchor at line 2 column 6 at 2:6",
  )
}

///|
test "parse struct085" {
  assert_eq(
    show_parse(b"j: !t k\x0a  text\x0a  - x\x0a  a: 1"),
    "err:j: invalid type: enum, expected a Typst value at line 1 column 4 at 1:4",
  )
}

///|
test "parse struct086" {
  assert_eq(
    show_parse(b"  d: {e: f}\x0a  : v\x0a    - - y"),
    "err:did not find expected key at line 2 column 3, while parsing a block mapping at line 1 column 3 at 2:3",
  )
}

///|
test "parse struct087" {
  assert_eq(
    show_parse(b"      text\x0a  : v\x0a? k\x0a  b:\x0a    a: 1"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct088" {
  assert_eq(
    show_parse(b"  : v\x0a c: [1, 2\x0a: v\x0a    # note\x0a- ? p\x0a  j: !t k"),
    "err:did not find expected key at line 1 column 3, while parsing a block mapping at 1:3",
  )
}

///|
test "parse struct089" {
  assert_eq(
    show_parse(b"- ? p\x0a  o:  \x0a"),
    "ok:[{\"p\": none, \"o\": none}]",
  )
}

///|
test "parse struct090" {
  assert_eq(
    show_parse(
      b"- x\x0ac: [1, 2\x0a    j: !t k\x0a l: m n\x0a # note\x0aa: 1\x0a",
    ),
    "err:did not find expected '-' indicator at line 2 column 1, while parsing a block collection at 2:1",
  )
}

///|
test "parse struct091" {
  assert_eq(show_parse(b"  g: &a h"), "ok:{\"g\": \"h\"}")
}

///|
test "parse struct092" {
  assert_eq(
    show_parse(b"  - >-\x0al: m n\x0a  o:  \x0a  a: 1\x0a    a: 1\x0a"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct093" {
  assert_eq(
    show_parse(b"  b:\x0a  ? k\x0aj: !t k\x0a  l: m n"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct094" {
  assert_eq(
    show_parse(b"    - |\x0a  d: {e: f}"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct095" {
  assert_eq(
    show_parse(b"  l: m n\x0a  # note\x0ac: [1, 2\x0a - ? p\x0ad: {e: f}"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

///|
test "parse struct096" {
  assert_eq(
    show_parse(b"b:\x0a j: !t k\x0a"),
    "err:b.j: invalid type: enum, expected a Typst value at line 2 column 5 at 2:5",
  )
}

///|
test "parse struct097" {
  assert_eq(show_parse(b"? k"), "ok:{\"k\": none}")
}

///|
test "parse struct098" {
  assert_eq(
    show_parse(b"c: [1, 2\x0a# note\x0a    - x\x0a"),
    "err:did not find expected ',' or ']' at line 3 column 5, while parsing a flow sequence at line 1 column 4 at 3:5",
  )
}

///|
test "parse struct099" {
  assert_eq(
    show_parse(b"  - x\x0a b:\x0a    - ? p\x0a- x\x0a"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}
