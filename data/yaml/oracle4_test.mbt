  )
}

///|
test "parse fuzz350" {
  assert_eq(
    show_parse(b"!x &a \xe2\x80\xa8&a ]'"),
    "err:invalid type: enum, expected a Typst value at 1:1",
  )
}

///|
test "parse fuzz351" {
  assert_eq(
    show_parse(b"@"),
    "err:found character that cannot start any token, while scanning for the next token at 1:1",
  )
}

///|
test "parse fuzz352" {
  assert_eq(
    show_parse(b"\x09true"),
    "err:found character that cannot start any token, while scanning for the next token at 1:1",
  )
}

