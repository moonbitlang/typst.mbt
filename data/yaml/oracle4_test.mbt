// Generated by the differential harness from the upstream Typst oracle.

///|
test "parse fuzz000" {
  assert_eq(
    show_parse(b"\x0a  {[1, 2]"),
    "err:invalid type: sequence, expected a string at line 2 column 4 at 2:4",
  )
}

