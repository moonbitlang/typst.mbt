  assert_eq(show_parse(b"\\n*a"), "ok:\"\\\\n*a\"")
}

///|
test "parse fuzz112" {
  assert_eq(
    show_parse(b"!!int |-"),
    "err:invalid value: string \"\", expected an integer at 1:1",
  )
}

///|
test "parse fuzz113" {
  assert_eq(show_parse(b"|\x0a  b- ...&a b&b  #c"), "ok:\"b- ...&a b&b  #c\"")
}

///|
test "parse fuzz114" {
  assert_eq(
    show_parse(b"[?\x0a ''\x0a|-\x0a- \xc3\xa9"),
    "err:found character that cannot start any token at line 3 column 1, while scanning for the next token at 3:1",
  )
}

///|
test "parse fuzz115" {
  assert_eq(
    show_parse(b"*a\xc3\xa9*ba!"),
    "err:did not find expected alphabetic or numeric character at line 1 column 3, while scanning an alias at 1:3",
  )
}

///|
test "parse fuzz116" {
  assert_eq(
    show_parse(b"!\\n~ !|-}!!int *b\x0a- "),
    "err:did not find expected whitespace or line break at line 1 column 2, while scanning a tag at 1:2",
  )
}

///|
test "parse fuzz117" {
  assert_eq(
    show_parse(b"*a? ...- ]true  \xc3\xa9!|-- -"),
    "err:mapping keys are not allowed in this context at line 1 column 3 at 1:3",
  )
}

///|
test "parse fuzz118" {
  assert_eq(
    show_parse(b"{%*a{"),
    "err:found character that cannot start any token at line 1 column 2, while scanning for the next token at 1:2",
  )
}

///|
test "parse fuzz119" {
  assert_eq(show_parse(b"*a?:!!str *b"), "err:unknown anchor at 1:1")
}

///|
test "parse fuzz120" {
  assert_eq(show_parse(b" #c? \\n[1, 2]"), "ok:none")
}

///|
test "parse fuzz121" {
  assert_eq(
    show_parse(b"{true\x09- ''"),
    "err:did not find expected ',' or '}' at line 2 column 1, while parsing a flow mapping at 2:1",
  )
}

///|
test "parse fuzz122" {
  assert_eq(
    show_parse(b"[1, 2]:{true? |-}"),
    "err:deserializing from YAML containing more than one document is not supported",
  )
}

