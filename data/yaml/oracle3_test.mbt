// Generated by the differential harness from the upstream Typst oracle.

///|
test "parse yaml_types_file" {
  assert_eq(
    show_parse(
      b"null_key: [null, ~]\x0a\"string\": text\x0ainteger: 5\x0afloat: 1.12\x0amapping: { '1': \"one\", '2': \"two\"}\x0aseq: [1, 2, 3, 4]\x0abool: false\x0atrue: bool\x0a1: ok\x0a",
    ),
    "ok:{\"null_key\": [none, none], \"string\": \"text\", \"integer\": 5, \"float\": f1.12, \"mapping\": {\"1\": \"one\", \"2\": \"two\"}, \"seq\": [1, 2, 3, 4], \"bool\": false, \"true\": \"bool\", \"1\": \"ok\"}",
  )
}

///|
test "parse bad_yaml_file_asset" {
  assert_eq(
    show_parse(b"this_will_break: [)\x0a"),
    "err:did not find expected ',' or ']' at line 2 column 1, while parsing a flow sequence at line 1 column 18 at 2:1",
  )
}

///|
test "parse edge_i64_max" {
  assert_eq(show_parse(b"9223372036854775807"), "ok:9223372036854775807")
}

///|
test "parse edge_i64_min" {
  assert_eq(show_parse(b"-9223372036854775808"), "ok:-9223372036854775808")
}

///|
test "parse edge_i64_max_plus_one" {
  assert_eq(show_parse(b"9223372036854775808"), "ok:f9.223372036854776e18")
}

///|
test "parse edge_i64_min_minus_one" {
  assert_eq(show_parse(b"-9223372036854775809"), "ok:f-9.223372036854776e18")
}

///|
test "parse edge_u64_max" {
  assert_eq(show_parse(b"18446744073709551615"), "ok:f1.8446744073709552e19")
}

///|
test "parse edge_u64_max_plus_one" {
  assert_eq(show_parse(b"18446744073709551616"), "ok:f1.8446744073709552e19")
}

///|
test "parse edge_i128_max" {
  assert_eq(
    show_parse(b"170141183460469231731687303715884105727"),
    "ok:f1.7014118346046923e38",
  )
}

///|
test "parse edge_i128_min" {
  assert_eq(
    show_parse(b"-170141183460469231731687303715884105728"),
    "ok:f-1.7014118346046923e38",
  )
}

///|
test "parse edge_u128_max" {
  assert_eq(
    show_parse(b"340282366920938463463374607431768211455"),
    "ok:f3.402823669209385e38",
  )
}

///|
test "parse deep_flow_ok_small" {
  assert_eq(
    show_parse(
      b"[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]",
    ),
    "ok:[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]",
  )
}

///|
test "encode none" {
  assert_eq(show_encode(None), "ok:null\n")
}

///|
test "encode true" {
  assert_eq(show_encode(Bool(true)), "ok:true\n")
}

///|
test "encode false" {
  assert_eq(show_encode(Bool(false)), "ok:false\n")
}

///|
test "encode int0" {
  assert_eq(show_encode(Int(0L)), "ok:0\n")
}

///|
test "encode int_neg" {
  assert_eq(show_encode(Int(-5L)), "ok:-5\n")
}

///|
test "encode int_max" {
  assert_eq(show_encode(Int(9223372036854775807L)), "ok:9223372036854775807\n")
}

///|
test "encode int_min" {
  assert_eq(
    show_encode(Int(-9223372036854775807L - 1L)),
    "ok:-9223372036854775808\n",
  )
}

///|
test "encode floats" {
  assert_eq(
    show_encode(
      Seq([
        flt("1.0"),
        flt("1.5"),
        flt("-0.0"),
        flt("0.0"),
        flt("1e16"),
        flt("1e15"),
        flt("123456789012345680"),
        flt("1e-5"),
        flt("1e-7"),
        flt("0.0001"),
        flt("123456789.123"),
        flt("1e300"),
        flt("5e-324"),
        flt("-2.5e-10"),
        flt("inf"),
        flt("-inf"),
        flt("nan"),
      ]),
    ),
    "ok:- 1.0\n- 1.5\n- -0.0\n- 0.0\n- 1e16\n- 1000000000000000.0\n- 1.2345678901234568e17\n- 0.00001\n- 1e-7\n- 0.0001\n- 123456789.123\n- 1e300\n- 5e-324\n- -2.5e-10\n- .inf\n- -.inf\n- .nan\n",
  )
}

///|
test "encode str_plain" {
  assert_eq(show_encode(Str("abc")), "ok:abc\n")
}

///|
test "encode str_empty" {
  assert_eq(show_encode(Str("")), "ok:''\n")
}

///|
test "encode str_resolving" {
  assert_eq(
    show_encode(
      Seq([
        Str("1"),
        Str("-1"),
        Str("+1"),
        Str("1.5"),
        Str(".5"),
        Str("1e3"),
        Str("true"),
        Str("True"),
        Str("TRUE"),
        Str("false"),
        Str("null"),
        Str("Null"),
        Str("~"),
        Str("010"),
        Str("-010"),
        Str("0x1F"),
        Str("0o7"),
        Str("0b1"),
        Str(".inf"),
        Str("-.inf"),
        Str(".nan"),
        Str("+.inf"),
        Str("1_000"),
        Str("yes"),
        Str("no"),
        Str("y"),
        Str("0x"),
        Str("00"),
        Str("0"),
        Str("-0"),
        Str("1."),
        Str("+-1"),
        Str("1e400"),
        Str("infinity"),
        Str("nan"),
      ]),
    ),
    "ok:- '1'\n- '-1'\n- '+1'\n- '1.5'\n- '.5'\n- '1e3'\n- 'true'\n- 'True'\n- 'TRUE'\n- 'false'\n- 'null'\n- 'Null'\n- '~'\n- '010'\n- '-010'\n- '0x1F'\n- '0o7'\n- '0b1'\n- '.inf'\n- '-.inf'\n- '.nan'\n- '+.inf'\n- 1_000\n- yes\n- no\n- y\n- 0x\n- '00'\n- '0'\n- '-0'\n- '1.'\n- +-1\n- 1e400\n- infinity\n- nan\n",
  )
}

///|
test "encode str_indicators" {
  assert_eq(
    show_encode(
      Seq([
        Str("-"),
        Str("- a"),
        Str("-a"),
        Str("--"),
        Str("?"),
        Str("? a"),
        Str("?a"),
        Str(":"),
        Str(": a"),
        Str(":a"),
        Str("a:"),
        Str("a: b"),
        Str("a:b"),
        Str("a :b"),
        Str("#a"),
        Str("a #b"),
        Str("a#b"),
        Str(",a"),
        Str("a,b"),
        Str("[a"),
        Str("a["),
        Str("a]"),
        Str("{a"),
        Str("a}"),
        Str("&a"),
        Str("a&"),
        Str("*a"),
        Str("!a"),
        Str("a!"),
        Str("|a"),
        Str("a|"),
        Str(">a"),
        Str("'a"),
        Str("a'b"),
        Str("\"a"),
        Str("a\"b"),
        Str("%a"),
        Str("a%"),
        Str("@a"),
        Str("`a"),
        Str("---"),
        Str("--- a"),
        Str("---a"),
        Str("..."),
        Str("... a"),
        Str("a ..."),
        Str("a?b"),
        Str("a, b"),
      ]),
    ),
    "ok:- '-'\n- '- a'\n- -a\n- --\n- '?'\n- '? a'\n- ?a\n- ':'\n- ': a'\n- :a\n- 'a:'\n- 'a: b'\n- a:b\n- a :b\n- '#a'\n- 'a #b'\n- a#b\n- ',a'\n- a,b\n- '[a'\n- a[\n- a]\n- '{a'\n- a}\n- '&a'\n- a&\n- '*a'\n- '!a'\n- a!\n- '|a'\n- a|\n- '>a'\n- '''a'\n- a'b\n- '\"a'\n- a\"b\n- '%a'\n- a%\n- '@a'\n- '`a'\n- '---'\n- '--- a'\n- '---a'\n- '...'\n- '... a'\n- a ...\n- a?b\n- a, b\n",
  )
}

///|
test "encode str_space" {
  assert_eq(
    show_encode(
      Seq([
        Str(" "),
        Str("  "),
        Str(" a"),
        Str("a "),
        Str(" a "),
        Str("a  b"),
        Str("a b"),
      ]),
    ),
    "ok:- ' '\n- '  '\n- ' a'\n- 'a '\n- ' a '\n- a  b\n- a b\n",
  )
}

///|
test "encode str_special" {
  assert_eq(
    show_encode(
      Seq([
        Str("a\u{9}b"),
        Str("\u{9}"),
        Str("a\\b"),
        Str("\u{e9}"),
        Str("\u{4e2d}\u{6587}"),
        Str("\u{1f600}"),
        Str("\u{85}"),
        Str("\u{a0}"),
        Str("a\u{a0}b"),
        Str("\u{2028}"),
        Str("\u{feff}"),
        Str("a\u{feff}"),
        Str("\u{fffe}"),
        Str("\u{ffff}"),
        Str("\u{e000}"),
        Str("\u{7f}"),
        Str("\u{1}"),
        Str("\u{0}"),
        Str("\u{1b}"),
        Str("\u{7}"),
        Str("\u{8}"),
        Str("\u{b}"),
        Str("\u{c}"),
        Str("\u{d}"),
        Str("a\u{d}"),
        Str("\u{9f}"),
        Str("\u{10ffff}"),
        Str("\u{d7ff}"),
      ]),
    ),
    "ok:- \"a\\tb\"\n- \"\\t\"\n- a\\b\n- \u{e9}\n- \u{4e2d}\u{6587}\n- \u{1f600}\n- \"\\N\"\n- \u{a0}\n- a\u{a0}b\n- '\u{2028}  '\n- \"\\uFEFF\"\n- \"a\\uFEFF\"\n- \"\\uFFFE\"\n- \"\\uFFFF\"\n- \u{e000}\n- \"\\x7F\"\n- \"\\x01\"\n- \"\\0\"\n- \"\\e\"\n- \"\\a\"\n- \"\\b\"\n- \"\\v\"\n- \"\\f\"\n- \"\\r\"\n- \"a\\r\"\n- \"\\x9F\"\n- \u{10ffff}\n- \u{d7ff}\n",
  )
}

///|
test "encode str_multiline" {
  assert_eq(
    show_encode(
      Seq([
        Str("a\u{a}b"),
        Str("a\u{a}"),
        Str("a\u{a}\u{a}"),
        Str("\u{a}"),
        Str("\u{a}\u{a}"),
        Str("\u{a}a"),
        Str(" a\u{a}b"),
        Str("a \u{a}b"),
        Str("a\u{a} b"),
        Str("\u{9}a\u{a}b"),
        Str("a\u{a}b "),
        Str("a\u{a}\u{9}b"),
        Str("x\u{2028}y"),
        Str("a\u{d}\u{a}b"),
        Str("a\u{a}\u{a}b\u{a}"),
        Str("a\u{a}\u{a}\u{a}b"),
        Str("- a\u{a}- b"),
        Str("a: b\u{a}c"),
        Str("#a\u{a}b"),
        Str("a\u{85}b\u{a}c"),
        Str("a\u{a}b\u{2028}"),
        Str("a\u{a}\u{2028}"),
      ]),
    ),
    "ok:- |-\n  a\n  b\n- |\n  a\n- |+\n  a\n\n- |2+\n\n- |2+\n\n\n- |2-\n\n  a\n- |2-\n   a\n  b\n- \"a \\nb\"\n- |-\n  a\n   b\n- \"\\ta\\nb\"\n- \"a\\nb \"\n- \"a\\n\\tb\"\n- 'x\u{2028}  y'\n- \"a\\r\\nb\"\n- |\n  a\n\n  b\n- |-\n  a\n\n\n  b\n- |-\n  - a\n  - b\n- |-\n  a: b\n  c\n- |-\n  #a\n  b\n- \"a\\Nb\\nc\"\n- |\n  a\n  b\u{2028}- |+\n  a\n\u{2028}",
  )
}

///|
test "encode str_quotes" {
  assert_eq(
    show_encode(
      Seq([
        Str("it's"),
        Str("a''b"),
        Str("'"),
        Str("''"),
        Str("\""),
        Str("a\""),
        Str("'a'"),
      ]),
    ),
    "ok:- it's\n- a''b\n- ''''\n- ''''''\n- '\"'\n- a\"\n- '''a'''\n",
  )
}

///|
test "encode str_long" {
  assert_eq(
    show_encode(
      Str(
        "word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word end",
      ),
    ),
    "ok:word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word end\n",
  )
}

///|
test "encode seq_empty" {
  assert_eq(show_encode(Seq([])), "ok:[]\n")
}

///|
test "encode map_empty" {
  assert_eq(show_encode(Map([])), "ok:{}\n")
}

///|
test "encode seq_nested" {
  assert_eq(
    show_encode(
      Seq([
        Seq([]),
        Seq([Seq([])]),
        Seq([Int(1L), Seq([Int(2L), Seq([Int(3L)])])]),
        Map([]),
        Map([("a", Seq([]))]),
      ]),
    ),
    "ok:- []\n- - []\n- - 1\n  - - 2\n    - - 3\n- {}\n- a: []\n",
  )
}

///|
test "encode map_nested" {
  assert_eq(
    show_encode(
      Map([
        ("a", Map([("b", Map([("c", Int(1L))]))])),
        ("d", Seq([Int(1L), Int(2L)])),
        ("e", Map([])),
        ("f", Seq([])),
        ("g", None),
      ]),
    ),
    "ok:a:\n  b:\n    c: 1\nd:\n- 1\n- 2\ne: {}\nf: []\ng: null\n",
  )
}

///|
test "encode seq_of_maps" {
  assert_eq(
    show_encode(
      Seq([
        Map([("a", Int(1L)), ("b", Int(2L))]),
        Map([("c", Seq([Int(1L), Map([("d", Str("x"))])]))]),
      ]),
    ),
    "ok:- a: 1\n  b: 2\n- c:\n  - 1\n  - d: x\n",
  )
}

///|
test "encode seq_of_seqs" {
  assert_eq(
    show_encode(Seq([Seq([Int(1L), Int(2L)]), Seq([Seq([Int(3L)]), Int(4L)])])),
    "ok:- - 1\n  - 2\n- - - 3\n  - 4\n",
  )
}

///|
test "encode map_single" {
  assert_eq(show_encode(Map([("only", Str("one"))])), "ok:only: one\n")
}

///|
test "encode map_single_nested" {
  assert_eq(
    show_encode(Map([("a", Map([("b", Map([("c", Str("d"))]))]))])),
    "ok:a:\n  b:\n    c: d\n",
  )
}

///|
test "encode keys" {
  assert_eq(
    show_encode(
      Map([
        ("", Int(1L)),
        ("1", Int(2L)),
        ("true", Int(3L)),
        ("null", Int(4L)),
        ("a: b", Int(5L)),
        ("- x", Int(6L)),
        ("a\u{a}b", Int(7L)),
        (
          "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk",
          Int(8L),
        ),
        (
          "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk",
          Int(9L),
        ),
        (" ", Int(10L)),
        (
          "\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}",
          Int(11L),
        ),
        ("a\u{9}b", Int(12L)),
        ("[", Int(13L)),
        ("#", Int(14L)),
      ]),
    ),
    "ok:'': 1\n'1': 2\n'true': 3\n'null': 4\n'a: b': 5\n'- x': 6\n? |-\n  a\n  b\n: 7\n? kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk\n: 8\nkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk: 9\n' ': 10\n? \u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\n: 11\n\"a\\tb\": 12\n'[': 13\n'#': 14\n",
  )
}

///|
test "encode key_multiline_value_map" {
  assert_eq(
    show_encode(
      Map([
        ("a\u{a}b", Map([("c", Int(1L))])),
        ("x\u{a}y", Seq([Int(1L), Int(2L)])),
      ]),
    ),
    "ok:? |-\n  a\n  b\n: c: 1\n? |-\n  x\n  y\n: - 1\n  - 2\n",
  )
}

///|
test "encode multiline_in_seq_in_map" {
  assert_eq(
    show_encode(
      Map([
        ("a", Seq([Str("x\u{a}y"), Str("z\u{a}")])),
        ("b", Map([("c", Str("p\u{a}q\u{a}\u{a}"))])),
      ]),
    ),
    "ok:a:\n- |-\n  x\n  y\n- |\n  z\nb:\n  c: |+\n    p\n    q\n\n",
  )
}

///|
test "encode multiline_in_nested_seq" {
  assert_eq(
    show_encode(Seq([Seq([Str("a\u{a}b"), Seq([Str("c\u{a}d")])])])),
    "ok:- - |-\n    a\n    b\n  - - |-\n      c\n      d\n",
  )
}

///|
test "encode empty_in_contexts" {
  assert_eq(
    show_encode(Map([("a", Str("")), ("b", Seq([Str("")])), ("", Str(""))])),
    "ok:a: ''\nb:\n- ''\n'': ''\n",
  )
}

///|
test "encode deep" {
  assert_eq(
    show_encode(Seq([Seq([Seq([Seq([Seq([Seq([Seq([Str("x")])])])])])])])),
    "ok:- - - - - - - x\n",
  )
}
