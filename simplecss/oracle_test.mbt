    "a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a { x:y; }\n--\na > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a > a|0,0,255|x=y;\n",
  )
  check_sheet(
    ["b { x: 1 }", "a { y: 2 }", "#i { z: 3 }", ".c { w: 4 }"],
    "b { x:1; }\na { y:2; }\n*[class~='c'] { w:4; }\n*[id='i'] { z:3; }\n--\nb|0,0,1|x=1;\na|0,0,1|y=2;\n*[class~='c']|0,1,0|w=4;\n*[id='i']|1,0,0|z=3;\n",
  )
  check_sheet(
    ["* {a:b}", "c {d:e}", "* {f:g}", "c {h:i}"],
    "* { a:b; }\n* { f:g; }\nc { d:e; }\nc { h:i; }\n--\n*|0,0,0|a=b;\n*|0,0,0|f=g;\nc|0,0,1|d=e;\nc|0,0,1|h=i;\n",
  )
  check_sheet(["/* x", "a { b: c }"], "a { b:c; }\n--\na|0,0,1|b=c;\n")
  check_sheet(
    ["a { b: c", "d { e: f }"],
    "a { b:c; }\nd { e:f; }\n--\na|0,0,1|b=c;\nd|0,0,1|e=f;\n",
  )
}

///|
test "declaration_tokenizer" {
  check_decls("", "")
  check_decls(" ", "")
  check_decls("/**/", "")
  check_decls("color:red", "color=red\n")
  check_decls("color:red;", "color=red\n")
  check_decls("color:red ", "color=red\n")
  check_decls(" color: red; ", "color=red\n")
  check_decls("  color  :  red  ; ", "color=red\n")
  check_decls("  color:red;;;;color:red; ", "color=red\ncolor=red\n")
  check_decls("background: url(\"img.png\");", "background=url(\"img.png\")\n")
  check_decls("background: url(\"{}\");", "background=url(\"{}\")\n")
  check_decls("color: red ! important", "color=red !important\n")
  check_decls("color: red !important", "color=red !important\n")
  check_decls("color: red!important", "color=red !important\n")
  check_decls("color: red !/**/important", "color=red !important\n")
  check_decls("border: 1em solid blue", "border=1em solid blue\n")
  check_decls(
    "background: navy url(support/diamond.png) -2em -2em no-repeat", "background=navy url(support/diamond.png) -2em -2em no-repeat\n",
  )
  check_decls("/**/color:red", "color=red\n")
  check_decls("/* *\\/*/color: red;", "color=red\n")
  check_decls("/**/color/**/:/**/red/**/;/**/", "color=red\n")
  check_decls("\ncolor\n:\nred\n;\n", "color=red\n")
  check_decls("{color:red}", "")
  check_decls("(color:red)", "")
  check_decls("[color:red]", "")
  check_decls("color:", "")
  check_decls("value:\"text\"", "value=\"text\"\n")
  check_decls("value:'text'", "value='text'\n")
  check_decls("color:#fff", "color=#fff\n")
  check_decls("color:0.5", "color=0.5\n")
  check_decls("color:.5", "color=.5\n")
  check_decls("color:#FFF", "color=#FFF\n")
  check_decls(
    "content: counter(chapno, upper-roman) \". \"", "content=counter(chapno, upper-roman) \". \"\n",
  )
  check_decls(
    "font-family:'Noto Serif','DejaVu Serif',serif", "font-family='Noto Serif','DejaVu Serif',serif\n",
  )
  check_decls("*zoom:1;", "zoom=1\n")
  check_decls("@unsupported { splines: reticulating } color: green", "")
  check_decls("/*\\*/*/color: red;", "")
  check_decls("a:b; c", "a=b\n")
  check_decls("a:b;c:d!important;e:'f'", "a=b\nc=d !important\ne='f'\n")
  check_decls("color:red; /* unclosed", "")
  check_decls("a: 1 2 3", "a=1 2 3\n")
  check_decls("a:b}c:d", "a=b\n")
  check_decls("x: y; z", "x=y\n")
  check_decls("a:b;;", "a=b\n")
  check_decls("*a:b", "a=b\n")
  check_decls("**a:b", "")
  check_decls("a:-", "a=-\n")
  check_decls("a:+5", "a=+5\n")
  check_decls("a:#", "a=#\n")
  check_decls("a:#-", "a=#-\n")
  check_decls("a:'x", "")
  check_decls("a:fn(x", "")
  check_decls("a: url( x ) b", "a=url( x ) b\n")
  check_decls("a:b !important c", "a=b !important\n")
  check_decls("a:b !importantc", "a=b !important\n")
  check_decls("a:b !impo", "a=b\n")
  check_decls(":b", "")
  check_decls("é:b", "")
  check_decls("a:é", "")
  check_decls("a:☃", "a=☃\n")
  check_decls("a: \u{3000}x", "a=x\n")
  check_decls("a: x\u{3000}", "a=x\n")
  check_decls(
    "fill:red;stroke:blue;stroke-width:2px", "fill=red\nstroke=blue\nstroke-width=2px\n",
  )
  check_decls(
    "fill: rgb(10%, 20%, 30%); opacity: .5", "fill=rgb(10%, 20%, 30%)\nopacity=.5\n",
  )
  check_decls(
    "font-family: \"Times New Roman\", serif; font-size: 12pt", "font-family=\"Times New Roman\", serif\nfont-size=12pt\n",
  )
  check_decls("marker-start: url(#m1)", "marker-start=url(#m1)\n")
  check_decls("a:b c:d", "a=b c\n")
  check_decls("a:b/c", "a=b\n")
  check_decls("a:1px/2px", "a=1px\n")
  check_decls("a:b\n;c:d", "a=b\nc=d\n")
  check_decls("a:b /* c */ d", "a=b /* c */ d\n")
  check_decls("a:b /* c", "")
  check_decls("a:b;/**/", "a=b\n")
  check_decls("-a:b", "-a=b\n")
  check_decls("--a:b", "")
  check_decls("-1:b", "")
  check_decls("a:-1", "a=-1\n")
  check_decls("a:1%", "a=1%\n")
  check_decls("a:1.%", "a=1.%\n")
  check_decls("a:+.5e", "a=+.5e\n")
  check_decls("a:inherit !important;b:c", "a=inherit !important\nb=c\n")
}

///|
test "selector_tokenizer" {
  check_sel_tokens("*", "*\n")
  check_sel_tokens("div", "type:div\n")
  check_sel_tokens("#div", "id:div\n")
  check_sel_tokens(".div", "class:div\n")
  check_sel_tokens("[id]", "attr:[id]\n")
  check_sel_tokens("[id=test]", "attr:[id=test]\n")
  check_sel_tokens("[id~=test]", "attr:[id~=test]\n")
  check_sel_tokens("[id|=test]", "attr:[id|=test]\n")
  check_sel_tokens("[id='test']", "attr:[id=test]\n")
  check_sel_tokens("[id=\"test\"]", "attr:[id=test]\n")
  check_sel_tokens("[id='te\\'st']", "attr:[id=te\\'st]\n")
  check_sel_tokens("[id=\"te\\\"st\"]", "attr:[id=te\\\"st]\n")
  check_sel_tokens("div:first-child", "type:div\npseudo:first-child\n")
  check_sel_tokens(":first-child", "pseudo:first-child\n")
  check_sel_tokens("div p", "type:div\ndesc\ntype:p\n")
  check_sel_tokens("div p a", "type:div\ndesc\ntype:p\ndesc\ntype:a\n")
  check_sel_tokens("div>p", "type:div\nchild\ntype:p\n")
  check_sel_tokens("div >p", "type:div\nchild\ntype:p\n")
  check_sel_tokens("div> p", "type:div\nchild\ntype:p\n")
  check_sel_tokens("div > p", "type:div\nchild\ntype:p\n")
  check_sel_tokens("div .p", "type:div\ndesc\nclass:p\n")
  check_sel_tokens("div *", "type:div\ndesc\n*\n")
  check_sel_tokens("div #p", "type:div\ndesc\nid:p\n")
  check_sel_tokens("div [id]", "type:div\ndesc\nattr:[id]\n")
  check_sel_tokens("div :link", "type:div\ndesc\npseudo:link\n")
  check_sel_tokens("div+p", "type:div\nadj\ntype:p\n")
  check_sel_tokens("div +p", "type:div\nadj\ntype:p\n")
  check_sel_tokens("div+ p", "type:div\nadj\ntype:p\n")
  check_sel_tokens("div + p", "type:div\nadj\ntype:p\n")
  check_sel_tokens("div {", "type:div\n")
  check_sel_tokens("div,", "type:div\n")
  check_sel_tokens("div{", "type:div\n")
  check_sel_tokens("div ,", "type:div\n")
  check_sel_tokens("div.test", "type:div\nclass:test\n")
  check_sel_tokens("div.test.warn", "type:div\nclass:test\nclass:warn\n")
  check_sel_tokens("div#id", "type:div\nid:id\n")
  check_sel_tokens("*[id]", "*\nattr:[id]\n")
  check_sel_tokens("*.test", "*\nclass:test\n")
  check_sel_tokens("*#id", "*\nid:id\n")
  check_sel_tokens("div * p", "type:div\ndesc\n*\ndesc\ntype:p\n")
  check_sel_tokens(
    "div[id=test][color=red]", "type:div\nattr:[id=test]\nattr:[color=red]\n",
  )
  check_sel_tokens(
    "a.external:visited", "type:a\nclass:external\npseudo:visited\n",
  )
  check_sel_tokens(":lang(en)", "lang:en\n")
  check_sel_tokens("a\nb", "type:a\ndesc\ntype:b\n")
  check_sel_tokens(
    ".warn :first-child", "class:warn\ndesc\npseudo:first-child\n",
  )
  check_sel_tokens("/* comment */a", "type:a\n")
  check_sel_tokens("a /**/ b", "type:a\ndesc\ntype:b\n")
  check_sel_tokens("a /**/b", "type:a\ndesc\ntype:b\n")
  check_sel_tokens("a/**/ b", "type:a\ndesc\ntype:b\n")
  check_sel_tokens("a/**/ /**/b", "type:a\ndesc\ntype:b\n")
  check_sel_tokens("a /**/ /**/ b", "type:a\ndesc\ntype:b\n")
  check_sel_tokens("a /**//**/ b", "type:a\ndesc\ntype:b\n")
  check_sel_tokens("", "err:selector missing\n")
  check_sel_tokens(" ", "err:selector missing\n")
  check_sel_tokens("a >", "type:a\nchild\nerr:selector missing\n")
  check_sel_tokens("> a", "err:unexpected combinator\n")
  check_sel_tokens("a > > b", "type:a\nchild\nerr:unexpected combinator\n")
  check_sel_tokens("a + + b", "type:a\nadj\nerr:unexpected combinator\n")
  check_sel_tokens("a b > c", "type:a\ndesc\ntype:b\nchild\ntype:c\n")
  check_sel_tokens("a,b", "type:a\n")
  check_sel_tokens("a{", "type:a\n")
  check_sel_tokens(":foo", "pseudo:foo\n")
  check_sel_tokens(":lang()", "err:invalid language pseudo-class\n")
  check_sel_tokens(":lang( )", "err:invalid language pseudo-class\n")
  check_sel_tokens(":lang( en-US )", "lang:en-US\n")
  check_sel_tokens(":lang(en", "err:unexpected end of stream\n")
  check_sel_tokens("[x", "err:unexpected end of stream\n")
  check_sel_tokens("[x=", "err:unexpected end of stream\n")
  check_sel_tokens("[x!y]", "err:invalid or unsupported attribute selector\n")
  check_sel_tokens("[x~y]", "err:expected '=' not 'y' at 1:4\n")
  check_sel_tokens("[x|y]", "err:expected '=' not 'y' at 1:4\n")
  check_sel_tokens("[x='y'", "err:unexpected end of stream\n")
  check_sel_tokens("[x='y", "err:unexpected end of stream\n")
  check_sel_tokens("[x=y z]", "err:expected ']' not ' ' at 1:5\n")
  check_sel_tokens("[]", "err:invalid ident at 1:2\n")
  check_sel_tokens("*.a", "*\nclass:a\n")
  check_sel_tokens("a*", "type:a\nerr:unexpected selector\n")
  check_sel_tokens("**", "*\nerr:unexpected selector\n")
  check_sel_tokens(
    "a.b#c[d]:hover", "type:a\nclass:b\nid:c\nattr:[d]\npseudo:hover\n",
  )
  check_sel_tokens("/* c */ a", "type:a\n")
  check_sel_tokens("a /* c */", "type:a\n")
  check_sel_tokens("a /", "type:a\nerr:invalid comment at 1:3\n")
  check_sel_tokens("a /x", "type:a\nerr:invalid comment at 1:3\n")
  check_sel_tokens("a  /* c */ > b", "type:a\nchild\ntype:b\n")
  check_sel_tokens("a /* c", "type:a\nerr:invalid comment at 1:3\n")
  check_sel_tokens("a/", "type:a\n")
  check_sel_tokens("a/x", "type:a\n")
  check_sel_tokens("é", "err:invalid ident at 1:1\nerr:selector missing\n")
  check_sel_tokens(
    "a é", "type:a\ndesc\nerr:invalid ident at 1:3\nerr:selector missing\n",
  )
  check_sel_tokens("☃.☃", "type:☃\nclass:☃\n")
  check_sel_tokens("a\n\n  /* x", "type:a\nerr:invalid comment at 3:3\n")
  check_sel_tokens(
    "a ~ b", "type:a\ndesc\nerr:invalid ident at 1:3\nerr:selector missing\n",
  )
  check_sel_tokens("a\t>\tb", "type:a\nchild\ntype:b\n")
  check_sel_tokens("a\r\nb", "type:a\ndesc\ntype:b\n")
  check_sel_tokens(".-a", "class:-a\n")
  check_sel_tokens(".-", "class:-\n")
  check_sel_tokens(".-1", "err:invalid ident at 1:2\n")
  check_sel_tokens("#-", "id:-\n")
  check_sel_tokens("a:-b", "type:a\npseudo:-b\n")
  check_sel_tokens("a::before", "type:a\nerr:invalid ident at 1:3\n")
  check_sel_tokens(":", "err:invalid ident at 1:2\n")
  check_sel_tokens(".", "err:invalid ident at 1:2\n")
  check_sel_tokens("#", "err:invalid ident at 1:2\n")
  check_sel_tokens("[", "err:invalid ident at 1:2\n")
  check_sel_tokens("[a~é]", "err:expected '=' not 'Ã' at 1:4\n")
  check_sel_tokens("[a|é]", "err:expected '=' not 'Ã' at 1:4\n")
  check_sel_tokens("a\n[b~=]", "type:a\ndesc\nerr:invalid ident at 2:5\n")
  check_sel_tokens(
    "a b c d e f", "type:a\ndesc\ntype:b\ndesc\ntype:c\ndesc\ntype:d\ndesc\ntype:e\ndesc\ntype:f\n",
  )
  check_sel_tokens("  a", "type:a\n")
  check_sel_tokens("a  ", "type:a\n")
  check_sel_tokens("a , b", "type:a\n")
  check_sel_tokens("a{b}", "type:a\n")
  check_sel_tokens("a > b, c", "type:a\nchild\ntype:b\n")
}

///|
test "selector_parse" {
  check_selector("*", "*|0,0,0")
  check_selector("li", "li|0,0,1")
  check_selector("ul li", "ul li|0,0,2")
  check_selector("ul ol + li", "ul ol + li|0,0,3")
  check_selector("h1 + *[rel=up]", "h1 + *[rel='up']|0,1,1")
  check_selector("ul ol li.red", "ul ol li[class~='red']|0,1,3")
  check_selector("li.red.level", "li[class~='red'][class~='level']|0,2,1")
  check_selector("#x34y", "*[id='x34y']|1,0,0")
  check_selector("a > b", "a > b|0,0,2")
  check_selector("", "None")
  check_selector(" ", "None")
  check_selector("a >", "None")
  check_selector("> a", "None")
  check_selector("a > > b", "None")
  check_selector("a + + b", "None")
  check_selector("a b > c", "a b > c|0,0,3")
  check_selector("a,b", "a|0,0,1")
  check_selector("a{", "a|0,0,1")
  check_selector(":foo", "None")
  check_selector(":lang()", "None")
  check_selector(":lang(en)", "*:lang(en)|0,1,0")
  check_selector("[x", "None")
  check_selector("[x=", "None")
  check_selector("[x!y]", "None")
  check_selector("*.a", "*[class~='a']|0,1,0")
  check_selector("a*", "None")
  check_selector("a.b#c[d]:hover", "a[class~='b'][id='c'][d]:hover|1,3,1")
  check_selector("/* c */ a", "a|0,0,1")
  check_selector("a /* c */", "a|0,0,1")
  check_selector("a /", "None")
  check_selector("a /x", "None")
  check_selector("a  /* c */ > b", "a > b|0,0,2")
  check_selector("é", "None")
  check_selector("a é", "None")
  check_selector("☃.☃", "☃[class~='☃']|0,1,1")
  check_selector(".a.b.c", "*[class~='a'][class~='b'][class~='c']|0,3,0")
  check_selector("#a#b", "*[id='a'][id='b']|2,0,0")
  check_selector("[id=x]", "*[id='x']|1,0,0")
  check_selector("[id]", "*[id]|1,0,0")
  check_selector("a [id=x] .b", "a *[id='x'] *[class~='b']|1,1,1")
  check_selector("*:first-child", "*:first-child|0,1,0")
  check_selector(":first-child:hover", "*:first-child:hover|0,2,0")
  check_selector(
    "a:link:visited:active:focus", "a:link:visited:active:focus|0,4,1",
  )
  check_selector("a:lang(de):lang(fr)", "a:lang(de):lang(fr)|0,2,1")
  check_selector(":lang(en) > a", "*:lang(en) > a|0,1,1")
  check_selector("a + b > c d", "a + b > c d|0,0,4")
  check_selector("a /* x */ + b", "a + b|0,0,2")
  check_selector(
    "#a > .b + c [d|=e]", "*[id='a'] > *[class~='b'] + c *[d|='e']|1,2,1",
  )
  check_selector("a ~ b", "None")
  check_selector("a::before", "None")
  check_selector("a > b,", "a > b|0,0,2")
  check_selector(".x:unknown", "None")
  check_selector("[a~='b c']", "*[a~='b c']|0,1,0")
  check_selector("[a='']", "*[a='']|0,1,0")
}

///|
test "selector_matches" {
  check_match("*", "root,g1,r1,c1,r2,g2,t1,s1,s2,g3,r4,r3")
  check_match("rect", "r1,r2,r4,r3")
  check_match("g rect", "r1,r2,r4")
  check_match("g > rect", "r1,r2,r4")
  check_match("svg > rect", "r3")
  check_match("svg rect", "r1,r2,r4,r3")
  check_match("rect + circle", "c1")
  check_match("circle + rect", "r2")
  check_match("rect + rect", "")
  check_match(".a", "g1,r1,s2,g3")
  check_match(".b", "g1,t1")
  check_match(".c", "t1")
  check_match(".a.b", "g1")
  check_match("g.a", "g1,g3")
  check_match("#r1", "r1")
  check_match("rect#r1", "r1")
  check_match("[fill]", "c1,r4")
  check_match("[fill=red]", "c1")
  check_match("[class~=c]", "t1")
  check_match("[class~='']", "t1")
  check_match("[lang|=en]", "r1,r2")
  check_match("[lang=en]", "r1")
  check_match(":first-child", "root,g1,r1,t1,s1,r4")
  check_match("rect:first-child", "r1,r4")
  check_match(":lang(en)", "r1,r2")
  check_match(":lang(en-US)", "r2")
  check_match(":lang(fr)", "r3")
  check_match(":hover", "r2")
  check_match(":focus", "")
  check_match(":link", "")
  check_match("svg g text tspan", "s1,s2")
  check_match("svg > g > text > tspan + tspan.a", "s2")
  check_match("g * tspan", "s1,s2")
  check_match("* *", "g1,r1,c1,r2,g2,t1,s1,s2,g3,r4,r3")
  check_match("* > *", "g1,r1,c1,r2,g2,t1,s1,s2,g3,r4,r3")
  check_match("g > * > tspan", "s1,s2")
  check_match("text tspan:first-child", "s1")
  check_match("svg tspan", "s1,s2")
  check_match("svg > tspan", "")
  check_match("g + g", "g2")
  check_match("g + g + rect", "r3")
  check_match("g + rect", "r3")
  check_match("* + *", "c1,r2,g2,s2,g3,r3")
  check_match("g rect + rect", "")
  check_match("svg > g rect", "r1,r2,r4")
  check_match("g g rect", "r4")
  check_match("g > g > rect", "")
  check_match(".a .a", "r1")
  check_match(".a > .a", "r1")
  check_match(".a + .a", "g3")
  check_match("[id] [id] [id] [id]", "s1,s2,g3,r4")
  check_match("text > g rect[fill=blue]", "r4")
  check_match("#g2 rect", "r4")
  check_match("#g1 > *:hover", "r2")
  check_match("tspan + g", "g3")
  check_match("tspan + g > rect", "r4")
  check_match("svg", "root")
  check_match("svg:first-child", "root")
  check_match("#root rect + g", "")
  check_match("nonexistent", "")
  check_match("g nonexistent", "")
  check_match("[class|=a]", "r1,s2,g3")
  check_match("[class=a]", "r1,s2,g3")
}

///|
test "attribute_operator_matches" {
  check_attr_op(@simplecss.Exists, "", true)
  check_attr_op(@simplecss.Exists, "x", true)
  check_attr_op(@simplecss.Matches("a"), "a", true)
  check_attr_op(@simplecss.Matches("a"), "ab", false)
  check_attr_op(@simplecss.Matches(""), "", true)
  check_attr_op(@simplecss.Contains("b"), "a b c", true)
  check_attr_op(@simplecss.Contains("b"), "a  b", true)
  check_attr_op(@simplecss.Contains("b"), "abc", false)
  check_attr_op(@simplecss.Contains(""), "a  b", true)
  check_attr_op(@simplecss.Contains(""), "a b", false)
  check_attr_op(@simplecss.Contains(""), "", true)
  check_attr_op(@simplecss.Contains("a b"), "a b", false)
  check_attr_op(@simplecss.Contains("b"), "a\tb", false)
  check_attr_op(@simplecss.StartsWith("en"), "en", true)
  check_attr_op(@simplecss.StartsWith("en"), "en-US", true)
  check_attr_op(@simplecss.StartsWith("en"), "enx", false)
  check_attr_op(@simplecss.StartsWith("en"), "en-", true)
  check_attr_op(@simplecss.StartsWith("en"), "e", false)
  check_attr_op(@simplecss.StartsWith("en"), "fr-en", false)
  check_attr_op(@simplecss.StartsWith(""), "-x", true)
  check_attr_op(@simplecss.StartsWith(""), "x", false)
  check_attr_op(@simplecss.StartsWith(""), "", true)
  check_attr_op(@simplecss.StartsWith("é"), "é-x", true)
  check_attr_op(@simplecss.StartsWith("é"), "éx", false)
  check_attr_op(@simplecss.StartsWith("☃"), "☃-", true)
}

///|
test "error_display" {
  check_error(@simplecss.UnexpectedEndOfStream, "unexpected end of stream")
  check_error(
    @simplecss.InvalidIdent(@simplecss.TextPos::new(1, 2)),
    "invalid ident at 1:2",
  )
  check_error(
    @simplecss.InvalidComment(@simplecss.TextPos::new(3, 4)),
    "invalid comment at 3:4",
  )
  check_error(
    @simplecss.InvalidValue(@simplecss.TextPos::new(10, 20)),
    "invalid value at 10:20",
  )
  check_error(
    @simplecss.InvalidByte(
      expected=b'\x3D',
      actual=b'\x5D',
      pos=@simplecss.TextPos::new(1, 5),
    ),
    "expected '=' not ']' at 1:5",
  )
  check_error(
    @simplecss.InvalidByte(
      expected=b'\x29',
      actual=b'\xC3',
      pos=@simplecss.TextPos::new(2, 1),
    ),
    "expected ')' not 'Ã' at 2:1",
  )
  check_error(
    @simplecss.InvalidByte(
      expected=b'\x2A',
      actual=b'\x80',
      pos=@simplecss.TextPos::new(2, 1),
    ),
    "expected '*' not '\u{80}' at 2:1",
  )
  check_error(@simplecss.SelectorMissing, "selector missing")
  check_error(@simplecss.UnexpectedSelector, "unexpected selector")
  check_error(@simplecss.UnexpectedCombinator, "unexpected combinator")
  check_error(
    @simplecss.InvalidAttributeSelector,
    "invalid or unsupported attribute selector",
  )
  check_error(
    @simplecss.InvalidLanguagePseudoClass,
    "invalid language pseudo-class",
  )
  check_display(@simplecss.FirstChild, "first-child")
  check_display(@simplecss.Link, "link")
  check_display(@simplecss.Visited, "visited")
  check_display(@simplecss.Hover, "hover")
  check_display(@simplecss.Active, "active")
  check_display(@simplecss.Focus, "focus")
  check_display(@simplecss.Lang("en-US"), "lang(en-US)")
  check_display(@simplecss.TextPos::new(7, 9), "7:9")
}
