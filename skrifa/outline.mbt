// Port of skrifa 0.42.1 `src/outline/mod.rs` and `src/outline/hint.rs`
// (glyf and CFF sources; VARC, CFF2, autohinting and the HarfBuzz path
// style are not supported).

///|
/// Source format for an outline glyph.
pub(all) enum OutlineGlyphFormat {
  /// TrueType outlines sourced from the `glyf` table.
  Glyf
  /// PostScript outlines sourced from the `CFF` table.
  Cff
  /// PostScript outlines sourced from the `CFF2` table.
  Cff2
  /// Variable composites sourced from the `VARC` table.
  Varc
} derive(Eq, Debug)

///|
#deprecated("call as `Eq::m(x)`, or un-deprecate this `extend` to make it a method")
#doc(hidden)
pub extend OutlineGlyphFormat with Eq::{not_equal, equal}

///|
#deprecated("call as `Debug::m(x)`, or un-deprecate this `extend` to make it a method")
#doc(hidden)
pub extend OutlineGlyphFormat with @debug.Debug::{to_repr}

///|
/// Information and adjusted metrics generated while drawing an outline
/// glyph.
pub(all) struct AdjustedMetrics {
  /// True if the underlying glyph contains flags indicating the
  /// presence of overlapping contours or components.
  has_overlaps : Bool
  /// If present, an adjusted left side bearing value generated by the
  /// scaler.
  lsb : Float?
  /// If present, an adjusted advance width value generated by the
  /// scaler.
  advance_width : Float?
} derive(Eq, Debug)

///|
#deprecated("call as `Eq::m(x)`, or un-deprecate this `extend` to make it a method")
#doc(hidden)
pub extend AdjustedMetrics with Eq::{not_equal, equal}

///|
#deprecated("call as `Debug::m(x)`, or un-deprecate this `extend` to make it a method")
#doc(hidden)
pub extend AdjustedMetrics with @debug.Debug::{to_repr}

///|
fn AdjustedMetrics::default() -> AdjustedMetrics {
  { has_overlaps: false, lsb: None, advance_width: None, }
}

///|
priv enum DrawInstance {
  Unhinted(Size, LocationRef)
  Hinted(HintingInstance, Bool)
}

///|
/// Options that define how a glyph is drawn to a pen.
pub struct DrawSettings {
  priv instance : DrawInstance
}

///|
/// Creates settings for an unhinted draw operation with the given size and
/// location in variation space.
pub fn DrawSettings::unhinted(
  size : Size,
  location : LocationRef,
) -> DrawSettings {
  { instance: Unhinted(size, location), }
}

///|
/// Creates settings for a hinted draw operation using hinting data
/// contained in the font.
///
/// If `is_pedantic` is true then any error that occurs during hinting will
/// cause drawing to fail.
pub fn DrawSettings::hinted(
  instance : HintingInstance,
  is_pedantic : Bool,
) -> DrawSettings {
  { instance: Hinted(instance, is_pedantic), }
}

///|
priv enum OutlineKind {
  GlyfKind(GlyfOutlines, GlyfOutline)
  // Third field is subfont index
  CffKind(CffOutlines, GlyphId, Int)
}

///|
/// A scalable glyph outline.
pub struct OutlineGlyph {
  priv kind : OutlineKind
}

///|
/// Returns the underlying source format for this outline.
pub fn OutlineGlyph::format(self : OutlineGlyph) -> OutlineGlyphFormat {
  match self.kind {
    GlyfKind(_, _) => Glyf
    CffKind(_, _, _) => Cff
  }
}

///|
/// Returns the glyph identifier for this outline.
pub fn OutlineGlyph::glyph_id(self : OutlineGlyph) -> GlyphId {
  match self.kind {
    GlyfKind(_, outline) => outline.glyph_id
    CffKind(_, gid, _) => gid
  }
}

///|
/// Returns a value indicating if the outline may contain overlapping
/// contours or components.
pub fn OutlineGlyph::has_overlaps(self : OutlineGlyph) -> Bool? {
  match self.kind {
    GlyfKind(_, outline) => Some(outline.has_overlaps)
    _ => None
  }
}

///|
/// Returns a value indicating whether the outline has hinting
/// instructions.
pub fn OutlineGlyph::has_hinting(self : OutlineGlyph) -> Bool? {
  match self.kind {
    GlyfKind(_, outline) => Some(outline.has_hinting)
    _ => None
  }
}

///|
/// Draws the outline glyph with the given settings and emits the resulting
/// path commands to the specified pen.
pub fn OutlineGlyph::draw(
  self : OutlineGlyph,
  settings : DrawSettings,
  pen : &OutlinePen,
) -> AdjustedMetrics raise DrawError {
  match settings.instance {
    Unhinted(size, location) => self.draw_unhinted(size, location, pen)
    Hinted(hinting_instance, is_pedantic) =>
      if hinting_instance.is_enabled() {
        hinting_instance.draw(self, pen, is_pedantic)
      } else {
        let metrics = self.draw_unhinted(
          hinting_instance.size,
          LocationRef(hinting_instance.coords),
          pen,
        )
        // Round advance width when hinting is requested, even if
        // the instance is disabled.
        {
          ..metrics,
          advance_width: match metrics.advance_width {
            Some(a) => Some(round_f32(a))
            None => None
          },
        }
      }
  }
}

///|
fn OutlineGlyph::draw_unhinted(
  self : OutlineGlyph,
  size : Size,
  _location : LocationRef,
  pen : &OutlinePen,
) -> AdjustedMetrics raise DrawError {
  let ppem = size.ppem()
  match self.kind {
    GlyfKind(glyf, outline) => {
      let scaled_outline = FreeTypeScaler::unhinted(glyf, outline, ppem).scale(
        outline.glyph,
        outline.glyph_id,
      )
      to_path(
        scaled_outline.xs,
        scaled_outline.ys,
        scaled_outline.flags,
        scaled_outline.contours,
        pen,
      ) catch {
        e => raise DrawError::ToPath(e)
      }
      {
        has_overlaps: outline.has_overlaps,
        lsb: Some(scaled_outline.adjusted_lsb().to_f32()),
        advance_width: Some(scaled_outline.adjusted_advance_width().to_f32()),
      }
    }
    CffKind(cff, glyph_id, subfont_ix) => {
      let subfont = cff.subfont(subfont_ix, ppem) catch {
        e => raise PostScript(e)
      }
      cff.draw(subfont, glyph_id, pen) catch {
        e => raise PostScript(e)
      }
      AdjustedMetrics::default()
    }
  }
}

///|
priv enum OutlineCollectionKind {
  CollNone
  CollGlyf(GlyfOutlines)
  CollCff(CffOutlines)
}

///|
/// Collection of scalable glyph outlines.
pub struct OutlineGlyphCollection {
  priv kind : OutlineCollectionKind
}

///|
/// Creates a new outline collection for the given font.
pub fn OutlineGlyphCollection::new(font : FontRef) -> OutlineGlyphCollection {
  let kind = match GlyfOutlines::new(font) {
    Some(glyf) => CollGlyf(glyf)
    None =>
      match CffOutlines::new(font) {
        Some(cff) => CollCff(cff)
        None => CollNone
      }
  }
  { kind, }
}

///|
/// Returns the underlying format of the source outline tables.
pub fn OutlineGlyphCollection::format(
  self : OutlineGlyphCollection,
) -> OutlineGlyphFormat? {
  match self.kind {
    CollGlyf(_) => Some(Glyf)
    CollCff(_) => Some(Cff)
    CollNone => None
  }
}

///|
/// Returns the outline for the given glyph identifier.
pub fn OutlineGlyphCollection::get(
  self : OutlineGlyphCollection,
  glyph_id : GlyphId,
) -> OutlineGlyph? {
  match self.kind {
    CollNone => None
    CollGlyf(glyf) => {
      let outline = glyf.outline(glyph_id) catch { _ => return None }
      Some({ kind: GlyfKind(glyf, outline), })
    }
    CollCff(cff) =>
      Some({ kind: CffKind(cff, glyph_id, cff.subfont_index(glyph_id)), })
  }
}

///|
/// Returns true if the interpreter engine should be used for hinting this
/// set of outlines.
pub fn OutlineGlyphCollection::prefer_interpreter(
  self : OutlineGlyphCollection,
) -> Bool {
  match self.kind {
    CollGlyf(glyf) => glyf.prefer_interpreter
    _ => true
  }
}

///|
/// Returns true when the interpreter engine _must_ be used for hinting
/// this set of outlines to produce correct results.
///
/// This corresponds to FreeType's `FT_FACE_FLAG_TRICKY` face flag.
pub fn OutlineGlyphCollection::require_interpreter(
  self : OutlineGlyphCollection,
) -> Bool {
  match self.font() {
    Some(font) => require_interpreter(font)
    None => false
  }
}

///|
/// Returns true when the font supports hinting at fractional sizes.
pub fn OutlineGlyphCollection::fractional_size_hinting(
  self : OutlineGlyphCollection,
) -> Bool {
  match self.kind {
    CollGlyf(glyf) => glyf.fractional_size_hinting
    _ => true
  }
}

///|
fn OutlineGlyphCollection::font(self : OutlineGlyphCollection) -> FontRef? {
  match self.kind {
    CollGlyf(glyf) => Some(glyf.font)
    CollCff(cff) => Some(cff.font)
    CollNone => None
  }
}

// ---------------------------------------------------------------------------
// Hinting

///|
/// Configuration settings for a hinting instance.
pub(all) struct HintingOptions {
  /// Specifies the hinting engine to use.
  engine : Engine
  /// Defines the properties of the intended target of a hinted outline.
  target : Target
} derive(Eq, Debug)

///|
#deprecated("call as `Eq::m(x)`, or un-deprecate this `extend` to make it a method")
#doc(hidden)
pub extend HintingOptions with Eq::{not_equal, equal}

///|
#deprecated("call as `Debug::m(x)`, or un-deprecate this `extend` to make it a method")
#doc(hidden)
pub extend HintingOptions with @debug.Debug::{to_repr}

///|
/// Specifies the backend to use when applying hints.
pub(all) enum Engine {
  /// The TrueType or PostScript interpreter.
  Interpreter
  /// The automatic hinter (not supported by this port).
  Auto
  /// Selects the engine based on the same rules that FreeType uses.
  AutoFallback
} derive(Eq, Debug)

///|
#deprecated("call as `Eq::m(x)`, or un-deprecate this `extend` to make it a method")
#doc(hidden)
pub extend Engine with Eq::{not_equal, equal}

///|
#deprecated("call as `Debug::m(x)`, or un-deprecate this `extend` to make it a method")
#doc(hidden)
pub extend Engine with @debug.Debug::{to_repr}

///|
/// Defines the target settings for hinting.
pub(all) enum Target {
  /// Strong hinting style that should only be used for aliased, monochromatic
  /// rasterization.
  Mono
  /// Hinting style that is suitable for anti-aliased rasterization.
  Smooth(
    mode~ : SmoothMode,
    symmetric_rendering~ : Bool,
    preserve_linear_metrics~ : Bool
  )
} derive(Eq, Debug)

///|
#deprecated("call as `Eq::m(x)`, or un-deprecate this `extend` to make it a method")
#doc(hidden)
pub extend Target with Eq::{not_equal, equal}

///|
#deprecated("call as `Debug::m(x)`, or un-deprecate this `extend` to make it a method")
#doc(hidden)
pub extend Target with @debug.Debug::{to_repr}

///|
/// Mode selector for a smooth hinting target.
pub(all) enum SmoothMode {
  Normal
  Light
  Lcd
  VerticalLcd
} derive(Eq, Debug)

///|
#deprecated("call as `Eq::m(x)`, or un-deprecate this `extend` to make it a method")
#doc(hidden)
pub extend SmoothMode with Eq::{not_equal, equal}

///|
#deprecated("call as `Debug::m(x)`, or un-deprecate this `extend` to make it a method")
#doc(hidden)
pub extend SmoothMode with @debug.Debug::{to_repr}

///|
/// Modes that control hinting when using embedded instructions.
pub struct HintingInstance {
  size : Size
  coords : Array[F2Dot14]
  target : Target
  priv kind : HinterKind
}

///|
priv enum HinterKind {
  HNone
  HGlyf(HintInstance)
}

///|
/// Creates a new embedded hinting instance for the given outline
/// collection, size, location in variation space and hinting mode.
pub fn HintingInstance::new(
  outline_glyphs : OutlineGlyphCollection,
  size : Size,
  location : LocationRef,
  options : HintingOptions,
) -> HintingInstance raise DrawError {
  let coords = if location.is_default() { [] } else { location.coords() }
  let engine = match options.engine {
    AutoFallback =>
      if outline_glyphs.prefer_interpreter() {
        Engine::Interpreter
      } else {
        Engine::Auto
      }
    e => e
  }
  let kind : HinterKind = match engine {
    Interpreter =>
      match outline_glyphs.kind {
        CollGlyf(glyf) => {
          let ppem = size.ppem()
          let scale = glyf.compute_hinted_scale(ppem).1.to_bits()
          // Use fixed point rounding for ppem to match what FreeType does
          let rounded_ppem = (
              (Fixed::from_bits(scale) * Fixed::from_bits(glyf.units_per_em)).to_bits() +
              32
            ) >>
            6
          HGlyf(HintInstance::new(glyf, scale, rounded_ppem, options.target))
        }
        // TODO(p4-skrifa): PostScript hinting for CFF outlines is not
        // ported.
        CollCff(_) => raise HintingFailed("CFF hinting is not supported")
        CollNone => HNone
      }
    // TODO(p4-skrifa): the autohinter is not ported.
    _ => raise HintingFailed("autohinting is not supported")
  }
  { size, coords, target: options.target, kind, }
}

///|
/// Returns the currently configured size.
pub fn HintingInstance::size(self : HintingInstance) -> Size {
  self.size
}

///|
/// Returns true if hinting should actually be applied for this instance.
pub fn HintingInstance::is_enabled(self : HintingInstance) -> Bool {
  match self.kind {
    HGlyf(instance) => instance.is_enabled()
    _ => false
  }
}

///|
fn HintingInstance::draw(
  self : HintingInstance,
  glyph : OutlineGlyph,
  pen : &OutlinePen,
  is_pedantic : Bool,
) -> AdjustedMetrics raise DrawError {
  let ppem = self.size.ppem()
  match (self.kind, glyph.kind) {
    (HGlyf(instance), GlyfKind(glyf, outline)) => {
      let scaled_outline = FreeTypeScaler::hinted(
        glyf, outline, ppem, instance, is_pedantic,
      ).scale(outline.glyph, outline.glyph_id)
      to_path(
        scaled_outline.xs,
        scaled_outline.ys,
        scaled_outline.flags,
        scaled_outline.contours,
        pen,
      ) catch {
        e => raise DrawError::ToPath(e)
      }
      {
        has_overlaps: outline.has_overlaps,
        lsb: Some(scaled_outline.adjusted_lsb().to_f32()),
        // When hinting is requested, we round the advance
        // <https://gitlab.freedesktop.org/freetype/freetype/-/blob/57617782464411201ce7bbc93b086c1b4d7d84a5/src/base/ftobjs.c#L889>
        advance_width: Some(
          scaled_outline.adjusted_advance_width().round().to_f32(),
        ),
      }
    }
    _ => raise NoSources
  }
}

///|
/// Rust `f32::round` (half away from zero).
fn round_f32(a : Float) -> Float {
  let t = a.trunc()
  if (a - t).abs() >= 0.5 {
    t + a.signum()
  } else {
    t
  }
}
