// Port of rustybuzz 0.20.1 `src/hb/ot_shaper_khmer_machine.rs` (generated by
// Ragel). The data tables are generated into
// `ot_shaper_khmer_machine_gen.mbt`; the driver below is ported by hand.

///|
priv enum KhmerSyllableType {
  ConsonantSyllable
  BrokenCluster
  NonKhmerCluster
}

///|
fn KhmerSyllableType::to_int(self : KhmerSyllableType) -> Int {
  match self {
    ConsonantSyllable => 0
    BrokenCluster => 1
    NonKhmerCluster => 2
  }
}

///|
fn find_syllables_khmer(buffer : Buffer) -> Unit {
  let mut cs = 0
  let mut ts = 0
  let mut te = 0
  let mut act = 0
  let mut p = 0
  let pe = buffer.len
  let eof = buffer.len
  let syllable_serial = Ref(1)
  fn found_syllable(ts : Int, te : Int, kind : KhmerSyllableType) {
    found_syllable_khmer(ts, te, syllable_serial, kind.to_int(), buffer)
  }

  {
    cs = khmer_syllable_machine_start
    ts = 0
    te = 0
    act = 0
  }
  let mut _klen = 0
  let mut _trans = 0
  let mut _keys = 0
  let mut _acts = 0
  let mut _nacts = 0
  let mut __have = 0
  // '_resume
  while p != pe || p == eof {
    // '_again (runs once)
    _acts = khmer_syllable_machine_from_state_actions[cs]
    _nacts = khmer_syllable_machine_actions[_acts]
    _acts += 1
    while _nacts > 0 {
      match khmer_syllable_machine_actions[_acts] {
        1 => ts = p
        _ => ()
      }
      _nacts -= 1
      _acts += 1
    }
    if p == eof {
      if khmer_syllable_machine_eof_trans[cs] > 0 {
        _trans = khmer_syllable_machine_eof_trans[cs] - 1
      }
    } else {
      _keys = khmer_syllable_machine_key_offsets[cs]
      _trans = khmer_syllable_machine_index_offsets[cs]
      _klen = khmer_syllable_machine_single_lengths[cs]
      __have = 0
      let c = buffer.info[p].khmer_category()
      if _klen > 0 {
        let mut _lower = _keys
        let mut _upper = _keys + _klen - 1
        let mut _mid = 0
        while true {
          if _upper < _lower {
            _keys += _klen
            _trans += _klen
            break
          }
          _mid = _lower + ((_upper - _lower) >> 1)
          if c < khmer_syllable_machine_trans_keys[_mid] {
            _upper = _mid - 1
          } else if c > khmer_syllable_machine_trans_keys[_mid] {
            _lower = _mid + 1
          } else {
            __have = 1
            _trans += _mid - _keys
            break
          }
        }
      }
      _klen = khmer_syllable_machine_range_lengths[cs]
      if __have == 0 && _klen > 0 {
        let mut _lower = _keys
        let mut _upper = _keys + (_klen << 1) - 2
        let mut _mid = 0
        while true {
          if _upper < _lower {
            _trans += _klen
            break
          }
          _mid = _lower + (((_upper - _lower) >> 1) & -2)
          if c < khmer_syllable_machine_trans_keys[_mid] {
            _upper = _mid - 2
          } else if c > khmer_syllable_machine_trans_keys[_mid + 1] {
            _lower = _mid + 2
          } else {
            _trans += (_mid - _keys) >> 1
            break
          }
        }
      }
    }
    cs = khmer_syllable_machine_cond_targs[_trans]
    if khmer_syllable_machine_cond_actions[_trans] != 0 {
      _acts = khmer_syllable_machine_cond_actions[_trans]
      _nacts = khmer_syllable_machine_actions[_acts]
      _acts += 1
      while _nacts > 0 {
        match khmer_syllable_machine_actions[_acts] {
          2 => te = p + 1
          3 => act = 2
          4 => act = 3
          5 => {
            te = p + 1
            found_syllable(ts, te, NonKhmerCluster)
          }
          6 => {
            te = p
            p = p - 1
            found_syllable(ts, te, ConsonantSyllable)
          }
          7 => {
            te = p
            p = p - 1
            found_syllable(ts, te, BrokenCluster)
            buffer.scratch_flags = buffer.scratch_flags |
              HB_BUFFER_SCRATCH_FLAG_HAS_BROKEN_SYLLABLE
          }
          8 => {
            te = p
            p = p - 1
            found_syllable(ts, te, NonKhmerCluster)
          }
          9 => {
            p = te - 1
            found_syllable(ts, te, ConsonantSyllable)
          }
          10 => {
            p = te - 1
            found_syllable(ts, te, BrokenCluster)
            buffer.scratch_flags = buffer.scratch_flags |
              HB_BUFFER_SCRATCH_FLAG_HAS_BROKEN_SYLLABLE
          }
          11 =>
            match act {
              2 => {
                p = te - 1
                found_syllable(ts, te, BrokenCluster)
                buffer.scratch_flags = buffer.scratch_flags |
                  HB_BUFFER_SCRATCH_FLAG_HAS_BROKEN_SYLLABLE
              }
              3 => {
                p = te - 1
                found_syllable(ts, te, NonKhmerCluster)
              }
              _ => ()
            }
          _ => ()
        }
        _nacts -= 1
        _acts += 1
      }
    }
    // break '_again
    if p == eof {
      if cs >= khmer_syllable_machine_first_final {
        break
      }
    } else {
      _acts = khmer_syllable_machine_to_state_actions[cs]
      _nacts = khmer_syllable_machine_actions[_acts]
      _acts += 1
      while _nacts > 0 {
        match khmer_syllable_machine_actions[_acts] {
          0 => ts = 0
          _ => ()
        }
        _nacts -= 1
        _acts += 1
      }
      p += 1
      continue
    }
    break
  }
}

///|
fn found_syllable_khmer(
  start : Int,
  end : Int,
  syllable_serial : Ref[Int],
  kind : Int,
  buffer : Buffer,
) -> Unit {
  for i in start..<end {
    buffer.info[i].set_syllable((syllable_serial.val << 4) | kind)
  }
  syllable_serial.val += 1
  if syllable_serial.val == 16 {
    syllable_serial.val = 1
  }
}
