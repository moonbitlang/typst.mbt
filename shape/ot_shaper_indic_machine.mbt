// Port of rustybuzz 0.20.1 `src/hb/ot_shaper_indic_machine.rs` (generated by
// Ragel). The data tables are generated into
// `ot_shaper_indic_machine_gen.mbt`; the driver below is ported by hand.

///|
priv enum IndicSyllableType {
  ConsonantSyllable
  VowelSyllable
  StandaloneCluster
  SymbolCluster
  BrokenCluster
  NonIndicCluster
}

///|
fn IndicSyllableType::to_int(self : IndicSyllableType) -> Int {
  match self {
    ConsonantSyllable => 0
    VowelSyllable => 1
    StandaloneCluster => 2
    SymbolCluster => 3
    BrokenCluster => 4
    NonIndicCluster => 5
  }
}

///|
fn find_syllables_indic(buffer : Buffer) -> Unit {
  let mut cs = 0
  let mut ts = 0
  let mut te = 0
  let mut act = 0
  let mut p = 0
  let pe = buffer.len
  let eof = buffer.len
  let syllable_serial = Ref(1)
  fn found_syllable(ts : Int, te : Int, kind : IndicSyllableType) {
    found_syllable_indic(ts, te, syllable_serial, kind.to_int(), buffer)
  }

  {
    cs = indic_syllable_machine_start
    ts = 0
    te = 0
    act = 0
  }
  let mut _klen = 0
  let mut _trans = 0
  let mut _keys = 0
  let mut _acts = 0
  let mut _nacts = 0
  let mut __have = 0
  // '_resume
  while p != pe || p == eof {
    // '_again (runs once)
    _acts = indic_syllable_machine_from_state_actions[cs]
    _nacts = indic_syllable_machine_actions[_acts]
    _acts += 1
    while _nacts > 0 {
      match indic_syllable_machine_actions[_acts] {
        1 => ts = p
        _ => ()
      }
      _nacts -= 1
      _acts += 1
    }
    if p == eof {
      if indic_syllable_machine_eof_trans[cs] > 0 {
        _trans = indic_syllable_machine_eof_trans[cs] - 1
      }
    } else {
      _keys = indic_syllable_machine_key_offsets[cs]
      _trans = indic_syllable_machine_index_offsets[cs]
      _klen = indic_syllable_machine_single_lengths[cs]
      __have = 0
      let c = buffer.info[p].indic_category()
      if _klen > 0 {
        let mut _lower = _keys
        let mut _upper = _keys + _klen - 1
        let mut _mid = 0
        while true {
          if _upper < _lower {
            _keys += _klen
            _trans += _klen
            break
          }
          _mid = _lower + ((_upper - _lower) >> 1)
          if c < indic_syllable_machine_trans_keys[_mid] {
            _upper = _mid - 1
          } else if c > indic_syllable_machine_trans_keys[_mid] {
            _lower = _mid + 1
          } else {
            __have = 1
            _trans += _mid - _keys
            break
          }
        }
      }
      _klen = indic_syllable_machine_range_lengths[cs]
      if __have == 0 && _klen > 0 {
        let mut _lower = _keys
        let mut _upper = _keys + (_klen << 1) - 2
        let mut _mid = 0
        while true {
          if _upper < _lower {
            _trans += _klen
            break
          }
          _mid = _lower + (((_upper - _lower) >> 1) & -2)
          if c < indic_syllable_machine_trans_keys[_mid] {
            _upper = _mid - 2
          } else if c > indic_syllable_machine_trans_keys[_mid + 1] {
            _lower = _mid + 2
          } else {
            _trans += (_mid - _keys) >> 1
            break
          }
        }
      }
    }
    cs = indic_syllable_machine_cond_targs[_trans]
    if indic_syllable_machine_cond_actions[_trans] != 0 {
      _acts = indic_syllable_machine_cond_actions[_trans]
      _nacts = indic_syllable_machine_actions[_acts]
      _acts += 1
      while _nacts > 0 {
        match indic_syllable_machine_actions[_acts] {
          2 => te = p + 1
          3 => act = 1
          4 => act = 5
          5 => act = 6
          6 => {
            te = p + 1
            found_syllable(ts, te, NonIndicCluster)
          }
          7 => {
            te = p
            p = p - 1
            found_syllable(ts, te, ConsonantSyllable)
          }
          8 => {
            te = p
            p = p - 1
            found_syllable(ts, te, VowelSyllable)
          }
          9 => {
            te = p
            p = p - 1
            found_syllable(ts, te, StandaloneCluster)
          }
          10 => {
            te = p
            p = p - 1
            found_syllable(ts, te, SymbolCluster)
          }
          11 => {
            te = p
            p = p - 1
            found_syllable(ts, te, BrokenCluster)
            buffer.scratch_flags = buffer.scratch_flags |
              HB_BUFFER_SCRATCH_FLAG_HAS_BROKEN_SYLLABLE
          }
          12 => {
            te = p
            p = p - 1
            found_syllable(ts, te, NonIndicCluster)
          }
          13 => {
            p = te - 1
            found_syllable(ts, te, ConsonantSyllable)
          }
          14 => {
            p = te - 1
            found_syllable(ts, te, VowelSyllable)
          }
          15 => {
            p = te - 1
            found_syllable(ts, te, StandaloneCluster)
          }
          16 => {
            p = te - 1
            found_syllable(ts, te, SymbolCluster)
          }
          17 => {
            p = te - 1
            found_syllable(ts, te, BrokenCluster)
            buffer.scratch_flags = buffer.scratch_flags |
              HB_BUFFER_SCRATCH_FLAG_HAS_BROKEN_SYLLABLE
          }
          18 =>
            match act {
              1 => {
                p = te - 1
                found_syllable(ts, te, ConsonantSyllable)
              }
              5 => {
                p = te - 1
                found_syllable(ts, te, BrokenCluster)
                buffer.scratch_flags = buffer.scratch_flags |
                  HB_BUFFER_SCRATCH_FLAG_HAS_BROKEN_SYLLABLE
              }
              6 => {
                p = te - 1
                found_syllable(ts, te, NonIndicCluster)
              }
              _ => ()
            }
          _ => ()
        }
        _nacts -= 1
        _acts += 1
      }
    }
    // break '_again
    if p == eof {
      if cs >= indic_syllable_machine_first_final {
        break
      }
    } else {
      _acts = indic_syllable_machine_to_state_actions[cs]
      _nacts = indic_syllable_machine_actions[_acts]
      _acts += 1
      while _nacts > 0 {
        match indic_syllable_machine_actions[_acts] {
          0 => ts = 0
          _ => ()
        }
        _nacts -= 1
        _acts += 1
      }
      p += 1
      continue
    }
    break
  }
}

///|
fn found_syllable_indic(
  start : Int,
  end : Int,
  syllable_serial : Ref[Int],
  kind : Int,
  buffer : Buffer,
) -> Unit {
  for i in start..<end {
    buffer.info[i].set_syllable((syllable_serial.val << 4) | kind)
  }
  syllable_serial.val += 1
  if syllable_serial.val == 16 {
    syllable_serial.val = 1
  }
}
