///|
const OFFSET_0X0028 : Int = 0

///|
const OFFSET_0X00B0 : Int = 24

///|
const OFFSET_0X0900 : Int = 64

///|
const OFFSET_0X1000 : Int = 1216

///|
const OFFSET_0X1780 : Int = 1376

///|
const OFFSET_0X1CD0 : Int = 1488

///|
const OFFSET_0X2008 : Int = 1536

///|
const OFFSET_0X2070 : Int = 1568

///|
const OFFSET_0X25F8 : Int = 1592

///|
const OFFSET_0XA8E0 : Int = 1600

///|
const OFFSET_0XA9E0 : Int = 1632

///|
const OFFSET_0XAA60 : Int = 1664

///|
const OFFSET_0XFE00 : Int = 1696

///|
const OFFSET_0X11300 : Int = 1712

///|
const OFFSET_0X11338 : Int = 1720

///|
const OFFSET_0X116D0 : Int = 1728

///|
fn get_categories(u : Int) -> (Int, Int) {
  match u >> 12 {
    0x0 => {
      if u == 0x00A0 {
        return (OT_PLACEHOLDER, POS_BASE_C)
      }
      if u >= 0x0028 && u <= 0x003F {
        return indic_table[u - 0x0028 + OFFSET_0X0028]
      }
      if u >= 0x00B0 && u <= 0x00D7 {
        return indic_table[u - 0x00B0 + OFFSET_0X00B0]
      }
      if u >= 0x0900 && u <= 0x0D7F {
        return indic_table[u - 0x0900 + OFFSET_0X0900]
      }
    }
    0x1 => {
      if u >= 0x1000 && u <= 0x109F {
        return indic_table[u - 0x1000 + OFFSET_0X1000]
      }
      if u >= 0x1780 && u <= 0x17EF {
        return indic_table[u - 0x1780 + OFFSET_0X1780]
      }
      if u >= 0x1CD0 && u <= 0x1CFF {
        return indic_table[u - 0x1CD0 + OFFSET_0X1CD0]
      }
    }
    0x2 => {
      if u == 0x25CC {
        return (OT_DOTTEDCIRCLE, POS_BASE_C)
      }
      if u >= 0x2008 && u <= 0x2027 {
        return indic_table[u - 0x2008 + OFFSET_0X2008]
      }
      if u >= 0x2070 && u <= 0x2087 {
        return indic_table[u - 0x2070 + OFFSET_0X2070]
      }
      if u >= 0x25F8 && u <= 0x25FF {
        return indic_table[u - 0x25F8 + OFFSET_0X25F8]
      }
    }
    0xA => {
      if u >= 0xA8E0 && u <= 0xA8FF {
        return indic_table[u - 0xA8E0 + OFFSET_0XA8E0]
      }
      if u >= 0xA9E0 && u <= 0xA9FF {
        return indic_table[u - 0xA9E0 + OFFSET_0XA9E0]
      }
      if u >= 0xAA60 && u <= 0xAA7F {
        return indic_table[u - 0xAA60 + OFFSET_0XAA60]
      }
    }
    0xF =>
      if u >= 0xFE00 && u <= 0xFE0F {
        return indic_table[u - 0xFE00 + OFFSET_0XFE00]
      }
    0x11 => {
      if u >= 0x11300 && u <= 0x11307 {
        return indic_table[u - 0x11300 + OFFSET_0X11300]
      }
      if u >= 0x11338 && u <= 0x1133F {
        return indic_table[u - 0x11338 + OFFSET_0X11338]
      }
      if u >= 0x116D0 && u <= 0x116E7 {
        return indic_table[u - 0x116D0 + OFFSET_0X116D0]
      }
    }
    _ => ()
  }
  (OT_X, POS_END)
}
