// Port of rustybuzz 0.20.1 `src/hb/ot_shaper_vowel_constraints.rs`.
// WARNING: the Rust file was generated by scripts/gen-vowel-constraints.py;
// this port was converted mechanically from it.

///|
fn output_dotted_circle(buffer : Buffer) -> Unit {
  buffer.output_glyph(0x25CC)
  let out_idx = buffer.out_len - 1
  buffer.out_info()[out_idx].reset_continuation()
}

///|
fn output_with_dotted_circle(buffer : Buffer) -> Unit {
  output_dotted_circle(buffer)
  buffer.next_glyph()
}

///|
fn preprocess_text_vowel_constraints(buffer : Buffer) -> Unit {
  if (buffer.flags & BUFFER_FLAG_DO_NOT_INSERT_DOTTED_CIRCLE) != 0 {
    return
  }

  // UGLY UGLY UGLY business of adding dotted-circle in the middle of
  // vowel-sequences that look like another vowel.  Data for each script
  // collected from the USE script development spec.
  //
  // https://github.com/harfbuzz/harfbuzz/issues/1019
  buffer.clear_output()
  if buffer.script == Some(script_devanagari) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x0905U =>
          match buffer.cur(1).glyph_id {
            0x093AU
            | 0x093BU
            | 0x093EU
            | 0x0945U
            | 0x0946U
            | 0x0949U
            | 0x094AU
            | 0x094BU
            | 0x094CU
            | 0x094FU
            | 0x0956U
            | 0x0957U => matched = true
            _ => ()
          }
        0x0906U =>
          match buffer.cur(1).glyph_id {
            0x093AU | 0x0945U | 0x0946U | 0x0947U | 0x0948U => matched = true
            _ => ()
          }
        0x0909U => matched = 0x0941U == buffer.cur(1).glyph_id
        0x090FU =>
          match buffer.cur(1).glyph_id {
            0x0945U | 0x0946U | 0x0947U => matched = true
            _ => ()
          }
        0x0930U =>
          if 0x094DU == buffer.cur(1).glyph_id &&
            buffer.idx + 2 < buffer.len &&
            0x0907U == buffer.cur(2).glyph_id {
            buffer.next_glyph()
            buffer.next_glyph()
            output_dotted_circle(buffer)
          }
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_bengali) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x0985U => matched = 0x09BEU == buffer.cur(1).glyph_id
        0x098BU => matched = 0x09C3U == buffer.cur(1).glyph_id
        0x098CU => matched = 0x09E2U == buffer.cur(1).glyph_id
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_gurmukhi) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x0A05U =>
          match buffer.cur(1).glyph_id {
            0x0A3EU | 0x0A48U | 0x0A4CU => matched = true
            _ => ()
          }
        0x0A72U =>
          match buffer.cur(1).glyph_id {
            0x0A3FU | 0x0A40U | 0x0A47U => matched = true
            _ => ()
          }
        0x0A73U =>
          match buffer.cur(1).glyph_id {
            0x0A41U | 0x0A42U | 0x0A4BU => matched = true
            _ => ()
          }
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_gujarati) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x0A85U =>
          match buffer.cur(1).glyph_id {
            0x0ABEU
            | 0x0AC5U
            | 0x0AC7U
            | 0x0AC8U
            | 0x0AC9U
            | 0x0ACBU
            | 0x0ACCU => matched = true
            _ => ()
          }
        0x0AC5U => matched = 0x0ABEU == buffer.cur(1).glyph_id
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_oriya) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x0B05U => matched = 0x0B3EU == buffer.cur(1).glyph_id
        0x0B0FU | 0x0B13U => matched = 0x0B57U == buffer.cur(1).glyph_id
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_tamil) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let matched = false
      if 0x0B85U == buffer.cur(0).glyph_id && 0x0BC2U == buffer.cur(1).glyph_id {
        buffer.next_glyph()
        output_dotted_circle(buffer)
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_telugu) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x0C12U =>
          match buffer.cur(1).glyph_id {
            0x0C4CU | 0x0C55U => matched = true
            _ => ()
          }
        0x0C3FU | 0x0C46U | 0x0C4AU =>
          matched = 0x0C55U == buffer.cur(1).glyph_id
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_kannada) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x0C89U | 0x0C8BU => matched = 0x0CBEU == buffer.cur(1).glyph_id
        0x0C92U => matched = 0x0CCCU == buffer.cur(1).glyph_id
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_malayalam) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x0D07U | 0x0D09U => matched = 0x0D57U == buffer.cur(1).glyph_id
        0x0D0EU => matched = 0x0D46U == buffer.cur(1).glyph_id
        0x0D12U =>
          match buffer.cur(1).glyph_id {
            0x0D3EU | 0x0D57U => matched = true
            _ => ()
          }
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_sinhala) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x0D85U =>
          match buffer.cur(1).glyph_id {
            0x0DCFU | 0x0DD0U | 0x0DD1U => matched = true
            _ => ()
          }
        0x0D8BU | 0x0D8FU | 0x0D94U =>
          matched = 0x0DDFU == buffer.cur(1).glyph_id
        0x0D8DU => matched = 0x0DD8U == buffer.cur(1).glyph_id
        0x0D91U =>
          match buffer.cur(1).glyph_id {
            0x0DCAU | 0x0DD9U | 0x0DDAU | 0x0DDCU | 0x0DDDU | 0x0DDEU =>
              matched = true
            _ => ()
          }
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_brahmi) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x11005U => matched = 0x11038U == buffer.cur(1).glyph_id
        0x1100BU => matched = 0x1103EU == buffer.cur(1).glyph_id
        0x1100FU => matched = 0x11042U == buffer.cur(1).glyph_id
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_khojki) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x11200U =>
          match buffer.cur(1).glyph_id {
            0x1122CU | 0x11231U | 0x11233U => matched = true
            _ => ()
          }
        0x11206U => matched = 0x1122CU == buffer.cur(1).glyph_id
        0x1122CU =>
          match buffer.cur(1).glyph_id {
            0x11230U | 0x11231U => matched = true
            _ => ()
          }
        0x11240U => matched = 0x1122EU == buffer.cur(1).glyph_id
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_khudawadi) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x112B0U =>
          match buffer.cur(1).glyph_id {
            0x112E0U | 0x112E5U | 0x112E6U | 0x112E7U | 0x112E8U =>
              matched = true
            _ => ()
          }
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_tirhuta) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x11481U => matched = 0x114B0U == buffer.cur(1).glyph_id
        0x1148BU | 0x1148DU => matched = 0x114BAU == buffer.cur(1).glyph_id
        0x114AAU =>
          match buffer.cur(1).glyph_id {
            0x114B5U | 0x114B6U => matched = true
            _ => ()
          }
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_modi) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x11600U | 0x11601U =>
          match buffer.cur(1).glyph_id {
            0x11639U | 0x1163AU => matched = true
            _ => ()
          }
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  } else if buffer.script == Some(script_takri) {
    buffer.idx = 0
    while buffer.idx + 1 < buffer.len {
      let mut matched = false
      match buffer.cur(0).glyph_id {
        0x11680U =>
          match buffer.cur(1).glyph_id {
            0x116ADU | 0x116B4U | 0x116B5U => matched = true
            _ => ()
          }
        0x11686U => matched = 0x116B2U == buffer.cur(1).glyph_id
        _ => ()
      }
      buffer.next_glyph()
      if matched {
        output_with_dotted_circle(buffer)
      }
    }
  }

  buffer.sync() |> ignore
}
