// Traits
pub(open) trait ColrPainter {
  fn outline_glyph(Self, GlyphId) -> Unit
  fn paint(Self, Paint) -> Unit
  fn push_clip(Self) -> Unit
  fn push_clip_box(Self, RectF) -> Unit
  fn pop_clip(Self) -> Unit
  fn push_layer(Self, CompositeMode) -> Unit
  fn pop_layer(Self) -> Unit
  fn push_transform(Self, Transform) -> Unit
  fn pop_transform(Self) -> Unit
}

pub(open) trait FromData {
  fn size() -> Int
  fn parse(BytesView) -> Self raise Malformed
}
pub impl FromData for Unit
pub impl FromData for Byte
pub impl FromData for Int
pub impl FromData for Int16
pub impl FromData for UInt
pub impl FromData for UInt16
pub impl FromData for UInt64
pub impl[T : Offset] FromData for T?

pub(open) trait FromSlice {
  fn parse_slice(BytesView) -> Self raise Malformed
}

pub(open) trait LookupSubtable {
  fn parse(BytesView, UInt16) -> Self raise Malformed
}

pub(open) trait Offset : FromData {
  fn to_usize(Self) -> Int
  fn is_null(Self) -> Bool
}

pub(open) trait OutlineBuilder {
  fn move_to(Self, Float, Float) -> Unit
  fn line_to(Self, Float, Float) -> Unit
  fn quad_to(Self, Float, Float, Float, Float) -> Unit
  fn curve_to(Self, Float, Float, Float, Float, Float, Float) -> Unit
  fn close(Self) -> Unit
}

pub(open) trait RecordListItem {
  fn parse(Tag, BytesView) -> Self raise Malformed
}
