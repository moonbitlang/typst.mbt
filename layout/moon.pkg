import {
  "moonbitlang/typst/library",
  "moonbitlang/typst/syntax",
  "moonbitlang/typst/unicode",
  "moonbitlang/typst/otf",
  "moonbitlang/typst/shape",
  "moonbitlang/typst/bidi",
  "moonbitlang/typst/linebreak",
  "moonbitlang/typst/hypher",
  "moonbitlang/core/hashset",
  "moonbitlang/core/math",
  "moonbitlang/core/double",
  "moonbitlang/core/cmp",
  "moonbitlang/core/int64",
  "moonbitlang/core/debug",
}

// `core/math` is only used by `libm_other.mbt` (the non-native targets; native
// calls the C library), and moon.pkg has no per-target imports.

warnings = "-unused_package"

options(
  targets: {
    "libm_native.mbt": [ "native" ],
    "libm_other.mbt": [ "not", "native" ],
  },
)
