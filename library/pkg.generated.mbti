pub impl FromValue for Char
pub impl FromValue for Int64
pub impl FromValue for Double
pub impl FromValue for String
pub impl[T : FromValue] FromValue for T?
pub impl[T : FromValue] FromValue for Array[T]
pub impl FromValue for @syntax.RootedPath
pub impl FromValue for @syntax.SyntaxMode
pub impl FromValue for @time.Month

pub(open) trait IntoValue {
  fn into_value(Self) -> Value
}
pub impl IntoValue for Bool
pub impl IntoValue for Char
pub impl IntoValue for Int64
pub impl IntoValue for Double
pub impl IntoValue for String
pub impl[T : IntoValue] IntoValue for T?
pub impl[T : IntoValue] IntoValue for Array[T]
pub impl IntoValue for @syntax.RootedPath
pub impl IntoValue for @syntax.SyntaxMode
pub impl IntoValue for @time.Month

pub(open) trait Numeric : Add + Sub + Neg + Eq {
  fn zero() -> Self
  fn is_finite(Self) -> Bool
  fn scale(Self, Double) -> Self
  fn div_scale(Self, Double) -> Self
}

pub(open) trait Reflect {
  fn input() -> CastInfo
  fn output() -> CastInfo
  fn castable(Value) -> Bool
}
pub impl Reflect for Bool
pub impl Reflect for Char
pub impl Reflect for Int64
pub impl Reflect for Double
pub impl Reflect for String
pub impl[T : Reflect] Reflect for T?
pub impl[T : Reflect] Reflect for Array[T]
pub impl Reflect for @syntax.RootedPath
pub impl Reflect for @syntax.SyntaxMode
pub impl Reflect for @time.Month

pub(open) trait World {
  fn library(Self) -> Library
  fn main(Self) -> @syntax.FileId
  fn source(Self, @syntax.FileId) -> @syntax.Source raise FileError
  fn file(Self, @syntax.FileId) -> Bytes raise FileError
  fn today(Self, Duration?) -> Datetime?
}
