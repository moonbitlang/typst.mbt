// Errors
pub(all) suberror FieldAccessError {
  Unknown
  Unset
} derive(Eq, @debug.Debug)
pub fn FieldAccessError::message(Self, Content, String) -> String
pub fn FieldAccessError::message_no_default(Self, Content, String) -> String

pub(all) suberror FileError {
  NotFound(String)
  AccessDenied
  IsDirectory
  NotSource
  InvalidUtf8
  Realize(@syntax.RealizeError)
  Package(PackageError)
  Other(String?)
} derive(Eq, Hash, @debug.Debug)
pub impl Show for FileError

pub(all) suberror HintedError {
  HintedError(HintedString)
} derive(@debug.Debug)

pub(all) suberror IntErrorKind {
  Empty
  InvalidDigit
  PosOverflow
  NegOverflow
  Zero
} derive(Eq, @debug.Debug)

pub(all) suberror PackageError {
  NotFound(@syntax.PackageSpec)
  VersionNotFound(@syntax.PackageSpec, @syntax.PackageVersion)
  NetworkFailed(String?)
  MalformedArchive(String?)
  Other(String?)
} derive(Eq, Hash, @debug.Debug)
pub impl Show for PackageError

pub(all) suberror SourceError {
  SourceError(Array[SourceDiagnostic])
} derive(@debug.Debug)

