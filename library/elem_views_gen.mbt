///|
/// Typed view of `inline` content (upstream `Packed<InlineElem>`).
pub struct InlineElem(Content)

///|
/// View content as `inline` if it is one.
pub fn InlineElem::of(c : Content) -> InlineElem? {
  if c.elem() == inline_elem() {
    Some(InlineElem(c))
  } else {
    None
  }
}

///|
pub fn InlineElem::pack(self : InlineElem) -> Content {
  self.0
}

///|
pub impl NativeElement for InlineElem with fn elem() {
  inline_elem()
}

///|
pub impl NativeElement for InlineElem with fn from_content_unchecked(c) {
  InlineElem(c)
}

///|
pub impl NativeElement for InlineElem with fn into_content(self) {
  self.0
}

///|
pub fn InlineElem::body(self : InlineElem) -> Value {
  view_cast(self.0.field_raw(inline_elem_body).unwrap(), "inline.body")
}

///|
pub fn InlineElem::with_body(self : InlineElem, v : Value) -> InlineElem {
  InlineElem(self.0.with_field(inline_elem_body, IntoValue::into_value(v)))
}

///|
pub fn InlineElem::new(body_ : Value) -> InlineElem {
  InlineElem(Content::new(inline_elem(), [(inline_elem_body, IntoValue::into_value(body_))]))
}

