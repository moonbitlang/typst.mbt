///|
test "rust float formatting matches Rust std" {
  let cases : Array[(Double, String)] = [
    (0.0, "0|0.0|0.00|0|0.000"),
    (-0.0, "-0|-0.0|-0.00|-0|-0.000"),
    (1.0, "1|1.0|1.00|1|1.000"),
    (1.5, "1.5|1.5|1.50|2|1.500"),
    (0.1, "0.1|0.1|0.10|0|0.100"),
    (0.3, "0.3|0.3|0.30|0|0.300"),
    (2.0 / 3.0, "0.6666666666666666|0.6666666666666666|0.67|1|0.667"),
    (
      1.0e20, "100000000000000000000|1e20|100000000000000000000.00|100000000000000000000|100000000000000000000.000",
    ),
    (1.0e-7, "0.0000001|1e-7|0.00|0|0.000"),
    (
      1.0e16, "10000000000000000|1e16|10000000000000000.00|10000000000000000|10000000000000000.000",
    ),
    (
      1.0e15, "1000000000000000|1000000000000000.0|1000000000000000.00|1000000000000000|1000000000000000.000",
    ),
    (0.0001, "0.0001|0.0001|0.00|0|0.000"),
    (0.00001, "0.00001|1e-5|0.00|0|0.000"),
    (
      123456789012345680.0, "123456789012345680|1.2345678901234568e17|123456789012345680.00|123456789012345680|123456789012345680.000",
    ),
    (
      5.0e-324, "0.|5e-324|0.00|0|0.000",
    ),
    (
      1.7976931348623157e308, "|1.7976931348623157e308|.00||.000",
    ),
    (-2.5, "-2.5|-2.5|-2.50|-2|-2.500"),
    (12.345, "12.345|12.345|12.35|12|12.345"),
    (1.005, "1.005|1.005|1.00|1|1.005"),
    (0.125, "0.125|0.125|0.12|0|0.125"),
    (
      1.0e21, "1000000000000000000000|1e21|1000000000000000000000.00|1000000000000000000000|1000000000000000000000.000",
    ),
    (3.14159, "3.14159|3.14159|3.14|3|3.142"),
    (100.0, "100|100.0|100.00|100|100.000"),
    (1234.5678, "1234.5678|1234.5678|1234.57|1235|1234.568"),
    (@double.infinity, "inf|inf|inf|inf|inf"),
    (@double.not_a_number, "NaN|NaN|NaN|NaN|NaN"),
  ]
  for case in cases {
    let (x, expected) = case
    let actual = "\{@library.rust_display_f64(x)}|\{@library.rust_debug_f64(x)}|\{@library.rust_fixed_f64(x, 2)}|\{@library.rust_fixed_f64(x, 0)}|\{@library.rust_fixed_f64(x, 3)}"
    assert_eq(actual, expected)
  }
}
