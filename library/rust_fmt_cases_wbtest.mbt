///|
test "f64 Display and Debug match Rust std on generated cases" {
  let failures = []
  for case in flt_cases {
    let (bits, display, debug) = case
    let x = bits.reinterpret_as_double()
    let d = rust_display_f64(x)
    let g = rust_debug_f64(x)
    if d != display || g != debug {
      failures.push("\{bits}: \{d} vs \{display}, \{g} vs \{debug}")
    }
  }
  if !failures.is_empty() {
    fail(
      "\{failures.length()} mismatches, e.g. " +
      failures[:5].to_array().join("; "),
    )
  }
}
