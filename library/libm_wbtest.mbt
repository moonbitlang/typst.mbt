// Differential tests of the `libm` ports (`libm_exp.mbt`, `libm_log.mbt`,
// `libm_pow.mbt`, `libm_hyperbolic.mbt`, `libm_trig.mbt`,
// `libm_inv_trig.mbt`, `libm.mbt`) against the `libm` crate. The expected
// results (bit-exact f64s, or FNV-1a-64 hashes of them) are in
// `libm_cases_wbtest.mbt`, generated by `oracle/src/bin/gen_libm_tests.rs`
// (see there for the cases and the regeneration command).

///|
fn libm_test_unary(name : String) -> (Double) -> Double {
  match name {
    "exp" => libm_exp
    "exp2" => libm_exp2
    "exp10" => libm_exp10
    "expm1" => libm_expm1
    "log" => libm_log
    "log2" => libm_log2
    "log10" => libm_log10
    "log1p" => libm_log1p
    "sin" => libm_sin
    "cos" => libm_cos
    "tan" => libm_tan
    "sinh" => libm_sinh
    "cosh" => libm_cosh
    "tanh" => libm_tanh
    "asinh" => libm_asinh
    "acosh" => libm_acosh
    "atanh" => libm_atanh
    "asin" => libm_asin
    "acos" => libm_acos
    "atan" => libm_atan
    "erf" => libm_erf
    _ => abort("unknown unary function \{name}")
  }
}

///|
fn libm_test_binary(name : String) -> (Double, Double) -> Double {
  match name {
    "pow" | "pow_root" => libm_pow
    "atan2" => libm_atan2
    "scalbn" => (x, n) => libm_scalbn(x, n.to_int())
    _ => abort("unknown binary function \{name}")
  }
}

///|
/// The bits of a result; every NaN counts as the same value.
fn libm_test_canon(r : Double) -> UInt64 {
  if r.is_nan() {
    0x7ff8000000000000UL
  } else {
    r.reinterpret_as_uint64()
  }
}

///|
fn libm_test_hex(v : UInt64) -> String {
  let digits = "0123456789abcdef"
  let buf = StringBuilder()
  for i = 15; i >= 0; i = i - 1 {
    buf.write_char(digits[((v >> (i * 4)) & 0xfUL).to_int()].unsafe_to_char())
  }
  buf.to_string()
}

///|
/// FNV-1a-64 over the result words (`Hash` in the generator).
fn libm_test_hash(h : UInt64, r : Double) -> UInt64 {
  (h ^ libm_test_canon(r)) * 0x100000001b3UL
}

///|
const LIBM_TEST_HASH_INIT : UInt64 = 0xcbf29ce484222325UL

///|
/// SplitMix64 (`Rng` in the generator).
priv struct LibmTestRng {
  mut state : UInt64
}

///|
fn LibmTestRng::next(self : LibmTestRng) -> UInt64 {
  self.state = self.state + 0x9E3779B97F4A7C15UL
  let mut z = self.state
  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9UL
  z = (z ^ (z >> 27)) * 0x94D049BB133111EBUL
  z ^ (z >> 31)
}

///|
/// `sample` in the generator: a double with a uniformly distributed biased
/// exponent in `lo..=hi`; the low mantissa bits are cleared for some samples.
fn libm_test_sample(rng : LibmTestRng, range : (Int, Int, Bool)) -> Double {
  let (lo, hi, signed) = range
  let e = lo.to_uint64() + (rng.next() >> 11) % (hi - lo + 1).to_uint64()
  let mut mant = rng.next() & 0x000fffffffffffffUL
  let t = rng.next()
  match (t & 7UL).to_int() {
    0 => mant = mant & 0xffffffff00000000UL
    1 => mant = mant & 0xfffff00000000000UL
    2 => mant = 0UL
    _ => ()
  }
  let sign = if signed { t >> 63 } else { 0UL }
  ((sign << 63) | (e << 52) | mant).reinterpret_as_double()
}

///|
/// `threshold_inputs` in the generator.
fn libm_test_threshold_inputs() -> Array[Double] {
  let v = []
  for hw in libm_threshold_words[:] {
    let b = hw.to_uint64() << 32
    let around : Array[UInt64] = [
      b,
      b - 1,
      b | 0xffffffffUL,
      b + (1UL << 32),
      b + 1,
    ]
    for bits in around {
      v.push(bits.reinterpret_as_double())
      v.push((bits | (1UL << 63)).reinterpret_as_double())
    }
  }
  v
}

///|
/// `binary_grids` in the generator.
fn libm_test_binary_grid(name : String) -> Array[(Double, Double)] {
  let v = []
  if name == "pow_root" {
    // `calc.root`: `libm::pow(radicand, 1.0 / index as f64)`.
    for i in 0..<=2000 {
      for n in 1..<=24 {
        v.push((i.to_double(), 1.0 / n.to_double()))
        v.push((i.to_double() / 8.0, 1.0 / (-n).to_double()))
      }
    }
  } else {
    for i in -80..<=80 {
      for j in -160..<=160 {
        v.push((i.to_double() / 4.0, j.to_double() / 4.0))
      }
    }
  }
  v
}

///|
test "libm: special values" {
  let failures = []
  for entry in libm_unary_expected[:] {
    let (name, expected) = entry
    let f = libm_test_unary(name)
    assert_eq(expected.length(), libm_unary_inputs.length())
    for i, bits in libm_unary_inputs {
      let got = libm_test_canon(f(bits.reinterpret_as_double()))
      if got != expected[i] {
        failures.push(
          "\{name}(\{libm_test_hex(bits)}) = \{libm_test_hex(got)}, expected \{libm_test_hex(expected[i])}",
        )
      }
    }
  }
  let n = libm_binary_inputs.length()
  for entry in libm_binary_expected[:] {
    let (name, expected) = entry
    let f = libm_test_binary(name)
    assert_eq(expected.length(), n * n)
    for i, x in libm_binary_inputs {
      for j, y in libm_binary_inputs {
        let got = libm_test_canon(
          f(x.reinterpret_as_double(), y.reinterpret_as_double()),
        )
        let want = expected[i * n + j]
        if got != want {
          failures.push(
            "\{name}(\{libm_test_hex(x)}, \{libm_test_hex(y)}) = \{libm_test_hex(got)}, expected \{libm_test_hex(want)}",
          )
        }
      }
    }
  }
  assert_eq(failures, [])
}

///|
test "libm: thresholds" {
  let inputs = libm_test_threshold_inputs()
  let failures = []
  for entry in libm_unary_thresholds[:] {
    let (name, expected) = entry
    let f = libm_test_unary(name)
    let mut h = LIBM_TEST_HASH_INIT
    for x in inputs {
      h = libm_test_hash(h, f(x))
    }
    if h != expected {
      failures.push(name)
    }
  }
  assert_eq(failures, [])
}

///|
test "libm: sweeps" {
  let failures = []
  for entry in libm_sweeps[:] {
    let (name, seed, count, xr, yr, expected) = entry
    let rng = LibmTestRng::{ state: seed, }
    let mut h = LIBM_TEST_HASH_INIT
    if yr.0 < 0 {
      let f = libm_test_unary(name)
      for _ in 0..<count {
        h = libm_test_hash(h, f(libm_test_sample(rng, xr)))
      }
    } else {
      let f = libm_test_binary(name)
      for _ in 0..<count {
        let x = libm_test_sample(rng, xr)
        let y = libm_test_sample(rng, yr)
        h = libm_test_hash(h, f(x, y))
      }
    }
    if h != expected {
      failures.push("\{name} \{xr} \{yr}")
    }
  }
  assert_eq(failures, [])
}

///|
test "libm: grids" {
  let failures = []
  for entry in libm_unary_grids[:] {
    let (name, expected) = entry
    let f = libm_test_unary(name)
    let mut h = LIBM_TEST_HASH_INIT
    for i in -80000..<=80000 {
      h = libm_test_hash(h, f(i.to_double() / 16.0))
    }
    if h != expected {
      failures.push(name)
    }
  }
  for entry in libm_binary_grids[:] {
    let (name, expected) = entry
    let f = libm_test_binary(name)
    let mut h = LIBM_TEST_HASH_INIT
    for arg in libm_test_binary_grid(name) {
      h = libm_test_hash(h, f(arg.0, arg.1))
    }
    if h != expected {
      failures.push(name)
    }
  }
  assert_eq(failures, [])
}

///|
/// The examples that showed the difference to `@math`: upstream prints
/// `#calc.exp(1)` as 2.7182818284590455 (`libm::exp` is one ulp above the
/// correctly rounded `e`).
test "libm: calc examples" {
  inspect(libm_exp(1.0), content="2.7182818284590455")
  inspect(libm_pow(18.0, 1.0 / 3.0), content="2.6207413942088964")
  inspect(libm_exp10(2.0), content="100")
}
