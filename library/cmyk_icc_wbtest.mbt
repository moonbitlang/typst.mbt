///|
test "cmyk icc transform matches moxcms" {
  // Reference outputs of moxcms 0.8.1 (aarch64, CMYK-to-XYZ.icc to sRGB).
  let samples : Array[((Int, Int, Int, Int), (Int, Int, Int))] = [
    ((241, 87, 13, 28), (0, 121, 176)),
    ((110, 74, 240, 67), (124, 125, 48)),
    ((5, 65, 184, 226), (61, 43, 11)),
    ((10, 227, 242, 213), (70, 0, 0)),
    ((168, 142, 92, 83), (78, 83, 101)),
    ((172, 27, 123, 143), (32, 95, 83)),
    ((54, 246, 58, 203), (68, 0, 34)),
    ((77, 241, 56, 100), (123, 22, 83)),
    ((37, 152, 175, 208), (70, 31, 15)),
    ((43, 208, 43, 48), (173, 69, 117)),
    ((46, 82, 112, 253), (20, 6, 2)),
    ((99, 161, 169, 251), (6, 3, 2)),
  ]
  for s in samples {
    let ((c, m, y, k), expected) = s
    assert_eq(cmyk_to_srgb8(c, m, y, k), expected)
  }
}
