// Differential tests of the float functions of `calc` against upstream's own
// functions: which `libm` function a call reaches, the handling of signs,
// angles and rounding around it, and the errors (the `libm` ports themselves
// are checked by `libm_wbtest.mbt`). The cases and their expected results
// are in `calc_cases_wbtest.mbt`, generated by
// `oracle/src/bin/gen_calc_tests.rs` (see there for the format and the
// regeneration command).

///|
/// The bits of a float; every NaN is written as `nan`.
fn calc_oracle_hx(v : Double) -> String {
  if v.is_nan() {
    "nan"
  } else {
    libm_test_hex(v.reinterpret_as_uint64())
  }
}

///|
fn calc_oracle_f64(s : StringView) -> Double {
  if s == "nan" {
    return 0x7FF8000000000000UL.reinterpret_as_double()
  }
  let mut v = 0UL
  for c in s {
    let d = if c >= '0' && c <= '9' {
      c.to_int() - '0'.to_int()
    } else {
      c.to_int() - 'a'.to_int() + 10
    }
    v = (v << 4) | d.to_uint64()
  }
  v.reinterpret_as_double()
}

///|
/// A number: `i<decimal>` or the bits of a float.
fn calc_oracle_num(s : StringView) -> Num {
  guard s.has_prefix("i") else { return Float(calc_oracle_f64(s)) }
  // Accumulates negatively, so that `i64::MIN` does not overflow.
  let mut v = 0L
  let mut neg = false
  for c in s.view(start_offset=1) {
    if c == '-' {
      neg = true
    } else {
      v = v * 10L - (c.to_int() - '0'.to_int()).to_int64()
    }
  }
  Int(if neg { v } else { -v })
}

///|
fn calc_oracle_int(s : StringView) -> Int64 {
  guard calc_oracle_num(s) is Int(i) else { abort("expected an integer") }
  i
}

///|
fn calc_oracle_dec_num(s : StringView) -> DecNum {
  match calc_oracle_num(s) {
    Int(i) => Int(i)
    Float(f) => Float(f)
  }
}

///|
/// A number or an angle (`rad:<bits>`, `deg:<bits>`).
fn calc_oracle_angle_like(s : StringView) -> AngleLike {
  if s.has_prefix("rad:") {
    Angle(Angle::rad(calc_oracle_f64(s.view(start_offset=4))))
  } else if s.has_prefix("deg:") {
    Angle(Angle::deg(calc_oracle_f64(s.view(start_offset=4))))
  } else {
    match calc_oracle_num(s) {
      Int(i) => Int(i)
      Float(f) => Float(f)
    }
  }
}

///|
fn[T] calc_oracle_sp(v : T) -> @syntax.Spanned[T] {
  { v, span: @syntax.Span::detached(), }
}

///|
fn calc_oracle_dec_num_str(v : DecNum) -> String {
  match v {
    Int(i) => "i\{i}"
    Float(f) => calc_oracle_hx(f)
    Decimal(_) => "decimal"
  }
}

///|
/// The result of the `calc` function `op` for the arguments `a`.
fn calc_oracle_call(op : StringView, a : ArrayView[StringView]) -> String raise {
  let span = @syntax.Span::detached()
  let hx = calc_oracle_hx
  let f = calc_oracle_f64
  let num = calc_oracle_num
  let sp_num = (s : StringView) => calc_oracle_sp(calc_oracle_num(s))
  match op {
    "exp" => hx(impl_calc_exp(span, sp_num(a[0])))
    "pow" =>
      calc_oracle_dec_num_str(
        impl_calc_pow(span, calc_oracle_dec_num(a[0]), sp_num(a[1])),
      )
    "sqrt" => hx(impl_calc_sqrt(sp_num(a[0])))
    "root" => hx(impl_calc_root(f(a[0]), calc_oracle_sp(calc_oracle_int(a[1]))))
    "sin" => hx(impl_calc_sin(calc_oracle_angle_like(a[0])))
    "cos" => hx(impl_calc_cos(calc_oracle_angle_like(a[0])))
    "tan" => hx(impl_calc_tan(calc_oracle_angle_like(a[0])))
    "asin" => hx(impl_calc_asin(sp_num(a[0])).to_rad())
    "acos" => hx(impl_calc_acos(sp_num(a[0])).to_rad())
    "atan" => hx(impl_calc_atan(num(a[0])).to_rad())
    "atan2" => hx(impl_calc_atan2(num(a[0]), num(a[1])).to_rad())
    "sinh" => hx(impl_calc_sinh(f(a[0])))
    "cosh" => hx(impl_calc_cosh(f(a[0])))
    "tanh" => hx(impl_calc_tanh(f(a[0])))
    "asinh" => hx(impl_calc_asinh(f(a[0])))
    "acosh" => hx(impl_calc_acosh(calc_oracle_sp(f(a[0]))))
    "atanh" => hx(impl_calc_atanh(calc_oracle_sp(f(a[0]))))
    "log" => hx(impl_calc_log(span, sp_num(a[0]), calc_oracle_sp(f(a[1]))))
    "ln" => hx(impl_calc_ln(span, sp_num(a[0])))
    "erf" => hx(impl_calc_erf(f(a[0])))
    "norm" => {
      let values = []
      for s in a[1:] {
        values.push(f(s))
      }
      hx(impl_calc_norm(calc_oracle_sp(f(a[0])), values))
    }
    "round" =>
      calc_oracle_dec_num_str(
        impl_calc_round(calc_oracle_dec_num(a[0]), calc_oracle_int(a[1])),
      )
    _ => fail("unknown function calc.\{op}")
  }
}

///|
test "calc oracle" {
  let mut failed = 0
  let failures : Map[String, Int] = Map([])
  let examples : Array[String] = []
  for line in calc_oracle_cases[:] {
    let fields = line.split("\t").collect()
    let op = fields[0]
    let expected = fields[fields.length() - 1]
    let args = fields[1:fields.length() - 1]
    let actual = calc_oracle_call(op, args) catch {
      SourceError(errs) => "!" + errs[0].message
      HintedError(err) => "!" + err.message
      err => raise err
    }
    if actual.view() != expected {
      failed += 1
      let op = op.to_owned()
      failures[op] = failures.get(op).unwrap_or(0) + 1
      if failures.get(op).unwrap_or(0) <= 4 {
        let args = args.map(s => s.to_owned())
        examples.push(
          "calc.\{op} \{args.join(" ")} => \{actual} (expected \{expected})",
        )
      }
    }
  }
  if failed > 0 {
    let by_op = failures.iter().map(p => "\{p.0}: \{p.1}").collect().join(", ")
    fail(
      "\{failed} of \{calc_oracle_cases.length()} cases failed (\{by_op})\n" +
      examples.join("\n"),
    )
  }
}
