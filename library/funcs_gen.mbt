///|
/// The global native functions of a category, in upstream definition
/// order.
fn generated_globals(category : String) -> Array[NativeFuncData] {
  match category {
    "foundations" => [native_repr(), native_panic(), native_assert(), native_eval(), native_plugin(), native_target()]
    "model" => [native_numbering()]
    "text" => [native_lower(), native_upper(), native_lorem()]
    "layout" => [native_measure(), native_layout()]
    "introspection" => [native_here(), native_query(), native_locate()]
    "loading" => [native_read(), native_csv(), native_json(), native_toml(), native_yaml(), native_cbor(), native_xml()]
    "math" => [native_math_abs(), native_math_norm(), native_math_round(), native_math_sqrt(), native_math_upright(), native_math_bold(), native_math_italic(), native_math_serif(), native_math_sans(), native_math_scr(), native_math_cal(), native_math_frak(), native_math_mono(), native_math_bb(), native_math_display(), native_math_inline(), native_math_script(), native_math_sscript()]
    _ => []
  }
}

///|
/// The functions of the `calc` module.
fn generated_calc_funcs() -> Array[NativeFuncData] {
  [native_calc_abs(), native_calc_pow(), native_calc_exp(), native_calc_sqrt(), native_calc_root(), native_calc_sin(), native_calc_cos(), native_calc_tan(), native_calc_asin(), native_calc_acos(), native_calc_atan(), native_calc_atan2(), native_calc_sinh(), native_calc_cosh(), native_calc_tanh(), native_calc_asinh(), native_calc_acosh(), native_calc_atanh(), native_calc_log(), native_calc_ln(), native_calc_erf(), native_calc_fact(), native_calc_perm(), native_calc_binom(), native_calc_gcd(), native_calc_lcm(), native_calc_floor(), native_calc_ceil(), native_calc_trunc(), native_calc_fract(), native_calc_round(), native_calc_clamp(), native_calc_min(), native_calc_max(), native_calc_even(), native_calc_odd(), native_calc_rem(), native_calc_div_euclid(), native_calc_rem_euclid(), native_calc_quo(), native_calc_norm()]
}
