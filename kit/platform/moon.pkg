import {
  "moonbitlang/core/env",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
}

import {
  "moonbitlang/core/debug",
} for "test"

// `core/buffer` is only used by `platform_wasm.mbt` (wasm and wasm-gc), and
// moon.pkg has no per-target imports.

warnings = "-unused_package"

options(
  "native-stub": [ "platform_stub.c" ],
  targets: {
    "platform_native.mbt": [ "native", "llvm" ],
    "platform_wasm.mbt": [ "wasm", "wasm-gc" ],
  },
)
