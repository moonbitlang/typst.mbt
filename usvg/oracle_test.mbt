test "usvg/corpus/linear-gradient" {
  assert_eq(
    corpus_case(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\">\n  <defs>\n    <linearGradient id=\"lg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n      <stop offset=\"0\" stop-color=\"red\"/>\n      <stop offset=\"50%\" stop-color=\"green\" stop-opacity=\"0.5\"/>\n      <stop offset=\"1\" stop-color=\"blue\"/>\n    </linearGradient>\n    <linearGradient id=\"lg2\" href=\"#lg1\" gradientUnits=\"userSpaceOnUse\" x1=\"10\" x2=\"90\" spreadMethod=\"reflect\" gradientTransform=\"rotate(10)\"/>\n  </defs>\n  <rect width=\"50\" height=\"50\" fill=\"url(#lg1)\"/>\n  <rect x=\"50\" width=\"50\" height=\"50\" fill=\"url(#lg2)\"/>\n  <rect y=\"50\" width=\"50\" height=\"50\" fill=\"url(#lg1)\" stroke=\"url(#lg2)\"/>\n</svg>\n",
    ),
    "size 42c80000 42c80000\n<svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n    <defs>\n        <linearGradient id=\"linearGradient1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\" gradientUnits=\"userSpaceOnUse\" gradientTransform=\"matrix(50 0 0 50 0 0)\">\n            <stop offset=\"0\" stop-color=\"#ff0000\"/>\n            <stop offset=\"0.5\" stop-color=\"#008000\" stop-opacity=\"0.5\"/>\n            <stop offset=\"1\" stop-color=\"#0000ff\"/>\n        </linearGradient>\n        <linearGradient id=\"lg2\" x1=\"10\" y1=\"0\" x2=\"90\" y2=\"1\" gradientUnits=\"userSpaceOnUse\" gradientTransform=\"matrix(0.9848078 0.17364818 -0.17364818 0.9848078 0 0)\" spreadMethod=\"reflect\">\n            <stop offset=\"0\" stop-color=\"#ff0000\"/>\n            <stop offset=\"0.5\" stop-color=\"#008000\" stop-opacity=\"0.5\"/>\n            <stop offset=\"1\" stop-color=\"#0000ff\"/>\n        </linearGradient>\n        <linearGradient id=\"lg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\" gradientUnits=\"userSpaceOnUse\" gradientTransform=\"matrix(50 0 0 50 0 50)\">\n            <stop offset=\"0\" stop-color=\"#ff0000\"/>\n            <stop offset=\"0.5\" stop-color=\"#008000\" stop-opacity=\"0.5\"/>\n            <stop offset=\"1\" stop-color=\"#0000ff\"/>\n        </linearGradient>\n    </defs>\n    <path fill=\"url(#linearGradient1)\" stroke=\"none\" d=\"M 0 0 L 50 0 L 50 50 L 0 50 Z\"/>\n    <path fill=\"url(#lg2)\" stroke=\"none\" d=\"M 50 0 L 100 0 L 100 50 L 50 50 Z\"/>\n    <path fill=\"url(#lg1)\" stroke=\"url(#lg2)\" d=\"M 0 50 L 50 50 L 50 100 L 0 100 Z\"/>\n</svg>\n",
