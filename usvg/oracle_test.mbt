test "usvg/corpus/groups-opacity-ids" {
  assert_eq(
    corpus_case(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\">\n  <g id=\"g1\" opacity=\"0.5\"><rect id=\"r1\" width=\"10\" height=\"10\"/></g>\n  <g><g><rect width=\"20\" height=\"20\" fill-opacity=\"50%\" stroke-opacity=\"0.3\" stroke=\"red\"/></g></g>\n  <g style=\"mix-blend-mode:multiply;isolation:isolate\"><rect width=\"5\" height=\"5\"/></g>\n  <g display=\"none\"><rect width=\"50\" height=\"50\"/></g>\n  <rect width=\"50\" height=\"50\" visibility=\"hidden\"/>\n</svg>\n",
    ),
    "size 42c80000 42c80000\n<svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n    <g id=\"g1\" opacity=\"0.5\">\n        <path id=\"r1\" fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 10 0 L 10 10 L 0 10 Z\"/>\n    </g>\n    <g>\n        <g>\n            <path fill=\"#000000\" fill-opacity=\"0.5\" stroke=\"#ff0000\" stroke-opacity=\"0.3\" d=\"M 0 0 L 20 0 L 20 20 L 0 20 Z\"/>\n        </g>\n    </g>\n    <g style=\"mix-blend-mode:multiply;isolation:isolate\">\n        <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 5 0 L 5 5 L 0 5 Z\"/>\n    </g>\n    <path fill=\"#000000\" stroke=\"none\" visibility=\"hidden\" d=\"M 0 0 L 50 0 L 50 50 L 0 50 Z\"/>\n</svg>\n",
  )
}

