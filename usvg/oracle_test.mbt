///|
test "usvg/corpus/recursive-links" {
  assert_eq(
    corpus_case(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\">\n  <clipPath id=\"c1\"><rect width=\"10\" height=\"10\" clip-path=\"url(#c1)\"/></clipPath>\n  <mask id=\"m1\"><rect width=\"10\" height=\"10\" mask=\"url(#m2)\"/></mask>\n  <mask id=\"m2\"><rect width=\"10\" height=\"10\" mask=\"url(#m1)\"/></mask>\n  <pattern id=\"p\" width=\"10\" height=\"10\" patternUnits=\"userSpaceOnUse\"><rect width=\"5\" height=\"5\" fill=\"url(#p)\"/></pattern>\n  <rect width=\"50\" height=\"50\" clip-path=\"url(#c1)\" mask=\"url(#m1)\" fill=\"url(#p)\"/>\n</svg>\n",
    ),
    "size 42c80000 42c80000\n<svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n    <defs>\n        <pattern id=\"p\" x=\"0\" y=\"0\" width=\"10\" height=\"10\" patternUnits=\"userSpaceOnUse\">\n            <path fill=\"none\" stroke=\"none\" visibility=\"hidden\" d=\"M 0 0 L 5 0 L 5 5 L 0 5 Z\"/>\n        </pattern>\n        <clipPath id=\"c1\">\n            <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 10 0 L 10 10 L 0 10 Z\"/>\n        </clipPath>\n        <mask id=\"m1\" maskUnits=\"userSpaceOnUse\" x=\"-5\" y=\"-5\" width=\"60.000004\" height=\"60.000004\">\n            <g mask=\"url(#m2)\">\n                <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 10 0 L 10 10 L 0 10 Z\"/>\n            </g>\n        </mask>\n        <mask id=\"m2\" maskUnits=\"userSpaceOnUse\" x=\"-1\" y=\"-1\" width=\"12\" height=\"12\">\n            <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 10 0 L 10 10 L 0 10 Z\"/>\n        </mask>\n    </defs>\n    <g clip-path=\"url(#c1)\" mask=\"url(#m1)\">\n        <path fill=\"url(#p)\" stroke=\"none\" d=\"M 0 0 L 50 0 L 50 50 L 0 50 Z\"/>\n    </g>\n</svg>\n",
  )
}

///|
test "usvg/corpus/shape-rendering" {
  assert_eq(
    corpus_case(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\" shape-rendering=\"crispEdges\">\n  <rect width=\"10\" height=\"10\"/>\n  <rect x=\"20\" width=\"10\" height=\"10\" shape-rendering=\"optimizeSpeed\"/>\n  <rect x=\"40\" width=\"10\" height=\"10\" shape-rendering=\"auto\"/>\n</svg>\n",
    ),
    "size 42c80000 42c80000\n<svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path fill=\"#000000\" stroke=\"none\" shape-rendering=\"crispEdges\" d=\"M 0 0 L 10 0 L 10 10 L 0 10 Z\"/>\n    <path fill=\"#000000\" stroke=\"none\" shape-rendering=\"optimizeSpeed\" d=\"M 20 0 L 30 0 L 30 10 L 20 10 Z\"/>\n    <path fill=\"#000000\" stroke=\"none\" d=\"M 40 0 L 50 0 L 50 10 L 40 10 Z\"/>\n</svg>\n",
  )
}

///|
test "usvg/corpus/text-without-fonts" {
  assert_eq(
    corpus_case(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\">\n  <text x=\"10\" y=\"20\" font-size=\"12\">Hello <tspan fill=\"red\">World</tspan></text>\n  <rect width=\"10\" height=\"10\"/>\n</svg>\n",
    ),
    "size 42c80000 42c80000\n<svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 10 0 L 10 10 L 0 10 Z\"/>\n</svg>\n",
  )
}

///|
test "usvg/corpus/gzip-like-header" {
  assert_eq(
    corpus_case(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\"><!-- comment --><?pi data?><rect width=\"10\" height=\"10\"/></svg>\n",
    ),
    "size 42c80000 42c80000\n<svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 10 0 L 10 10 L 0 10 Z\"/>\n</svg>\n",
  )
}

///|
test "usvg/corpus/dtd-entities" {
  assert_eq(
    corpus_case(
      "<?xml version=\"1.0\"?>\n<!DOCTYPE svg [ <!ENTITY red \"#ff0000\"> ]>\n<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\"><rect width=\"10\" height=\"10\" fill=\"&red;\"/></svg>\n",
    ),
    "size 42c80000 42c80000\n<svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path fill=\"#ff0000\" stroke=\"none\" d=\"M 0 0 L 10 0 L 10 10 L 0 10 Z\"/>\n</svg>\n",
  )
}

///|
test "usvg/corpus/namespaced" {
  assert_eq(
    corpus_case(
      "<s:svg xmlns:s=\"http://www.w3.org/2000/svg\" xmlns:o=\"http://other\" width=\"100\" height=\"100\">\n  <s:rect width=\"10\" height=\"10\" o:fill=\"red\"/>\n  <o:rect width=\"20\" height=\"20\"/>\n</s:svg>\n",
    ),
    "size 42c80000 42c80000\n<svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 10 0 L 10 10 L 0 10 Z\"/>\n</svg>\n",
  )
}

///|
test "usvg/corpus/arcs-rotated" {
  assert_eq(
    corpus_case(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"200\" height=\"200\">\n  <path d=\"M 50 50 A 30 50 -45 0 1 150 150\" fill=\"none\" stroke=\"black\"/>\n  <path d=\"M 50 150 A 1 1 0 1 1 150 50\" fill=\"none\" stroke=\"red\"/>\n  <path d=\"M 10 10 A 0 10 0 0 0 20 20\" fill=\"none\" stroke=\"green\"/>\n  <ellipse cx=\"100\" cy=\"100\" rx=\"0.001\" ry=\"40\"/>\n  <circle cx=\"50\" cy=\"150\" r=\"33.3333\"/>\n</svg>\n",
    ),
    "size 43480000 43480000\n<svg width=\"200\" height=\"200\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path fill=\"none\" stroke=\"#000000\" d=\"M 50 50 C 66.56854 33.431458 102.385765 42.38576 130 70 C 157.61424 97.614235 166.56854 133.43146 150 150\"/>\n    <path fill=\"none\" stroke=\"#ff0000\" d=\"M 50 150 C 22.385761 122.385765 22.385761 77.614235 50 50 C 77.614235 22.385761 122.385765 22.385761 150 50\"/>\n    <path fill=\"none\" stroke=\"#008000\" d=\"M 10 10 L 20 20\"/>\n    <path fill=\"#000000\" stroke=\"none\" d=\"M 100.00101 100 C 100.00101 122.08281 100.00055 139.98787 100 140 C 99.99945 139.98787 99.99899 122.08281 99.99899 100 C 99.99899 77.91719 99.99945 60.01213 100 60 C 100.00055 60.01213 100.00101 77.91719 100.00101 100 Z\"/>\n    <path fill=\"#000000\" stroke=\"none\" d=\"M 83.3333 150 C 83.3333 168.40947 68.40947 183.3333 50 183.3333 C 31.590525 183.3333 16.6667 168.40947 16.666698 150 C 16.6667 131.59053 31.590525 116.6667 50 116.6667 C 68.40947 116.6667 83.3333 131.59053 83.3333 150 Z\"/>\n</svg>\n",
  )
}

///|
test "usvg/corpus/quad-curves-markers" {
  assert_eq(
    corpus_case(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\">\n  <marker id=\"m\" markerWidth=\"3\" markerHeight=\"3\"><rect width=\"3\" height=\"3\"/></marker>\n  <path d=\"M10 10 Q 50 90 90 10 M 10 50 L 20 50 z\" stroke=\"black\" fill=\"none\" marker-start=\"url(#m)\" marker-mid=\"url(#m)\" marker-end=\"url(#m)\"/>\n</svg>\n",
    ),
    "size 42c80000 42c80000\n<svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n    <defs>\n        <clipPath id=\"clipPath1\">\n            <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 3 0 L 3 3 L 0 3 Z\"/>\n        </clipPath>\n        <clipPath id=\"clipPath2\">\n            <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 3 0 L 3 3 L 0 3 Z\"/>\n        </clipPath>\n        <clipPath id=\"clipPath3\">\n            <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 3 0 L 3 3 L 0 3 Z\"/>\n        </clipPath>\n    </defs>\n    <path fill=\"none\" stroke=\"#000000\" d=\"M 10 10 Q 50 90 90 10 M 10 50 L 20 50 Z\"/>\n    <g>\n        <g clip-path=\"url(#clipPath1)\" transform=\"matrix(1 0 0 1 10 10)\">\n            <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 3 0 L 3 3 L 0 3 Z\"/>\n        </g>\n        <g clip-path=\"url(#clipPath2)\" transform=\"matrix(1 0 0 1 90 10)\">\n            <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 3 0 L 3 3 L 0 3 Z\"/>\n        </g>\n        <g clip-path=\"url(#clipPath2)\" transform=\"matrix(1 0 0 1 10 50)\">\n            <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 3 0 L 3 3 L 0 3 Z\"/>\n        </g>\n        <g clip-path=\"url(#clipPath2)\" transform=\"matrix(1 0 0 1 20 50)\">\n            <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 3 0 L 3 3 L 0 3 Z\"/>\n        </g>\n        <g clip-path=\"url(#clipPath3)\" transform=\"matrix(1 0 0 1 10 50)\">\n            <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 3 0 L 3 3 L 0 3 Z\"/>\n        </g>\n    </g>\n</svg>\n",
  )
}

///|
test "usvg/corpus/deep-groups" {
  assert_eq(
    corpus_case(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\">\n  <g transform=\"translate(5 5)\"><g opacity=\"0.9\"><g transform=\"rotate(5)\" id=\"x\"><g><rect width=\"10\" height=\"10\" transform=\"translate(1 1)\"/></g></g></g></g>\n</svg>\n",
    ),
    "size 42c80000 42c80000\n<svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n    <g transform=\"matrix(1 0 0 1 5 5)\">\n        <g opacity=\"0.9\">\n            <g id=\"x\" transform=\"matrix(0.9961947 0.08715574 -0.08715574 0.9961947 0 0)\">\n                <g>\n                    <g transform=\"matrix(1 0 0 1 1 1)\">\n                        <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 10 0 L 10 10 L 0 10 Z\"/>\n                    </g>\n                </g>\n            </g>\n        </g>\n    </g>\n</svg>\n",
  )
}

///|
test "usvg/corpus/a-element" {
  assert_eq(
    corpus_case(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\">\n  <a href=\"https://example.org\"><rect width=\"10\" height=\"10\"/></a>\n</svg>\n",
    ),
    "size 42c80000 42c80000\n<svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n    <g>\n        <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 10 0 L 10 10 L 0 10 Z\"/>\n    </g>\n</svg>\n",
  )
}

///|
test "usvg/corpus/pattern-in-mask-shared" {
  assert_eq(
    corpus_case(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\">\n  <pattern id=\"p\" width=\"0.5\" height=\"0.5\"><rect width=\"5\" height=\"5\" fill=\"white\"/></pattern>\n  <mask id=\"m\" maskUnits=\"userSpaceOnUse\" x=\"0\" y=\"0\" width=\"100\" height=\"100\"><rect width=\"100\" height=\"100\" fill=\"url(#p)\"/></mask>\n  <rect width=\"40\" height=\"40\" mask=\"url(#m)\"/>\n  <rect x=\"50\" width=\"40\" height=\"40\" mask=\"url(#m)\"/>\n</svg>\n",
    ),
    "size 42c80000 42c80000\n<svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n    <defs>\n        <pattern id=\"p\" x=\"0\" y=\"0\" width=\"0.5\" height=\"0.5\">\n            <path fill=\"#ffffff\" stroke=\"none\" d=\"M 0 0 L 5 0 L 5 5 L 0 5 Z\"/>\n        </pattern>\n        <mask id=\"m\" maskUnits=\"userSpaceOnUse\" x=\"0\" y=\"0\" width=\"100\" height=\"100\">\n            <path fill=\"url(#p)\" stroke=\"none\" d=\"M 0 0 L 100 0 L 100 100 L 0 100 Z\"/>\n        </mask>\n    </defs>\n    <g mask=\"url(#m)\">\n        <path fill=\"#000000\" stroke=\"none\" d=\"M 0 0 L 40 0 L 40 40 L 0 40 Z\"/>\n    </g>\n    <g mask=\"url(#m)\">\n        <path fill=\"#000000\" stroke=\"none\" d=\"M 50 0 L 90 0 L 90 40 L 50 40 Z\"/>\n    </g>\n</svg>\n",
  )
}
