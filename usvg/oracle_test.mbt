///|
test "usvg/corpus/shapes-basic" {
  assert_eq(
    corpus_case(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"200\" height=\"100\">\n  <rect x=\"10\" y=\"10\" width=\"50\" height=\"30\" fill=\"red\"/>\n  <circle cx=\"100\" cy=\"50\" r=\"20\" fill=\"green\" stroke=\"black\" stroke-width=\"3\"/>\n  <ellipse cx=\"150\" cy=\"50\" rx=\"30\" ry=\"10\" fill=\"blue\"/>\n  <line x1=\"0\" y1=\"0\" x2=\"200\" y2=\"100\" stroke=\"purple\"/>\n  <polyline points=\"10,90 20,80 30,90 40,80\" fill=\"none\" stroke=\"black\"/>\n  <polygon points=\"150,10 190,10 170,40\" fill=\"orange\"/>\n</svg>\n",
    ),
    "size 43480000 42c80000\n<svg width=\"200\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path fill=\"#ff0000\" stroke=\"none\" d=\"M 10 10 L 60 10 L 60 40 L 10 40 Z\"/>\n    <path fill=\"#008000\" stroke=\"#000000\" stroke-width=\"3\" d=\"M 120 50 C 120 61.0457 111.04569 70 100 70 C 88.95431 70 80 61.0457 80 50 C 80 38.954304 88.95431 30 100 30 C 111.04569 30 120 38.954304 120 50 Z\"/>\n    <path fill=\"#0000ff\" stroke=\"none\" d=\"M 180 50 C 180 55.522846 166.56854 60 150 60 C 133.43146 60 120 55.522846 120 50 C 120 44.477154 133.43146 40 150 40 C 166.56854 40 180 44.477154 180 50 Z\"/>\n    <path fill=\"#000000\" stroke=\"#800080\" d=\"M 0 0 L 200 100\"/>\n    <path fill=\"none\" stroke=\"#000000\" d=\"M 10 90 L 20 80 L 30 90 L 40 80\"/>\n    <path fill=\"#ffa500\" stroke=\"none\" d=\"M 150 10 L 190 10 L 170 40 Z\"/>\n</svg>\n",
  )
}

