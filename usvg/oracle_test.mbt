  )
}

///|
test "usvg/corpus/colors" {
  assert_eq(
    corpus_case(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\" color=\"teal\">\n  <rect width=\"10\" height=\"10\" fill=\"currentColor\"/>\n  <rect x=\"10\" width=\"10\" height=\"10\" fill=\"rgba(255, 0, 0, 0.5)\"/>\n  <rect x=\"20\" width=\"10\" height=\"10\" fill=\"hsl(120, 100%, 50%)\"/>\n  <rect x=\"30\" width=\"10\" height=\"10\" fill=\"#ABCDEF80\"/>\n  <rect x=\"40\" width=\"10\" height=\"10\" fill=\"transparent\"/>\n  <rect x=\"50\" width=\"10\" height=\"10\" fill=\"nonsense\"/>\n  <rect x=\"60\" width=\"10\" height=\"10\" fill=\"none\" stroke=\"nonsense\"/>\n  <rect x=\"70\" width=\"10\" height=\"10\" fill=\"RED\"/>\n</svg>\n",
    ),
    "size 42c80000 42c80000\n<svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path fill=\"#008080\" stroke=\"none\" d=\"M 0 0 L 10 0 L 10 10 L 0 10 Z\"/>\n    <path fill=\"#ff0000\" fill-opacity=\"0.5019608\" stroke=\"none\" d=\"M 10 0 L 20 0 L 20 10 L 10 10 Z\"/>\n    <path fill=\"#00ff00\" stroke=\"none\" d=\"M 20 0 L 30 0 L 30 10 L 20 10 Z\"/>\n    <path fill=\"#abcdef\" fill-opacity=\"0.5019608\" stroke=\"none\" d=\"M 30 0 L 40 0 L 40 10 L 30 10 Z\"/>\n    <path fill=\"#000000\" fill-opacity=\"0\" stroke=\"none\" d=\"M 40 0 L 50 0 L 50 10 L 40 10 Z\"/>\n    <path fill=\"#000000\" stroke=\"none\" d=\"M 50 0 L 60 0 L 60 10 L 50 10 Z\"/>\n    <path fill=\"none\" stroke=\"none\" visibility=\"hidden\" d=\"M 60 0 L 70 0 L 70 10 L 60 10 Z\"/>\n    <path fill=\"#ff0000\" stroke=\"none\" d=\"M 70 0 L 80 0 L 80 10 L 70 10 Z\"/>\n</svg>\n",
  )
}

///|
test "usvg/corpus/images-data" {
  assert_eq(
    corpus_case(
      "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"100\" height=\"100\">\n  <image width=\"20\" height=\"20\" xlink:href=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\"/>\n  <image x=\"30\" width=\"30\" preserveAspectRatio=\"xMidYMid slice\" height=\"10\" href=\"data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' width='10' height='20'&gt;&lt;rect width='5' height='5'/&gt;&lt;/svg&gt;\"/>\n  <image x=\"60\" href=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPjxjaXJjbGUgcj0iMiIgY3g9IjIiIGN5PSIyIi8+PC9zdmc+\" image-rendering=\"optimizeSpeed\"/>\n  <image y=\"60\" width=\"10\" href=\"image.png\"/>\n  <image y=\"60\" x=\"20\" height=\"10\" href=\"data:text/plain;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\" style=\"image-rendering:pixelated\"/>\n</svg>\n",
    ),
    "size 42c80000 42c80000\n<svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n    <defs>\n        <clipPath id=\"clipPath1\">\n            <path fill=\"#000000\" stroke=\"none\" d=\"M 30 0 L 60 0 L 60 10 L 30 10 Z\"/>\n        </clipPath>\n    </defs>\n    <g transform=\"matrix(20 0 0 20 0 0)\">\n        <image width=\"1\" height=\"1\" xlink:href=\"data:image/png;base64, iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\"/>\n    </g>\n    <g clip-path=\"url(#clipPath1)\">\n        <g transform=\"matrix(3 0 0 3 30 -25)\">\n            <image width=\"10\" height=\"20\" xlink:href=\"data:image/svg+xml;base64, PHN2ZyB3aWR0aD0iMTAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+CiAgICA8cGF0aCBmaWxsPSIjMDAwMDAwIiBzdHJva2U9Im5vbmUiIGQ9Ik0gMCAwIEwgNSAwIEwgNSA1IEwgMCA1IFoiLz4KPC9zdmc+Cg==\"/>\n        </g>\n    </g>\n    <g transform=\"matrix(1 0 0 1 60 0)\">\n        <image width=\"4\" height=\"4\" image-rendering=\"optimizeSpeed\" xlink:href=\"data:image/svg+xml;base64, \"/>\n    </g>\n    <g transform=\"matrix(10 0 0 10 20 60)\">\n        <image width=\"1\" height=\"1\" style=\"image-rendering:pixelated\" xlink:href=\"data:image/png;base64, iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\"/>\n    </g>\n</svg>\n",
  )
}

