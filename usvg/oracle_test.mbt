      "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\">\n  <g transform=\"skewX(30) rotate(10)\">\n    <path d=\"M10 10 C 20 0 40 60 50 10\" fill=\"none\" stroke=\"black\" stroke-width=\"4\"/>\n  </g>\n</svg>\n",
