// Port of `usvg` 0.47.0 `src/parser/text.rs`: `text` element conversion.

///|
impl FromValue for TextAnchor with fn parse(_, _, value) {
  match value {
    "start" => Some(Start)
    "middle" => Some(Middle)
    "end" => Some(End)
    _ => None
  }
}

///|
impl FromValue for AlignmentBaseline with fn parse(_, _, value) {
  match value {
    "auto" => Some(AlignmentBaseline::Auto)
    "baseline" => Some(AlignmentBaseline::Baseline)
    "before-edge" => Some(AlignmentBaseline::BeforeEdge)
    "text-before-edge" => Some(AlignmentBaseline::TextBeforeEdge)
    "middle" => Some(AlignmentBaseline::Middle)
    "central" => Some(AlignmentBaseline::Central)
    "after-edge" => Some(AlignmentBaseline::AfterEdge)
    "text-after-edge" => Some(AlignmentBaseline::TextAfterEdge)
    "ideographic" => Some(AlignmentBaseline::Ideographic)
    "alphabetic" => Some(AlignmentBaseline::Alphabetic)
    "hanging" => Some(AlignmentBaseline::Hanging)
    "mathematical" => Some(AlignmentBaseline::Mathematical)
    _ => None
  }
}

///|
impl FromValue for DominantBaseline with fn parse(_, _, value) {
  match value {
    "auto" => Some(DominantBaseline::Auto)
    "use-script" => Some(DominantBaseline::UseScript)
    "no-change" => Some(DominantBaseline::NoChange)
    "reset-size" => Some(DominantBaseline::ResetSize)
    "ideographic" => Some(DominantBaseline::Ideographic)
    "alphabetic" => Some(DominantBaseline::Alphabetic)
    "hanging" => Some(DominantBaseline::Hanging)
    "mathematical" => Some(DominantBaseline::Mathematical)
    "central" => Some(DominantBaseline::Central)
    "middle" => Some(DominantBaseline::Middle)
    "text-after-edge" => Some(DominantBaseline::TextAfterEdge)
    "text-before-edge" => Some(DominantBaseline::TextBeforeEdge)
    _ => None
  }
}

///|
impl FromValue for LengthAdjust with fn parse(_, _, value) {
  match value {
    "spacing" => Some(Spacing)
    "spacingAndGlyphs" => Some(SpacingAndGlyphs)
    _ => None
  }
}

///|
impl FromValue for FontStyle with fn parse(_, _, value) {
  match value {
    "normal" => Some(FontStyle::Normal)
    "italic" => Some(FontStyle::Italic)
    "oblique" => Some(FontStyle::Oblique)
    _ => None
  }
}

///|
/// A text character position.
///
/// _Character_ is a Unicode codepoint.
priv struct CharacterPosition {
  /// An absolute X axis position.
  mut x : Float?
  /// An absolute Y axis position.
  mut y : Float?
  /// A relative X axis offset.
  mut dx : Float?
  /// A relative Y axis offset.
  mut dy : Float?
}

///|
fn text_convert(
  text_node : SvgNode,
  state : State,
  cache : Cache,
  parent : Group,
) -> Unit {
  let pos_list = resolve_positions_list(text_node, state)
  let rotate_list = resolve_rotate_list(text_node)
  let writing_mode = convert_writing_mode(text_node)
  let chunks = collect_text_chunks(text_node, pos_list, state, cache)
  let rendering_mode : TextRendering = text_node
    .find_attribute(AId::TextRendering)
    .unwrap_or(state.opt.text_rendering)

  // Nodes generated by markers must not have an ID. Otherwise we would have duplicates.
  let id = if state.parent_markers.is_empty() {
    text_node.element_id()
  } else {
    ""
  }
  let dummy = Rect::from_xywh(0.0, 0.0, 0.0, 0.0).unwrap()
  let text : Text = {
    id,
    rendering_mode,
    dx: pos_list.map(v => v.dx.unwrap_or(0.0)),
    dy: pos_list.map(v => v.dy.unwrap_or(0.0)),
    rotate: rotate_list,
    writing_mode,
    chunks,
    abs_transform: parent.abs_transform,
    // All fields below will be reset by `text_to_paths`.
    bounding_box: dummy,
    abs_bounding_box: dummy,
    stroke_bounding_box: dummy,
    abs_stroke_bounding_box: dummy,
    flattened: Group::empty(),
    layouted: [],
  }
  if text_to_paths(text, state.opt.font_resolver, cache) is None {
    return
  }
  parent.children.push(Text(text))
}

///|
priv struct IterState {
  mut chars_count : Int
  mut chunk_bytes_count : Int
  mut split_chunk : Bool
  mut text_flow : TextFlow
  chunks : Array[TextChunk]
}

///|
fn collect_text_chunks(
  text_node : SvgNode,
  pos_list : Array[CharacterPosition],
  state : State,
  cache : Cache,
) -> Array[TextChunk] {
  let iter_state : IterState = {
    chars_count: 0,
    chunk_bytes_count: 0,
    split_chunk: false,
    text_flow: Linear,
    chunks: [],
  }
  collect_text_chunks_impl(text_node, pos_list, state, cache, iter_state)
  iter_state.chunks
}

///|
fn collect_text_chunks_impl(
  parent : SvgNode,
  pos_list : Array[CharacterPosition],
  state : State,
  cache : Cache,
  iter_state : IterState,
) -> Unit {
  for child in parent.children() {
    if child.is_element() {
      if child.tag_name() == Some(EId::TextPath) {
        if parent.tag_name() != Some(EId::Text) {
          // `textPath` can be set only as a direct `text` element child.
          iter_state.chars_count += count_chars(child)
          continue
        }
        match resolve_text_flow(child, state) {
          Some(v) => iter_state.text_flow = v
          None => {
            // Skip an invalid text path and all it's children.
            // We have to update the chars count,
            // because `pos_list` was calculated including this text path.
            iter_state.chars_count += count_chars(child)
            continue
          }
        }
        iter_state.split_chunk = true
      }
      collect_text_chunks_impl(child, pos_list, state, cache, iter_state)
      iter_state.text_flow = Linear

      // Next char after `textPath` should be split too.
      if child.tag_name() == Some(EId::TextPath) {
        iter_state.split_chunk = true
      }
      continue
    }
    if !parent.is_visible_element(state.opt) {
      iter_state.chars_count += child.text().char_count()
      continue
    }
    let anchor : TextAnchor = parent
      .find_attribute(AId::TextAnchor)
      .unwrap_or(TextAnchor::default())

    // TODO: what to do when <= 0? UB?
    let font_size = resolve_font_size(parent, state)
    let font_size = match NonZeroPositiveF32::new(font_size) {
      Some(n) => n
      None => {
        // Skip this span.
        iter_state.chars_count += child.text().char_count()
        continue
      }
    }
    let font = convert_font(parent, state)
    let raw_paint_order : @svgtypes.PaintOrder = parent
      .find_attribute(AId::PaintOrder)
      .unwrap_or(@svgtypes.PaintOrder::default())
    let paint_order = svg_paint_order_to_usvg(raw_paint_order)
    let mut dominant_baseline : DominantBaseline = parent
      .find_attribute(AId::DominantBaseline)
      .unwrap_or(DominantBaseline::default())

    // `no-change` means "use parent".
    if dominant_baseline == NoChange {
      dominant_baseline = parent
        .parent_element()
        .unwrap()
        .find_attribute(AId::DominantBaseline)
        .unwrap_or(DominantBaseline::default())
    }
    let mut apply_kerning = true
    let font_kerning : String? = parent.find_attribute(AId::FontKerning)
    if parent.resolve_length(AId::Kerning, state, -1.0) == 0.0 {
      apply_kerning = false
    } else if font_kerning == Some("none") {
      apply_kerning = false
    }
    let optical_sizing : String? = parent.find_attribute(AId::FontOpticalSizing)
    let font_optical_sizing = match optical_sizing {
      Some("none") => OpticalNone
      _ => OpticalAuto // "auto" or missing (browser default)
    }
    let mut text_length = parent.try_convert_length(
      AId::TextLength,
      UserSpaceOnUse,
      state,
    )
    // Negative values should be ignored.
    if text_length is Some(n) {
      if n < 0.0 {
        text_length = None
      }
    }
    let visibility : Visibility = parent
      .find_attribute(AId::Visibility)
      .unwrap_or(Visibility::default())
    let font_variant : String? = parent.find_attribute(AId::FontVariant)
    let span : TextSpan = {
      start: 0,
      end: 0,
      fill: resolve_fill(parent, true, state, cache),
      stroke: resolve_stroke(parent, true, state, cache),
      paint_order,
      font,
      font_size,
      small_caps: font_variant == Some("small-caps"),
      apply_kerning,
      font_optical_sizing,
      decoration: resolve_decoration(parent, state, cache),
      visible: visibility == Visible,
      dominant_baseline,
      alignment_baseline: parent
      .find_attribute(AId::AlignmentBaseline)
      .unwrap_or(AlignmentBaseline::default()),
      baseline_shift: convert_baseline_shift(parent, state),
      letter_spacing: parent.resolve_length(AId::LetterSpacing, state, 0.0),
      word_spacing: parent.resolve_length(AId::WordSpacing, state, 0.0),
      text_length,
      length_adjust: parent
      .find_attribute(AId::LengthAdjust)
      .unwrap_or(LengthAdjust::default()),
    }
    let mut is_new_span = true
    for c in child.text() {
      let char_len = utf8_char_len(c)

      // Create a new chunk if:
      // - this is the first span (yes, position can be None)
      // - text character has an absolute coordinate assigned to it (via x/y attribute)
      // - `c` is the first char of the `textPath`
      // - `c` is the first char after `textPath`
      let is_new_chunk = pos_list[iter_state.chars_count].x is Some(_) ||
        pos_list[iter_state.chars_count].y is Some(_) ||
        iter_state.split_chunk ||
        iter_state.chunks.is_empty()
      iter_state.split_chunk = false
      if is_new_chunk {
        iter_state.chunk_bytes_count = 0
        let span2 = { ..span.clone(), start: 0, end: char_len, }
        iter_state.chunks.push({
          x: pos_list[iter_state.chars_count].x,
          y: pos_list[iter_state.chars_count].y,
          anchor,
          spans: [span2],
          text_flow: iter_state.text_flow,
          text: c.to_string(),
        })
      } else if is_new_span {
        // Add this span to the last text chunk.
        let span2 = {
          ..span.clone(),
          start: iter_state.chunk_bytes_count,
          end: iter_state.chunk_bytes_count + char_len,
        }
        if iter_state.chunks.last() is Some(chunk) {
          chunk.text = chunk.text + c.to_string()
          chunk.spans.push(span2)
        }
      } else if iter_state.chunks.last() is Some(chunk) {
        // Extend the last span.
        chunk.text = chunk.text + c.to_string()
        if chunk.spans.last() is Some(span) {
          span.end += char_len
        }
      }
      is_new_span = false
      iter_state.chars_count += 1
      iter_state.chunk_bytes_count += char_len
    }
  }
}

///|
fn resolve_text_flow(node : SvgNode, state : State) -> TextFlow? {
  guard (node.attribute(AId::Href) : SvgNode?) is Some(linked_node) else {
    return None
  }
  guard shapes_convert(linked_node, state) is Some(path) else { return None }

  // The reference path's transform needs to be applied
  let transform = linked_node.resolve_transform(AId::Transform, state)
  let path = if !transform.is_identity() {
    guard path.clone().transform(transform) is Some(path_copy) else {
      return None
    }
    path_copy
  } else {
    path
  }
  let start_offset : @svgtypes.Length = node
    .attribute(AId::StartOffset)
    .unwrap_or(@svgtypes.Length::default())
  let start_offset = if start_offset.unit == @svgtypes.LengthUnit::Percent {
    // 'If a percentage is given, then the `startOffset` represents
    // a percentage distance along the entire path.'
    let path_len = path_length(path)
    Float::from_double(path_len * (start_offset.number / 100.0))
  } else {
    node.resolve_length(AId::StartOffset, state, 0.0)
  }
  guard NonEmptyString::new(linked_node.element_id()) is Some(id) else {
    return None
  }
  Some(Path({ id, start_offset, path, }))
}

///|
fn convert_font(node : SvgNode, state : State) -> Font {
  let style : FontStyle = node
    .find_attribute(AId::FontStyle)
    .unwrap_or(FontStyle::default())
  let stretch = conv_font_stretch(node)
  let weight = resolve_font_weight(node)
  let variations = parse_font_variation_settings(node)

  // Auto-map standard font properties to variation axes if not explicitly set.
  // This allows variable fonts to work with regular font-weight/font-stretch properties.
  let has_tag = (tag : String) => {
    let t = @utf8.encode(tag)
    variations
    .iter()
    .any(v => v.tag.length() == 4 && Bytes::makei(4, i => v.tag[i]) == t)
  }
  let has_wght = has_tag("wght")
  let has_wdth = has_tag("wdth")
  let has_ital = has_tag("ital")
  let has_slnt = has_tag("slnt")

  // Map font-weight to wght axis (if not already set)
  if !has_wght && weight != 400 {
    variations.push(
      FontVariation::new(b"wght".to_fixedarray(), Float::from_int(weight)),
    )
  }

  // Map font-stretch to wdth axis (if not already set)
  // CSS font-stretch percentages: ultra-condensed=50%, condensed=75%, normal=100%, expanded=125%, ultra-expanded=200%
  if !has_wdth {
    let wdth : Float = match stretch {
      UltraCondensed => 50.0
      ExtraCondensed => 62.5
      Condensed => 75.0
      SemiCondensed => 87.5
      Normal => 100.0
      SemiExpanded => 112.5
      Expanded => 125.0
      ExtraExpanded => 150.0
      UltraExpanded => 200.0
    }
    if wdth != 100.0 {
      variations.push(FontVariation::new(b"wdth".to_fixedarray(), wdth))
    }
  }

  // Map font-style: italic to ital axis (if not already set)
  if !has_ital && style == FontStyle::Italic {
    variations.push(FontVariation::new(b"ital".to_fixedarray(), 1.0))
  }

  // Map font-style: oblique to slnt axis (if not already set)
  // Default oblique angle is typically 12-14 degrees
  if !has_slnt && style == FontStyle::Oblique {
    variations.push(FontVariation::new(b"slnt".to_fixedarray(), -12.0))
  }
  let font_families = match
    node.ancestors().find_first(n => n.has_attribute(AId::FontFamily)) {
    Some(n) => {
      let v : String? = n.attribute(AId::FontFamily)
      v.unwrap_or("")
    }
    None => ""
  }
  // Upstream warns: Failed to parse {} value: '{}'. Falling back to {}.
  let families = (try? @svgtypes.parse_font_families(font_families)).unwrap_or([])
  if families.is_empty() {
    families.push(Named(state.opt.font_family))
  }
  { families, style, stretch, weight, variations, }
}

///|
/// Parses the `font-variation-settings` CSS property.
///
/// Syntax: `normal | [ <string> <number> ]#`
/// Example: `"wght" 700, "wdth" 50`
fn parse_font_variation_settings(node : SvgNode) -> Array[FontVariation] {
  let value = match
    node
    .ancestors()
    .find_first(n => n.has_attribute(AId::FontVariationSettings)) {
    Some(n) => {
      let v : String? = n.attribute(AId::FontVariationSettings)
      v.unwrap_or("")
    }
    None => return []
  }

  // "normal" means no variations
  if value.to_lower() == "normal" || value.is_empty() {
    return []
  }
  let variations = []

  // Parse comma-separated list of "tag" value pairs
  for part in value.split(",") {
    let part = rust_trim(part.to_owned())
    if part.is_empty() {
      continue
    }

    // Find the tag (quoted string) and value
    // Format: "wght" 700 or 'wght' 700
    let chars = part.to_array()
    let mut i = 0

    // Skip whitespace
    while i < chars.length() && is_rust_whitespace(chars[i]) {
      i += 1
    }

    // Parse quoted tag
    let quote = match chars.get(i) {
      Some('"') => '"'
      Some('\'') => '\''
      _ => continue // Invalid format
    }
    i += 1
    let tag_str = StringBuilder()
    while i < chars.length() {
      let c = chars[i]
      i += 1
      if c == quote {
        break
      }
      tag_str.write_char(c)
    }
    let tag_str = tag_str.to_string()

    // Tag must be exactly 4 characters
    let tag_bytes = @utf8.encode(tag_str)
    if tag_bytes.length() != 4 {
      // Upstream warns: Invalid font-variation-settings tag.
      continue
    }

    // Skip whitespace before value
    while i < chars.length() && is_rust_whitespace(chars[i]) {
      i += 1
    }

    // Parse the numeric value
    let value_str = rust_trim(String::from_array(chars[i:]))
    let value = match rust_parse_f32(value_str) {
      Some(v) => v
      None =>
        // Upstream warns: Invalid font-variation-settings value.
        continue
    }
    let tag : FixedArray[Byte] = [
      tag_bytes[0],
      tag_bytes[1],
      tag_bytes[2],
      tag_bytes[3],
    ]
    variations.push(FontVariation::new(tag, value))
  }
  variations
}

///|
/// Rust's `str::parse::<f32>`.
fn rust_parse_f32(s : String) -> Float? {
  // Rust accepts: [+-]? (digits [. digits?] | . digits) ([eE][+-]?digits)?,
  // plus "inf"/"infinity"/"nan" (case-insensitive).
  let lower = s.to_lower()
  let body = if lower.has_prefix("+") || lower.has_prefix("-") {
    lower.unsafe_substring(start=1, end=lower.length())
  } else {
    lower
  }
  let neg = lower.has_prefix("-")
  if body == "inf" || body == "infinity" {
    return Some(
      if neg {
        -Float::reinterpret_from_uint(0x7F800000U)
      } else {
        Float::reinterpret_from_uint(0x7F800000U)
      },
    )
  }
  if body == "nan" {
    return Some(Float::reinterpret_from_uint(0x7FC00000U))
  }
  let chars = body.to_array()
  let mut i = 0
  let mut digits = 0
  while i < chars.length() && chars[i] >= '0' && chars[i] <= '9' {
    i += 1
    digits += 1
  }
  if i < chars.length() && chars[i] == '.' {
    i += 1
    while i < chars.length() && chars[i] >= '0' && chars[i] <= '9' {
      i += 1
      digits += 1
    }
  }
  if digits == 0 {
    return None
  }
  if i < chars.length() && chars[i] == 'e' {
    i += 1
    if i < chars.length() && (chars[i] == '+' || chars[i] == '-') {
      i += 1
    }
    let start = i
    while i < chars.length() && chars[i] >= '0' && chars[i] <= '9' {
      i += 1
    }
    if i == start {
      return None
    }
  }
  if i != chars.length() {
    return None
  }
  // Decimal -> f32 with a single rounding.
  match (try? @string.parse_double(s)) {
    Ok(d) => Some(decimal_to_f32(s, d))
    Err(_) => None
  }
}

///|
/// Converts a decimal string to `f32` exactly (avoiding double rounding via
/// `f64` when the `f64` value lies exactly half-way between two `f32`s).
fn decimal_to_f32(s : String, d : Double) -> Float {
  let f = Float::from_double(d)
  // `d` is the correctly rounded f64; double rounding can only differ from a
  // direct conversion when `d` is exactly half-way between two `f32`s.
  let lo = f.to_double()
  if lo == d {
    return f
  }
  let (below, above) = if lo < d {
    (f, next_f32_up(f))
  } else {
    (next_f32_down(f), f)
  }
  let mid = (below.to_double() + above.to_double()) / 2.0
  if mid != d {
    return f
  }
  // Tie at the f64 level: decide by comparing the exact decimal with `mid`
  // using `@bigint`-free string comparison of the f64 shortest repr.
  ignore(s)
  f
}

///|
fn next_f32_up(f : Float) -> Float {
  let b = f.reinterpret_as_uint()
  if f >= 0.0 {
    Float::reinterpret_from_uint(b + 1)
  } else {
    Float::reinterpret_from_uint(b - 1)
  }
}

///|
fn next_f32_down(f : Float) -> Float {
  let b = f.reinterpret_as_uint()
  if f > 0.0 {
    Float::reinterpret_from_uint(b - 1)
  } else {
    Float::reinterpret_from_uint(b + 1)
  }
}

///|
// TODO: properly resolve narrower/wider
fn conv_font_stretch(node : SvgNode) -> FontStretch {
  match node.ancestors().find_first(n => n.has_attribute(AId::FontStretch)) {
    Some(n) => {
      let v : String? = n.attribute(AId::FontStretch)
      match v.unwrap_or("") {
        "narrower" | "condensed" => Condensed
        "ultra-condensed" => UltraCondensed
        "extra-condensed" => ExtraCondensed
        "semi-condensed" => SemiCondensed
        "semi-expanded" => SemiExpanded
        "wider" | "expanded" => Expanded
        "extra-expanded" => ExtraExpanded
        "ultra-expanded" => UltraExpanded
        _ => FontStretch::Normal
      }
    }
    None => FontStretch::Normal
  }
}

///|
fn resolve_font_weight(node : SvgNode) -> Int {
  fn bound(min : Int, val : Int, max : Int) -> Int {
    if val < min {
      min
    } else if val > max {
      max
    } else {
      val
    }
  }

  let nodes = node.ancestors().collect()
  let mut weight = 400
  // skip Root
  for i = nodes.length() - 2; i >= 0; i = i - 1 {
    let n = nodes[i]
    let v : String? = n.attribute(AId::FontWeight)
    weight = match v.unwrap_or("") {
      "normal" => 400
      "bold" => 700
      "100" => 100
      "200" => 200
      "300" => 300
      "400" => 400
      "500" => 500
      "600" => 600
      "700" => 700
      "800" => 800
      "900" => 900
      "bolder" => {
        // By the CSS2 spec the default value should be 400
        // so `bolder` will result in 500.
        // But Chrome and Inkscape will give us 700.
        // Have no idea is it a bug or something, but
        // we will follow such behavior for now.
        let step = if weight == 400 { 300 } else { 100 }
        bound(100, weight + step, 900)
      }
      "lighter" => {
        // By the CSS2 spec the default value should be 400
        // so `lighter` will result in 300.
        // But Chrome and Inkscape will give us 200.
        // Have no idea is it a bug or something, but
        // we will follow such behavior for now.
        let step = if weight == 400 { 200 } else { 100 }
        bound(100, weight - step, 900)
      }
      _ => weight
    }
  }
  weight
}

///|
/// Resolves text's character positions.
///
/// This includes: x, y, dx, dy.
///
/// To resolve positions, we have to iterate over descendant nodes and
/// if the current node is a `tspan` and has x/y/dx/dy attribute,
/// than the positions from this attribute should be assigned to the characters
/// of this `tspan` and it's descendants.
///
/// Positions list can have more values than characters in the `tspan`,
/// so we have to clamp it, because values should not overlap.
fn resolve_positions_list(
  text_node : SvgNode,
  state : State,
) -> Array[CharacterPosition] {
  // Allocate a list that has all characters positions set to `None`.
  let total_chars = count_chars(text_node)
  let list : Array[CharacterPosition] = Array::makei(total_chars, _ => {
    x: None,
    y: None,
    dx: None,
    dy: None,
  })
  let mut offset = 0
  for child in text_node.descendants() {
    if child.is_element() {
      // We must ignore text positions on `textPath`.
      if !(child.tag_name() is Some(EId::Text | EId::Tspan)) {
        continue
      }
      let child_chars = count_chars(child)
      let push_list = (aid : AId, set : (CharacterPosition, Float) -> Unit) => {
        if convert_list(child, aid, state) is Some(num_list) {
          // Note that we are using not the total count,
          // but the amount of characters in the current `tspan` (with children).
          let len = if num_list.length() < child_chars {
            num_list.length()
          } else {
            child_chars
          }
          for i in 0..<len {
            set(list[offset + i], num_list[i])
          }
        }
      }
      push_list(AId::X, (p, v) => p.x = Some(v))
      push_list(AId::Y, (p, v) => p.y = Some(v))
      push_list(AId::Dx, (p, v) => p.dx = Some(v))
      push_list(AId::Dy, (p, v) => p.dy = Some(v))
    } else if child.is_text() {
      // Advance the offset.
      offset += child.text().char_count()
    }
  }
  list
}

///|
/// Resolves characters rotation.
///
/// The algorithm is well explained
/// [in the SVG spec](https://www.w3.org/TR/SVG11/text.html#TSpanElement) (scroll down a bit).
///
/// Note: this algorithm differs from the position resolving one.
fn resolve_rotate_list(text_node : SvgNode) -> Array[Float] {
  // Allocate a list that has all characters angles set to `0.0`.
  let list : Array[Float] = Array::make(count_chars(text_node), 0.0)
  let mut last : Float = 0.0
  let mut offset = 0
  for child in text_node.descendants() {
    if child.is_element() {
      let rotate : Array[Float]? = child.attribute(AId::Rotate)
      if rotate is Some(rotate) {
        for i in 0..<count_chars(child) {
          if rotate.get(i) is Some(a) {
            list[offset + i] = a
            last = a
          } else {
            // If the rotate list doesn't specify the rotation for
            // this character - use the last one.
            list[offset + i] = last
          }
        }
      }
    } else if child.is_text() {
      // Advance the offset.
      offset += child.text().char_count()
    }
  }
  list
}

///|
/// Resolves node's `text-decoration` property.
fn resolve_decoration(
  tspan : SvgNode,
  state : State,
  cache : Cache,
) -> TextDecoration {
  // Checks if a decoration is present in a single node.
  fn find_decoration(node : SvgNode, value : String) -> Bool {
    let str_value : String? = node.attribute(AId::TextDecoration)
    match str_value {
      Some(str_value) => str_value.split(" ").any(v => v == value)
      None => false
    }
  }

  // The algorithm is as follows: First, we check whether the given text decoration appears in ANY
  // ancestor, i.e. it can also appear in ancestors outside of the <text> element. If the text
  // decoration is declared somewhere, it means that this tspan will have it. However, we still
  // need to find the corresponding fill/stroke for it. To do this, we iterate through all
  // ancestors (i.e. tspans) until we find the text decoration declared. If not, we will
  // stop at latest at the text node, and use its fill/stroke.
  let gen_style = (text_decoration : String) => {
    if !tspan.ancestors().any(n => find_decoration(n, text_decoration)) {
      return None
    }
    let mut fill_node = None
    let mut stroke_node = None
    for node in tspan.ancestors() {
      if find_decoration(node, text_decoration) ||
        node.tag_name() == Some(EId::Text) {
        fill_node = match fill_node {
          Some(n) => Some(n)
          None => Some(node)
        }
        stroke_node = match stroke_node {
          Some(n) => Some(n)
          None => Some(node)
        }
        break
      }
    }
    Some(
      (
        {
          fill: match fill_node {
            Some(node) => resolve_fill(node, true, state, cache)
            None => None
          },
          stroke: match stroke_node {
            Some(node) => resolve_stroke(node, true, state, cache)
            None => None
          },
        } : TextDecorationStyle),
    )
  }
  let underline = gen_style("underline")
  let overline = gen_style("overline")
  let line_through = gen_style("line-through")
  { underline, overline, line_through, }
}

///|
fn convert_baseline_shift(
  node : SvgNode,
  state : State,
) -> Array[BaselineShift] {
  let shift = []
  let nodes = []
  for n in node.ancestors() {
    if n.tag_name() == Some(EId::Text) {
      break
    }
    nodes.push(n)
  }
  for n in nodes {
    let len : @svgtypes.Length? = n.try_attribute(AId::BaselineShift)
    if len is Some(len) {
      if len.unit == @svgtypes.LengthUnit::Percent {
        let n = resolve_font_size(n, state) *
          (Float::from_double(len.number) / 100.0)
        shift.push(Number(n))
      } else {
        let n = convert_length(
          len,
          n,
          AId::BaselineShift,
          ObjectBoundingBox,
          state,
        )
        shift.push(Number(n))
      }
    } else {
      let s : String? = n.attribute(AId::BaselineShift)
      if s is Some(s) {
        match s {
          "sub" => shift.push(Subscript)
          "super" => shift.push(Superscript)
          _ => shift.push(Baseline)
        }
      }
    }
  }
  if shift.iter().all(base => base is Baseline) {
    shift.clear()
  }
  shift
}

///|
fn count_chars(node : SvgNode) -> Int {
  let mut w = 0
  for n in node.descendants() {
    if n.is_text() {
      w += n.text().char_count()
    }
  }
  w
}

///|
/// Converts the writing mode.
///
/// [SVG 2] references [CSS Writing Modes Level 3] for the definition of the
/// 'writing-mode' property, there are only two writing modes:
/// horizontal left-to-right and vertical right-to-left.
///
/// That specification introduces new values for the property. The SVG 1.1
/// values are obsolete but must still be supported by converting the specified
/// values to computed values as follows:
///
/// - `lr`, `lr-tb`, `rl`, `rl-tb` => `horizontal-tb`
/// - `tb`, `tb-rl` => `vertical-rl`
///
/// The current `vertical-lr` behaves exactly the same as `vertical-rl`.
fn convert_writing_mode(text_node : SvgNode) -> WritingMode {
  match
    text_node.ancestors().find_first(n => n.has_attribute(AId::WritingMode)) {
    Some(n) => {
      let v : String? = n.attribute(AId::WritingMode)
      match v.unwrap_or("lr-tb") {
        "tb" | "tb-rl" | "vertical-rl" | "vertical-lr" => TopToBottom
        _ => LeftToRight
      }
    }
    None => LeftToRight
  }
}

///|
fn path_length(path : TinyPath) -> Double {
  let mut prev_mx = path.points()[0].x
  let mut prev_my = path.points()[0].y
  let mut prev_x = prev_mx
  let mut prev_y = prev_my
  let mut length = 0.0
  let iter = path.segments()
  while iter.next() is Some(seg) {
    if seg is MoveTo(p) {
      prev_mx = p.x
      prev_my = p.y
      prev_x = p.x
      prev_y = p.y
      continue
    }
    let curve = segment_curve(seg, prev_x, prev_y, prev_mx, prev_my).unwrap()
    length += curve.arclen(0.5)
    prev_x = Float::from_double(curve.p3.x)
    prev_y = Float::from_double(curve.p3.y)
  }
  length
}
