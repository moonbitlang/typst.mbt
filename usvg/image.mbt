// Port of `usvg` 0.47.0 `src/parser/image.rs`: `image` elements.

///|
/// An `xlink:href` resolver for `<image>` elements.
///
/// This type can be useful if you want to have an alternative `xlink:href` handling
/// to the default one. For example, you can forbid access to local files (which is allowed by default)
/// or add support for resolving actual URLs (usvg doesn't do any network requests).
pub(all) struct ImageHrefResolver {
  /// Resolver function that will be used when `xlink:href` contains a
  /// [Data URL](https://developer.mozilla.org/en-US/docs/Web/HTTP/Basics_of_HTTP/Data_URIs).
  ///
  /// A function would be called with mime, decoded base64 data and parsing options.
  resolve_data : (String, Bytes, Options) -> ImageKind?
  /// Resolver function that will be used to handle an arbitrary string in `xlink:href`.
  resolve_string : (String, Options) -> ImageKind?
}

///|
pub impl Default for ImageHrefResolver with fn default() {
  {
    resolve_data: ImageHrefResolver::default_data_resolver(),
    resolve_string: ImageHrefResolver::default_string_resolver(),
  }
}

///|
/// Creates a default
/// [Data URL](https://developer.mozilla.org/en-US/docs/Web/HTTP/Basics_of_HTTP/Data_URIs)
/// resolver closure.
///
/// base64 encoded data is already decoded.
///
/// The default implementation would try to load JPEG, PNG, GIF, WebP, SVG and SVGZ types.
/// Note that it will simply match the `mime` or data's magic.
/// The actual images would not be decoded. It's up to the renderer.
pub fn ImageHrefResolver::default_data_resolver() -> (String, Bytes, Options) -> ImageKind? {
  (mime, data, opts) => {
    match mime {
      "image/jpg" | "image/jpeg" => Some(JPEG(data))
      "image/png" => Some(PNG(data))
      "image/gif" => Some(GIF(data))
      "image/webp" => Some(WEBP(data))
      "image/svg+xml" => load_sub_svg(data, opts)
      "text/plain" =>
        match get_image_data_format(data) {
          Some(ImgJPEG) => Some(JPEG(data))
          Some(ImgPNG) => Some(PNG(data))
          Some(ImgGIF) => Some(GIF(data))
          Some(ImgWEBP) => Some(WEBP(data))
          _ => load_sub_svg(data, opts)
        }
      _ => None
    }
  }
}

///|
/// Creates a default string resolver.
///
/// Upstream treats an input string as a file path and tries to open it.
/// This port has no file system access here, so the default resolver
/// ignores all strings (like an inaccessible path upstream).
pub fn ImageHrefResolver::default_string_resolver() -> (String, Options) -> ImageKind? {
  (_, _) => None
}

///|
priv enum ImageFormat {
  ImgPNG
  ImgJPEG
  ImgGIF
  ImgWEBP
  ImgSVG
} derive(Eq)

///|
fn image_convert(
  node : SvgNode,
  state : State,
  cache : Cache,
  parent : Group,
) -> Unit? {
  // Upstream warns: Image lacks the 'xlink:href' attribute. Skipped.
  guard (node.try_attribute(AId::Href) : String?) is Some(href) else {
    return None
  }
  guard get_href_data(href, state) is Some(kind) else { return None }
  let visibility : Visibility = node
    .find_attribute(AId::Visibility)
    .unwrap_or(Visibility::default())
  let visible = visibility == Visible
  let rendering_mode : ImageRendering = node
    .find_attribute(AId::ImageRendering)
    .unwrap_or(state.opt.image_rendering)

  // Nodes generated by markers must not have an ID. Otherwise we would have duplicates.
  let id = if state.parent_markers.is_empty() { node.element_id() } else { "" }
  guard kind.actual_size() is Some(actual_size) else { return None }
  let x = node.convert_user_length(AId::X, state, @svgtypes.Length::zero())
  let y = node.convert_user_length(AId::Y, state, @svgtypes.Length::zero())
  let mut width = node.convert_user_length(
    AId::Width,
    state,
    @svgtypes.Length::new_number(actual_size.width().to_double()),
  )
  let mut height = node.convert_user_length(
    AId::Height,
    state,
    @svgtypes.Length::new_number(actual_size.height().to_double()),
  )
  let w_attr : @svgtypes.Length? = node.attribute(AId::Width)
  let h_attr : @svgtypes.Length? = node.attribute(AId::Height)
  match (w_attr, h_attr) {
    (Some(_), None) =>
      // Only width was defined, so we need to scale height accordingly.
      height = actual_size.height() * (width / actual_size.width())
    (None, Some(_)) =>
      // Only height was defined, so we need to scale width accordingly.
      width = actual_size.width() * (height / actual_size.height())
    _ => ()
  }
  let aspect : @svgtypes.AspectRatio = node
    .attribute(AId::PreserveAspectRatio)
    .unwrap_or(@svgtypes.AspectRatio::default())
  // Upstream warns: Image has an invalid size. Skipped.
  guard NonZeroRect::from_xywh(x, y, width, height) is Some(rect) else {
    return None
  }
  convert_image_inner(
    kind, id, visible, rendering_mode, aspect, actual_size, rect, cache, parent,
  )
}

///|
fn convert_image_inner(
  kind : ImageKind,
  id : String,
  visible : Bool,
  rendering_mode : ImageRendering,
  aspect : @svgtypes.AspectRatio,
  actual_size : Size,
  rect : NonZeroRect,
  cache : Cache,
  parent : Group,
) -> Unit? {
  let aligned_size = fit_view_box(actual_size, rect, aspect)
  let (aligned_x, aligned_y) = aligned_pos(
    aspect.align,
    rect.x(),
    rect.y(),
    rect.width() - aligned_size.width(),
    rect.height() - aligned_size.height(),
  )
  let view_box = aligned_size.to_non_zero_rect(aligned_x, aligned_y)
  let image_ts = Transform::from_row(
    view_box.width() / actual_size.width(),
    0.0,
    0.0,
    view_box.height() / actual_size.height(),
    view_box.x(),
    view_box.y(),
  )
  let abs_transform = parent.abs_transform.pre_concat(image_ts)
  guard view_box.transform(parent.abs_transform) is Some(abs_bounding_box) else {
    return None
  }
  let g = Group::empty()
  g.id = id
  g.children.push(
    Image({
      id: "",
      visible,
      size: actual_size,
      rendering_mode,
      kind,
      abs_transform,
      abs_bounding_box,
    }),
  )
  g.transform = image_ts
  g.abs_transform = abs_transform
  g.calculate_bounding_boxes() |> ignore
  if aspect.slice {
    // Image slice acts like a rectangular clip.
    let path = Path::new_simple(
      @tiny_skia_path.PathBuilder::from_rect(rect.to_rect()),
    ).unwrap()
    path.fill = Some(Fill::default())
    let clip = ClipPath::empty(cache.gen_clip_path_id())
    clip.root.children.push(Path(path))

    // Clip path should not be affected by the image viewbox transform.
    // The final structure should look like:
    // <g clip-path="url(#clipPath1)">
    //     <g transform="matrix(1 0 0 1 10 20)">
    //         <image/>
    //     </g>
    // </g>

    let g2 = Group::empty()
    g2.id = g.id
    g.id = ""
    g2.abs_transform = parent.abs_transform
    g2.clip_path = Some(clip)
    g2.children.push(Group(g))
    g2.calculate_bounding_boxes() |> ignore
    parent.children.push(Group(g2))
  } else {
    parent.children.push(Group(g))
  }
  Some(())
}

///|
fn get_href_data(href : String, state : State) -> ImageKind? {
  if DataUrl::process(href) is Some(url) {
    guard url.decode_to_vec() is Some(data) else { return None }
    let mime = "\{url.mime_type.0}/\{url.mime_type.1}"
    (state.opt.image_href_resolver.resolve_data)(mime, data, state.opt)
  } else {
    (state.opt.image_href_resolver.resolve_string)(href, state.opt)
  }
}

///|
/// Checks that file has a PNG, a GIF, a JPEG or a WebP magic bytes.
fn get_image_data_format(data : Bytes) -> ImageFormat? {
  guard imagesize_image_type(data) is Some(ty) else { return None }
  match ty {
    Gif => Some(ImgGIF)
    Jpeg => Some(ImgJPEG)
    Png => Some(ImgPNG)
    Webp => Some(ImgWEBP)
    _ => None
  }
}

///|
/// Tries to load the `ImageData` content as an SVG image or emits a warning and returns `None`.
fn load_sub_svg(data : Bytes, opt : Options) -> ImageKind? {
  try Tree::from_data_nested(data, opt) catch {
    _ =>
      // Upstream warns: Failed to load nested SVG image.
      None
  } noraise {
    tree => Some(SVG(tree))
  }
}

///|
/// Fits size into a viewbox.
fn fit_view_box(
  size : Size,
  rect : NonZeroRect,
  aspect : @svgtypes.AspectRatio,
) -> Size {
  let s = rect.size()
  if aspect.align == @svgtypes.Align::None {
    s
  } else if aspect.slice {
    size.expand_to(s)
  } else {
    size.scale_to(s)
  }
}
