// Port of `icu_segmenter 2.3.0`: `line.rs` and `line/v1.rs` (the UAX #14
// line segmenter with `SegmenterBreakLineV1` data, Unicode 15.1 rules),
// UTF-8 code path. All offsets are UTF-8 byte offsets.

///|
/// An enum specifies the strictness of line-breaking rules. It can be passed as
/// an argument when creating a line segmenter.
///
/// Each enum value has the same meaning with respect to the `line-break`
/// property values in the CSS Text spec. See the details in
/// <https://drafts.csswg.org/css-text-3/#line-break-property>.
pub(all) enum LineBreakStrictness {
  /// Breaks text using the least restrictive set of line-breaking rules.
  Loose
  /// Breaks text using the most common set of line-breaking rules.
  Normal
  /// Breaks text using the most stringent set of line-breaking rules.
  ///
  /// This is the default behaviour of the Unicode Line Breaking Algorithm,
  /// resolving class [CJ](https://www.unicode.org/reports/tr14/#CJ) to
  /// [NS](https://www.unicode.org/reports/tr14/#NS);
  /// see rule [LB1](https://www.unicode.org/reports/tr14/#LB1).
  Strict
  /// Breaks text assuming there is a soft wrap opportunity around every
  /// typographic character unit, disregarding any prohibition against line
  /// breaks.
  Anywhere
} derive(Eq, Debug)

///|
/// An enum specifies the line break opportunities between letters. It can be
/// passed as an argument when creating a line segmenter.
pub(all) enum LineBreakWordOption {
  /// Words break according to their customary rules.
  Normal
  /// Breaking is allowed within "words".
  BreakAll
  /// Breaking is forbidden within "word".
  KeepAll
} derive(Eq, Debug)

///|
/// Options to tailor line-breaking behavior.
pub(all) struct LineBreakOptions {
  /// Strictness of line-breaking rules. Default is `Strict`.
  strictness : LineBreakStrictness?
  /// Line break opportunities between letters. Default is `Normal`.
  word_option : LineBreakWordOption?
  /// Whether the content locale is Japanese or Chinese (`content_locale`
  /// with language `ja` or `zh`).
  ja_zh : Bool
}

///|
pub fn LineBreakOptions::default() -> LineBreakOptions {
  { strictness: None, word_option: None, ja_zh: false, }
}

///|
priv struct ResolvedLineBreakOptions {
  strictness : LineBreakStrictness
  word_option : LineBreakWordOption
  ja_zh : Bool
}

///|
fn LineBreakOptions::resolve(
  self : LineBreakOptions,
) -> ResolvedLineBreakOptions {
  {
    strictness: self.strictness.unwrap_or(Strict),
    word_option: self.word_option.unwrap_or(LineBreakWordOption::Normal),
    ja_zh: self.ja_zh,
  }
}

///|
/// Supports loading line break data, and creating line break iterators.
///
/// The segmenter returns mandatory breaks (as defined by definition LD7 of
/// Unicode Standard Annex #14, _Unicode Line Breaking Algorithm_) as well as
/// line break opportunities (definition LD3). It does not distinguish them.
///
/// For consistency with the grapheme, word, and sentence segmenters, there is
/// always a breakpoint returned at index 0, but this breakpoint is not a
/// meaningful line break opportunity.
pub struct LineSegmenter {
  priv options : ResolvedLineBreakOptions
  priv data : RuleBreakData
  priv complex : ComplexPayloads
}

///|
/// Constructs a `LineSegmenter` with an invariant locale, custom
/// `LineBreakOptions`, and compiled LSTM data for complex scripts (Khmer,
/// Lao, Myanmar, and Thai).
pub fn LineSegmenter::new_lstm(options : LineBreakOptions) -> LineSegmenter {
  let s = LineSegmenter::new_for_non_complex_scripts(options)
  s.complex.with_southeast_asian_lstms()
  s
}

///|
/// Constructs a `LineSegmenter` with an invariant locale, custom
/// `LineBreakOptions`, and no support for scripts requiring complex context
/// dependent line breaks (Khmer, Lao, Myanmar, Thai).
pub fn LineSegmenter::new_for_non_complex_scripts(
  options : LineBreakOptions,
) -> LineSegmenter {
  {
    options: options.resolve(),
    data: line_data,
    complex: ComplexPayloads::new(),
  }
}

///|
/// Typst's line break segmenter for Chinese/Japanese text
/// (`try_new_for_non_complex_scripts_with_buffer_provider` with
/// `typst_assets::icu::ICU_CJ_SEGMENT`).
///
/// This is generated by manually overriding the line break properties for
/// curly quotes `U+201C` and `U+201D` from `QU` (`Quotation`) to `OP`
/// (`OpenPunctuation`) and `CP` (`CloseParenthesis`), respectively.
pub fn LineSegmenter::new_cj(options : LineBreakOptions) -> LineSegmenter {
  {
    options: options.resolve(),
    data: cj_line_data,
    complex: ComplexPayloads::new(),
  }
}

///|
/// The line break opportunities of a string, as UTF-8 byte offsets.
///
/// There are always breakpoints at 0 and the string length, or only at 0 for
/// the empty string.
pub fn LineSegmenter::segment_str(
  self : LineSegmenter,
  input : String,
) -> Array[Int] {
  let chars = []
  let mut len = 0
  for i = 0; i < input.length(); {
    let (c, next) = @unicode.decode_at(input, i)
    chars.push((len, c))
    len += utf8_len(c)
    continue next
  }
  let iter : LineBreakIteratorV1 = {
    chars,
    cursor: 0,
    len,
    current_pos_data: None,
    result_cache: [],
    data: self.data,
    options: self.options,
    complex: self.complex,
  }
  let out = []
  while iter.next() is Some(b) {
    out.push(b)
  }
  out
}

///|
fn is_break_utf32_by_normal(codepoint : Int, ja_zh : Bool) -> Bool {
  (codepoint == 0x301C || codepoint == 0x30A0) && ja_zh
}

///|
fn is_break_utf32_by_loose(
  right_codepoint : Int,
  left_prop : Int,
  right_prop : Int,
  ja_zh : Bool,
) -> Bool? {
  Some(
    match (right_prop, right_codepoint, left_prop) {
      // breaks before hyphens
      (LINE_PROPERTY_BA, 0x2010 | 0x2013, LINE_PROPERTY_ID) => true
      // breaks before certain CJK hyphen-like characters
      (LINE_PROPERTY_NS, 0x301C | 0x30A0, _) => ja_zh
      // breaks before iteration marks
      (LINE_PROPERTY_NS, 0x3005 | 0x303B | 0x309D | 0x309E | 0x30FD | 0x30FE, _) =>
        true
      // breaks before certain centered punctuation marks:
      (
        LINE_PROPERTY_NS,
        0x30FB
        | 0xFF1A
        | 0xFF1B
        | 0xFF65
        | 0x203C
        | 0x2047
        | 0x2048
        | 0x2049,
        _,
      ) => ja_zh
      // breaks between inseparable characters such as U+2025, U+2026 i.e. characters with the Unicode Line Break property IN
      (LINE_PROPERTY_IN, _, LINE_PROPERTY_IN) => true
      // breaks before certain centered punctuation marks:
      (LINE_PROPERTY_EX, 0xFF01 | 0xFF1F, _) => ja_zh
      // breaks before suffixes:
      // Characters with the Unicode Line Break property PO and the East Asian Width property
      (LINE_PROPERTY_PO_EAW, _, _) => ja_zh
      // breaks after prefixes:
      // Characters with the Unicode Line Break property PR and the East Asian Width property
      (_, _, LINE_PROPERTY_PR_EAW) => ja_zh
      _ => return None
    },
  )
}

///|
priv struct LineBreakIteratorV1 {
  /// The `(byte offset, code point)` pairs of the input.
  chars : Array[(Int, Int)]
  /// Index of the next element `iter.next()` returns.
  mut cursor : Int
  mut len : Int
  mut current_pos_data : (Int, Int)?
  mut result_cache : Array[Int]
  data : RuleBreakData
  options : ResolvedLineBreakOptions
  complex : ComplexPayloads
}

///|
priv enum StringBoundaryPosType {
  Start
  Middle
  End
}

///|
fn LineBreakIteratorV1::next(self : LineBreakIteratorV1) -> Int? {
  if self.options.strictness == Anywhere {
    // Upstream segments grapheme clusters here; Typst never uses this mode.
    abort("LineBreakStrictness::Anywhere is not supported")
  }
  match self.check_eof() {
    Start => return Some(0)
    End => return None
    Middle => ()
  }

  // If we have break point cache by previous run, return this result
  if self.result_cache.length() > 0 {
    let first_pos = self.result_cache[0]
    let mut i = 0
    while true {
      if i == first_pos {
        self.result_cache = self.result_cache[1:].map(r => r - i)
        return self.get_current_position()
      }
      i += match self.get_current_codepoint() {
        Some(c) => utf8_len(c)
        None => 0
      }
      self.advance_iter()
      if self.is_eof() {
        self.result_cache.clear()
        return Some(self.len)
      }
    }
  }

  // The state prior to a sequence of CM and ZWJ affected by rule LB9.
  let mut lb9_left : Int? = None
  // Whether LB9 was applied to a ZWJ, so that breaks at the current
  // position must be suppressed.
  let mut lb8a_after_lb9 = false
  while true {
    let left_codepoint = match self.get_current_codepoint() {
      Some(c) => c
      None => return None
    }
    self.advance_iter()
    let right_codepoint = match self.get_current_codepoint() {
      Some(c) => c
      None => return Some(self.len)
    }
    let left_prop = match lb9_left {
      Some(p) => p
      None => self.get_linebreak_property(left_codepoint)
    }
    let right_prop = self.get_linebreak_property(right_codepoint)

    // UAX14 doesn't have Thai etc, so use another way.
    if self.get_linebreak_property(left_codepoint) == self.data.complex_property &&
      right_prop == self.data.complex_property {
      let result = self.line_handle_complex_utf8(left_codepoint)
      if result is Some(_) {
        return result
      }
      // I may have to fetch text until non-SA character?.
    }
    let after_zwj = lb8a_after_lb9 ||
      (lb9_left is None && left_prop == LINE_PROPERTY_ZWJ)
    if (right_prop == LINE_PROPERTY_CM || right_prop == LINE_PROPERTY_ZWJ) &&
      left_prop != LINE_PROPERTY_BK &&
      left_prop != LINE_PROPERTY_CR &&
      left_prop != LINE_PROPERTY_LF &&
      left_prop != LINE_PROPERTY_NL &&
      left_prop != LINE_PROPERTY_SP &&
      left_prop != LINE_PROPERTY_ZW {
      lb9_left = Some(left_prop)
      lb8a_after_lb9 = right_prop == LINE_PROPERTY_ZWJ
      continue
    } else {
      lb9_left = None
      lb8a_after_lb9 = false
    }

    // CSS word-break property handling
    if self.options.word_option == KeepAll {
      //  typographic letter units shouldn't be break
      if is_letter_unit(left_prop) && is_letter_unit(right_prop) {
        continue
      }
    }

    // CSS line-break property handling
    match self.options.strictness {
      Normal =>
        if is_break_utf32_by_normal(right_codepoint, self.options.ja_zh) &&
          !after_zwj {
          return self.get_current_position()
        }
      Loose =>
        if is_break_utf32_by_loose(
            right_codepoint,
            left_prop,
            right_prop,
            self.options.ja_zh,
          )
          is Some(breakable) {
          if breakable && !after_zwj {
            return self.get_current_position()
          }
          continue
        }
      _ => ()
    }

    // If break_state is equals or grater than 0, it is alias of property.
    match self.data.get_break_state_from_table(left_prop, right_prop) {
      Break | NoMatch =>
        if after_zwj {
          continue
        } else {
          return self.get_current_position()
        }
      Keep => continue
      Index(index) | Intermediate(index) => {
        let mut index = index
        let mut previous_iter = self.cursor
        let mut previous_pos_data = self.current_pos_data
        let mut previous_is_after_zwj = after_zwj

        // Since we are building up a state in this inner loop, we do not
        // need an analogue of lb9_left; continuing the inner loop preserves
        // `index` which is the current state, and thus implements the
        // “treat as” rule.
        let mut left_prop_pre_lb9 = right_prop

        // current state isn't resolved due to intermediating.
        // Example, [AK] [AS] is processing LB28a, but if not matched after fetching
        // data, we should break after [AK].
        let is_intermediate_rule_no_match = if lb8a_after_lb9 {
          // left was ZWJ so we don't break between ZWJ.
          true
        } else {
          index > self.data.last_codepoint_property
        }
        let mut continue_outer = false
        while true {
          self.advance_iter()
          let after_zwj = left_prop_pre_lb9 == LINE_PROPERTY_ZWJ
          let previous_break_state_is_cp_prop = index <=
            self.data.last_codepoint_property
          let prop = match self.get_current_linebreak_property() {
            Some(prop) => prop
            None => {
              // Reached EOF. But we are analyzing multiple characters now, so next break may be previous point.
              let break_state = self.data.get_break_state_from_table(
                index,
                self.data.eot_property,
              )
              if break_state == NoMatch {
                self.cursor = previous_iter
                self.current_pos_data = previous_pos_data
                if previous_is_after_zwj {
                  // Do not break [AK] [ZWJ] ÷ [AS] (eot).
                  continue_outer = true
                  break
                } else {
                  return self.get_current_position()
                }
              }
              // EOF
              return Some(self.len)
            }
          }
          if (prop == LINE_PROPERTY_CM || prop == LINE_PROPERTY_ZWJ) &&
            left_prop_pre_lb9 != LINE_PROPERTY_BK &&
            left_prop_pre_lb9 != LINE_PROPERTY_CR &&
            left_prop_pre_lb9 != LINE_PROPERTY_LF &&
            left_prop_pre_lb9 != LINE_PROPERTY_NL &&
            left_prop_pre_lb9 != LINE_PROPERTY_SP &&
            left_prop_pre_lb9 != LINE_PROPERTY_ZW {
            left_prop_pre_lb9 = prop
            continue
          }
          match self.data.get_break_state_from_table(index, prop) {
            Keep => {
              continue_outer = true
              break
            }
            NoMatch => {
              self.cursor = previous_iter
              self.current_pos_data = previous_pos_data
              if after_zwj {
                // Break [AK] ÷ [AS] [ZWJ] [XX],
                // but not [AK] [ZWJ] ÷ [AS] [ZWJ] [XX].
                if is_intermediate_rule_no_match && !previous_is_after_zwj {
                  return self.get_current_position()
                }
                continue_outer = true
                break
              } else if previous_is_after_zwj {
                // Do not break [AK] [ZWJ] ÷ [AS] [XX].
                continue_outer = true
                break
              } else {
                return self.get_current_position()
              }
            }
            Break =>
              if after_zwj {
                continue_outer = true
                break
              } else {
                return self.get_current_position()
              }
            Intermediate(i) => {
              index = i
              previous_iter = self.cursor
              previous_pos_data = self.current_pos_data
              previous_is_after_zwj = after_zwj
            }
            Index(i) => {
              index = i
              if previous_break_state_is_cp_prop {
                previous_iter = self.cursor
                previous_pos_data = self.current_pos_data
                previous_is_after_zwj = after_zwj
              }
            }
          }
          left_prop_pre_lb9 = prop
        }
        if continue_outer {
          continue
        }
      }
    }
  }
  None
}

///|
fn is_letter_unit(prop : Int) -> Bool {
  prop
  is (LINE_PROPERTY_AI
  | LINE_PROPERTY_AL
  | LINE_PROPERTY_ID
  | LINE_PROPERTY_NU
  | LINE_PROPERTY_HY
  | LINE_PROPERTY_H2
  | LINE_PROPERTY_H3
  | LINE_PROPERTY_JL
  | LINE_PROPERTY_JV
  | LINE_PROPERTY_JT
  | LINE_PROPERTY_CJ)
}

///|
fn LineBreakIteratorV1::advance_iter(self : LineBreakIteratorV1) -> Unit {
  if self.cursor < self.chars.length() {
    self.current_pos_data = Some(self.chars[self.cursor])
    self.cursor += 1
  } else {
    self.current_pos_data = None
  }
}

///|
fn LineBreakIteratorV1::is_eof(self : LineBreakIteratorV1) -> Bool {
  self.current_pos_data is None
}

///|
fn LineBreakIteratorV1::check_eof(
  self : LineBreakIteratorV1,
) -> StringBoundaryPosType {
  if self.is_eof() {
    self.advance_iter()
    if self.is_eof() {
      if self.len == 0 {
        // Empty string. Since `self.current_pos_data` is always going to be empty,
        // we never read `self.len` except for here, so we can use it to mark that
        // we have already returned the single empty-string breakpoint.
        self.len = 1
        Start
      } else {
        End
      }
    } else {
      Start
    }
  } else {
    Middle
  }
}

///|
fn LineBreakIteratorV1::get_current_position(
  self : LineBreakIteratorV1,
) -> Int? {
  match self.current_pos_data {
    Some((pos, _)) => Some(pos)
    None => None
  }
}

///|
fn LineBreakIteratorV1::get_current_codepoint(
  self : LineBreakIteratorV1,
) -> Int? {
  match self.current_pos_data {
    Some((_, c)) => Some(c)
    None => None
  }
}

///|
fn LineBreakIteratorV1::get_linebreak_property(
  self : LineBreakIteratorV1,
  codepoint : Int,
) -> Int {
  let prop = self.data.get32(codepoint)
  let word_option = self.options.word_option
  let strictness = self.options.strictness
  // CJ is treated as NS by default, yielding strict line breaking.
  // https://www.unicode.org/reports/tr14/#CJ
  if prop == LINE_PROPERTY_CJ &&
    (word_option == BreakAll || strictness is (Loose | Normal)) {
    // All CJ's General_Category is Other_Letter (Lo).
    LINE_PROPERTY_ID
  } else if word_option == BreakAll && prop == self.data.complex_property {
    LINE_PROPERTY_ID
  } else if word_option == BreakAll &&
    (prop == LINE_PROPERTY_AL || prop == LINE_PROPERTY_NU) {
    LINE_PROPERTY_ID
  } else {
    prop
  }
}

///|
fn LineBreakIteratorV1::get_current_linebreak_property(
  self : LineBreakIteratorV1,
) -> Int? {
  match self.get_current_codepoint() {
    Some(c) => Some(self.get_linebreak_property(c))
    None => None
  }
}

///|
fn LineBreakIteratorV1::line_handle_complex_utf8(
  self : LineBreakIteratorV1,
  left_codepoint : Int,
) -> Int? {
  // word segmenter doesn't define break rules for some scripts such as Thai.
  let start_iter = self.cursor
  let start_point = self.current_pos_data
  let s = [left_codepoint]
  while true {
    match self.get_current_codepoint() {
      Some(c) => s.push(c)
      None => return None
    }
    self.advance_iter()
    match self.get_current_codepoint() {
      Some(current_codepoint) =>
        if self.get_linebreak_property(current_codepoint) !=
          self.data.complex_property {
          break
        }
      // EOF
      None => break
    }
  }

  // Restore iterator to move to head of complex string
  self.cursor = start_iter
  self.current_pos_data = start_point
  let breaks = self.complex.segment_str(s)
  self.result_cache = breaks
  guard self.result_cache.length() > 0 else { return None }
  let first_pos = self.result_cache[0]
  let mut i = utf8_len(left_codepoint)
  while true {
    if i == first_pos {
      // Re-calculate breaking offset
      self.result_cache = self.result_cache[1:].map(r => r - i)
      return self.get_current_position()
    }
    i += match self.get_current_codepoint() {
      Some(c) => utf8_len(c)
      None => 0
    }
    self.advance_iter()
    if self.is_eof() {
      self.result_cache.clear()
      return Some(self.len)
    }
  }
  None
}

///|
fn utf8_len(c : Int) -> Int {
  if c < 0x80 {
    1
  } else if c < 0x800 {
    2
  } else if c < 0x10000 {
    3
  } else {
    4
  }
}
