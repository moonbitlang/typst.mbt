// Port of the break opportunity part of upstream
// `typst-layout/src/inline/linebreak.rs`: `SEGMENTER`, `CJ_SEGMENTER`,
// `Breakpoint`, `Trim`, `breakpoints`, `find_url_scheme`, `hyphenations`
// and `linebreak_link`. The paragraph `Preparation` is abstracted into the
// parameters of `breakpoints`. All offsets are UTF-8 byte offsets.

///|
/// The general line break segmenter.
let the_segmenter : LineSegmenter = LineSegmenter::new_lstm(
  LineBreakOptions::default(),
)

///|
/// The line break segmenter for Chinese/Japanese text.
///
/// This is generated by manually overriding the line break properties for curly
/// quotes `U+201C` and `U+201D` from `QU` (`Quotation`) to `OP`
/// (`OpenPunctuation`) and `CP` (`CloseParenthesis`), respectively.
let the_cj_segmenter : LineSegmenter = LineSegmenter::new_cj(
  LineBreakOptions::default(),
)

///|
/// Upstream's `SEGMENTER` (`LineSegmenter::new_lstm(Default::default())`).
pub fn default_segmenter() -> LineSegmenter {
  the_segmenter
}

///|
/// Upstream's `CJ_SEGMENTER`.
pub fn cj_segmenter() -> LineSegmenter {
  the_cj_segmenter
}

///|
/// A line break opportunity.
pub(all) enum Breakpoint {
  /// Just a normal opportunity (e.g. after a space).
  Normal
  /// A mandatory breakpoint (after '\n' or at the end of the text).
  Mandatory
  /// An opportunity for hyphenating and how many chars are before/after it
  /// in the word.
  Hyphen(Int, Int)
} derive(Eq, Hash, Debug)

///|
/// How to trim the end of a line.
///
/// It's an invariant that `self.layout <= self.shaping`.
pub(all) struct Trim {
  /// The text in the range `layout..shaping` should be shaped but should not
  /// affect layout. This ensures that we trim spaces for layout purposes, but
  /// still render zero-advance space glyphs for copy paste.
  layout : Int
  /// The text should only be shaped up until the given text offset. Newlines
  /// are already trimmed here.
  shaping : Int
} derive(Eq, Debug)

///|
/// Create an instance with equal layout and shaping trim.
fn Trim::uniform(trim : Int) -> Trim {
  { layout: trim, shaping: trim, }
}

///|
/// Trim a line before this breakpoint.
pub fn Breakpoint::trim(self : Breakpoint, start : Int, line : String) -> Trim {
  match self {
    // Trailing whitespace should be shaped, but the glyphs should have
    // their advance width zeroed. This way, they are available for copy
    // paste, but don't influence layout.
    // Also trim Unicode `Default_Ignorable`s, since they may interfere
    // with end-of-line adjustments in CJK layout and since they are not
    // rendered, they will be included in another glyph cluster. If they
    // aren't trimmed here and they attach to a space glyph that is
    // covered by a font, the space may be considered relevant for
    // inline layout, which is undesirable. Unicode `Default_Ignorable`s
    // include among others:
    // - `\u{200B}` zero width space
    // - `\u{202A}` LTR embedding
    // - `\u{202B}` RTL embedding
    // - `\u{202C}` POP embedding
    // - `\u{2066}` LTR isolate
    // - `\u{2069}` POP isolate
    Normal => {
      let trimmed = trim_end_len(line, c => {
        let ch = Int::unsafe_to_char(c)
        @unicode.is_whitespace(ch) || @unicode.is_default_ignorable(ch)
      })
      { layout: start + trimmed, shaping: start + utf8_str_len(line), }
    }

    // Trim linebreaks.
    Mandatory => {
      let trimmed = trim_end_len(line, c => {
        line_break(c) is (MandatoryBreak | CarriageReturn | LineFeed | NextLine)
      })
      Trim::uniform(start + trimmed)
    }

    // Trim nothing.
    Hyphen(_, _) => Trim::uniform(start + utf8_str_len(line))
  }
}

///|
/// Whether this is a hyphen breakpoint.
pub fn Breakpoint::is_hyphen(self : Breakpoint) -> Bool {
  self is Hyphen(_, _)
}

///|
/// The UTF-8 length of `s` after trimming trailing chars matching `pred`.
fn trim_end_len(s : String, pred : (Int) -> Bool) -> Int {
  let mut end = s.length()
  while end > 0 {
    let (c, start) = @unicode.decode_before(s, end)
    if !pred(c) {
      break
    }
    end = start
  }
  utf8_str_len(s.view(end_offset=end))
}

///|
fn utf8_str_len(s : StringView) -> Int {
  let mut n = 0
  for i = 0; i < s.length(); {
    let (c, next) = @unicode.decode_at(s, i)
    n += utf8_len(c)
    continue next
  }
  n
}

///|
/// A string indexed by UTF-8 byte offsets.
priv struct Utf8Str {
  text : String
  /// `to_utf16[i]` is the UTF-16 index of byte offset `i`, or `-1` if `i`
  /// is not a char boundary. Has length `len + 1`.
  to_utf16 : FixedArray[Int]
  /// `cps[i]` is the code point starting at byte `i`, or `-1`.
  cps : FixedArray[Int]
}

///|
fn Utf8Str::new(text : String) -> Utf8Str {
  let len = utf8_str_len(text)
  let to_utf16 = FixedArray::make(len + 1, -1)
  let cps = FixedArray::make(len, -1)
  let mut pos = 0
  for i = 0; i < text.length(); {
    let (c, next) = @unicode.decode_at(text, i)
    to_utf16[pos] = i
    cps[pos] = c
    pos += utf8_len(c)
    continue next
  }
  to_utf16[len] = text.length()
  { text, to_utf16, cps, }
}

///|
fn Utf8Str::len(self : Utf8Str) -> Int {
  self.cps.length()
}

///|
fn Utf8Str::slice(self : Utf8Str, start : Int, end : Int) -> StringView {
  self.text.view(
    start_offset=self.to_utf16[start],
    end_offset=self.to_utf16[end],
  )
}

///|
/// The last char before byte offset `i`.
fn Utf8Str::char_before(self : Utf8Str, i : Int) -> Int? {
  if i <= 0 {
    return None
  }
  let (c, _) = @unicode.decode_before(self.text, self.to_utf16[i])
  Some(c)
}

///|
/// Yields for each breakpoint the text index, whether the break is mandatory
/// (after `\n`) and whether a hyphen is required (when breaking inside of a
/// word).
///
/// The paragraph is described by:
/// - `cj`: whether the paragraph's configured language (`p.config.lang`) is
///   Chinese or Japanese,
/// - `hyphenate`: `p.config.hyphenate != Some(false)`,
/// - `lang_at`: the hyphenation language at a text offset (`lang_at`),
/// - `hyphenate_at`: whether hyphenation is enabled at a text offset
///   (`hyphenate_at`).
pub fn breakpoints(
  text : String,
  cj~ : Bool,
  hyphenate~ : Bool,
  lang_at~ : (Int) -> @hypher.Lang?,
  hyphenate_at~ : (Int) -> Bool,
  f : (Int, Breakpoint) -> Unit,
) -> Unit {
  // Single breakpoint at the end for empty text.
  if text.is_empty() {
    f(0, Mandatory)
    return
  }
  let segmenter = if cj { the_cj_segmenter } else { the_segmenter }
  let t = Utf8Str::new(text)
  let mut last = 0
  let points = segmenter.segment_str(text)
  let mut iter = 0
  let mut next_url_scheme = find_url_scheme(t, 0)
  while true {
    // Special case for links. UAX #14 doesn't handle them well.
    if next_url_scheme is Some((_, end)) && end < last {
      next_url_scheme = find_url_scheme(t, last)
    }

    // For URLs with domains as host, UAX #14 typically places a breakpoint
    // after the `://`. However, it does not do so if a digit follows. For
    // this reason, we also heuristically detect URL schemes and check
    // whether we are within (or typically _at_) a scheme.
    let head = t.slice(0, last)
    let tail = t.slice(last, t.len())
    if head.has_suffix("://") ||
      tail.has_prefix("www.") ||
      (next_url_scheme is Some((start, end)) && start <= last && last < end) {
      let (link, _) = @syntax.link_prefix(tail.to_owned())
      let base = last
      linebreak_link(link, i => f(base + i, Normal))
      last += utf8_str_len(link)
      while iter < points.length() && points[iter] < last {
        iter += 1
      }
    }

    // Get the next UAX #14 linebreak opportunity.
    guard iter < points.length() else { break }
    let point = points[iter]
    iter += 1

    // Skip breakpoint if there is no char before it. icu4x generates one
    // at offset 0, but we don't want it.
    guard t.char_before(point) is Some(c) else { continue }

    // Find out whether the last break was mandatory by checking against
    // rules LB4 and LB5, special-casing the end of text according to LB3.
    // See also: https://docs.rs/icu_segmenter/latest/icu_segmenter/struct.LineSegmenter.html
    let breakpoint = if point == t.len() {
      Mandatory
    } else {
      let obj_replace = 0xFFFC
      match line_break(c) {
        MandatoryBreak | CarriageReturn | LineFeed | NextLine => Mandatory

        // https://github.com/typst/typst/issues/5489
        //
        // OBJECT-REPLACEMENT-CHARACTERs provide Contingent Break
        // opportunities before and after by default. This behaviour
        // is however tailorable, see:
        // https://www.unicode.org/reports/tr14/#CB
        // https://www.unicode.org/reports/tr14/#TailorableBreakingRules
        // https://www.unicode.org/reports/tr14/#LB20
        //
        // Don't provide a line breaking opportunity between a LTR-
        // ISOLATE (or any other Combining Mark) and an OBJECT-
        // REPLACEMENT-CHARACTER representing an inline item, if the
        // LTR-ISOLATE could end up as the only character on the
        // previous line.
        CombiningMark if t.cps[point] == obj_replace &&
          last + utf8_len(c) == point => continue
        _ => Normal
      }
    }

    // Hyphenate between the last and current breakpoint.
    if hyphenate && last < point {
      for segment in @unicode.split_word_bounds(t.slice(last, point)) {
        if !segment.is_empty() && all_alphabetic(segment) {
          hyphenations(lang_at, hyphenate_at, last, segment.to_owned(), f)
        }
        last += utf8_str_len(segment)
      }
    }

    // Call `f` for the UAX #14 break opportunity.
    f(point, breakpoint)
    last = point
  }
}

///|
fn all_alphabetic(s : StringView) -> Bool {
  for i = 0; i < s.length(); {
    let (c, next) = @unicode.decode_at(s, i)
    if !@unicode.is_alphabetic(Int::unsafe_to_char(c)) {
      return false
    }
    continue next
  }
  true
}

///|
/// Heuristically attempts to find the next URL scheme in the given text.
///
/// Anything matching this grammar rule that is also followed by '://', is
/// treated as a potential URL scheme.
fn find_url_scheme(t : Utf8Str, base : Int) -> (Int, Int)? {
  let text = t.slice(base, t.len())
  guard text.find("://") is Some(end16) else { return None }
  let prefix = text.view(end_offset=end16)
  let mut start16 = prefix.length()
  while start16 > 0 &&
        is_valid_in_url_scheme(prefix.code_unit_at(start16 - 1).to_int()) {
    start16 -= 1
  }
  let start = utf8_str_len(prefix.view(end_offset=start16))
  let end = utf8_str_len(prefix)
  Some((base + start, base + end))
}

///|
/// Whether the given character is valid in a URL scheme.
///
/// This method uses the scheme grammar from
/// <https://www.rfc-editor.org/info/rfc3986/#section-3.1>.
fn is_valid_in_url_scheme(c : Int) -> Bool {
  // scheme = ALPHA *( ALPHA / DIGIT / "+" / "-" / "." )
  c == '+' ||
  c == '-' ||
  c == '.' ||
  (c >= 'a' && c <= 'z') ||
  (c >= 'A' && c <= 'Z') ||
  (c >= '0' && c <= '9')
}

///|
/// Generate breakpoints for hyphenations within a word.
fn hyphenations(
  lang_at : (Int) -> @hypher.Lang?,
  hyphenate_at : (Int) -> Bool,
  offset : Int,
  word : String,
  f : (Int, Breakpoint) -> Unit,
) -> Unit {
  guard lang_at(offset) is Some(lang) else { return }
  let mut offset = offset
  let count = char_count(word)
  let end = offset + utf8_str_len(word)
  let mut chars = 0
  for syllable in @hypher.hyphenate(word, lang) {
    offset += utf8_str_len(syllable)
    chars += char_count(syllable)

    // Don't hyphenate after the final syllable.
    if offset == end {
      continue
    }

    // Filter out hyphenation opportunities where hyphenation was actually
    // disabled.
    if !hyphenate_at(offset) {
      continue
    }

    // Filter out forbidden hyphenation opportunities.
    if !syllable.is_empty() {
      let (last, _) = @unicode.decode_before(syllable, syllable.length())
      if line_break(last) is (Glue | WordJoiner | ZWJ) {
        continue
      }
    }

    // Determine the number of codepoints before and after the hyphenation.
    let l = if chars > 255 { 255 } else { chars }
    let r = if count - chars > 255 { 255 } else { count - chars }

    // Call `f` for the word-internal hyphenation opportunity.
    f(offset, Hyphen(l, r))
  }
}

///|
fn char_count(s : String) -> Int {
  let mut n = 0
  for i = 0; i < s.length(); {
    let (_, next) = @unicode.decode_at(s, i)
    n += 1
    continue next
  }
  n
}

///|
priv enum LinkClass {
  Alphabetic
  Digit
  Open
  Other
} derive(Eq)

///|
fn LinkClass::of(c : Int) -> LinkClass {
  let ch = Int::unsafe_to_char(c)
  if @unicode.is_alphabetic(ch) {
    Alphabetic
  } else if @unicode.is_numeric(ch) {
    Digit
  } else if c == '(' || c == '[' {
    Open
  } else {
    Other
  }
}

///|
/// Produce linebreak opportunities for a link.
fn linebreak_link(link : String, f : (Int) -> Unit) -> Unit {
  let t = Utf8Str::new(link)
  let mut offset = 0
  let mut prev = Other
  for end in 0..<t.len() {
    let c = t.cps[end]
    if c < 0 {
      continue
    }
    let class = LinkClass::of(c)

    // Emit opportunities when going from
    // - other -> other
    // - alphabetic -> numeric
    // - numeric -> alphabetic
    // Never before/after opening delimiters.
    if end > 0 &&
      prev != Open &&
      (if class == Other { prev == Other } else { class != prev }) {
      let piece_len = end - offset
      if piece_len < 16 {
        // For bearably long segments, emit them as one.
        offset = end
        f(offset)
      } else {
        // If it gets very long (e.g. a hash in the URL), just allow a
        // break at every char.
        for i in offset..<end {
          let pc = t.cps[i]
          if pc >= 0 {
            offset += utf8_len(pc)
            f(offset)
          }
        }
      }
    }
    prev = class
  }
}
