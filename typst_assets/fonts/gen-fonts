#!/bin/sh
# Generates the sources of the embedded fonts (the pre-build step of
# `typst_assets/fonts/moon.pkg`):
#
# - fonts_gen.c (native): the fonts as base64 C string chunks, decoded by
#   `fonts_stub.c`. As a native stub, it is compiled once and cached, so
#   release builds of the CLI don't recompile the font data as part of the
#   whole-program C file.
# - fonts_wasm_gen.mbt (wasm, wasm-gc): the fonts as base64 multi-line
#   strings, decoded by `fonts_wasm.mbt`.
#
# Usage: gen-fonts <fonts_gen.c> <fonts_wasm_gen.mbt> <font files...>
#
# Needs only POSIX sh, awk, wc, tr, fold and base64 (`gen-fonts.ps1` is the
# PowerShell equivalent for Windows).
set -eu

out_c=$1
out_mbt=$2
shift 2

tmp_c="$out_c.tmp"
tmp_mbt="$out_mbt.tmp"
tmp_b64="$out_c.b64.tmp"
trap 'rm -f "$tmp_c" "$tmp_mbt" "$tmp_b64"' EXIT

header="Generated by typst_assets/fonts/gen-fonts from typst_assets/fonts/files. Do not edit."
printf '// %s\n\n#include <stdint.h>\n#include <stddef.h>\n\n' "$header" > "$tmp_c"
printf '// %s\n\n' "$header" > "$tmp_mbt"

# MoonBit limits the size of a top-level segment, so long fonts are split
# into several strings.
chunk_lines=8000

i=0
lens=""
chunks=""
for font in "$@"; do
  len=$(wc -c < "$font" | tr -d ' \t\r\n')
  lens="$lens $len"
  base64 < "$font" | tr -d '\r\n' | fold -w 100 > "$tmp_b64"
  printf '\n' >> "$tmp_b64"
  # C: a NULL-terminated array of string chunks (short literals keep every
  # C compiler happy).
  awk -v i="$i" '
    BEGIN { printf "const char *const typst_font_%d[] = {\n", i }
    length($0) > 0 { printf "  \"%s\",\n", $0 }
    END { printf "  NULL,\n};\n\n" }
  ' "$tmp_b64" >> "$tmp_c"
  # MoonBit: multi-line strings of at most `chunk_lines` lines.
  names=$(awk -v i="$i" -v n="$chunk_lines" -v out="$tmp_mbt" '
    length($0) == 0 { next }
    {
      if (count % n == 0) {
        name = sprintf("font_%d_base64_%d", i, count / n)
        if (count > 0) { printf "\n" >> out }
        printf "///|\nlet %s : String =\n", name >> out
        names = names (count > 0 ? ", " : "") name
      }
      printf "  #|%s\n", $0 >> out
      count++
    }
    END { printf "\n" >> out; print names }
  ' "$tmp_b64")
  chunks="$chunks|$names"
  i=$((i + 1))
done

# C: the font table.
{
  printf 'const char *const *const typst_fonts[] = {\n'
  j=0
  while [ "$j" -lt "$i" ]; do
    printf '  typst_font_%d,\n' "$j"
    j=$((j + 1))
  done
  printf '};\n\nconst int32_t typst_font_lens[] = {\n'
  for len in $lens; do
    printf '  %s,\n' "$len"
  done
  printf '};\n\nconst int32_t typst_font_count = %d;\n' "$i"
} >> "$tmp_c"

# MoonBit: the font table.
{
  printf '///|\n/// The base64 data (in chunks) and decoded length of each font.\n'
  printf 'let fonts_base64 : Array[(Array[String], Int)] = [\n'
  rest=${chunks#|}
  for len in $lens; do
    names=${rest%%|*}
    case "$rest" in
      *"|"*) rest=${rest#*|} ;;
      *) rest="" ;;
    esac
    printf '  ([%s], %s),\n' "$names" "$len"
  done
  printf ']\n'
} >> "$tmp_mbt"

mv "$tmp_c" "$out_c"
mv "$tmp_mbt" "$out_mbt"
