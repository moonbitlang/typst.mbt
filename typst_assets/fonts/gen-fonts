#!/bin/sh
# Generates the sources of the embedded fonts (the pre-build step of
# `typst_assets/fonts/moon.pkg`):
#
# - fonts_gen.c (native): the fonts as C string chunks of hex escapes (raw
#   bytes, so `fonts_stub.c` only copies them; decoding base64 took a large
#   part of the CLI's startup). As a native stub, it is compiled once and
#   cached, so release builds of the CLI don't recompile the font data as
#   part of the whole-program C file.
# - fonts_wasm_gen.mbt (wasm, wasm-gc): the fonts as base64 multi-line
#   strings, decoded by `fonts_wasm.mbt`.
#
# Usage: gen-fonts <fonts_gen.c> <fonts_wasm_gen.mbt> <font files...> (other
# arguments, such as this script, are ignored)
#
# Needs only POSIX sh, awk, wc, tr, fold, od and base64 (`gen-fonts.ps1` is
# the PowerShell equivalent for Windows).
set -eu

out_c=$1
out_mbt=$2
shift 2

tmp_c="$out_c.tmp"
tmp_mbt="$out_mbt.tmp"
tmp_b64="$out_c.b64.tmp"
tmp_raw="$out_c.raw.tmp"
tmp_flat="$out_c.flat.tmp"
tmp_hex="$out_c.hex.tmp"
trap 'rm -f "$tmp_c" "$tmp_mbt" "$tmp_b64" "$tmp_raw" "$tmp_flat" "$tmp_hex"' EXIT

fail() {
  echo "gen-fonts: $*" >&2
  exit 1
}

header="Generated by typst_assets/fonts/gen-fonts from typst_assets/fonts/files. Do not edit."
printf '// %s\n\n#include <stdint.h>\n#include <stddef.h>\n\n' "$header" > "$tmp_c"
# The rows are initialized without their terminating NUL on purpose.
cat >> "$tmp_c" << 'EOF'
#if defined(__clang__)
#pragma clang diagnostic ignored "-Wunknown-warning-option"
#pragma clang diagnostic ignored "-Wunterminated-string-initialization"
#elif defined(__GNUC__)
#pragma GCC diagnostic ignored "-Wpragmas"
#pragma GCC diagnostic ignored "-Wunterminated-string-initialization"
#elif defined(_MSC_VER)
#pragma warning(disable : 4295)
#endif

EOF
printf '// %s\n\n' "$header" > "$tmp_mbt"

# MoonBit limits the size of a top-level segment, so long fonts are split
# into several strings.
chunk_lines=8000

# The number of bytes per row of the C font arrays (short string literals
# keep every C compiler happy).
chunk_bytes=64

i=0
lens=""
chunks=""
for font in "$@"; do
  # The generator scripts are inputs of the pre-build step too.
  case "$font" in
    *.otf | *.ttf | *.otc | *.ttc) ;;
    *) continue ;;
  esac
  # Every stage writes a file and is checked on its own (the status of a
  # pipeline is only that of its last command).
  len=$(wc -c < "$font") || fail "cannot read $font"
  len=$((len + 0))
  [ "$len" -gt 0 ] || fail "empty font $font"
  lens="$lens $len"
  base64 < "$font" > "$tmp_raw" || fail "base64 failed for $font"
  tr -d '\r\n' < "$tmp_raw" > "$tmp_flat" || fail "tr failed"
  flat_len=$(wc -c < "$tmp_flat") || fail "wc failed"
  flat_len=$((flat_len + 0))
  [ "$flat_len" -eq $(( (len + 2) / 3 * 4 )) ] ||
    fail "base64 of $font has $flat_len characters, expected $(( (len + 2) / 3 * 4 ))"
  fold -w 100 "$tmp_flat" > "$tmp_b64" || fail "fold failed"
  printf '\n' >> "$tmp_b64"
  # C: a two-dimensional char array (contiguous, without pointers) with rows
  # of `chunk_bytes` bytes, initialized by string literals of hex escapes
  # (the last row may be shorter; C drops the terminating NUL of literals
  # that fill a row exactly).
  od -An -v -tx1 "$font" > "$tmp_hex" || fail "od failed for $font"
  awk -v i="$i" -v chunk="$chunk_bytes" -v expected="$len" '
    BEGIN { printf "static const char typst_font_%d[][%d] = {\n", i, chunk; n = 0; total = 0; line = "" }
    {
      for (k = 1; k <= NF; k++) {
        line = line "\\x" $k
        n++
        total++
        if (n == chunk) { printf "  \"%s\",\n", line; line = ""; n = 0 }
      }
    }
    END {
      if (n > 0) { printf "  \"%s\",\n", line }
      printf "};\n\n"
      if (total != expected) { exit 1 }
    }
  ' "$tmp_hex" >> "$tmp_c" || fail "hex dump of $font has the wrong length"
  # MoonBit: multi-line strings of at most `chunk_lines` lines.
  names=$(awk -v i="$i" -v n="$chunk_lines" -v out="$tmp_mbt" '
    length($0) == 0 { next }
    {
      if (count % n == 0) {
        name = sprintf("font_%d_base64_%d", i, count / n)
        if (count > 0) { printf "\n" >> out }
        printf "///|\nlet %s : String =\n", name >> out
        names = names (count > 0 ? ", " : "") name
      }
      printf "  #|%s\n", $0 >> out
      count++
    }
    END { printf "\n" >> out; print names }
  ' "$tmp_b64") || fail "awk failed"
  chunks="$chunks|$names"
  i=$((i + 1))
done

# C: the font table.
{
  printf 'const char *const typst_font_data[] = {\n'
  j=0
  while [ "$j" -lt "$i" ]; do
    printf '  typst_font_%d[0],\n' "$j"
    j=$((j + 1))
  done
  printf '};\n\nconst int32_t typst_font_lens[] = {\n'
  for len in $lens; do
    printf '  %s,\n' "$len"
  done
  printf '};\n\nconst int32_t typst_font_count = %d;\n' "$i"
} >> "$tmp_c"

# MoonBit: the font table.
{
  printf '///|\n/// The base64 data (in chunks) and decoded length of each font.\n'
  printf 'let fonts_base64 : Array[(Array[String], Int)] = [\n'
  rest=${chunks#|}
  for len in $lens; do
    names=${rest%%|*}
    case "$rest" in
      *"|"*) rest=${rest#*|} ;;
      *) rest="" ;;
    esac
    printf '  ([%s], %s),\n' "$names" "$len"
  done
  printf ']\n'
} >> "$tmp_mbt"

mv "$tmp_c" "$out_c"
mv "$tmp_mbt" "$out_mbt"
