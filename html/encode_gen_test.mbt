///|
test "encode/head-meta/compact" {
  check_encode(
    el("head", children=[
      el("link", attrs=[("rel", "stylesheet")]),
      el("style", children=[txt("p { color: red; }\n\n  a {}")]),
      el("script", children=[txt("x()")]),
      el("noscript", children=[txt("no")]),
    ]),
    pretty=false,
    "<!DOCTYPE html><head><link rel=\"stylesheet\"><style>p { color: red; }\n\n  a {}</style><script>x()</script><noscript>no</noscript></head>",
  )
}

///|
test "encode/head-meta/pretty" {
  check_encode(
    el("head", children=[
      el("link", attrs=[("rel", "stylesheet")]),
      el("style", children=[txt("p { color: red; }\n\n  a {}")]),
      el("script", children=[txt("x()")]),
      el("noscript", children=[txt("no")]),
    ]),
    pretty=true,
    "<!DOCTYPE html>\n<head>\n  <link rel=\"stylesheet\">\n  <style>\n    p { color: red; }\n    \n      a {}\n  </style>\n  <script>\n    x()\n  </script>\n  <noscript>no</noscript>\n</head>\n",
  )
}

