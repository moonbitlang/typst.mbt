    "error: the character `\"\\u{1}\"` cannot be encoded in HTML",
  )
}

///|
test "encode/style-control/pretty" {
  check_encode(
    el("style", children=[txt("a\u{1}")]),
    pretty=true,
    "error: the character `\"\\u{1}\"` cannot be encoded in HTML",
  )
}

