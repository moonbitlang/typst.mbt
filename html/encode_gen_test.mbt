///|
test "encode/math/compact" {
  check_encode(
    el("p", children=[
      txt("A "),
      el("math", children=[el("mi", children=[txt("x")])]),
      el("math", attrs=[("display", "block")], children=[
        el("mrow", children=[
          el("mi", children=[txt("x")]),
          el("mo", children=[txt("+")]),
          el("mfrac", children=[
            el("mn", children=[txt("1")]),
            el("mn", children=[txt("2")]),
          ]),
        ]),
      ]),
    ]),
    pretty=false,
    "<!DOCTYPE html><p>A <math><mi>x</mi></math><math display=\"block\"><mrow><mi>x</mi><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></math></p>",
  )
}

///|
test "encode/math/pretty" {
  check_encode(
    el("p", children=[
      txt("A "),
      el("math", children=[el("mi", children=[txt("x")])]),
      el("math", attrs=[("display", "block")], children=[
        el("mrow", children=[
          el("mi", children=[txt("x")]),
          el("mo", children=[txt("+")]),
          el("mfrac", children=[
            el("mn", children=[txt("1")]),
            el("mn", children=[txt("2")]),
          ]),
        ]),
      ]),
    ]),
    pretty=true,
    "<!DOCTYPE html>\n<p>\n  A <math>\n    <mi>x</mi>\n  </math>\n  <math display=\"block\">\n    <mrow>\n      <mi>x</mi>\n      <mo>+</mo>\n      <mfrac>\n        <mn>1</mn>\n        <mn>2</mn>\n      </mfrac>\n    </mrow>\n  </math>\n</p>\n",
  )
}

