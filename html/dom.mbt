// Port of the DOM of `typst-html/src/dom.rs`.
//
// `HtmlTag`, `HtmlAttr` and `HtmlAttrs` live in `library` (`html_tag.mbt`,
// `html_attr.mbt`) because element fields store them. `HtmlDocument` is in
// `document.mbt` (together with upstream's `HtmlOutput`).

///|
/// A child of an HTML element.
pub(all) enum HtmlNode {
  /// An introspectable element that produced something within this node.
  Tag(@library.Tag)
  /// Plain text.
  Text(String, @syntax.Span)
  /// Another element.
  Element(HtmlElement)
  /// Layouted content that will be embedded into HTML as an SVG.
  Frame(HtmlFrame)
}

///|
/// Create a plain text node.
pub fn HtmlNode::text(text : String, span : @syntax.Span) -> HtmlNode {
  Text(text, span)
}

///|
/// Returns the span, if any.
pub fn HtmlNode::span(self : HtmlNode) -> @syntax.Span {
  match self {
    Tag(_) => @syntax.Span::detached()
    Text(_, span) => span
    Element(element) => element.span
    Frame(frame) => frame.span
  }
}

///|
/// Iterates over nodes alongside the indices as they would be observed in
/// the final DOM (upstream `HtmlSliceExt::iter_with_dom_indices`).
///
/// - Tags receive the index of the preceding node and don't advance the
///   cursor.
///
/// - For indexing purposes, consecutive text nodes are considered as
///   groups. They receive the same index as they are not distinguishable on
///   the DOM level.
pub fn iter_with_dom_indices(
  nodes : ArrayView[HtmlNode],
) -> Array[(HtmlNode, Int)] {
  let out = []
  let mut cursor = 0
  let mut was_text = false
  for child in nodes {
    let mut i = cursor
    match child {
      Tag(_) => ()
      Text(_, _) => was_text = true
      _ => {
        cursor += if was_text { 1 } else { 0 }
        i = cursor
        cursor += 1
        was_text = false
      }
    }
    out.push((child, i))
  }
  out
}

///|
/// An HTML element.
///
/// Upstream elements are values (with copy-on-write children); here they
/// are mutable references, so code that modifies an element must own it.
pub(all) struct HtmlElement {
  /// The HTML tag.
  mut tag : @library.HtmlTag
  /// The element's attributes.
  mut attrs : @library.HtmlAttrs
  /// The element's CSS properties. Currently only used for generated styles.
  mut css : @library.CssProperties
  /// The element's children.
  mut children : Array[HtmlNode]
  /// The element's logical parent. For introspection purposes, this element
  /// is logically ordered immediately after the parent's start location.
  mut parent : @library.Location?
  /// The span from which the element originated, if any.
  mut span : @syntax.Span
  /// Whether this is a span with `white-space: pre-wrap`  generated by the
  /// compiler to prevent whitespace from being collapsed.
  ///
  /// For such spans, spaces and tabs in the element are emitted as escape
  /// sequences. While this does not matter for browser engine rendering (as
  /// the `white-space` CSS property is enough), it ensures that formatters
  /// won't mess up the output.
  mut pre_span : Bool
}

///|
/// Create a new, blank element without attributes or children.
pub fn HtmlElement::new(tag : @library.HtmlTag) -> HtmlElement {
  {
    tag,
    attrs: @library.HtmlAttrs::new(),
    css: @library.CssProperties::new(),
    children: [],
    parent: None,
    span: @syntax.Span::detached(),
    pre_span: false,
  }
}

///|
/// Attach children to the element.
///
/// Note: This overwrites potential previous children.
pub fn HtmlElement::with_children(
  self : HtmlElement,
  children : Array[HtmlNode],
) -> HtmlElement {
  self.children = children
  self
}

///|
/// Add an attribute to the element.
pub fn HtmlElement::with_attr(
  self : HtmlElement,
  key : @library.HtmlAttr,
  value : String,
) -> HtmlElement {
  self.attrs.push(key, value)
  self
}

///|
/// Adds CSS styles to an element.
pub fn HtmlElement::with_css(
  self : HtmlElement,
  css : @library.CssProperties,
) -> HtmlElement {
  self.css = css
  self
}

///|
/// Attach a span to the element.
pub fn HtmlElement::spanned(
  self : HtmlElement,
  span : @syntax.Span,
) -> HtmlElement {
  self.span = span
  self
}

///|
/// Layouted content that will be embedded into HTML as an SVG.
pub(all) struct HtmlFrame {
  /// The frame that will be displayed as an SVG.
  inner : @library.Frame
  /// The text size where the frame was defined. This is used to size the
  /// frame with em units to make text in and outside of the frame sized
  /// consistently.
  text_size : @library.Abs
  /// An ID to assign to the SVG itself.
  mut id : String?
  /// The element's CSS properties.
  mut css : @library.CssProperties
  /// IDs to assign to destination jump points within the SVG.
  anchors : Array[(@library.Point, String)]
  /// The span from which the frame originated.
  span : @syntax.Span
}

///|
/// Wraps a laid-out frame.
pub fn HtmlFrame::new(
  inner : @library.Frame,
  styles : @library.StyleChain,
  span : @syntax.Span,
) -> HtmlFrame {
  {
    inner,
    text_size: @library.TextElem::size_in(styles).resolve(styles),
    id: None,
    css: @library.CssProperties::new(),
    anchors: [],
    span,
  }
}
