///|
let attr_strings_cell : Ref[Array[(String, String)]?] = { val: None, }

///|
/// Strings referenced by [Type::Strings] (`ATTR_STRINGS`).
pub fn attr_strings() -> Array[(String, String)] {
  match attr_strings_cell.val {
    Some(t) => t
    None => {
      let out = []
      attr_strings_0(out)
      attr_strings_1(out)
      attr_strings_2(out)
      attr_strings_3(out)
      attr_strings_4(out)
      attr_strings_5(out)
      attr_strings_cell.val = Some(out)
      out
    }
  }
}
