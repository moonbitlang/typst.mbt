///|
let attrs_cell : Ref[Array[AttrInfo]?] = { val: None, }

///|
/// A list of all elements' attributes (`ATTRS`).
pub fn attrs() -> Array[AttrInfo] {
  match attrs_cell.val {
    Some(t) => t
    None => {
      let out = []
      attrs_0(out)
      attrs_1(out)
      attrs_2(out)
      attrs_3(out)
      attrs_cell.val = Some(out)
      out
    }
  }
}

