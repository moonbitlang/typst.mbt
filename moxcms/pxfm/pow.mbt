// Port of `pxfm::pow::f_pow` (correctly rounded `f64` power, CORE-MATH
// algorithm) together with the helpers from `pow_exec.rs` it needs.
//
// Deviation: the `x == 2` / `x == 10` shortcuts (`f_exp2` / `f_exp10`) are
// not ported; those inputs take the generic path instead (still correctly
// rounded, like upstream's shortcuts).

///|
fn is_integer(n : Double) -> Bool {
  n == round_ties_even_f64(n)
}

///|
fn is_odd_integer(x : Double) -> Bool {
  (f64_as_i64(x) & 1L) != 0L
}

///|
fn f_powi(x : Double, y : Double) -> Double {
  let mut iter_count = f64_as_i64(y.abs())
  let mut s = DoubleDouble::new(0.0, x)
  // exponentiation by squaring: O(log(y)) complexity
  let mut acc = if iter_count % 2L != 0L {
    s
  } else {
    DoubleDouble::new(0.0, 1.0)
  }
  while true {
    iter_count = iter_count >> 1
    if iter_count == 0L {
      break
    }
    s = DoubleDouble::mult(s, s)
    if iter_count % 2L != 0L {
      acc = DoubleDouble::mult(acc, s)
    }
  }
  let dz = if y.reinterpret_as_uint64() >> 63 != 0UL {
    acc.recip()
  } else {
    acc
  }
  let e = 0x3c40000000000000UL.reinterpret_as_double() // 2^-59
  let ub = dz.hi + fma(e, -dz.hi, dz.lo)
  let lb = dz.hi + fma(e, dz.hi, dz.lo)
  if ub == lb {
    return dz.to_f64()
  }
  f_powi_hard(x, y)
}

///|
fn f_powi_hard(x : Double, y : Double) -> Double {
  let mut iter_count = f64_as_i64(y.abs())
  let mut s = TripleDouble::new(0.0, 0.0, x)
  // exponentiation by squaring: O(log(y)) complexity
  let mut acc = if iter_count % 2L != 0L {
    s
  } else {
    TripleDouble::new(0.0, 0.0, 1.0)
  }
  while true {
    iter_count = iter_count >> 1
    if iter_count == 0L {
      break
    }
    s = TripleDouble::quick_mult(s, s)
    if iter_count % 2L != 0L {
      acc = TripleDouble::quick_mult(acc, s)
    }
  }
  let dz = if y.reinterpret_as_uint64() >> 63 != 0UL {
    acc.recip()
  } else {
    acc
  }
  dz.to_f64()
}

///|
fn log_poly_1(z : Double) -> DoubleDouble {
  // The following is a degree-8 polynomial generated by Sollya for
  // log(1+x)-x+x^2/2 over [-0.0040283203125,0.0040283203125].
  let p_1 : FixedArray[UInt64] = [
    0x3fd5555555555558UL, 0xbfd0000000000003UL, 0x3fc999999981f535UL, 0xbfc55555553d1eb4UL,
    0x3fc2494526fd4a06UL, 0xbfc0001f0c80e8ceUL,
  ]
  let p = (i : Int) => p_1[i].reinterpret_as_double()
  let w = DoubleDouble::from_exact_mult(z, z)
  let t = fma(p(5), z, p(4))
  let mut u = fma(p(3), z, p(2))
  let mut v = fma(p(1), z, p(0))
  u = fma(t, w.hi, u)
  v = fma(u, w.hi, v)
  u = v * w.hi
  DoubleDouble::new(fma(u, z, -0.5 * w.lo), -0.5 * w.hi)
}

///|
/// Given 2^-1074 <= x <= 0x1.fffffffffffffp+1023, puts in h+l an
/// approximation of log(x).
fn pow_log_1(x : Double) -> (DoubleDouble, Bool) {
  let x_u = x.reinterpret_as_uint64()
  let mut m = x_u & 0xfffffffffffffUL
  let mut e = ((x_u >> 52) & 0x7ffUL).reinterpret_as_int64()
  let t = if e != 0L {
    let t = m | (0x3ffUL << 52)
    m = m + (1UL << 52)
    e -= 0x3ffL
    t
  } else {
    // x is a subnormal double
    let k = m.clz() - 11
    e = -0x3feL - k.to_int64()
    m = m << k
    m | (0x3ffUL << 52)
  }
  // now |x| = 2^_e*_t = 2^(_e-52)*m with 1 <= _t < 2,
  // and 2^52 <= _m < 2^53
  let mut t = t.reinterpret_as_double()
  // If m > sqrt(2) we divide it by 2 so ensure 1/sqrt(2) < t < sqrt(2)
  let c = if m >= 0x16a09e667f3bcdUL { 1 } else { 0 }
  e = e + c.to_int64()
  let be = e
  let i = (m >> (if c == 1 { 45 } else { 44 })).to_int() // i/2^8 <= t < (i+1)/2^8
  t = t * (if c == 1 { 0.5 } else { 1.0 })
  let r = pow_inverse[i - 181].reinterpret_as_double()
  let l1 = pow_log_inv[(i - 181) * 2 + 1].reinterpret_as_double()
  let l2 = pow_log_inv[(i - 181) * 2].reinterpret_as_double()
  let z = fma(r, t, -1.0)
  let log2_dd_hi = 0x3fe62e42fefa3800UL.reinterpret_as_double()
  let log2_dd_lo = 0x3d2ef35793c76730UL.reinterpret_as_double()
  let th = fma(be.to_double(), log2_dd_hi, l1)
  let tl = fma(be.to_double(), log2_dd_lo, l2)
  let mut v = DoubleDouble::f64_add(th, DoubleDouble::new(tl, z))
  let p = log_poly_1(z)
  v = DoubleDouble::f64_add(v.hi, DoubleDouble::new(v.lo + p.lo, p.hi))
  if e == 0L &&
    v.lo.abs() > v.hi.abs() * 0x3e70000000000000UL.reinterpret_as_double() {
    v = DoubleDouble::from_exact_add(v.hi, v.lo)
    return (v, true)
  }
  (v, false)
}

///|
/// Given z such that |z| < 2^-12.905, approximates exp(z).
fn exp_poly_1(z : Double) -> DoubleDouble {
  let q_1 : FixedArray[UInt64] = [
    0x3ff0000000000000UL, 0x3ff0000000000000UL, 0x3fe0000000000000UL, 0x3fc5555555997996UL,
    0x3fa5555555849d8dUL,
  ]
  let q = (i : Int) => q_1[i].reinterpret_as_double()
  let mut qq = fma(q(4), z, q(3))
  qq = fma(qq, z, q(2))
  let h0 = fma(qq, z, q(1))
  let v1 = DoubleDouble::from_exact_mult(z, h0)
  DoubleDouble::f64_add(q(0), v1)
}

///|
fn pow_exp_1(r : DoubleDouble, s : Double) -> DoubleDouble {
  let rho0 = 0xc0874910ee4e8a27UL.reinterpret_as_double()
  let rho1 = 0xc08483b8cca421afUL.reinterpret_as_double()
  let rho2 = 0x40862e42e709a95bUL.reinterpret_as_double()
  let rho3 = 0x40862e4316ea5df9UL.reinterpret_as_double()
  let nan = 0.0 / 0.0
  // use !(rh <= RHO2) instead of rh < RHO2 to catch rh = NaN too
  if !(r.hi <= rho2) {
    return if r.hi > rho3 {
      let m = 0x7fefffffffffffffUL.reinterpret_as_double()
      DoubleDouble::new(m * s, m * s)
    } else {
      DoubleDouble::new(nan, nan)
    }
  }
  if r.hi < rho1 {
    return if r.hi < rho0 {
      DoubleDouble::new(
        0x0000000000000001UL.reinterpret_as_double() * (0.5 * s),
        0.0 * s,
      )
    } else {
      DoubleDouble::new(nan, nan)
    }
  }
  let invlog2 = 0x40b71547652b82feUL.reinterpret_as_double()
  let k = round_f64(r.hi * invlog2)
  let log2h = 0x3f262e42fefa39efUL.reinterpret_as_double()
  let log2l = 0x3bbabc9e3b39803fUL.reinterpret_as_double()
  let zh = fma(log2h, -k, r.hi)
  let zl = fma(log2l, -k, r.lo)
  let bk = k.to_int64() // k is an integer, this is just a conversion
  let mk = (bk >> 12) + 0x3ffL
  let i2 = ((bk >> 6) & 0x3fL).to_int()
  let i1 = (bk & 0x3fL).to_int()
  let t0 = DoubleDouble::from_bit_pair(
    exp_reduce_t0[i2 * 2],
    exp_reduce_t0[i2 * 2 + 1],
  )
  let t1 = DoubleDouble::from_bit_pair(
    exp_reduce_t1[i1 * 2],
    exp_reduce_t1[i1 * 2 + 1],
  )
  let mut de = DoubleDouble::quick_mult(t1, t0)
  let q = exp_poly_1(zh + zl)
  de = DoubleDouble::quick_mult(de, q)
  let mut du = mk.reinterpret_as_uint64() << 52
  du = (du.reinterpret_as_double() * s).reinterpret_as_uint64()
  let f = du.reinterpret_as_double()
  DoubleDouble::new(de.lo * f, de.hi * f)
}

///|
/// Power function (`pxfm::f_pow`), max found ULP 0.5.
pub fn f_pow(x : Double, y : Double) -> Double {
  let mut y = y
  let x_sign = x.reinterpret_as_uint64() >> 63 != 0UL
  let y_sign = y.reinterpret_as_uint64() >> 63 != 0UL
  let x_abs = x.reinterpret_as_uint64() & 0x7fffffffffffffffUL
  let y_abs = y.reinterpret_as_uint64() & 0x7fffffffffffffffUL
  let mantissa_mask = (1UL << 52) - 1UL
  let y_mant = y.reinterpret_as_uint64() & mantissa_mask
  let x_u = x.reinterpret_as_uint64()
  let x_a = x_abs
  let y_a = y_abs
  let mut x = x
  let nan = 0.0 / 0.0
  let inf = 1.0 / 0.0
  let inf_bits = 0x7ff0000000000000UL
  let one_bits = 0x3ff0000000000000UL
  // If x or y is signaling NaN
  if x.is_nan() || y.is_nan() {
    return nan
  }
  let mut s = 1.0
  if y_mant == 0UL ||
    y_a > 0x43d74910d52d3052UL ||
    x_u == one_bits ||
    x_u >= inf_bits ||
    x_u < 0xffefffffffffffffUL {
    // Exceptional exponents.
    if y == 0.0 {
      return 1.0
    }
    match y_a {
      0x3fe0000000000000UL => {
        if x == 0.0 || x_u == 0xfff0000000000000UL {
          // pow(-0, 1/2) = +0
          // pow(-inf, 1/2) = +inf
          return if y_sign { 1.0 / (x * x) } else { x * x }
        }
        return if y_sign {
          if x.is_inf() {
            return if !x_sign { 0.0 } else { nan }
          }
          let r = x.sqrt() / x
          let rx = r * x
          let drx = fma(r, x, -rx)
          let h = fma(r, rx, -1.0) + r * drx
          let dr = r * 0.5 * h
          r - dr
        } else {
          x.sqrt()
        }
      }
      0x3ff0000000000000UL => return if y_sign { 1.0 / x } else { x }
      0x4000000000000000UL => {
        let x_e = ((x.reinterpret_as_uint64() >> 52) & 0x7ffUL).to_int() - 1023
        if x_e > 511 {
          return if y_sign { 0.0 } else { inf }
        }
        // not enough precision to make 0.5 ULP for subnormals
        let a_xe = x_e.to_int64() & 0x7fffffffffffffffL
        if a_xe < 70L {
          let x_sqr = DoubleDouble::from_exact_mult(x, x)
          return if y_sign {
            let recip = x_sqr.recip()
            recip.to_f64()
          } else {
            x_sqr.to_f64()
          }
        }
      }
      _ => ()
    }
    // |y| > |1075 / log2(1 - 2^-53)|.
    if y_a > 0x43d74910d52d3052UL {
      if y_a >= 0x7ff0000000000000UL {
        // y is inf or nan
        if y_mant != 0UL {
          // y is NaN
          return if x_u == one_bits { 1.0 } else { y }
        }
        // Now y is +-Inf
        if x_abs.reinterpret_as_double().is_nan() {
          // pow(NaN, +-Inf) = NaN
          return x
        }
        if x_a == 0x3ff0000000000000UL {
          // pow(+-1, +-Inf) = 1.0
          return 1.0
        }
        if x == 0.0 && y_sign {
          // pow(+-0, -Inf) = +inf and raise FE_DIVBYZERO
          return inf
        }
        return if (x_a < one_bits) == y_sign { inf } else { 0.0 }
      }
      // x^y will overflow / underflow in double precision.
      y = if y_sign {
        0xc630000000000000UL.reinterpret_as_double()
      } else {
        0x4630000000000000UL.reinterpret_as_double()
      }
    }
    // y is finite and non-zero.
    if x_u == one_bits {
      // pow(1, y) = 1
      return 1.0
    }
    if x == 0.0 {
      let out_is_neg = x_sign && is_odd_integer(y)
      if y_sign {
        // pow(0, negative number) = inf
        return if out_is_neg { -inf } else { inf }
      }
      // pow(0, positive number) = 0
      return if out_is_neg { -0.0 } else { 0.0 }
    }
    // Note: the `x == 2` (`f_exp2`) and `x == 10` (`f_exp10`) shortcuts are
    // not ported, see the file comment.
    if x_a == inf_bits {
      let out_is_neg = x_sign && is_odd_integer(y)
      if y_sign {
        return if out_is_neg { -0.0 } else { 0.0 }
      }
      return if out_is_neg { -inf } else { inf }
    }
    if x_a > inf_bits {
      // x is NaN.
      return x
    }
    // x is finite and negative, and y is a finite integer.
    let is_y_integer = is_integer(y)
    // y is integer and in [-102;102] and |x|<2^10
    if is_y_integer &&
      y_a <= 0x4059800000000000UL &&
      x_a <= 0x4090000000000000UL &&
      x_a > 0x3cc0000000000000UL {
      return f_powi(x, y)
    }
    if x_sign {
      if is_y_integer {
        x = -x
        if is_odd_integer(y) {
          // set sign to 1 for y even, to -1 for y odd
          let y_parity = if y.abs() >=
            0x4340000000000000UL.reinterpret_as_double() {
            0
          } else {
            (f64_as_i64(y) & 1L).to_int()
          }
          s = if y_parity == 0 { 1.0 } else { -1.0 }
        }
      } else {
        // pow( negative, non-integer ) = NaN
        return nan
      }
    }
    // y is finite and non-zero.
    if x_u == one_bits {
      return 1.0
    }
    if x == 0.0 {
      let out_is_neg = x_sign && is_odd_integer(y)
      if y_sign {
        return if out_is_neg { -inf } else { inf }
      }
      return if out_is_neg { -0.0 } else { 0.0 }
    }
    if x_a == inf_bits {
      let out_is_neg = x_sign && is_odd_integer(y)
      if y_sign {
        return if out_is_neg { -0.0 } else { 0.0 }
      }
      return if out_is_neg { -inf } else { inf }
    }
    if x_a > inf_bits {
      return x
    }
  }
  // approximate log(x)
  let (l, cancel) = pow_log_1(x)
  // We should avoid a spurious underflow/overflow in y*log(x).
  let ey = ((y.reinterpret_as_uint64() >> 52) & 0x7ffUL).to_int()
  let l = if ey < 0x36 || ey >= 0x7f5 { DoubleDouble::new(nan, nan) } else { l }
  let r = DoubleDouble::quick_mult_f64(l, y)
  let res = pow_exp_1(r, s)
  let err = if cancel {
    0x3c55700000000000UL.reinterpret_as_double()
  } else {
    0x3bf2700000000000UL.reinterpret_as_double()
  }
  let res_min = res.hi + fma(err, -res.hi, res.lo)
  let res_max = res.hi + fma(err, res.hi, res.lo)
  if res_min == res_max {
    return res_max
  }
  pow_rational128(x, y, s)
}
