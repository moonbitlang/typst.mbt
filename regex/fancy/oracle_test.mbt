// Differential tests against the real `fancy-regex` crate; the data is
// generated by `oracle/src/bin/gen_fancy_regex_tests.rs` into
// `oracle_data_test.mbt` and `syntect_data_test.mbt`.

///|
/// Build with the generator's flag letters: `o` Oniguruma mode, `i`
/// case-insensitive, `m` multi-line, `s` dot matches newline, `x` ignore
/// whitespace, `b` backtrack limit 1000.
fn build_with(
  pattern : String,
  flags : String,
) -> @fancy.Regex raise @fancy.FancyError {
  let b = @fancy.RegexBuilder::new(pattern)
  for f in flags {
    match f {
      'o' => b.oniguruma_mode(true) |> ignore
      'i' => b.case_insensitive(true) |> ignore
      'm' => b.multi_line(true) |> ignore
      's' => b.dot_matches_new_line(true) |> ignore
      'x' => b.ignore_whitespace(true) |> ignore
      'b' => b.backtrack_limit(1000) |> ignore
      _ => abort("unknown flag")
    }
  }
  b.build()
}

///|
fn describe_caps(caps : @fancy.Captures) -> String {
  let out = StringBuilder()
  out.write_char('[')
  for i in 0..<caps.len() {
    if i > 0 {
      out.write_char(' ')
    }
    match caps.get(i) {
      Some(m) => out.write_string("\{m.start()}..\{m.end()}")
      None => out.write_char('-')
    }
  }
  out.write_char(']')
  out.to_string()
}

///|
/// The UTF-8 byte offsets of the char boundaries (at most 16: the first 12
/// and the last 4).
fn boundaries(hay : String) -> Array[Int] {
  let all = []
  let mut b = 0
  for c in hay {
    all.push(b)
    let c = c.to_int()
    b += if c < 0x80 {
      1
    } else if c < 0x800 {
      2
    } else if c < 0x10000 {
      3
    } else {
      4
    }
  }
  all.push(b)
  if all.length() > 16 {
    let v = all[:12].to_owned()
    v.append(all[all.length() - 4:].to_owned())
    v
  } else {
    all
  }
}

///|
/// The largest char boundary <= half the length.
fn mid_boundary(text : @fancy.Text) -> Int {
  let mut mid = text.len() / 2
  while text.prefix(mid).len() != mid {
    mid -= 1
  }
  mid
}

///|
fn describe_search(re : @fancy.Regex, text : @fancy.Text, pos : Int) -> String {
  try re.captures_from_pos_text(text, pos) catch {
    e => "err:\{e}"
  } noraise {
    Some(caps) => describe_caps(caps)
    None => "none"
  }
}

///|
fn describe(re : @fancy.Regex, hay : String) -> String {
  let out = StringBuilder()
  let text = @fancy.Text::new(hay)
  try re.is_match_text(text) catch {
    e => out.write_string("m=err:\{e}")
  } noraise {
    b => out.write_string("m=\{b}")
  }
  for pos in boundaries(hay) {
    out.write_string(" @\{pos}:")
    out.write_string(describe_search(re, text, pos))
  }
  // A search on a prefix (like syntect's `&line[..end]`).
  let mid = mid_boundary(text)
  out.write_string(" pre\{mid}:")
  out.write_string(describe_search(re, text.prefix(mid), 0))
  out.write_string(" iter:")
  let it = re.captures_iter(hay)
  let mut n = 0
  while it.next() is Some(caps) {
    if n >= 20 {
      out.write_string("...")
      break
    }
    match caps {
      Ok(caps) => out.write_string(describe_caps(caps))
      Err(e) => out.write_string("err:\{e}")
    }
    n += 1
  }
  out.to_string()
}

///|
fn report(failures : Array[String], total : Int) -> Unit raise {
  if !failures.is_empty() {
    let shown = if failures.length() > 40 {
      failures[:40].to_owned()
    } else {
      failures
    }
    fail("\{failures.length()} of \{total} failed:\n" + shown.join("\n"))
  }
}

///|
test "fancy-regex oracle" {
  let failures = []
  let mut total = 0
  for part in oracle_cases[:] {
    for case in part[:] {
      let (pattern, flags, build, hays) = case
      total += 1
      let p = @unicode.rust_debug_str(pattern)
      let re = build_with(pattern, flags) catch {
        e => {
          let actual = "error: \{e}"
          if actual != build {
            failures.push(
              "build \{p} /\{flags}:\n  expected \{build}\n  actual   \{actual}",
            )
          }
          continue
        }
      }
      if build != "ok" {
        failures.push(
          "build \{p} /\{flags}:\n  expected \{build}\n  actual   ok",
        )
        continue
      }
      for h in hays[:] {
        let (hay, expected) = h
        total += 1
        let actual = describe(re, hay)
        if actual != expected {
          failures.push(
            "\{p} /\{flags} on \{@unicode.rust_debug_str(hay)}:\n  expected \{expected}\n  actual   \{actual}",
          )
        }
      }
    }
  }
  report(failures, total)
}

///|
test "syntect regexes build" {
  let failures = []
  for case in syntect_regexes[:] {
    let (pattern, expected) = case
    let actual = try build_with(pattern, "o") catch {
      e => "error: \{e}"
    } noraise {
      _ => "ok"
    }
    if actual != expected {
      failures.push(
        "\{@unicode.rust_debug_str(pattern)}:\n  expected \{expected}\n  actual   \{actual}",
      )
    }
  }
  report(failures, syntect_regexes.length())
}

///|
test "syntect regexes match" {
  let failures = []
  let mut total = 0
  let lines = syntect_lines[:].map(l => @fancy.Text::new(l))
  for case in syntect_matches[:] {
    let (pattern, expected) = case
    let re = build_with(pattern, "o")
    for i, line in lines {
      total += 1
      let l = syntect_lines[i]
      let mid = mid_boundary(line)
      let d = StringBuilder()
      for search in [(0, line), (mid, line), (0, line.prefix(mid))] {
        let (pos, text) = search
        d.write_string(describe_search(re, text, pos))
        d.write_char(' ')
      }
      let actual = d.to_string()
      if actual != expected[i] {
        failures.push(
          "\{@unicode.rust_debug_str(pattern)} on \{@unicode.rust_debug_str(l)}:\n  expected \{expected[i]}\n  actual   \{actual}",
        )
      }
    }
  }
  report(failures, total)
}
