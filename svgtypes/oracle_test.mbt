    ("sans-serif", "sans-serif"),
    ("cursive", "cursive"),
    ("fantasy", "fantasy"),
    ("monospace", "monospace"),
    ("'Times New Roman'", "\"Times New Roman\""),
    ("'Times New Roman', sans-serif", "\"Times New Roman\"|sans-serif"),
    ("Arial, sans-serif, 'fantasy'", "\"Arial\"|sans-serif|\"fantasy\""),
    ("    Arial  , monospace  , 'fantasy'", "\"Arial\"|monospace|\"fantasy\""),
    ("Times    New Roman", "\"Times New Roman\""),
    (
      "\"Times New Roman\", sans-serif, sans-serif, \"Arial\"", "\"Times New Roman\"|sans-serif|sans-serif|\"Arial\"",
    ),
    ("Times New Roman,,,Arial", "\"Times New Roman\"|\"Arial\""),
    (
      "简体中文,sans-serif  , ,\"日本語フォント\",Arial", "\"简体中文\"|sans-serif|\"日本語フォント\"|\"Arial\"",
    ),
    ("", ""),
    ("Red/Black, sans-serif", "E(invalid ident)"),
    ("\"Lucida\" Grande, sans-serif", "E(unexpected data at position 10)"),
    ("Ahem!, sans-serif", "E(invalid ident)"),
    ("test@foo, sans-serif", "E(invalid ident)"),
    ("#POUND, sans-serif", "E(invalid ident)"),
    ("Hawaii 5-0, sans-serif", "E(invalid ident)"),
    ("a, ", "E(unexpected end of stream)"),
    ("'unterminated", "E(unexpected end of stream)"),
    ("'a\\'b'", "\"a\\'b\""),
    ("-foo", "\"-foo\""),
    ("--foo", "E(invalid ident)"),
    ("-", "\"-\""),
    ("Ünïcödé Font", "E(invalid ident)"),
    ("ðx", "\"ðx\""),
    ("íx", "E(invalid ident)"),
    ("a,'b',c", "\"a\"|\"b\"|\"c\""),
    ("a ,b", "\"a\"|\"b\""),
    ("'a' 'b'", "E(unexpected data at position 5)"),
    ("Noto  Sans , ", "E(unexpected end of stream)"),
    ("xîy", "\"xîy\""),
    ("Arial\t,serif", "\"Arial\"|serif"),
  ]
  check_cases("font_families", cases)
}

