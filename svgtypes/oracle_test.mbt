///|
test "oracle transform_list" {
  let cases : Array[(String, String)] = [
    (
      "matrix(1 0 0 1 10 20)", "matrix(3ff0000000000000,0000000000000000,0000000000000000,3ff0000000000000,4024000000000000,4034000000000000)",
    ),
    ("translate(10 20)", "translate(4024000000000000,4034000000000000)"),
    ("scale(2 3)", "scale(4000000000000000,4008000000000000)"),
    ("rotate(30)", "rotate(403e000000000000)"),
    (
      "rotate(30 10 20)", "translate(4024000000000000,4034000000000000);rotate(403e000000000000);translate(c024000000000000,c034000000000000)",
    ),
    (
      "translate(10 15) translate(0 5)", "translate(4024000000000000,402e000000000000);translate(0000000000000000,4014000000000000)",
    ),
    (
      "translate(10) scale(2)", "translate(4024000000000000,0000000000000000);scale(4000000000000000,4000000000000000)",
    ),
    (
      "translate(25 215) scale(2) skewX(45)", "translate(4039000000000000,406ae00000000000);scale(4000000000000000,4000000000000000);skewX(4046800000000000)",
    ),
    ("skewX(45)", "skewX(4046800000000000)"),
    ("text", "E(unexpected end of stream)"),
    (
      "scale(2) text", "scale(4000000000000000,4000000000000000);E(unexpected end of stream)",
    ),
    ("???G", "E(expected '(' not '?' at position 1)"),
    (" ", ""),
    ("\u{1}", "E(expected '(' not '\u{1}' at position 1)"),
    ("rect()", "E(unexpected data at position 1)"),
    (
      "scale(2) rect()", "scale(4000000000000000,4000000000000000);E(unexpected data at position 10)",
    ),
    ("", ""),
    ("skewY(30)", "skewY(403e000000000000)"),
    ("rotate(-45.5)", "rotate(c046c00000000000)"),
    (
      "matrix(1,2,3,4,5,6)", "matrix(3ff0000000000000,4000000000000000,4008000000000000,4010000000000000,4014000000000000,4018000000000000)",
    ),
    ("matrix(1 2 3 4 5)", "E(invalid number at position 17)"),
    (
      "translate(1,2),scale(3)", "translate(3ff0000000000000,4000000000000000);scale(4008000000000000,4008000000000000)",
    ),
    ("translate (1 2)", "translate(3ff0000000000000,4000000000000000)"),
    ("rotate(10 20)", "E(invalid number at position 13)"),
    (
      "rotate(10 20 30 40)", "E(expected ')' not '4' at position 17);rotate(4024000000000000);translate(c034000000000000,c03e000000000000)",
