    ),
    (
      "drop-shadow(currentColor 2 3)", "drop-shadow(N,L(4000000000000000,None),L(4008000000000000,None),L(0000000000000000,None))",
    ),
    (
      "drop-shadow(2 3 currentColor)", "drop-shadow(N,L(4000000000000000,None),L(4008000000000000,None),L(0000000000000000,None))",
    ),
    (
      "drop-shadow(red 2 3 4)", "drop-shadow(rgba(255,0,0,255),L(4000000000000000,None),L(4008000000000000,None),L(4010000000000000,None))",
    ),
    ("drop-shadow(red 2 3 4 red)", "E(expected ')' not 'r' at position 23)"),
    (
      "drop-shadow(currentColor 2 3 4 currentColor)", "E(expected ')' not 'c' at position 32)",
    ),
    ("drop-shadow(2% 3% 4%)", "E(a percentage value detected at position 13)"),
    (
      "drop-shadow(-1 -2 3)", "drop-shadow(N,L(bff0000000000000,None),L(c000000000000000,None),L(4008000000000000,None))",
    ),
    ("hue-rotate(45)", "E(an invalid angle at position 12)"),
    ("url(#qwe)", "url(qwe)"),
    (
      "blur() blur()", "blur(L(0000000000000000,None));blur(L(0000000000000000,None))",
    ),
    (
      "blur() contrast(1)", "blur(L(0000000000000000,None));contrast(3ff0000000000000)",
    ),
    ("none blur()", "E(invalid value)"),
    ("hue-rotate()", "hue-rotate(A(0000000000000000,Degrees))"),
    ("hue-rotate(0)", "hue-rotate(A(0000000000000000,Degrees))"),
    ("hue-rotate(45deg)", "hue-rotate(A(4046800000000000,Degrees))"),
    ("hue-rotate(1rad)", "hue-rotate(A(3ff0000000000000,Radians))"),
    ("hue-rotate(1turn)", "hue-rotate(A(3ff0000000000000,Turns))"),
    ("hue-rotate(100grad)", "hue-rotate(A(4059000000000000,Gradians))"),
    ("contrast(0)", "contrast(0000000000000000)"),
    ("grayscale(1)", "grayscale(3ff0000000000000)"),
    ("invert(0.5)", "invert(3fe0000000000000)"),
    ("opacity(25%)", "opacity(3fd0000000000000)"),
    ("sepia(-0)", "E(a negative value detected at position 7)"),
    ("saturate(1e2)", "saturate(4059000000000000)"),
    ("url(#)", "E(an invalid url at position 1)"),
    ("url()", "E(expected '#' not ')' at position 5)"),
    ("foo(1)", "E(unexpected data at position 1)"),
    ("blur(1", "E(unexpected end of stream)"),
    ("blur", "E(unexpected end of stream)"),
    (
      "drop-shadow(rgb(1,2,3) 1px 2px 3px)", "drop-shadow(rgba(1,2,3,255),L(3ff0000000000000,Px),L(4000000000000000,Px),L(4008000000000000,Px))",
    ),
    (
      "drop-shadow(1px 2px -3px)", "drop-shadow(N,L(3ff0000000000000,Px),L(4000000000000000,Px),L(0000000000000000,None))",
    ),
    ("drop-shadow(#fff 1 2 3 4)", "E(expected ')' not '4' at position 24)"),
    (
      "blur(1) , blur(2)", "blur(L(3ff0000000000000,None));E(expected '(' not ',' at position 9)",
    ),
    ("blur(-0)", "E(a negative value detected at position 6)"),
    (
      "drop-shadow(1 2 #abc)", "drop-shadow(rgba(170,187,204,255),L(3ff0000000000000,None),L(4000000000000000,None),L(0000000000000000,None))",
    ),
    ("drop-shadow(red)", "E(invalid number at position 16)"),
    ("drop-shadow(1)", "E(invalid number at position 14)"),
    (
      "hue-rotate(1e2deg) invert()", "hue-rotate(A(4059000000000000,Degrees));invert(3ff0000000000000)",
    ),
    ("url(#a b)", "E(expected ')' not 'b' at position 8)"),
    ("BLUR(1)", "E(unexpected data at position 1)"),
  ]
  check_cases("filter", cases)
}

