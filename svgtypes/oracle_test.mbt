      "translate(.7792, 1509.8) skewX(75)", "translate(3fe8ef34d6a161e5,4097973333333333);skewX(4052c00000000000)",
    ),
  ]
  check_cases("transform_list", cases)
}

///|
test "oracle filter" {
  let cases : Array[(String, String)] = [
    ("", ""),
    ("none", ""),
    ("blur()", "blur(L(0000000000000000,None))"),
    ("blur(2)", "blur(L(4000000000000000,None))"),
    ("blur(2mm)", "blur(L(4000000000000000,Mm))"),
    ("blur(2%)", "E(a percentage value detected at position 6)"),
