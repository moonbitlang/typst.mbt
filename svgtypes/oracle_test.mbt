///|
test "oracle paint" {
  let cases : Array[(String, String)] = [
    ("none", "none"),
    ("  none   ", "none"),
    (" inherit ", "inherit"),
    (" currentColor ", "currentColor"),
    (" red ", "rgba(255,0,0,255)"),
    (" url(#qwe) ", "url(qwe,N)"),
    (" url(#qwe) none ", "url(qwe,none)"),
    (" url(#qwe) currentColor ", "url(qwe,currentColor)"),
    (" url(#qwe) red ", "url(qwe,rgba(255,0,0,255))"),
    ("qwe", "E(invalid value)"),
    ("red icc-color(acmecmyk, 0.11, 0.48, 0.83, 0.00)", "E(invalid value)"),
    (
      "url(#qwe) red icc-color(acmecmyk, 0.11, 0.48, 0.83, 0.00)", "E(unexpected data at position 5)",
    ),
    ("context-fill", "context-fill"),
    ("context-stroke", "context-stroke"),
    ("\u{A0}none\u{3000}", "none"),
    ("url(#)", "E(invalid value)"),
    ("url(#a) qwe", "E(invalid value)"),
    ("url('#a') blue", "url(a,rgba(0,0,255,255))"),
    ("url(\"#a b\")", "url(a b,N)"),
    ("url(#a", "E(invalid value)"),
    ("", "E(invalid value)"),
    ("#fff", "rgba(255,255,255,255)"),
    ("rgb(1,2,3)", "rgba(1,2,3,255)"),
    ("url(#a)  #123", "url(a,rgba(17,34,51,255))"),
    ("url(#a) none x", "E(invalid value)"),
    ("url( #x )", "url(x,N)"),
    ("URL(#x)", "E(invalid value)"),
    ("inherit x", "E(invalid value)"),
  ]
  check_cases("paint", cases)
}

///|
test "oracle iri" {
  let cases : Array[(String, String)] = [
    ("#id", "iri(id)"),
    ("   #id   ", "iri(id)"),
    ("   #id   text", "E(unexpected data at position 10)"),
    ("#1", "iri(1)"),
    ("# id", "E(invalid value)"),
    ("", "E(unexpected end of stream)"),
    ("id", "E(expected '#' not 'i' at position 1)"),
    ("#", "E(invalid value)"),
    ("#a)b", "iri(a)b)"),
    ("#é", "iri(é)"),
    ("#a\tb", "iri(a\tb)"),
    ("  #日本 x", "E(unexpected data at position 7)"),
  ]
  check_cases("iri", cases)
}

///|
test "oracle funciri" {
  let cases : Array[(String, String)] = [
    ("url(#id)", "funciri(id)"),
    ("url(#1)", "funciri(1)"),
    ("    url(    #id    )   ", "funciri(id)"),
    ("url(#id) qwe", "E(unexpected data at position 10)"),
    ("url('#id')", "funciri(id)"),
    ("url(' #id ')", "funciri(id)"),
    ("url(\"#id\")", "funciri(id)"),
    ("url(\" #id \")", "funciri(id)"),
    ("url ( #1 )", "E(expected 'url(' not 'url ' at position 1)"),
    ("url(#)", "E(invalid value)"),
    ("url(# id)", "E(invalid value)"),
    ("url('#id)", "E(unexpected end of stream)"),
    ("url(#id')", "E(invalid value)"),
    ("", "E(unexpected end of stream)"),
    ("url(", "E(unexpected end of stream)"),
    ("url(#a\u{3000}')", "E(invalid value)"),
    ("url('#a\u{3000}')", "funciri(a)"),
    ("url(#日本)", "funciri(日本)"),
    ("url(#a\"b)", "E(invalid value)"),
    ("url(\"#id')", "E(invalid value)"),
    ("uRl(#x)", "E(expected 'url(' not 'uRl(' at position 1)"),
    ("url('#id' )", "funciri(id)"),
    ("url(#id x)", "E(expected ')' not 'x' at position 9)"),
  ]
  check_cases("funciri", cases)
}

///|
test "oracle viewbox" {
  let cases : Array[(String, String)] = [
    (
      "-20 30 100 500", "vb(c034000000000000,403e000000000000,4059000000000000,407f400000000000)",
    ),
    ("qwe", "E(viewBox contains an invalid number)"),
    ("10 20 30 0", "E(viewBox has a negative or zero size)"),
    ("10 20 0 40", "E(viewBox has a negative or zero size)"),
    ("10 20 0 0", "E(viewBox has a negative or zero size)"),
    ("10 20 -30 0", "E(viewBox has a negative or zero size)"),
    ("10 20 30 -40", "E(viewBox has a negative or zero size)"),
    ("10 20 -30 -40", "E(viewBox has a negative or zero size)"),
    ("", "E(viewBox contains an invalid number)"),
    (
      "1,2,3,4", "vb(3ff0000000000000,4000000000000000,4008000000000000,4010000000000000)",
    ),
    ("1 2 3", "E(viewBox contains an invalid number)"),
    (
      "1 2 3 4 5", "vb(3ff0000000000000,4000000000000000,4008000000000000,4010000000000000)",
    ),
    (
      "1 2 3 4x", "vb(3ff0000000000000,4000000000000000,4008000000000000,4010000000000000)",
    ),
    (
      " 0 0 1e-300 1e300 ", "vb(0000000000000000,0000000000000000,01a56e1fc2f8f359,7e37e43c8800759c)",
    ),
    (
      "760.93693 +657. +.108 7634.E22", "vb(4087c77ed527e521,4084880000000000,3fbba5e353f7ced9,454f92cfd89fd0ac)",
    ),
    (
      "44.354 +413. 7653.07409 25", "vb(40462d4fdf3b645a,4079d00000000000,40bde512f78feef6,4039000000000000)",
    ),
