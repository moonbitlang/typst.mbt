pub fn Value::float(Double) -> Self
pub fn Value::fr(Double) -> Self
pub fn Value::global(String) -> Self
pub fn Value::int(Int64) -> Self
pub fn Value::label(String) -> Self
pub fn Value::length(Length) -> Self
pub fn Value::none() -> Self
pub fn Value::paint(Paint) -> Self
pub fn Value::sizing(Sizing) -> Self
pub fn Value::str(String) -> Self
pub fn Value::stroke(Stroke) -> Self
pub impl ToValue for Value

// Type aliases

// Traits
pub(open) trait IntoContent {
  fn into_content(Self) -> Content
}
pub impl IntoContent for String

pub(open) trait IntoSource {
  fn into_source(Self) -> Source
}
pub impl IntoSource for String
pub impl IntoSource for Bytes

pub trait SetRule : IntoContent {
}

pub trait ToValue {
  fn to_value(Self) -> Value
}
pub impl ToValue for Bool
pub impl ToValue for Int
pub impl ToValue for Int64
pub impl ToValue for Double
pub impl ToValue for String
pub impl[T : ToValue] ToValue for T?
pub impl[T : ToValue] ToValue for Array[T]
pub impl[T : ToValue] ToValue for @library.Smart[T]
