///|
pub fn showcase_static() -> @doc.Document {
  Document([
    SetDocument(title=Seq([Lit("typst.mbt Showcase")]), author=["typst.mbt"], keywords=[
      "typst", "moonbit", "typesetting",
    ]),
    SetPage(
      paper="a4",
      margin=Sides(x=Cm(2.2), top=Cm(2.6), bottom=Cm(2.4)),
      header=Context(_ => {
        Markup(
          "#{{\n    if counter(page).get().first() > 1 [\n      #set text(9pt, fill: luma(110))\n      _typst.mbt — a MoonBit port of Typst_\n      #h(1fr)\n      #counter(page).display(\"1 / 1\", both: true)\n    ]\n  }}",
        )
      }),
    ),
    SetText(font=["Libertinus Serif"], size=Pt(11.0), lang="en"),
    SetPar(leading=Em(0.62), justify=true),
    SetHeading(numbering=Numbering("1.1")),
    SetEquation(numbering=Numbering("(1)")),
    Show(Select::heading(level=1), (v_it, _) => {
      Markup(
        "#(it => {\n  v(0.6em)\n  block(text(fill: rgb(\"#1f4e79\"), it))\n  v(0.2em)\n})(it1)",
        scope=[("it1", Value::content(v_it))],
      )
    }),
    ShowWith(
      Select::raw(block=true),
      Value::call("function.with", positional=[Value::global("block")], named=[
        ("fill", Value::call("luma", positional=[Value::int(246)])),
        ("inset", Value::length(Pt(9.0))),
        ("radius", Value::length(Pt(4.0))),
        ("width", Value::length(Pct(100.0))),
        (
          "stroke",
          Value::add(
            Value::length(Pt(0.5)),
            Value::call("luma", positional=[Value::int(220)]),
          ),
        ),
      ]),
    ),
    ShowWith(Select::link(), Value::global("underline")),
    Parbreak(),
    Space::newline(),
    Markup(
      "#block(\n  width: 100%,\n  inset: (x: 18pt, y: 22pt),\n  radius: 8pt,\n  fill: gradient.linear(rgb(\"#1f4e79\"), rgb(\"#2e86ab\"), rgb(\"#7fc8a9\"), angle: 20deg),\n)[\n  #set text(fill: white)\n  #text(26pt, weight: \"bold\")[typst.mbt]\n  #v(-6pt)\n  #text(13pt)[A faithful MoonBit port of the Typst typesetting engine]\n  #v(4pt)\n  #text(9.5pt)[This document was compiled end to end by the MoonBit port: parsing, evaluation,\n    layout, shaping, line breaking, hyphenation, math, bibliography and PDF export.]\n]",
    ),
    Parbreak(),
    V(Pt(4.0)),
    Space::newline(),
    Outline(depth=2, indent=Auto),
    Parbreak(),
    Heading(Seq([Lit("Text and paragraphs")]), depth=1),
    Parbreak(),
    Lit(
      "Typst lays out text with a Knuth–Plass style optimizer, OpenType shaping and",
    ),
    Space::newline(),
    Lit("Unicode line breaking. Ligatures"),
    Space(),
    Lit("(fi, fl, ffi), kerning and old-style figures"),
    Space::newline(),
    Lit("("),
    Text(Prose("1234567890"), number_type="old-style"),
    Lit(") come from the fonts"),
    Smartquote(double=false),
    Space(),
    Lit("OpenType"),
    Space::newline(),
    Lit("tables, and hyphenation follows the language"),
    Lit(":"),
    Space(),
    Lit("the paragraph you are reading is"),
    Space::newline(),
    Lit("justified with hyphenation enabled."),
    Footnote(
      Seq([
        Lit("Hyphenation patterns come from the"),
        Space::newline(),
        Raw("hypher", block=false),
        Space(),
        Lit("crate, ported to MoonBit together with its tries."),
      ]),
    ),
    Space(),
    Lit("Smart quotes adapt"),
    Space::newline(),
    Lit("to the language"),
    Lit(":"),
    Space(),
    Smartquote(double=true),
    Lit("English"),
    Smartquote(double=true),
    Lit(","),
    Space(),
    Text(Prose("\"Deutsch\""), lang="de"),
    Lit(","),
    Space::newline(),
    Text(Prose("\"Français\""), lang="fr"),
    Lit("."),
    Parbreak(),
    Text(
      Seq([
        Lit("Donaudampfschifffahrtsgesellschaftskapitänsmütze ist ein"),
        Space::newline(),
        Lit(
          "langes deutsches Wort, das ohne Silbentrennung kaum in eine Zeile passt.",
        ),
      ]),
      lang="de",
    ),
    Parbreak(),
    Lit("Mixed scripts are shaped and reordered with the Unicode bidirectional"),
    Space::newline(),
    Lit("algorithm"),
    Lit(":"),
    Space(),
    Lit("English,"),
    Space(),
    Text(Seq([Lit("مرحبا بالعالم")]), font=["Geeza Pro"], lang="ar"),
    Lit(", and"),
    Space::newline(),
    Text(
      Prose("排版引擎的移植"),
      font=["PingFang SC", "Songti SC"],
      lang="zh",
    ),
    Lit(", all in"),
    Space::newline(),
    Lit("one line."),
    Parbreak(),
    Grid(
      [
        Seq([
          Space::newline(),
          Strong(Prose("Lists")),
          Space::newline(),
          ListItem(Seq([Lit("Native, wasm-gc and wasm targets")])),
          Space::newline(),
          ListItem(
            Seq([
              Lit("Differential tests against upstream"),
              Space::newline(),
              ListItem(Seq([Lit("3 792 test files")])),
              Space::newline(),
              ListItem(Seq([Lit("Byte-exact SVG")])),
            ]),
          ),
          Space::newline(),
          EnumItem(Prose("Parse")),
          Space::newline(),
          EnumItem(Prose("Evaluate")),
          Space::newline(),
          EnumItem(Seq([Lit("Lay out")])),
          Space::newline(),
        ]),
        Seq([
          Space::newline(),
          Strong(Prose("Quote")),
          Space::newline(),
          Quote(
            Seq([
              Space::newline(),
              Lit("Beauty is our business."),
              Space::newline(),
            ]),
            block=true,
            attribution=Seq([Lit("Donald E. Knuth")]),
          ),
          Space::newline(),
        ]),
      ],
      columns=[Fr(1.0), Fr(1.0)],
      gutter=[Pt(14.0)],
    ),
    Parbreak(),
    Heading(Prose("Mathematics"), depth=1),
    Parbreak(),
    Lit("The quadratic formula"),
    Space(),
    Equation("x = (-b plus.minus sqrt(b^2 - 4 a c)) / (2 a)"),
    Space(),
    Lit("sits"),
    Space::newline(),
    Lit("inline, while display math gets its own line"),
    Lit(":"),
    Parbreak(),
    Equation(
      "integral_(-infinity)^infinity e^(-x^2) dif x = sqrt(pi)\n  quad \"and\" quad\n  sum_(n=1)^infinity 1 / n^2 = pi^2 / 6",
      block=true,
    ),
    Parbreak(),
    Equation(
      "mat(\n  cos theta, -sin theta;\n  sin theta, cos theta;\n) vec(x, y)\n= vec(x cos theta - y sin theta, x sin theta + y cos theta)",
      block=true,
    ),
    Parbreak(),
    Equation(
      "f(x) = cases(\n  x^2 & \"if\" x >= 0,\n  -x & \"otherwise\",\n) wide\nlim_(n -> infinity) (1 + 1/n)^n = e",
      block=true,
    ),
    Parbreak(),
    Equation(
      "nabla times bold(B) - 1/c^2 (partial bold(E)) / (partial t) = mu_0 bold(J)",
      block=true,
    ),
    Space(),
    Call("label", positional=[Value::str("maxwell")]),
    Parbreak(),
    Lit("Maxwell"),
    Smartquote(double=false),
    Lit("s law,"),
    Space(),
    Ref("maxwell"),
    Lit(", is referenced by label."),
    Parbreak(),
    Heading(Seq([Lit("Tables and figures")]), depth=1),
    Parbreak(),
    Markup(
      "#figure(\n  table(\n    columns: (auto, 1fr, auto, auto),\n    align: (left, left, right, right),\n    stroke: (x, y) => if y == 0 { (bottom: 0.8pt) } else { (bottom: 0.3pt + luma(200)) },\n    fill: (_, y) => if y > 0 and calc.odd(y) { luma(247) },\n    table.header[*Stage*][*What it checks*][*Tests*][*Pass*],\n    [syntax], [parser, AST, incremental reparse], [3 792], [100%],\n    [eval], [evaluation, styles, introspection], [3 792], [99.7%],\n    [paged], [frames: layout, text, math], [2 299], [100%],\n    [svg], [SVG export, byte-identical], [2 299], [100%],\n    [pdf], [PDF semantics and tag tree], [2 299], [100%],\n    [render], [PNG rasterization], [2 299], [100%],\n  ),\n  caption: [Differential test stages against upstream Typst.],\n)",
    ),
    Space(),
    Call("label", positional=[Value::str("stages")]),
    Parbreak(),
    Grid(
      [
        Figure(
          Image("glacier.jpg", width=Pct(100.0)),
          caption=Seq([Lit("A JPEG photo, embedded as is.")]),
        ),
        Figure(
          Image("diagram.svg", width=Pct(100.0)),
          caption=Seq([Lit("An SVG diagram, converted to vectors.")]),
        ),
      ],
      columns=[Fr(1.15), Fr(1.0)],
      gutter=[Pt(12.0)],
    ),
    Parbreak(),
    Figure(
      Image("matplotlib.pdf", width=Pct(62.0)),
      caption=Seq([
        Lit("A PDF figure"),
        Space(),
        Lit("(matplotlib), embedded as a vector form."),
      ]),
    ),
    Parbreak(),
    Heading(Prose("Code"), depth=1),
    Parbreak(),
    Lit("Code blocks are highlighted with a port of"),
    Space(),
    Raw("syntect", block=false),
    Space(),
    Lit("and Typst"),
    Smartquote(double=false),
    Lit("s bundled"),
    Space::newline(),
    Lit("syntaxes"),
    Lit(":"),
    Parbreak(),
    Raw(
      "/// Compute the n-th Fibonacci number.\nfn fib(n: u64) -> u64 {\n    let (mut a, mut b) = (0, 1);\n    for _ in 0..n {\n        (a, b) = (b, a + b);\n    }\n    a\n}",
      block=true,
      lang="rust",
    ),
    Parbreak(),
    Raw(
      "def primes(limit: int) -> list[int]:\n    sieve = [True] * (limit + 1)\n    for i in range(2, int(limit ** 0.5) + 1):\n        if sieve[i]:\n            sieve[i * i :: i] = [False] * len(sieve[i * i :: i])\n    return [i for i in range(2, limit + 1) if sieve[i]]",
      block=true,
      lang="python",
    ),
    Parbreak(),
    Heading(Prose("Drawing"), depth=1),
    Parbreak(),
    Align(
      Center,
      Stack(
        [
          Circle(
            radius=Pt(22.0),
            fill=Value(
              Value::call("gradient.radial", positional=[
                Value::call("rgb", positional=[Value::str("#ffd166")]),
                Value::call("rgb", positional=[Value::str("#ef476f")]),
              ]),
            ),
          ),
          Rect(
            width=Pt(60.0),
            height=Pt(44.0),
            fill=Value(
              Value::call("gradient.conic", positional=[
                Value::spread(Value::global("color.map.rainbow")),
              ]),
            ),
            radius=Corners(all=Pt(6.0)),
          ),
          PolygonRegular(
            fill=Rgb("#118ab2"),
            stroke=Stroke(paint=Rgb("#073b4c"), thickness=Pt(1.5)),
            size=Pt(48.0),
            vertices=6,
          ),
          Curve(
            [
              CurveMove((Pt(0.0), Pt(40.0))),
              CurveCubic(
                (Pt(20.0), Neg(Pt(20.0))),
                (Pt(40.0), Pt(80.0)),
                (Pt(60.0), Pt(10.0)),
              ),
            ],
            stroke=Stroke(paint=Rgb("#06d6a0"), thickness=Pt(2.0)),
          ),
          Value::call("box", named=[
            ("width", Value::length(Pt(70.0))),
            ("height", Value::length(Pt(44.0))),
            (
              "fill",
              Value::call(
                "tiling",
                positional=[
                  Value::content(
                    Seq([
                      Space::newline(),
                      Place(
                        Line(
                          start=(Pt(0.0), Pt(0.0)),
                          end_=(Pt(8.0), Pt(8.0)),
                          stroke=Stroke(paint=Luma(120), thickness=Pt(0.6)),
                        ),
                      ),
                      Space::newline(),
                    ]),
                  ),
                ],
                named=[
                  (
                    "size",
                    Value::array([
                      Value::length(Pt(8.0)),
                      Value::length(Pt(8.0)),
                    ]),
                  ),
                ],
              ),
            ),
            ("stroke", Value::length(Pt(0.6))),
          ]),
        ],
        dir=Ltr,
        spacing=Pt(12.0),
      ),
    ),
    Parbreak(),
    Heading(Prose("Citations"), depth=1),
    Parbreak(),
    Lit("Bibliographies are formatted with a port of"),
    Space(),
    Raw("hayagriva", block=false),
    Space(),
    Lit("and the Citation Style"),
    Space::newline(),
    Lit("Language"),
    Lit(":"),
    Space(),
    Lit("the Net Wok study"),
    Space(),
    Ref("netwok"),
    Lit(", distributed dumplings revisited"),
    Space::newline(),
    Ref("netwok", supplement=Supplement(Seq([Lit("p. 200")]))),
    Lit(", piracy"),
    Space(),
    Ref("arrgh"),
    Space(),
    Lit("and glaciers"),
    Space(),
    Ref("glacier-melt"),
    Lit(", as well as a classic"),
    Space::newline(),
    Ref("tolkien54"),
    Lit("."),
    Parbreak(),
    Bibliography("works.bib", style="ieee"),
    Space::newline(),
  ])
}
