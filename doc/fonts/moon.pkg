// The font data is generated from `files/` by the generator of
// `typst_assets/fonts` (`gen-fonts`, `gen-fonts.ps1` on Windows), with C
// symbols of its own (`--prefix`): both packages are in one executable.
formatter(ignore: [ "fonts_wasm_gen.mbt" ])

options(
  "pre-build": [
    {
      "input": [
        "../../typst_assets/fonts/gen-fonts",
        "../../typst_assets/fonts/gen-fonts.ps1",
        "files/IBMPlexSans-Regular.ttf",
        "files/IBMPlexSans-Italic.ttf",
        "files/IBMPlexSans-Bold.ttf",
        "files/IBMPlexSans-BoldItalic.ttf",
        "files/IBMPlexSans-Medium.ttf",
      ],
      "output": [ "fonts_gen.c", "fonts_wasm_gen.mbt" ],
      "command": "typst_assets/fonts/gen-fonts --prefix=doc_font $output $input",
    },
  ],
  "native-stub": [ "fonts_stub.c", "fonts_gen.c" ],
  targets: {
    "fonts_native.mbt": [ "native", "llvm" ],
    "fonts_wasm.mbt": [ "wasm", "wasm-gc" ],
    "fonts_wasm_gen.mbt": [ "wasm", "wasm-gc" ],
  },
)
