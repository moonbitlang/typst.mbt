///|
/// Visits the result slots of the instruction (visit_results.rs), returning
/// the instruction with the slots the visitor returned.
pub fn[V : VisitResults] Op::visit_results(self : Op, visitor : V) -> Op {
  match self {
    Copy(result~, value~) => {
      let result = visitor.visit_result_reg(result)
      Copy(result~, value~)
    }
    Copy2(results~, values~) => {
      let results = FixedSlotSpan::from_span_unchecked(visitor.visit_result_regs(results.span(), Some(2)))
      Copy2(results~, values~)
    }
    CopyImm32(result~, value~) => {
      let result = visitor.visit_result_reg(result)
      CopyImm32(result~, value~)
    }
    CopyI64Imm32(result~, value~) => {
      let result = visitor.visit_result_reg(result)
      CopyI64Imm32(result~, value~)
    }
    CopyF64Imm32(result~, value~) => {
      let result = visitor.visit_result_reg(result)
      CopyF64Imm32(result~, value~)
    }
    CopySpan(results~, values~, len~) => {
      let results = visitor.visit_result_regs(results, None)
      CopySpan(results~, values~, len~)
    }
    CopyMany(results~, values~) => {
      let results = visitor.visit_result_regs(results, None)
      CopyMany(results~, values~)
    }
    CallInternal0(results~, func~) => {
      let results = visitor.visit_result_regs(results, None)
      CallInternal0(results~, func~)
    }
    CallInternal(results~, func~) => {
      let results = visitor.visit_result_regs(results, None)
      CallInternal(results~, func~)
    }
    CallImported0(results~, func~) => {
      let results = visitor.visit_result_regs(results, None)
      CallImported0(results~, func~)
    }
    CallImported(results~, func~) => {
      let results = visitor.visit_result_regs(results, None)
      CallImported(results~, func~)
    }
    CallIndirect0(results~, func_type~) => {
      let results = visitor.visit_result_regs(results, None)
      CallIndirect0(results~, func_type~)
    }
    CallIndirect0Imm16(results~, func_type~) => {
      let results = visitor.visit_result_regs(results, None)
      CallIndirect0Imm16(results~, func_type~)
    }
    CallIndirect(results~, func_type~) => {
      let results = visitor.visit_result_regs(results, None)
      CallIndirect(results~, func_type~)
    }
    CallIndirectImm16(results~, func_type~) => {
      let results = visitor.visit_result_regs(results, None)
      CallIndirectImm16(results~, func_type~)
    }
    SelectI32And(result~, lhs~, rhs~) => {
      let result = visitor.visit_result_reg(result)
      SelectI32And(result~, lhs~, rhs~)
    }
    SelectI32AndImm16(result~, lhs~, rhs~) => {
      let result = visitor.visit_result_reg(result)
      SelectI32AndImm16(result~, lhs~, rhs~)
    }
    SelectI32Or(result~, lhs~, rhs~) => {
