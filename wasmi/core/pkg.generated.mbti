  fn base(Self) -> UInt64
  fn load(Self) -> UInt64 = _
  fn instance(Self) -> UInt64 = _
  fn store(Self) -> UInt64 = _
  fn call(Self) -> UInt64 = _
  fn simd(Self) -> UInt64 = _
  fn bytes_per_fuel(Self) -> UInt64
}

pub(open) trait ResourceLimiter {
  fn memory_growing(Self, UInt64, UInt64, UInt64?) -> Bool raise LimiterError
  fn table_growing(Self, UInt64, UInt64, UInt64?) -> Bool raise LimiterError
  fn memory_grow_failed(Self, LimiterError) -> Unit = _
  fn table_grow_failed(Self, LimiterError) -> Unit = _
  fn instances(Self) -> UInt64
  fn tables(Self) -> UInt64
  fn memories(Self) -> UInt64
}
