import {
  "moonbitlang/typst/syntax",
  "moonbitlang/typst/library",
  "moonbitlang/typst/eval",
  "moonbitlang/typst/typst",
  "moonbitlang/typst/layout",
  "moonbitlang/typst/html",
  "moonbitlang/typst/svg",
  "moonbitlang/typst/render",
  "moonbitlang/typst/pdf",
  "moonbitlang/typst/bundle",
  "moonbitlang/typst/data/serde",
  "moonbitlang/typst/data/json" @tjson,
  "moonbitlang/typst/data/yaml",
  "moonbitlang/typst/kit",
  "moonbitlang/typst/kit/platform",
  "moonbitlang/typst/kit/watcher",
  "moonbitlang/core/encoding/utf8",
}

pkgtype(kind: "executable")

import {
  "moonbitlang/core/env",
  "moonbitlang/core/debug",
} for "wbtest"

// `watch` needs a file system watcher, which exists on the native and wasm
// targets (`kit/watcher`).

options(
  targets: {
    "watch.mbt": [ "native", "wasm" ],
    "watch_unsupported.mbt": [ "wasm-gc", "js" ],
  },
)
