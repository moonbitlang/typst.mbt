import {
  "moonbitlang/core/cmp",
  "moonbitlang/core/v128",
}

import {
  "moonbitlang/x/fs",
  "moonbitlang/core/string",
  "moonbitlang/core/bench",
} for "wbtest"

// `@v128` is experimental, and unused on wasm-gc/js, which select the
// `*_scalar.mbt` files (see AGENTS.md: v128 kernels).

warnings = "-alert_experimental-unused_package"

options(
  targets: {
    "vertical_v128.mbt": [ "native", "wasm" ],
    "kernels_v128_wbtest.mbt": [ "native", "wasm" ],
    "vertical_scalar.mbt": [ "wasm-gc", "js" ],
    "horizontal_v128.mbt": [ "native", "wasm" ],
    "horizontal_scalar.mbt": [ "wasm-gc", "js" ],
  },
)
