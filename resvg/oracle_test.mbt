    ),
    "300x300 66d0c91fabef5961",
  )
}

///|
test "resvg/corpus/filter-drop-shadow-offset-merge" {
  assert_eq(
    corpus_render(
      "<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <filter id=\"f1\"><feDropShadow dx=\"6\" dy=\"4\" stdDeviation=\"3\" flood-color=\"navy\" flood-opacity=\"0.6\"/></filter>\n  <filter id=\"f2\">\n    <feOffset in=\"SourceAlpha\" dx=\"5\" dy=\"5\" result=\"o\"/>\n    <feGaussianBlur in=\"o\" stdDeviation=\"2\" result=\"b\"/>\n    <feFlood flood-color=\"gold\" flood-opacity=\"0.5\" x=\"10%\" y=\"10%\" width=\"50%\" height=\"50%\"/>\n    <feMerge><feMergeNode in=\"b\"/><feMergeNode/><feMergeNode in=\"SourceGraphic\"/></feMerge>\n  </filter>\n  <path d=\"M30 30 h60 v60 h-60 z\" fill=\"coral\" filter=\"url(#f1)\"/>\n  <circle cx=\"140\" cy=\"140\" r=\"35\" fill=\"teal\" filter=\"url(#f2)\" transform=\"rotate(20 140 140)\"/>\n</svg>\n",
    ),
    "300x300 b2e64bb01758ef68",
  )
}

///|
test "resvg/corpus/filter-color" {
  assert_eq(
    corpus_render(
      "<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <linearGradient id=\"g\"><stop offset=\"0\" stop-color=\"red\"/><stop offset=\"0.5\" stop-color=\"lime\"/><stop offset=\"1\" stop-color=\"blue\" stop-opacity=\"0.5\"/></linearGradient>\n  <filter id=\"hue\"><feColorMatrix type=\"hueRotate\" values=\"73\"/></filter>\n  <filter id=\"sat\"><feColorMatrix type=\"saturate\" values=\"0.3\"/></filter>\n  <filter id=\"mat\" color-interpolation-filters=\"sRGB\"><feColorMatrix type=\"matrix\" values=\"0.3 0.5 0.2 0 0.1  0 1 0 0 0  0.7 0 0.3 0 0  0 0 0 0.8 0.1\"/></filter>\n  <filter id=\"lum\"><feColorMatrix type=\"luminanceToAlpha\"/></filter>\n  <filter id=\"ct\">\n    <feComponentTransfer>\n      <feFuncR type=\"table\" tableValues=\"0 0.8 0.2 1\"/>\n      <feFuncG type=\"discrete\" tableValues=\"0.1 0.5 0.9\"/>\n      <feFuncB type=\"gamma\" amplitude=\"1.3\" exponent=\"0.6\" offset=\"0.05\"/>\n      <feFuncA type=\"linear\" slope=\"0.8\" intercept=\"0.1\"/>\n    </feComponentTransfer>\n  </filter>\n  <rect x=\"10\" y=\"10\" width=\"180\" height=\"30\" fill=\"url(#g)\" filter=\"url(#hue)\"/>\n  <rect x=\"10\" y=\"45\" width=\"180\" height=\"30\" fill=\"url(#g)\" filter=\"url(#sat)\"/>\n  <rect x=\"10\" y=\"80\" width=\"180\" height=\"30\" fill=\"url(#g)\" filter=\"url(#mat)\"/>\n  <rect x=\"10\" y=\"115\" width=\"180\" height=\"30\" fill=\"url(#g)\" filter=\"url(#lum)\"/>\n  <rect x=\"10\" y=\"150\" width=\"180\" height=\"40\" fill=\"url(#g)\" filter=\"url(#ct)\"/>\n</svg>\n",
    ),
    "300x300 9c8280584256b820",
  )
}

///|
test "resvg/corpus/filter-composite-blend" {
  assert_eq(
    corpus_render(
      "<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <filter id=\"f1\">\n    <feFlood flood-color=\"orange\" result=\"fl\"/>\n    <feComposite in=\"SourceGraphic\" in2=\"fl\" operator=\"arithmetic\" k1=\"0.5\" k2=\"0.3\" k3=\"0.4\" k4=\"-0.1\"/>\n  </filter>\n  <filter id=\"f2\">\n    <feFlood flood-color=\"blue\" flood-opacity=\"0.5\" result=\"fl\"/>\n    <feComposite in=\"fl\" in2=\"SourceAlpha\" operator=\"xor\"/>\n  </filter>\n  <filter id=\"f3\" color-interpolation-filters=\"linearRGB\">\n    <feFlood flood-color=\"#08f\" result=\"fl\"/>\n    <feBlend in=\"SourceGraphic\" in2=\"fl\" mode=\"color-burn\"/>\n  </filter>\n  <circle cx=\"50\" cy=\"50\" r=\"35\" fill=\"crimson\" filter=\"url(#f1)\"/>\n  <circle cx=\"150\" cy=\"50\" r=\"35\" fill=\"crimson\" filter=\"url(#f2)\"/>\n  <circle cx=\"100\" cy=\"140\" r=\"45\" fill=\"#c84\" filter=\"url(#f3)\"/>\n</svg>\n",
    ),
    "300x300 869151919e25757b",
  )
}

///|
test "resvg/corpus/filter-convolve-morphology" {
  assert_eq(
    corpus_render(
      "<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <filter id=\"c1\"><feConvolveMatrix order=\"3\" kernelMatrix=\"1 -1 1 -1 2 -1 1 -1 1\" divisor=\"1.5\" bias=\"0.1\" edgeMode=\"duplicate\"/></filter>\n  <filter id=\"c2\"><feConvolveMatrix order=\"3 2\" kernelMatrix=\"1 2 3 4 5 6\" targetX=\"2\" targetY=\"0\" edgeMode=\"wrap\" preserveAlpha=\"true\"/></filter>\n  <filter id=\"c3\"><feConvolveMatrix order=\"2\" kernelMatrix=\"1 0 0 -1\" edgeMode=\"none\"/></filter>\n  <filter id=\"m1\"><feMorphology operator=\"erode\" radius=\"2 1\"/></filter>\n  <filter id=\"m2\"><feMorphology operator=\"dilate\" radius=\"3\"/></filter>\n  <linearGradient id=\"g\"><stop offset=\"0\" stop-color=\"red\"/><stop offset=\"1\" stop-color=\"blue\" stop-opacity=\"0.3\"/></linearGradient>\n  <rect x=\"10\" y=\"10\" width=\"80\" height=\"50\" fill=\"url(#g)\" filter=\"url(#c1)\"/>\n  <rect x=\"110\" y=\"10\" width=\"80\" height=\"50\" fill=\"url(#g)\" filter=\"url(#c2)\"/>\n  <rect x=\"10\" y=\"80\" width=\"80\" height=\"50\" fill=\"url(#g)\" filter=\"url(#c3)\"/>\n  <path d=\"M110 80 l40 50 l40 -50 z\" fill=\"green\" filter=\"url(#m1)\"/>\n  <path d=\"M60 150 l40 40 l40 -40 z\" fill=\"green\" filter=\"url(#m2)\"/>\n</svg>\n",
    ),
    "300x300 5939d0ea30eeea24",
  )
}

///|
test "resvg/corpus/filter-turbulence-displacement" {
  assert_eq(
    corpus_render(
      "<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <filter id=\"t1\" x=\"0\" y=\"0\" width=\"1\" height=\"1\"><feTurbulence baseFrequency=\"0.05 0.02\" numOctaves=\"3\" seed=\"7\"/></filter>\n  <filter id=\"t2\" x=\"0\" y=\"0\" width=\"1\" height=\"1\"><feTurbulence type=\"fractalNoise\" baseFrequency=\"0.1\" numOctaves=\"2\" seed=\"-3\" stitchTiles=\"stitch\"/></filter>\n  <filter id=\"d\">\n    <feTurbulence baseFrequency=\"0.03\" numOctaves=\"2\" result=\"t\"/>\n    <feDisplacementMap in=\"SourceGraphic\" in2=\"t\" scale=\"15\" xChannelSelector=\"R\" yChannelSelector=\"A\"/>\n  </filter>\n  <rect x=\"5\" y=\"5\" width=\"90\" height=\"90\" filter=\"url(#t1)\"/>\n  <rect x=\"105\" y=\"5\" width=\"90\" height=\"90\" filter=\"url(#t2)\"/>\n  <rect x=\"30\" y=\"110\" width=\"140\" height=\"80\" fill=\"slateblue\" stroke=\"black\" stroke-width=\"4\" filter=\"url(#d)\"/>\n</svg>\n",
    ),
    "300x300 8b3e0d52c5dfdf2d",
  )
}

///|
test "resvg/corpus/filter-lighting" {
  assert_eq(
    corpus_render(
      "<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <filter id=\"l1\"><feDiffuseLighting surfaceScale=\"4\" diffuseConstant=\"1.2\" lighting-color=\"#ffd\"><feDistantLight azimuth=\"45\" elevation=\"35\"/></feDiffuseLighting></filter>\n  <filter id=\"l2\"><feSpecularLighting surfaceScale=\"3\" specularConstant=\"1\" specularExponent=\"12\" lighting-color=\"white\"><fePointLight x=\"60\" y=\"40\" z=\"30\"/></feSpecularLighting></filter>\n  <filter id=\"l3\"><feDiffuseLighting surfaceScale=\"2\" lighting-color=\"lime\"><feSpotLight x=\"150\" y=\"110\" z=\"60\" pointsAtX=\"160\" pointsAtY=\"170\" pointsAtZ=\"0\" specularExponent=\"2\" limitingConeAngle=\"30\"/></feDiffuseLighting></filter>\n  <filter id=\"l4\"><feSpecularLighting specularExponent=\"1\"><feDistantLight azimuth=\"200\" elevation=\"60\"/></feSpecularLighting></filter>\n  <circle cx=\"50\" cy=\"50\" r=\"40\" fill=\"gray\" filter=\"url(#l1)\"/>\n  <circle cx=\"150\" cy=\"50\" r=\"40\" fill=\"gray\" fill-opacity=\"0.7\" filter=\"url(#l2)\"/>\n  <rect x=\"110\" y=\"110\" width=\"80\" height=\"80\" fill=\"black\" filter=\"url(#l3)\"/>\n  <circle cx=\"50\" cy=\"150\" r=\"40\" fill=\"gray\" filter=\"url(#l4)\" transform=\"scale(1.1 0.9)\"/>\n</svg>\n",
    ),
    "300x300 b443df2d07da0820",
  )
}

///|
test "resvg/corpus/filter-tile-image" {
  assert_eq(
    corpus_render(
      "<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n  <defs><circle id=\"dot\" cx=\"10\" cy=\"10\" r=\"8\" fill=\"maroon\"/></defs>\n  <filter id=\"t\" x=\"0\" y=\"0\" width=\"1\" height=\"1\">\n    <feFlood flood-color=\"khaki\" x=\"0\" y=\"0\" width=\"30\" height=\"25\" result=\"a\"/>\n    <feOffset in=\"a\" dx=\"5\" dy=\"3\" result=\"b\"/>\n    <feTile in=\"b\"/>\n  </filter>\n  <filter id=\"i\" x=\"0\" y=\"0\" width=\"1\" height=\"1\">\n    <feImage xlink:href=\"#dot\" x=\"20\" y=\"10\"/>\n  </filter>\n  <rect x=\"10\" y=\"10\" width=\"180\" height=\"90\" filter=\"url(#t)\"/>\n  <rect x=\"10\" y=\"110\" width=\"180\" height=\"80\" filter=\"url(#i)\" transform=\"rotate(3)\"/>\n</svg>\n",
    ),
    "300x300 ccf8a0ad8a949d2e",
  )
}

///|
test "resvg/corpus/filter-chain-subregions" {
  assert_eq(
    corpus_render(
      "<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <filter id=\"f\" filterUnits=\"userSpaceOnUse\" x=\"10\" y=\"10\" width=\"180\" height=\"180\" primitiveUnits=\"objectBoundingBox\">\n    <feGaussianBlur stdDeviation=\"0.02\" x=\"0.1\" y=\"0.1\" width=\"0.6\" height=\"0.6\" result=\"b\"/>\n    <feOffset in=\"b\" dx=\"0.05\" dy=\"0.05\" result=\"o\"/>\n    <feComposite in=\"SourceGraphic\" in2=\"o\" operator=\"over\"/>\n  </filter>\n  <filter id=\"g\"><feGaussianBlur stdDeviation=\"2\"/><feGaussianBlur stdDeviation=\"0 4\"/></filter>\n  <rect x=\"30\" y=\"30\" width=\"100\" height=\"100\" fill=\"darkorange\" stroke=\"black\" filter=\"url(#f)\"/>\n  <circle cx=\"150\" cy=\"150\" r=\"30\" fill=\"navy\" filter=\"url(#g) url(#f)\"/>\n</svg>\n",
    ),
    "300x300 2a22841cfd9c8b85",
  )
}

///|
test "resvg/corpus/images-raster" {
  assert_eq(
    corpus_render(
      "<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <image x=\"10\" y=\"10\" width=\"80\" height=\"60\" preserveAspectRatio=\"none\" href=\"data:image/png;base64,\"/>\n  <image x=\"110\" y=\"10\" width=\"80\" height=\"60\" style=\"image-rendering:pixelated\" href=\"data:image/png;base64,\"/>\n  <image x=\"10\" y=\"110\" width=\"80\" height=\"80\" style=\"image-rendering:optimizeSpeed\" href=\"data:image/gif;base64,\"/>\n  <image x=\"110\" y=\"110\" width=\"80\" height=\"80\" transform=\"rotate(10 150 150)\" href=\"data:image/jpeg;base64,\"/>\n  <image x=\"60\" y=\"60\" width=\"80\" height=\"80\" opacity=\"0.5\" href=\"data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10'&gt;&lt;circle cx='5' cy='5' r='4' fill='green' opacity='0.5'/&gt;&lt;/svg&gt;\"/>\n</svg>\n",
    ),
    "300x300 0faaddf2ef82cf25",
  )
}

