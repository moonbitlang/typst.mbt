      "<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <linearGradient id=\"lg\" x1=\"0.2\" y1=\"0\" x2=\"0.6\" y2=\"0.3\" spreadMethod=\"reflect\">\n    <stop offset=\"0\" stop-color=\"red\" stop-opacity=\"0.7\"/>\n    <stop offset=\"0.5\" stop-color=\"yellow\"/>\n    <stop offset=\"1\" stop-color=\"blue\"/>\n  </linearGradient>\n  <radialGradient id=\"rg\" cx=\"0.5\" cy=\"0.5\" r=\"0.3\" fx=\"0.35\" fy=\"0.4\" fr=\"0.05\" spreadMethod=\"repeat\" gradientTransform=\"skewX(10)\">\n    <stop offset=\"0\" stop-color=\"white\"/>\n    <stop offset=\"1\" stop-color=\"purple\"/>\n  </radialGradient>\n  <rect x=\"10\" y=\"10\" width=\"180\" height=\"85\" fill=\"url(#lg)\" fill-opacity=\"0.8\"/>\n  <ellipse cx=\"100\" cy=\"145\" rx=\"90\" ry=\"45\" fill=\"url(#rg)\" stroke=\"url(#lg)\" stroke-width=\"6\"/>\n</svg>\n",
    ),
    "300x300 ddabcd3796107d03",
  )
}

