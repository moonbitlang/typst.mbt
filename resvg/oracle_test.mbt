      "<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <g opacity=\"0.5\"><rect x=\"-5000\" y=\"-5000\" width=\"10000\" height=\"10000\" fill=\"blue\"/></g>\n  <g filter=\"url(#f)\"><circle cx=\"100\" cy=\"100\" r=\"5000\" fill=\"red\"/></g>\n  <filter id=\"f\"><feGaussianBlur stdDeviation=\"3\"/></filter>\n</svg>\n",
