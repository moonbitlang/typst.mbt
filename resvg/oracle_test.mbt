test "resvg/corpus/masks" {
  assert_eq(
    corpus_render(
      "<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <linearGradient id=\"g\"><stop offset=\"0\" stop-color=\"white\"/><stop offset=\"1\" stop-color=\"black\"/></linearGradient>\n  <mask id=\"m2\" mask-type=\"alpha\">\n    <circle cx=\"100\" cy=\"100\" r=\"80\" fill=\"black\" fill-opacity=\"0.6\"/>\n  </mask>\n  <mask id=\"m1\" mask=\"url(#m2)\" x=\"10\" y=\"10\" width=\"170\" height=\"150\" maskUnits=\"userSpaceOnUse\">\n    <rect x=\"0\" y=\"0\" width=\"200\" height=\"200\" fill=\"url(#g)\"/>\n  </mask>\n  <mask id=\"empty\"/>\n  <rect x=\"0\" y=\"0\" width=\"200\" height=\"200\" fill=\"darkgreen\" mask=\"url(#m1)\"/>\n  <rect x=\"0\" y=\"0\" width=\"50\" height=\"50\" fill=\"red\" mask=\"url(#empty)\"/>\n</svg>\n",
    ),
    "300x300 58d4956e88e0acc3",
  )
}

///|
test "resvg/corpus/opacity-blend-isolation" {
  assert_eq(
    corpus_render(
      "<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <rect x=\"0\" y=\"0\" width=\"200\" height=\"100\" fill=\"orange\"/>\n  <g opacity=\"0.5\" style=\"isolation:isolate\">\n    <circle cx=\"80\" cy=\"90\" r=\"50\" fill=\"blue\" style=\"mix-blend-mode:multiply\"/>\n    <circle cx=\"120\" cy=\"90\" r=\"50\" fill=\"green\" style=\"mix-blend-mode:screen\"/>\n  </g>\n  <g style=\"mix-blend-mode:difference\" transform=\"translate(0.3 0.7)\">\n    <rect x=\"40\" y=\"120\" width=\"120\" height=\"60\" fill=\"white\"/>\n  </g>\n  <g style=\"mix-blend-mode:hue\"><rect x=\"10\" y=\"20\" width=\"40\" height=\"160\" fill=\"#3a7\"/></g>\n  <g style=\"mix-blend-mode:luminosity\"><rect x=\"150\" y=\"20\" width=\"40\" height=\"160\" fill=\"#a37\"/></g>\n</svg>\n",
    ),
    "300x300 02e37fcf37442d07",
  )
}

