///|
test "resvg/corpus/paths-fill-stroke" {
  assert_eq(
    corpus_render(
      "<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <path d=\"M 20 30 C 60 -20 140 220 180 50 L 120 180 Z\" fill=\"seagreen\" stroke=\"navy\" stroke-width=\"7\" stroke-linejoin=\"round\" fill-rule=\"evenodd\"/>\n  <circle cx=\"100\" cy=\"100\" r=\"40\" fill=\"none\" stroke=\"crimson\" stroke-width=\"5\" stroke-dasharray=\"10 5 3\" stroke-dashoffset=\"4\" paint-order=\"stroke\"/>\n  <rect x=\"30\" y=\"140\" width=\"50\" height=\"30\" fill=\"gold\" shape-rendering=\"crispEdges\" transform=\"rotate(15 55 155)\"/>\n</svg>\n",
    ),
    "300x300 27858fc6c8b9ec66",
  )
}

