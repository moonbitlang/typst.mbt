import {
  "moonbitlang/typst/libm",
  "moonbitlang/core/math",
  "moonbitlang/core/debug",
}

import {
  "moonbitlang/x/fs",
} for "test"

// `x/fs` is only used by `stroke_oracle_test.mbt` (native only), and moon.pkg
// has no per-target imports.

warnings = "-unused_package"

options(
  "native-stub": [ "sincos_stub.c" ],
  targets: {
    "libm_native.mbt": [ "native" ],
    "libm_other.mbt": [ "not", "native" ],
    // Bit-exact only with the platform libm.
    "stroke_oracle_test.mbt": [ "native" ],
  },
)
