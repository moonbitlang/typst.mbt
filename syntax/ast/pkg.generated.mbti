// Traits
pub(open) trait AstNode {
  fn from_untyped(@syntax.SyntaxNode) -> Self?
  fn to_untyped(Self) -> @syntax.SyntaxNode
  fn span(Self) -> @syntax.Span = _
  fn placeholder() -> Self
}
