    #|        names: [Producer, Pat]
    #|
  inspect(
    load_case("yaml", src),
    content=(
      #|entries: full, chapter, video
      #|== apa
      #|cite 0: {(}<|entry:1><|names><|names><|name:0>{Doe}</></></>{, }<|date>{1999}</></>{; }<|entry:0><|names><|names><|name:0>{Doe}</>{ & }<|name:1>{Roe}</></></>{, }<|date>{2020}</></>{; }<|entry:2><|names><|text>{i:Episode One}</></>{, n.d.}</>{)}
      #|bib: hanging=true align=none line=2 entry=0
      #|[chapter] - | <|names><|names><|name:0>{Doe, J}</></></>{. (}<|date>{1999}</>{). }<|text>{A Chapter}</>{. In }<|names><|names><|name:0>{Smith}</>{ & }<|name:1>{John}</>{ (Eds.)}</></>{, }<|text>{i:Parent Book}</>{ (}<|label>{pp.}</>{ }<|text>{10–20}</>{).}
      #|[full] - | <|names><|names><|name:0>{Doe, J.}</>{, & }<|name:1>{Roe, R. J}</></></>{. (}<|date>{2020}</>{). }<|text>{i:The Book of Things}</>{ (}<|names><|name:0>{J. Smith}</>{, ed.; }<|name:0>{H. Müller}</>{, trans.}</>{; }<|number>{3rd}</>{ }<|label>{ed.}</>{, }<|label>{Vol.}</>{ }<|text>{2}</>{, Pt. }<|text>{2}</>{, }<|label>{Issue}</>{ }<|text>{7}</>{, }<|label>{Chapter}</>{ }<|text>{2}</>{). }<|text>{Acme}</>{. }<|text>[https://doi.org/10.1000/abc](https://doi.org/10.1000/abc)</>
      #|[video] - | <|names><|text>{i:Episode One}</></>{. (n.d.). [Broadcast].}
      #|== ieee
      #|cite 0: <|entry:0>{[}<|citation-number>{1}</>{]}</>{, }<|entry:1>{[}<|citation-number>{2}</>{]}</>{, }<|entry:2>{[}<|citation-number>{3}</>{]}</>
      #|bib: hanging=false align=flush line=1 entry=0
      #|[full] <|citation-number>{[1]}</> | <|names><|name:0>{J. Doe}</>{ and }<|name:1>{R. J. Roe}</></>{, }<|text>{i:The Book of Things}</>{, }<|number>{3rd}</>{ ed., vol. }<|number>{2}</>{, }<|number>{4}</>{ vols., no. }<|number>{7}</>{. in }<|text>{The Series}</>{, }<|text>{vol. 2}</>{. }<|text>{Berlin}</>{: }<|text>{Acme}</>{, }<|date>{2020}</>{.}<|text>{ doi: }[10.1000/abc](https://doi.org/10.1000/abc){.}</>
      #|[chapter] <|citation-number>{[2]}</> | <|names><|name:0>{J. Doe}</></>{, }<|text>{“A Chapter,”}</>{ in }<|text>{i:Parent Book}</>{, }<|names><|name:0>{Smith}</>{ and }<|name:1>{John}</>{, Eds.}</>{, }<|date>{1999}</>{, }<|label>{pp.}</>{ }<|text>{10–20}</>{.}
      #|[video] <|citation-number>{[3]}</> | <|text>{“Episode One.”}</>
      #|== chicago-notes
      #|cite 0: <|entry:0><|names><|names><|name:0>{Jane Doe}</>{ and }<|name:1>{Richard Jr. Roe}</></></>{, }<|text>{i:The Book of Things}</>{, }<|number>{3rd}</>{ }<|label>{ed.}</>{, }<|label>{vol.}</>{ }<|text>{2}</>{, pt. }<|text>{2}</>{, }<|names>{ed. }<|name:0>{John Smith}</>{, trans. }<|name:0>{Hans Müller}</></>{, }<|text>{The Series}</>{, }<|label>{no.}</>{ }<|text>{7}</>{ (}<|text>{Acme}</>{, }<|date>{2020}</>{), }<|text>[https://doi.org/10.1000/abc](https://doi.org/10.1000/abc)</></>{; }<|entry:1><|names><|names><|name:0>{Jane Doe}</></></>{, }<|text>{“A Chapter,”}</>{ in }<|text>{i:Parent Book}</>{, }<|names>{ed. }<|name:0>{Smith}</>{ and }<|name:1>{John}</></>{ (}<|date>{1999}</>{)}</>{; }<|entry:2><|names><|text>{i:Episode One}</></>{, n.d., }<|text>{45:00}</></>{.}
      #|bib: hanging=true align=none line=1 entry=1
      #|[chapter] - | <|names><|names><|name:0>{Doe, Jane}</></></>{. }<|text>{“A Chapter.”}</>{ In }<|text>{i:Parent Book}</>{, }<|names>{edited by }<|name:0>{Smith}</>{ and }<|name:1>{John}</></>{. }<|date>{1999}</>{.}
      #|[full] - | <|names><|names><|name:0>{Doe, Jane}</>{, and }<|name:1>{Richard Jr. Roe}</></></>{. }<|text>{i:The Book of Things}</>{. }<|number>{3rd}</>{ }<|label>{ed}</>{. }<|label>{Vol.}</>{ }<|text>{2}</>{, pt. }<|text>{2}</>{, }<|names>{edited by }<|name:0>{John Smith}</>{, translated by }<|name:0>{Hans Müller}</></>{. }<|text>{The Series}</>{, }<|label>{no.}</>{ }<|text>{7}</>{. }<|text>{Acme}</>{, }<|date>{2020}</>{. }<|text>[https://doi.org/10.1000/abc](https://doi.org/10.1000/abc)</>{.}
      #|[video] - | <|names><|text>{i:Episode One}</></>{. n.d. }<|text>{45:00}</>{.}
      #|
    ),
  )
}

///|
test "load/yaml_1" {
  let src =
    #|foo:
    #|  type: Article
    #|  date: [1, 2]
    #|
  inspect(
    load_case("yaml", src),
    content=(
      #|yaml error: foo.date: invalid type: sequence, expected a date in the format YYYY-MM-DD at line 3 column 9 @ 29:3:9
      #|
    ),
  )
}

///|
test "load/yaml_2" {
  let src =
    #|foo:
    #|  type: Unknownish
    #|  title: X
    #|
  inspect(
    load_case("yaml", src),
    content=(
      #|yaml error: foo.type: unknown variant `Unknownish`, expected one of `Article`, `article`, `Chapter`, `chapter`, `Entry`, `entry`, `Anthos`, `anthos`, `Report`, `report`, `Thesis`, `thesis`, `Web`, `web`, `Scene`, `scene`, `Artwork`, `artwork`, `Patent`, `patent`, `Case`, `case`, `Newspaper`, `newspaper`, `Legislation`, `legislation`, `Manuscript`, `manuscript`, `Post`, `post`, `Misc`, `misc`, `Performance`, `performance`, `Periodical`, `periodical`, `Proceedings`, `proceedings`, `Book`, `book`, `Blog`, `blog`, `Reference`, `reference`, `Conference`, `conference`, `Anthology`, `anthology`, `Repository`, `repository`, `Thread`, `thread`, `Video`, `video`, `Audio`, `audio`, `Exhibition`, `exhibition`, `Original`, `original` at line 2 column 9 @ 13:2:9
      #|
    ),
  )
}

///|
test "load/yaml_3" {
  let src =
    #|foo:
    #|  type: Article
    #|  date: 2020-13-01
    #|
  inspect(
