///|
test "load/bad_bib" {
  let src =
    #|@article{arrgh,
    #|    title    = {An‐arrgh‐chy: The Law and Economics of Pirate Organization},
    #|    author   = {Leeson, Peter T.},
    #|    crossref = {polecon},
    #|    date     = {19XXX-XX-XX},
    #|}
    #|
  inspect(
    load_case("bib", src),
    content=(
      #|entries: arrgh
      #|== apa
      #|cite 0: {(}<|entry:0><|names><|names><|name:0>{Leeson}</></></>{, n.d.}</>{)}
      #|bib: hanging=true align=none line=2 entry=0
      #|[arrgh] - | <|names><|names><|name:0>{Leeson, P. T}</></></>{. (n.d.). }<|text>{i:An‐arrgh‐chy: The Law and Economics of Pirate Organization}</>{.}
      #|== ieee
      #|cite 0: <|entry:0>{[}<|citation-number>{1}</>{]}</>
      #|bib: hanging=false align=flush line=1 entry=0
      #|[arrgh] <|citation-number>{[1]}</> | <|names><|name:0>{P. T. Leeson}</></>{, }<|text>{“An‐arrgh‐chy: The Law and Economics of Pirate Organization.”}</>
      #|== chicago-notes
      #|cite 0: <|entry:0><|names><|names><|name:0>{Peter T. Leeson}</></></>{, }<|text>{i:An‐arrgh‐chy: The Law and Economics of Pirate Organization}</>{, n.d.}</>
      #|bib: hanging=true align=none line=1 entry=1
      #|[arrgh] - | <|names><|names><|name:0>{Leeson, Peter T}</></></>{. }<|text>{i:An‐arrgh‐chy: The Law and Economics of Pirate Organization}</>{. n.d.}
      #|
    ),
  )
}

