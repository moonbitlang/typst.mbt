///|
test "load/bib_7" {
  let src =
    #|@article{dates1, title = {A}, date = {2001-02-03T12:00:00}}
    #|@article{dates2, title = {B}, year = {2001}, month = {feb}, day = {3}}
    #|@article{dates3, title = {C}, date = {1999~}}
    #|@article{dates4, title = {D}, date = {..}}
    #|@article{dates5, title = {E}, date = {19XX}}
    #|
  inspect(
    load_case("bib", src),
    content=(
      #|entries: dates1, dates2, dates3, dates4, dates5
      #|== apa
      #|cite 0: {(}<|entry:0><|names><|text>{i:A}</></>{, }<|date>{2001}</></>{; }<|entry:1><|names><|text>{i:B}</></>{, }<|date>{2001}</></>{; }<|entry:2><|names><|text>{i:C}</></>{, ca. }<|date>{1999}</></>{; }<|entry:3><|names><|text>{i:D}</></>{, n.d.}</>{; }<|entry:4><|names><|text>{i:E}</></>{, }<|date>{1999}</></>{)}
      #|bib: hanging=true align=none line=2 entry=0
      #|[dates1] - | <|names><|text>{i:A}</></>{. (}<|date>{2001}</>{).}
      #|[dates2] - | <|names><|text>{i:B}</></>{. (}<|date>{2001}</>{).}
      #|[dates3] - | <|names><|text>{i:C}</></>{. (ca. }<|date>{1999}</>{).}
      #|[dates4] - | <|names><|text>{i:D}</></>{. (n.d.).}
      #|[dates5] - | <|names><|text>{i:E}</></>{. (}<|date>{1999}</>{).}
      #|== ieee
      #|cite 0: <|entry:0>{[}<|citation-number>{1}</>{]}</>{, }<|entry:1>{[}<|citation-number>{2}</>{]}</>{, }<|entry:2>{[}<|citation-number>{3}</>{]}</>{, }<|entry:3>{[}<|citation-number>{4}</>{]}</>{, }<|entry:4>{[}<|citation-number>{5}</>{]}</>
      #|bib: hanging=false align=flush line=1 entry=0
      #|[dates1] <|citation-number>{[1]}</> | <|text>{“A,”}</>{ }<|date>{Feb. 2001}</>{.}
      #|[dates2] <|citation-number>{[2]}</> | <|text>{“B,”}</>{ }<|date>{Feb. 2001}</>{.}
      #|[dates3] <|citation-number>{[3]}</> | <|text>{“C,”}</>{ }<|date>{1999}</>{.}
      #|[dates4] <|citation-number>{[4]}</> | <|text>{“D.”}</>
      #|[dates5] <|citation-number>{[5]}</> | <|text>{“E,”}</>{ }<|date>{1999}</>{.}
      #|== chicago-notes
      #|cite 0: <|entry:0><|text>{i:A}</>{, }<|date>{February 3, 2001}</></>{; }<|entry:1><|text>{i:B}</>{, }<|date>{February 3, 2001}</></>{; }<|entry:2><|text>{i:C}</>{, }<|date>{[1999?]}</></>{; }<|entry:3><|text>{i:D}</>{, n.d.}</>{; }<|entry:4><|text>{i:E}</>{, }<|date>{1999}</></>{.}
      #|bib: hanging=true align=none line=1 entry=1
      #|[dates1] - | <|names><|text>{i:A}</></>{. }<|date>{February 3, 2001}</>{.}
      #|[dates2] - | <|names><|text>{i:B}</></>{. }<|date>{February 3, 2001}</>{.}
      #|[dates3] - | <|names><|text>{i:C}</></>{. }<|date>{[1999?]}</>{.}
      #|[dates4] - | <|names><|text>{i:D}</></>{. n.d.}
      #|[dates5] - | <|names><|text>{i:E}</></>{. }<|date>{1999}</>{.}
      #|
    ),
  )
}

