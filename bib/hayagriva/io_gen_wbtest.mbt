    load_case("yaml", src),
    content=(
      #|entries: foo
      #|== apa
      #|cite 0: {(}<|entry:0><|names><|text>{i:Ok}</></>{, n.d.}</>{)}
      #|bib: hanging=true align=none line=2 entry=0
      #|[foo] - | <|names><|text>{i:ok}</></>{. (n.d.).}
      #|== ieee
      #|cite 0: <|entry:0>{[}<|citation-number>{1}</>{]}</>
      #|bib: hanging=false align=flush line=1 entry=0
      #|[foo] <|citation-number>{[1]}</> | <|text>{“ok.”}</>
      #|== chicago-notes
      #|cite 0: <|entry:0><|text>{“Ok,”}</>{ preprint, n.d.}</>
      #|bib: hanging=true align=none line=1 entry=1
      #|[foo] - | <|names><|text>{“Ok.”}</></>{ Preprint, n.d.}
      #|
    ),
  )
}

