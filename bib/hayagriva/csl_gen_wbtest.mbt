      #|[tolkien54] <|citation-number>{[7]}</> | <|names><|name:0>{Tolkien JRR}</></>{. }<|text>{The Fellowship of the Ring}</>{.  }<|text>{London}</>{: }<|text>{Allen & Unwin}</>{; }<|date>{1954}</>{.  (}<|text>{The Lord of the Rings}</>{).}
      #|[DBLP:books/lib/Knuth86a] <|citation-number>{[8]}</> | <|names><|name:0>{Knuth DE}</></>{. }<|text>{Computer modern typefaces}</>{.  }<|text>{Addison-Wesley}</>{; }<|date>{1986}</>{. }<|text>[https://www.worldcat.org/oclc/13157596](https://www.worldcat.org/oclc/13157596)</>
      #|[sharing] <|citation-number>{[9]}</> | <|names><|name:0>{Kopp J}</>{, }<|name:1>{Gerike R}</>{, }<|name:2>{Axhausen KW}</></>{. }<|text>{Do sharing people behave differently? An empirical evaluation of the distinctive mobility patterns of free-floating car-sharing members}</>{. }<|text>{Transportation.}</>{ }<|date>{2015}</>{;}<|text>{42}</><|text>{(3)}</><|text>{:449–469}</>{.}
      #|[restful] <|citation-number>{[10]}</> | <|names><|name:0>{Richardson L}</>{, }<|name:1>{Ruby S}</></>{. }<|text>{RESTful Web Services}</>{. }<|number>{1st}</>{ ed.  }<|text>{Sebastopol, CA, USA}</>{: }<|text>{O'Reilly Media}</>{; }<|date>{2008}</>{.}
      #|[mcintosh_anxiety] <|citation-number>{[11]}</> | <|names><|name:0>{McIntosh IB}</>{, }<|name:1>{Swanson V}</>{, }<|name:2>{Power KG}</>{, }<|name:3>{Raeside F}</>{, }<|name:4>{Dempster C}</></>{. }<|text>{Anxiety and Health Problems Related to Air Travel}</>{. }<|text>{Journal of Travel Medicine.}</>{ }<|date>{2006}</>{;}<|text>{5}</><|text>{(4)}</><|text>{:198–204}</>{.}
