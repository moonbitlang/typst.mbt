      #|[restful] - | <|names><|name:0>{Richardson, L.}</>{, }<|name:1>{Ruby, S.}</></>{, }<|date>{2008}</>{. }<|text>{RESTful Web Services}</>{, }<|number>{1st}</>{ ed. }<|text>{O'Reilly Media}</>{, }<|text>{Sebastopol, CA, USA}</>{.}
