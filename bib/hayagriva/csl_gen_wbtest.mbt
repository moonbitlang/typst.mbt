      #|[smith2020c] - | <|names><|name:0>{Smith J}</></>{ }<|date>{(2020c)}</>{ }<|text>{Gamma Rays}</>
      #|[who2021] - | <|names><|name:0>{World Health Organization}</></>{ }<|date>{(2021)}</>{ }<|text>{World Health Statistics}</>
      #|
    ),
  )
}

