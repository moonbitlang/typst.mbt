    input_disamb_yml, "yaml", "springer-basic-author-date", spec,
  )
  inspect(
    dump,
    content=(
      #|cite 0: {(}<|entry:0><|names><|name:0>{Smith}</></>{ }<|date>{2020a}</></>{)}
      #|cite 1: {(}<|entry:0><|names><|name:0>{Smith}</></>{ }<|date>{2020b}</></>{)}
