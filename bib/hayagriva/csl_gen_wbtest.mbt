      #|[netwok] - | <|names><|names><|name:0>{Astley, Rick}</>{, and }<|name:1>{Linda Morris}</></></>{. }<|date>{2020}</>{. }<|text>{“At-Scale Impact of the Net Wok: A Culinarically Holistic Investigation of Distributed Dumplings.”}</>{ }<|text>{i:Armenian Journal of Proceedings}</>{ }<|text>{61}</>{ (}<|date>{2020}</>{): }<|text>{192–219}</>{.}
