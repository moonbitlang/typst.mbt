      #|[mueller2018b] - | <|names><|name:0>{Mueller, H.}</></>{ (}<|date>{2018}</>{) }<|text>{i:Unter Allem}</>{.}
      #|[mueller2018] - | <|names><|name:0>{Müller, H.}</></>{ (}<|date>{2018}</>{) }<|text>{i:Über Alles}</>{.}
