///|
test "csl/works_bib/american-chemical-society/each" {
  let spec =
    #|netwok
    #|issue201
    #|arrgh
    #|quark
    #|distress
    #|glacier-melt
    #|tolkien54
    #|DBLP:books/lib/Knuth86a
    #|sharing
    #|restful
    #|mcintosh_anxiety
    #|psychology25
  let dump = run_csl_case(
    input_works_bib, "bib", "american-chemical-society", spec,
  )
  inspect(
    dump,
    content=(
      #|cite 0: <|entry:0><|citation-number>{sup:1}</></>
      #|cite 1: <|entry:0><|citation-number>{sup:2}</></>
      #|cite 2: <|entry:0><|citation-number>{sup:3}</></>
      #|cite 3: <|entry:0><|citation-number>{sup:4}</></>
      #|cite 4: <|entry:0><|citation-number>{sup:5}</></>
      #|cite 5: <|entry:0><|citation-number>{sup:6}</></>
      #|cite 6: <|entry:0><|citation-number>{sup:7}</></>
      #|cite 7: <|entry:0><|citation-number>{sup:8}</></>
      #|cite 8: <|entry:0><|citation-number>{sup:9}</></>
      #|cite 9: <|entry:0><|citation-number>{sup:10}</></>
      #|cite 10: <|entry:0><|citation-number>{sup:11}</></>
      #|cite 11: <|entry:0><|citation-number>{sup:12}</></>
