      #|[worth] - | <|names><|names><|name:0>{Worth, Jon}</></></>{. }<|text>{“Jon Worth Euroblog.”}</>{ }<|text>[https://jonworth.eu/](https://jonworth.eu/)</>{.}
      #|
    ),
  )
}

