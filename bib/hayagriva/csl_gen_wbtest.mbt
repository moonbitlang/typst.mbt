      #|cite 0: {(}<|entry:0><|names><|name:0>{Smith}</></>{, }<|date>{2020}</><|text>{a}</></>{)}
      #|cite 1: {(}<|entry:0><|names><|name:0>{Jane Smith}</></>{, }<|date>{2020}</></>{)}
