      #|[restful] - | <|names><|names><|name:0>{Richardson, Leonard}</>{, and }<|name:1>{Sam Ruby}</></></>{. }<|date>{2008}</>{. }<|text>{i:RESTful Web Services}</>{. }<|number>{1st}</>{ }<|label>{ed}</>{. }<|text>{Sebastopol, CA, USA}</>{: }<|text>{O'Reilly Media}</>{.}
      #|[psychology25] - | <|names><|names><|name:0>{Strong, Edward}</></></>{. }<|date>{1925}</>{. }<|text>{i:The Psychology of Selling and Advertising}</>{. }<|number>{1st}</>{ }<|label>{ed}</>{. }<|text>{New York, NY, USA}</>{: }<|text>{McGraw-Hill Book Co.}</>
      #|[tolkien54] - | <|names><|names><|name:0>{Tolkien, J. R. R}</></></>{. }<|date>{1954}</>{. }<|text>{i:The Fellowship of the Ring}</>{. }<|label>{Vol.}</>{ }<|text>{1}</>{, pt. }<|text>{1}</>{. }<|text>{The Lord of the Rings}</>{. }<|text>{London}</>{: }<|text>{Allen & Unwin}</>{.}
      #|
    ),
