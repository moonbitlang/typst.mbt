      #|[anon] - | <|text>{No Date Page}</>{. }<|text>[https://example.com/page](https://example.com/page)</>
      #|[doe2019] - | <|names><|name:0>{Doe J}</>{, }<|name:1>{Roe R}</>{, }<|name:2>{Poe E}</>{, }<|name:3>{Moe M}</></>{ }<|date>{(2019a)}</>{ }<|text>{Many Authors}</>
      #|[doe2019b] - | <|names><|name:0>{Doe J}</>{, }<|name:1>{Roe R}</>{, }<|name:2>{Zoe Z}</>{, }<|name:3>{Moe M}</></>{ }<|date>{(2019b)}</>{ }<|text>{Many Other Authors}</>
