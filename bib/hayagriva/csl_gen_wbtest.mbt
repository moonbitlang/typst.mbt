      #|bib: hanging=false align=flush line=1 entry=0
      #|[netwok] <|citation-number>{[1]}</> | <|names><|name:0>{R. Astley}</>{, }<|name:1>{L. Morris}</></>{, }<|text>{“At-scale impact of the Net Wok: A culinarically holistic investigation of distributed dumplings”}</>{ }<|text>{i:Armenian Journal of Proceedings}</>{ }<|date>{b:2020}</>{, }<|text>{i:61}</>{, }<|text>{192–219}</>{.}
      #|[issue201] <|citation-number>{[2]}</> | <|names><|name:0>{cfr42}</></>{, }<|text>{“Use of ids field creates unstable references”}</>{, }<|text>{can be found under }[https://github.com/plk/biblatex/issues/201](https://github.com/plk/biblatex/issues/201)</>{, }<|date>{b:2014}</>{.}
      #|[arrgh] <|citation-number>{[3]}</> | <|names><|name:0>{P. T. Leeson}</></>{, }<|text>{“The Pirate Organization”}</>{ }{b:n.d.}
