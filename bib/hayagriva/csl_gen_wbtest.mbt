///|
test "csl/disamb_yml/chicago-author-date/each" {
  let spec =
    #|smith2020a
    #|smith2020b
    #|smith2020c
    #|doe2019
    #|doe2019b
    #|who2021
    #|anon
    #|mueller2018
    #|mueller2018b
    #|vangogh
  let dump = run_csl_case(input_disamb_yml, "yaml", "chicago-author-date", spec)
  inspect(
    dump,
    content=(
      #|cite 0: {(}<|entry:0><|names><|names><|name:0>{Smith}</></></>{ }<|date>{2020}</></>{)}
      #|cite 1: {(}<|entry:0><|names><|names><|name:0>{Smith}</></></>{ }<|date>{2020}</></>{)}
      #|cite 2: {(}<|entry:0><|names><|names><|name:0>{Smith}</></></>{ }<|date>{2020}</></>{)}
      #|cite 3: {(}<|entry:0><|names><|names><|name:0>{Doe}</>{, }<|name:1>{Roe}</>{, }<|name:2>{Poe}</>{, et al.}</></>{ }<|date>{2019}</></>{)}
      #|cite 4: {(}<|entry:0><|names><|names><|name:0>{Doe}</>{, }<|name:1>{Roe}</>{, }<|name:2>{Zoe}</>{, et al.}</></>{ }<|date>{2019}</></>{)}
      #|cite 5: {(}<|entry:0><|names><|names><|name:0>{World Health Organization}</></></>{ }<|date>{2021}</></>{)}
      #|cite 6: {(}<|entry:0><|names><|text>{“No Date Page,”}</></>{ n.d.}</>{)}
      #|cite 7: {(}<|entry:0><|names><|names><|name:0>{Müller}</></></>{ }<|date>{2018}</></>{)}
      #|cite 8: {(}<|entry:0><|names><|names><|name:0>{Mueller}</></></>{ }<|date>{2018}</></>{)}
      #|cite 9: {(}<|entry:0><|names><|names><|name:0>{Gogh}</></></>{ }<|date>{1890}</></>{)}
      #|bib: hanging=true align=none line=1 entry=1
      #|[anon] - | <|names><|text>{“No Date Page.”}</></>{ n.d. }<|text>[https://example.com/page](https://example.com/page)</>{.}
      #|[doe2019] - | <|names><|names><|name:0>{Doe}</>{, }<|name:1>{Roe}</>{, }<|name:2>{Poe}</>{, et al}</></>{. }<|date>{2019}</>{. }<|text>{“Many Authors.”}</>{ Preprint,.}
      #|[doe2019b] - | <|names><|names><|name:0>{Doe}</>{, }<|name:1>{Roe}</>{, }<|name:2>{Zoe}</>{, et al}</></>{. }<|date>{2019}</>{. }<|text>{“Many Other Authors.”}</>{ Preprint,.}
      #|[vangogh] - | <|names><|names><|name:0>{Gogh, Vincent van}</></></>{. }<|date>{1890}</>{. }<|text>{i:Letters}</>{. }<|names>{Edited by }<|name:0>{John Smith}</></>{.}
      #|[mueller2018b] - | <|names><|names><|name:0>{Mueller, Hans}</></></>{. }<|date>{2018}</>{. }<|text>{i:Unter Allem}</>{.}
      #|[mueller2018] - | <|names><|names><|name:0>{Müller, Hans}</></></>{. }<|date>{2018}</>{. }<|text>{i:Über Alles}</>{.}
      #|[smith2020b] - | <|names><|names><|name:0>{Smith}</></></>{. }<|date>{2020}</>{. }<|text>{i:Beta Decay}</>{. }<|text>{Acme}</>{.}
