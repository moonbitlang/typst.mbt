      #|[glacier-melt] - | <|names><|name:0>{Hock, R.}</></>{ (}<|date>{2005}</>{) }<|text>{“Glacier melt: a review of processes and their modelling,”}</>{ }<|text>{i:Progress in Physical Geography: Earth and Environment}</>{, }<|text>{29}</><|text>{(3)}</>{, }<|label>{pp.}</>{ }<|text>{362–391}</>{. Available at: }<|text>[https://doi.org/10.1191/0309133305pp453ra](https://doi.org/10.1191/0309133305pp453ra)</>{.}
      #|[DBLP:books/lib/Knuth86a] - | <|names><|name:0>{Knuth, D.E.}</></>{ (}<|date>{1986}</>{) }<|text>{i:Computer modern typefaces}</>{. }<|text>{Addison-Wesley}</>{. Available at: }<|text>[https://www.worldcat.org/oclc/13157596](https://www.worldcat.org/oclc/13157596)</>{.}
      #|[sharing] - | <|names><|name:0>{Kopp, J.}</>{, }<|name:1>{Gerike, R.}</>{ and }<|name:2>{Axhausen, K.W.}</></>{ (}<|date>{2015}</>{) }<|text>{“Do sharing people behave differently? An empirical evaluation of the distinctive mobility patterns of free-floating car-sharing members,”}</>{ }<|text>{i:Transportation}</>{, }<|text>{42}</><|text>{(3)}</>{, }<|label>{pp.}</>{ }<|text>{449–469}</>{.}
      #|[arrgh] - | <|names><|name:0>{Leeson, P.T.}</></>{ (no date}<|text>{ a}</>{) }<|text>{“The Pirate Organization.”}</>
      #|[quark] - | <|names><|name:0>{Leeson, P.T.}</></>{ (no date}<|text>{ b}</>{) }<|text>{“The Quark Organization.”}</>
      #|[mcintosh_anxiety] - | <|names><|name:0>{McIntosh, I.B. }</>{i:et al.}</>{ (}<|date>{2006}</>{) }<|text>{“Anxiety and Health Problems Related to Air Travel,”}</>{ }<|text>{i:Journal of Travel Medicine}</>{, }<|text>{5}</><|text>{(4)}</>{, }<|label>{pp.}</>{ }<|text>{198–204}</>{.}
      #|[restful] - | <|names><|name:0>{Richardson, L.}</>{ and }<|name:1>{Ruby, S.}</></>{ (}<|date>{2008}</>{) }<|text>{i:RESTful Web Services}</>{. }<|number>{1st}</>{ ed. }<|text>{Sebastopol, CA, USA}</>{: }<|text>{O'Reilly Media}</>{.}
      #|[psychology25] - | <|names><|name:0>{Strong, E.}</></>{ (}<|date>{1925}</>{) }<|text>{i:The psychology of selling and advertising}</>{. }<|number>{1st}</>{ ed. }<|text>{New York, NY, USA}</>{: }<|text>{McGraw-Hill Book Co.}</>
      #|[tolkien54] - | <|names><|name:0>{Tolkien, J.R.R.}</></>{ (}<|date>{1954}</>{) }<|text>{i:The Fellowship of the Ring}</>{. }<|text>{London}</>{: }<|text>{Allen & Unwin}</>{ (}<|text>{The Lord of the Rings}</>{).}
      #|
    ),
  )
}

