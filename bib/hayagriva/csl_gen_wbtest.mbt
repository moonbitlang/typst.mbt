      #|cite 10: {(}<|entry:0><|names><|name:0>{McIntosh }</>{i:et al.}</>{, }<|date>{2006}</></>{)}
      #|cite 11: {(}<|entry:0><|names><|name:0>{Strong}</></>{, }<|date>{1925}</></>{)}
      #|bib: hanging=false align=none line=1 entry=1
      #|[distress] - | <|names><|name:0>{Aldrin, B.}</></>{ (no date) }<|text>{“An Insight into Bibliographical Distress.”}</>
      #|[netwok] - | <|names><|name:0>{Astley, R.}</>{ and }<|name:1>{Morris, L.}</></>{ (}<|date>{2020}</>{) }<|text>{“At-scale impact of the Net Wok: A culinarically holistic investigation of distributed dumplings,”}</>{ }<|text>{i:Armenian Journal of Proceedings}</>{, }<|text>{61}</>{, }<|label>{pp.}</>{ }<|text>{192–219}</>{.}
