      #|[latex-users] <|citation-number>{32.}</> | <|names><|name:0>{Pepe, A.}</></>{ }<|text>{How many scholarly articles are written in LaTeX?}</>{. Preprint at }<|text>[https://doi.org/10.22541/au.148771883.35456290](https://doi.org/10.22541/au.148771883.35456290)</>{ }<|date>{(2017)}</>{.}
      #|[editors] <|citation-number>{33.}</> | <|names><|name:0>{Munroe, R.}</></>{ }<|text>{i:Types of Editors}</>{. (}<|date>{2014}</>{).}
      #|[barb] <|citation-number>{34.}</> | <|names><|name:0>{Günther-Haug, B.}</></>{ }<|text>{i:Den Boden unter den Füßen verlieren}</>{. (}<|text>{MVG}</>{, }<|date>{2020}</>{).}
      #|[lamb] <|citation-number>{35.}</> | <|names><|name:0>{Kell-Nehrer, F.}</></>{ }<|text>{i:The Life of a Friendly Lamb}</>{. }<|label>{vol.}</>{ }<|text>{10}</>{ }<|text>{22–23}</>{ (}<|date>{2011}</>{).}
      #|[snail] <|citation-number>{36.}</> | <|names><|name:0>{Kell-Nehrer, F.}</></>{ }<|text>{i:A Snail Study}</>{. }<|label>{vol.}</>{ }<|text>{4B}</>{ }<|text>{28}</>{ (}<|date>{2011}</>{).}
      #|[lamb-chapter] <|citation-number>{37.}</> | {in }<|text>{i:The life of a friendly lamb}</>{ }<|label>{vol.}</>{ }<|text>{10}</>{ }<|text>{10–12}</>{ (}<|date>{2011}</>{).}
      #|[snail-chapter] <|citation-number>{38.}</> | {in }<|text>{i:A Snail Study}</>{ }<|label>{vol.}</>{ }<|text>{4B}</>{ }<|text>{10–12}</>{ (}<|date>{2011}</>{).}
      #|
    ),
  )
}

