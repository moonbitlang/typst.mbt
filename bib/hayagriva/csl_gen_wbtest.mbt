      #|[sharing] - | <|names><|names><|name:0>{Kopp, Johanna}</>{, }<|name:1>{Regine Gerike}</>{, and }<|name:2>{Kay W. Axhausen}</></></>{. }<|date>{2015}</>{. }<|text>{“Do Sharing People Behave Differently? An Empirical Evaluation of the Distinctive Mobility Patterns of Free-Floating Car-Sharing Members.”}</>{ }<|text>{i:Transportation}</>{ }<|text>{42}</>{ (}<|text>{3}</>{): }<|text>{449–69}</>{.}
      #|[arrgh] - | <|names><|names><|name:0>{Leeson, Peter T}</></></>{. n.d.-}<|text>{a}</>{. }<|text>{i:The Pirate Organization}</>{.}
      #|[quark] - | <|names>{———}<|names></></>{. n.d.-}<|text>{b}</>{. }<|text>{i:The Quark Organization}</>{.}
