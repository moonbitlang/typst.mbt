    dump,
    content=(
      #|cite 0: {(}<|entry:0><|names><|name:0>{Astley}</>{, }<|name:1>{Morris}</></>{ }<|date>{2020}</></>{)}
      #|cite 1: {(}<|entry:0><|names><|name:0>{cfr42}</></>{ }<|date>{2014}</></>{)}
