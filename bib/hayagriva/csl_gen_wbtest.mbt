test "csl/works_bib/american-anthropological-association/each" {
  let spec =
    #|netwok
    #|issue201
    #|arrgh
    #|quark
    #|distress
    #|glacier-melt
    #|tolkien54
    #|DBLP:books/lib/Knuth86a
    #|sharing
    #|restful
    #|mcintosh_anxiety
    #|psychology25
  let dump = run_csl_case(
    input_works_bib, "bib", "american-anthropological-association", spec,
  )
  inspect(
    dump,
    content=(
      #|cite 0: {(}<|entry:0><|names><|name:0>{Astley}</>{ and }<|name:1>{Morris}</></>{ }<|date>{2020}</></>{)}
      #|cite 1: {(}<|entry:0><|names><|name:0>{cfr42}</></>{ }<|date>{2014}</></>{)}
      #|cite 2: {(}<|entry:0><|names><|name:0>{Leeson}</></>{ n.d.}</>{)}
      #|cite 3: {(}<|entry:0><|names><|name:0>{Leeson}</></>{ n.d.}</>{)}
      #|cite 4: {(}<|entry:0><|names><|name:0>{Aldrin}</></>{ n.d.}</>{)}
      #|cite 5: {(}<|entry:0><|names><|name:0>{Hock}</></>{ }<|date>{2005}</></>{)}
      #|cite 6: {(}<|entry:0><|names><|name:0>{Tolkien}</></>{ }<|date>{1954}</></>{)}
      #|cite 7: {(}<|entry:0><|names><|name:0>{Knuth}</></>{ }<|date>{1986}</></>{)}
      #|cite 8: {(}<|entry:0><|names><|name:0>{Kopp}</>{, }<|name:1>{Gerike}</>{, and }<|name:2>{Axhausen}</></>{ }<|date>{2015}</></>{)}
      #|cite 9: {(}<|entry:0><|names><|name:0>{Richardson}</>{ and }<|name:1>{Ruby}</></>{ }<|date>{2008}</></>{)}
      #|cite 10: {(}<|entry:0><|names><|name:0>{McIntosh }</>{et al.}</>{ }<|date>{2006}</></>{)}
      #|cite 11: {(}<|entry:0><|names><|name:0>{Strong}</></>{ }<|date>{1925}</></>{)}
      #|bib: hanging=false align=none line=1 entry=0
      #|[distress] - | <block|><|names><|name:0>{Aldrin, Buzz}</></></><left-margin|>{ N.d.}</><right-inline|><|text>{An Insight into Bibliographical Distress}</></>{.}
      #|[netwok] - | <block|><|names><|name:0>{Astley, Rick}</>{, and }<|name:1>{Linda Morris}</></></><left-margin|>{ }<|date>{2020}</></><right-inline|><|text>{At-Scale Impact of the Net Wok: A Culinarically Holistic Investigation of Distributed Dumplings}</>{. }<|text>{Armenian Journal of Proceedings}</><|text>{ 61}</>{. }<|text>{Automattic Inc.}</><|text>{: 192–219}</></>{.}
      #|[issue201] - | <block|><|names><|name:0>{cfr42}</></></><left-margin|>{ }<|date>{2014}</></><right-inline|><|text>{Use of Ids Field Creates Unstable References}</>{. }<|text>[https://github.com/plk/biblatex/issues/201](https://github.com/plk/biblatex/issues/201)</></>{.}
      #|[glacier-melt] - | <block|><|names><|name:0>{Hock, Regine}</></></><left-margin|>{ }<|date>{2005}</></><right-inline|><|text>{Glacier Melt: A Review of Processes and Their Modelling}</>{. }<|text>{Progress in Physical Geography: Earth and Environment}</><|text>{ 29}</><|text>{(3)}</><|text>{: 362–391}</></>{.}
      #|[DBLP:books/lib/Knuth86a] - | <block|><|names><|name:0>{Knuth, Donald Ervin}</></></><left-margin|>{ }<|date>{1986}</></><right-inline|><|text>{Computer Modern Typefaces}</>{. }<|text>{Addison-Wesley}</>{. }<|text>[https://www.worldcat.org/oclc/13157596](https://www.worldcat.org/oclc/13157596)</></>{.}
      #|[sharing] - | <block|><|names><|name:0>{Kopp, Johanna}</>{, }<|name:1>{Regine Gerike}</>{, and }<|name:2>{Kay W. Axhausen}</></></><left-margin|>{ }<|date>{2015}</></><right-inline|><|text>{Do Sharing People Behave Differently? An Empirical Evaluation of the Distinctive Mobility Patterns of Free-Floating Car-Sharing Members}</>{. }<|text>{Transportation}</><|text>{ 42}</><|text>{(3)}</><|text>{: 449–469}</></>{.}
      #|[arrgh] - | <block|><|names><|name:0>{Leeson, Peter T.}</></></><left-margin|>{ N.d.}</><right-inline|><|text>{The Pirate Organization}</></>{.}
      #|[quark] - | <block|><|names>{}</></><left-margin|>{ N.d.}</><right-inline|><|text>{The Quark Organization}</></>{.}
      #|[mcintosh_anxiety] - | <block|><|names><|name:0>{McIntosh, Iain B.}</>{, }<|name:1>{Vivien Swanson}</>{, }<|name:2>{Kevin G. Power}</>{, }<|name:3>{Fiona Raeside}</>{, and }<|name:4>{Craig Dempster}</></></><left-margin|>{ }<|date>{2006}</></><right-inline|><|text>{Anxiety and Health Problems Related to Air Travel}</>{. }<|text>{Journal of Travel Medicine}</><|text>{ 5}</><|text>{(4)}</><|text>{: 198–204}</></>{.}
      #|[restful] - | <block|><|names><|name:0>{Richardson, Leonard}</>{, and }<|name:1>{Sam Ruby}</></></><left-margin|>{ }<|date>{2008}</></><right-inline|><|text>{RESTful Web Services}</>{. }<|number>{1st}</>{ edition. }<|text>{Sebastopol, CA, USA}</>{: }<|text>{O'Reilly Media}</></>{.}
      #|[psychology25] - | <block|><|names><|name:0>{Strong, Edward}</></></><left-margin|>{ }<|date>{1925}</></><right-inline|><|text>{The Psychology of Selling and Advertising}</>{. }<|number>{1st}</>{ edition. }<|text>{New York, NY, USA}</>{: }<|text>{McGraw-Hill Book Co.}</></>
      #|[tolkien54] - | <block|><|names><|name:0>{Tolkien, J. R. R.}</></></><left-margin|>{ }<|date>{1954}</></><right-inline|><|text>{The Fellowship of the Ring}</>{, vol.}<|number>{1}</>{. }<|text>{The Lord of the Rings}</>{. }<|text>{London}</>{: }<|text>{Allen & Unwin}</></>{.}
      #|
    ),
  )
}

