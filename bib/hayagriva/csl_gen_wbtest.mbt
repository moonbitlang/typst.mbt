      #|[doe2019b] - | <|names><|name:0>{Doe}</>{, }<|name:1>{Roe}</>{, }<|name:2>{Zoe}</>{, }{i:et al.}</>{ (}<|date>{2019}</>{) }<|text>{“Many Other Authors.”}</>
