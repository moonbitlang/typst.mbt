  inspect(
    dump,
    content=(
      #|cite 0: {(}<|entry:0><|names><|name:0>{Astley}</>{ and }<|name:1>{Morris}</></>{ }<|date>{2020}</></>{)}
      #|cite 1: {(}<|entry:0><|names><|name:0>{cfr42}</></>{ }<|date>{2014}</></>{)}
      #|cite 2: {(}<|entry:0><|names><|name:0>{Leeson}</></>{ n.d.}</>{)}
      #|cite 3: {(}<|entry:0><|names><|name:0>{Leeson}</></>{ n.d.}</>{)}
      #|cite 4: {(}<|entry:0><|names><|name:0>{Aldrin}</></>{ n.d.}</>{)}
      #|cite 5: {(}<|entry:0><|names><|name:0>{Hock}</></>{ }<|date>{2005}</></>{)}
      #|cite 6: {(}<|entry:0><|names><|name:0>{Tolkien}</></>{ }<|date>{1954}</></>{)}
      #|cite 7: {(}<|entry:0><|names><|name:0>{Knuth}</></>{ }<|date>{1986}</></>{)}
      #|cite 8: {(}<|entry:0><|names><|name:0>{Kopp }</>{et al.}</>{ }<|date>{2015}</></>{)}
      #|cite 9: {(}<|entry:0><|names><|name:0>{Richardson}</>{ and }<|name:1>{Ruby}</></>{ }<|date>{2008}</></>{)}
      #|cite 10: {(}<|entry:0><|names><|name:0>{McIntosh }</>{et al.}</>{ }<|date>{2006}</></>{)}
      #|cite 11: {(}<|entry:0><|names><|name:0>{Strong}</></>{ }<|date>{1925}</></>{)}
      #|bib: hanging=true align=none line=1 entry=1
      #|[distress] - | <|names><|name:0>{Aldrin B}</></>{  }<|text>{An Insight into Bibliographical Distress}</>{. }
      #|[netwok] - | <|names><|name:0>{Astley R}</>{, }<|name:1>{Morris L}</></>{ }<|date>{(2020)}</>{ }<|text>{At-scale impact of the Net Wok: A culinarically holistic investigation of distributed dumplings}</>{. }<|text>{Armenian Journal of Proceedings}</>{ }<|text>{61}</><|text>{: 192–219.}</>{ }
      #|[issue201] - | <|names><|name:0>{cfr42}</></>{ }<|date>{(2014)}</>{ }<|text>{Use of ids field creates unstable references}</>{. }<|text>{Available from: }[https://github.com/plk/biblatex/issues/201](https://github.com/plk/biblatex/issues/201)</>{. }
      #|[glacier-melt] - | <|names><|name:0>{Hock R}</></>{ }<|date>{(2005)}</>{ }<|text>{Glacier melt: a review of processes and their modelling}</>{. }<|text>{Progress in Physical Geography: Earth and Environment}</>{ }<|text>{29}</><|text>{: 362–391.}</>{ }<|text>[https://doi.org/10.1191/0309133305pp453ra](https://doi.org/10.1191/0309133305pp453ra)</>{ }
      #|[DBLP:books/lib/Knuth86a] - | <|names><|name:0>{Knuth DE}</></>{ }<|date>{(1986)}</>{ }<|text>{Computer modern typefaces}</>{. }<|text>{Addison-Wesley}</>{. }<|text>{Available from: }[https://www.worldcat.org/oclc/13157596](https://www.worldcat.org/oclc/13157596)</>{. }
      #|[sharing] - | <|names><|name:0>{Kopp J}</>{, }<|name:1>{Gerike R}</>{, }<|name:2>{Axhausen KW}</></>{ }<|date>{(2015)}</>{ }<|text>{Do sharing people behave differently? An empirical evaluation of the distinctive mobility patterns of free-floating car-sharing members}</>{. }<|text>{Transportation}</>{ }<|text>{42}</><|text>{: 449–469.}</>{ }
      #|[arrgh] - | <|names><|name:0>{Leeson PT}</></>{  }<|text>{The Pirate Organization}</>{. }
      #|[quark] - | <|names><|name:0>{Leeson PT}</></>{  }<|text>{The Quark Organization}</>{. }
      #|[mcintosh_anxiety] - | <|names><|name:0>{McIntosh IB}</>{, }<|name:1>{Swanson V}</>{, }<|name:2>{Power KG}</>{, }<|name:3>{Raeside F}</>{, }<|name:4>{Dempster C}</></>{ }<|date>{(2006)}</>{ }<|text>{Anxiety and Health Problems Related to Air Travel}</>{. }<|text>{Journal of Travel Medicine}</>{ }<|text>{5}</><|text>{: 198–204.}</>{ }
