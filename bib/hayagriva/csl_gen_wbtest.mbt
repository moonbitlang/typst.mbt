      #|[smith2020b] - | <|names><|name:0>{Smith, Jane}</></>{ (}<|date>{2020}</>{) }<|text>{i:Beta Decay}</>{. }<|text>{Acme}</>{.}
      #|[smith2020c] - | <|names><|name:0>{Smith, J.}</></>{ (}<|date>{2020}</><|text>{b}</>{) }<|text>{“Gamma Rays.”}</>
      #|[who2021] - | <|names><|name:0>{World Health Organization}</></>{ (}<|date>{2021}</>{) }<|text>{i:World Health Statistics}</>{.}
