      #|cite 11: {(}<|entry:0><|names><|name:0>{Strong}</></>{ }<|date>{1925}</></>{)}
      #|bib: hanging=false align=none line=1 entry=1
      #|[distress] - | <block|><|names><|name:0>{ALDRIN, Buzz}</></>{, [no date]. }<|text>{i:An Insight into Bibliographical Distress}</>{. }</>
      #|[netwok] - | <block|><|names><|name:0>{ASTLEY, Rick}</>{ and }<|name:1>{MORRIS, Linda}</></>{, }<|date>{2020}</>{. }<|text>{At-scale impact of the Net Wok: A culinarically holistic investigation of distributed dumplings. }</><|text>{i:Armenian Journal of Proceedings}</>{. }<|date>{2020}</>{. }<|text>{Vol. 61}</>{, }<|text>{p. 192–219}</>{. }</>
      #|[issue201] - | <block|><|names><|name:0>{CFR42}</></>{, }<|date>{2014}</>{. }<|text>{Use of ids field creates unstable references. }</>{. Online. }<|date>{7 February 2014}</>{. Available from: }<|text>[https://github.com/plk/biblatex/issues/201](https://github.com/plk/biblatex/issues/201)</></>
      #|[glacier-melt] - | <block|><|names><|name:0>{HOCK, Regine}</></>{, }<|date>{2005}</>{. }<|text>{Glacier melt: a review of processes and their modelling. }</><|text>{i:Progress in Physical Geography: Earth and Environment}</>{. }<|date>{2005}</>{. }<|text>{Vol. 29}</>{, }<|text>{no. 3}</>{, }<|text>{p. 362–391}</>{. }<|text>{DOI }[10.1191/0309133305pp453ra](https://doi.org/10.1191/0309133305pp453ra)</>{. }</>
      #|[DBLP:books/lib/Knuth86a] - | <block|><|names><|name:0>{KNUTH, Donald Ervin}</></>{, }<|date>{1986}</>{. }<|text>{i:Computer modern typefaces}</>{. Online. }<|text>{Addison-Wesley}</>{. }<|text>{ISBN 0201134462}</>{. Available from: }<|text>[https://www.worldcat.org/oclc/13157596](https://www.worldcat.org/oclc/13157596)</></>
      #|[sharing] - | <block|><|names><|name:0>{KOPP, Johanna}</>{, }<|name:1>{GERIKE, Regine}</>{ and }<|name:2>{AXHAUSEN, Kay W.}</></>{, }<|date>{2015}</>{. }<|text>{Do sharing people behave differently? An empirical evaluation of the distinctive mobility patterns of free-floating car-sharing members. }</><|text>{i:Transportation}</>{. }<|date>{2015}</>{. }<|text>{Vol. 42}</>{, }<|text>{no. 3}</>{, }<|text>{p. 449–469}</>{. }</>
      #|[arrgh] - | <block|><|names><|name:0>{LEESON, Peter T.}</></>{, [no date]. }<|text>{The Pirate Organization. }</></>
      #|[quark] - | <block|><|names><|name:0>{LEESON, Peter T.}</></>{, [no date]. }<|text>{The Quark Organization. }</></>
      #|[mcintosh_anxiety] - | <block|><|names><|name:0>{MCINTOSH, Iain B.}</>{, }<|name:1>{SWANSON, Vivien}</>{, }<|name:2>{POWER, Kevin G.}</>{, }<|name:3>{RAESIDE, Fiona}</>{ and }<|name:4>{DEMPSTER, Craig}</></>{, }<|date>{2006}</>{. }<|text>{Anxiety and Health Problems Related to Air Travel. }</><|text>{i:Journal of Travel Medicine}</>{. }<|date>{2006}</>{. }<|text>{Vol. 5}</>{, }<|text>{no. 4}</>{, }<|text>{p. 198–204}</>{. }</>
      #|[restful] - | <block|><|names><|name:0>{RICHARDSON, Leonard}</>{ and }<|name:1>{RUBY, Sam}</></>{, }<|date>{2008}</>{. }<|text>{i:RESTful Web Services}</>{. }<|text>{1}</>{. }<|text>{Sebastopol, CA, USA}</>{: }<|text>{O'Reilly Media}</>{. }</>
      #|[psychology25] - | <block|><|names><|name:0>{STRONG, Edward}</></>{, }<|date>{1925}</>{. }<|text>{i:The psychology of selling and advertising}</>{. }<|text>{1}</>{. }<|text>{New York, NY, USA}</>{: }<|text>{McGraw-Hill Book Co}</>{. }</>
      #|[tolkien54] - | <block|><|names><|name:0>{TOLKIEN, J. R. R.}</></>{, }<|date>{1954}</>{. }<|text>{i:The Fellowship of the Ring}</>{. }<|text>{London}</>{: }<|text>{Allen & Unwin}</>{. }<|text>{The Lord of the Rings}</>{. }</>
      #|
    ),
  )
}

