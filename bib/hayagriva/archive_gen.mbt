      "oose></macro><macro name=\"publisher\"><group delimiter=\": \"><text variable=\"publisher-place\" form=\"long\" quotes=\"false\" strip-periods=\"false\"/><text variable=\"publisher\" form=\"long\" quotes=\"false\" strip-periods=\"false\"/></group></macro><macro name=\"issued-year\"><date variable=\"issued\"><date-part name=\"year\" strip-periods=\"false\"/></date></macro><macro name=\"locators\"><group delimiter=\", \"><group delimiter=\" \"><text term=\"volume\" form=\"short\" plural=\"false\" quotes=\"false\" strip-periods=\"false\" text-case=\"capitalize-first\"/><text variable=\"volume\" form=\"long\" quotes=\"false\" strip-periods=\"false\"/></group><group delimiter=\" \"><text term=\"issue\" form=\"symbol\" plural=\"false\" quotes=\"false\" strip-periods=\"false\"/><text variable=\"issue\" form=\"long\" quotes=\"false\" strip-periods=\"false\"/></group></group></macro><macro name=\"page\"><group delimiter=\" \"><label variable=\"page\" form=\"short\" plural=\"never\" text-case=\"capitalize-first\" strip-periods=\"false\"/><text variable=\"page\" form=\"long\" quotes=\"false\" strip-periods=\"false\"/></group><group delimiter=\" \"><text variable=\"number-of-pages\" form=\"long\" quotes=\"false\" strip-periods=\"false\"/><text term=\"page\" form=\"short\" plural=\"false\" quotes=\"false\" strip-periods=\"false\"/></group></macro><macro name=\"access\"><choose><if type=\"webpage post-weblog\" match=\"any\"><choose><if variable=\"URL\" match=\"all\"><text variable=\"URL\" form=\"long\" prefix=\"URL: \" quotes=\"false\" strip-periods=\"false\"/><group prefix=\" (\" suffix=\")\" delimiter=\": \"><text term=\"accessed\" form=\"long\" plural=\"false\" quotes=\"false\" strip-periods=\"false\"/><date variable=\"accessed\"><date-part name=\"day\" form=\"numeric-leading-zeros\" suffix=\".\" strip-periods=\"false\"/><date-part name=\"month\" form=\"numeric-leading-zeros\" suffix=\".\" strip-periods=\"false\"/><date-part name=\"year\" strip-periods=\"false\"/></date