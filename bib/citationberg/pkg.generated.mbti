  Dependent(DependentStyle)
} derive(Eq, @debug.Debug)
pub fn Style::from_xml(String) -> Result[Self, XmlDeError]
pub fn Style::info(Self) -> StyleInfo

pub(all) struct StyleAttribution {
  name : String
  email : String?
  uri : String?
} derive(Eq, @debug.Debug)

pub(all) enum StyleCategory {
  CitationFormat(CitationFormat)
  Field(Field)
} derive(Eq, @debug.Debug)

pub(all) enum StyleClass {
  InText
  Note
} derive(Eq, Hash, @debug.Debug)

pub(all) struct StyleInfo {
  authors : Array[StyleAttribution]
  contributors : Array[StyleAttribution]
  category : Array[StyleCategory]
  field : Array[Field]
  id : String
  issn : Array[String]
  eissn : String?
  issnl : String?
  link : Array[InfoLink]
  published : Timestamp?
  rights : License?
  summary : LocalString?
  title : LocalString
  title_short : LocalString?
  updated : Timestamp?
} derive(Eq, @debug.Debug)

pub(all) enum StyleValidationError {
  MissingCitation
  MissingParent
  MissingClassAttr
} derive(Eq, @debug.Debug)
pub fn StyleValidationError::output(Self, &Logger) -> Unit
pub fn StyleValidationError::to_string(Self) -> String
pub impl Show for StyleValidationError

pub(all) enum SubsequentAuthorSubstituteRule {
  CompleteAll
  CompleteEach
  PartialEach
  PartialFirst
} derive(Eq, Hash, @debug.Debug)

pub(all) struct Substitute {
  children : Array[LayoutRenderingElement]
} derive(Eq, @debug.Debug)

pub(all) enum Term {
  Kind(Kind)
  NameVariable(NameVariable)
  NumberVariable(NumberVariable)
  PageVariable
  Locator(Locator)
  Other(OtherTerm)
} derive(Eq, Hash, @debug.Debug)
pub fn Term::from_str(String) -> Self?
pub fn Term::is_gendered(Self) -> Bool
pub fn Term::is_lexically_same(Self, Self) -> Bool
pub fn Term::is_n_ordinal(Self) -> Bool
pub fn Term::is_ordinal(Self) -> Bool
pub fn Term::term_fallback(Self) -> Self

pub(all) enum TermConversionError {
  OutOfRange
  Unknown
} derive(Eq, Hash, @debug.Debug)
pub impl Show for TermConversionError

pub(all) enum TermForm {
  Long
  Short
  Verb
  VerbShort
  Symbol
} derive(Eq, Hash, @debug.Debug)
pub fn TermForm::fallback(Self) -> Self?

pub(all) struct Terms {
  terms : Array[LocalizedTerm]
} derive(Eq, @debug.Debug)

pub(all) enum TestPosition {
  First
  Subsequent
  IbidWithLocator
  Ibid
  NearNote
} derive(Eq, Hash, @debug.Debug)

pub(all) struct Text {
  target : TextTarget
  formatting : Formatting
  affixes : Affixes
  display : Display?
  quotes : Bool
  strip_periods : Bool
  text_case : TextCase?
} derive(Eq, @debug.Debug)
pub fn Text::find_variable_element(Self, Variable, Array[CslMacro]) -> LayoutRenderingElement?
pub fn Text::with_target(TextTarget) -> Self

pub(all) enum TextCase {
  Lowercase
  Uppercase
  CapitalizeFirst
  CapitalizeAll
  SentenceCase
  TitleCase
} derive(Eq, Hash, @debug.Debug)
pub fn TextCase::is_language_independent(Self) -> Bool

pub(all) enum TextDecoration {
  None_
  Underline
} derive(Eq, Hash, @debug.Debug)
pub impl Default for TextDecoration

pub(all) enum TextTarget {
  Variable(var_~ : Variable, form~ : LongShortForm)
  Macro(name~ : String)
  Term(term~ : Term, form~ : TermForm, plural~ : Bool)
  Value(val~ : String)
} derive(Eq, @debug.Debug)

pub(all) struct Timestamp {
  raw : String
} derive(Eq, @debug.Debug)

pub(all) enum Variable {
  Standard(StandardVariable)
  Page(PageVariable)
  Number(NumberVariable)
  Date(DateVariable)
  Name(NameVariable)
} derive(Eq, Hash, @debug.Debug)
pub fn Variable::from_str(String) -> Self?
pub fn Variable::is_number_of_variable(Self) -> Bool
pub impl Show for Variable

pub(all) struct VariablelessLabel {
  form : TermForm
  plural : LabelPluralize
  formatting : Formatting
  affixes : Affixes
  text_case : TextCase?
  strip_periods : Bool
} derive(Eq, @debug.Debug)

pub(all) enum VerticalAlign {
  None_
  Baseline
  Sup
  Sub
} derive(Eq, Hash, @debug.Debug)
pub impl Default for VerticalAlign

pub(all) struct XmlDeError {
  message : String
  path : String?
} derive(Eq, @debug.Debug)
pub fn XmlDeError::output(Self, &Logger) -> Unit
pub fn XmlDeError::to_string(Self) -> String
pub impl Show for XmlDeError

