  assert_eq(
    wasmi_outcome(
      b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x04\x01\x60\x00\x00\x03\x02\x01\x00\x0a\x3b\x01\x39\x00\xfd\x0c\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xfd\x0c\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xfd\x0d\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x1a\x0b",
    ),
    "ok",
  )
}

///|
test "wasmi validate start_extra" {
  assert_eq(
    wasmi_outcome(
      b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x04\x01\x60\x00\x00\x03\x02\x01\x00\x08\x02\x00\x00\x0a\x04\x01\x02\x00\x0b",
    ),
    "unexpected content in the start section (at offset 0x15)",
  )
}

///|
test "wasmi validate table_init_expr" {
  assert_eq(
    wasmi_outcome(
      b"\x00\x61\x73\x6d\x01\x00\x00\x00\x04\x09\x01\x40\x00\x70\x00\x01\xd0\x70\x0b",
    ),
    "tables with expression initializers require the function-references proposal (at offset 0xb)",
  )
}

///|
test "wasmi validate tag_import" {
  assert_eq(
    wasmi_outcome(
      b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x04\x01\x60\x00\x00\x02\x08\x01\x01\x6d\x01\x6e\x04\x00\x00",
    ),
    "exceptions proposal not enabled (at offset 0x11)",
  )
}

///|
test "wasmi validate tag_section" {
  assert_eq(
    wasmi_outcome(
      b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x04\x01\x60\x00\x00\x0d\x03\x01\x00\x00",
    ),
    "exceptions proposal not enabled (at offset 0x10)",
  )
}

///|
test "wasmi validate threads" {
  assert_eq(
    wasmi_outcome(
      b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x04\x01\x60\x00\x00\x03\x02\x01\x00\x05\x03\x01\x00\x01\x0a\x0d\x01\x0b\x00\x41\x00\x41\x00\xfe\x00\x02\x00\x1a\x0b",
    ),
    "threads support is not enabled (at offset 0x20)",
  )
}

///|
test "wasmi validate truncated_header" {
  assert_eq(
    wasmi_outcome(b"\x00\x61\x73\x6d\x01\x00"),
    "unexpected end-of-file (at offset 0x4)",
  )
}

///|
test "wasmi validate try_table" {
  assert_eq(
    wasmi_outcome(
      b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x04\x01\x60\x00\x00\x03\x02\x01\x00\x0a\x08\x01\x06\x00\x1f\x40\x00\x0b\x0b",
    ),
    "exceptions support is not enabled (at offset 0x17)",
  )
}

///|
test "wasmi validate type_after_code" {
  assert_eq(
    wasmi_outcome(
      b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x04\x01\x60\x00\x00\x03\x02\x01\x00\x0a\x04\x01\x02\x00\x0b\x01\x04\x01\x60\x00\x00",
    ),
    "section out of order (at offset 0x20)",
  )
}

///|
test "wasmi validate type_mismatch" {
  assert_eq(
    wasmi_outcome(
      b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x06\x01\x60\x01\x7f\x01\x7f\x03\x02\x01\x00\x0a\x0c\x01\x0a\x00\x20\x00\x43\x00\x00\x80\x3f\x6a\x0b",
    ),
    "type mismatch: expected i32, found f32 (at offset 0x20)",
  )
}

///|
test "wasmi validate typed_select_v128" {
  assert_eq(
    wasmi_outcome(
      b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x04\x01\x60\x00\x00\x03\x02\x01\x00\x0a\x2e\x01\x2c\x00\xfd\x0c\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xfd\x0c\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x41\x00\x1c\x01\x7b\x1a\x0b",
    ),
    "ok",
  )
}

///|
test "wasmi validate unknown_section" {
  assert_eq(
    wasmi_outcome(b"\x00\x61\x73\x6d\x01\x00\x00\x00\x0e\x00"),
    "malformed section id: 14 (at offset 0xa)",
  )
}

///|
test "wasmi validate version2" {
  assert_eq(
    wasmi_outcome(b"\x00\x61\x73\x6d\x02\x00\x00\x00"),
    "unknown binary version: 0x2 (at offset 0x0)",
  )
}

///|
test "wasmi validate wide" {
  assert_eq(
    wasmi_outcome(
      b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x04\x01\x60\x00\x00\x03\x02\x01\x00\x0a\x10\x01\x0e\x00\x42\x00\x42\x00\x42\x00\x42\x00\xfc\x13\x1a\x1a\x0b",
