///|
/// `VisitOperator::visit_operator`: validates `op`.
pub fn WasmProposalValidator::visit_operator(
  self : WasmProposalValidator,
  op : Operator,
) -> Unit raise BinaryReaderError {
  match op {
    Unreachable => self.visit_unreachable()
    Nop => self.visit_nop()
    Block(blockty~) => self.visit_block(blockty)
    Loop(blockty~) => self.visit_loop(blockty)
    If(blockty~) => self.visit_if(blockty)
    Else => self.visit_else()
    End => self.visit_end()
    Br(relative_depth~) => self.visit_br(relative_depth)
    BrIf(relative_depth~) => self.visit_br_if(relative_depth)
    BrTable(targets~) => self.visit_br_table(targets)
    Return => self.visit_return()
    Call(function_index~) => self.visit_call(function_index)
    CallIndirect(type_index~, table_index~) =>
      self.visit_call_indirect(type_index, table_index)
    Drop => self.visit_drop()
    Select => self.visit_select()
    LocalGet(local_index~) => self.visit_local_get(local_index)
    LocalSet(local_index~) => self.visit_local_set(local_index)
    LocalTee(local_index~) => self.visit_local_tee(local_index)
    GlobalGet(global_index~) => self.visit_global_get(global_index)
    GlobalSet(global_index~) => self.visit_global_set(global_index)
    I32Load(memarg~) => self.visit_i32_load(memarg)
    I64Load(memarg~) => self.visit_i64_load(memarg)
    F32Load(memarg~) => self.visit_f32_load(memarg)
    F64Load(memarg~) => self.visit_f64_load(memarg)
    I32Load8S(memarg~) => self.visit_i32_load8_s(memarg)
    I32Load8U(memarg~) => self.visit_i32_load8_u(memarg)
