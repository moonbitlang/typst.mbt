    "M 415e16d0,41107a4c L 41bf0b68,42441e93 L 41a00000,42480000 L 4180f498,42441e93 L 41d0f498,41107a4c L 41f00000,41200000 L 41f00000,41600000 L 41200000,41600000 L 41200000,41200000 L 415e16d0,41107a4c Z M 409c0f85,40c00000 L 420c7e0f,40c00000 L 41a00000,4284fc1e L 40c3d25f,412f85b4 Z | b 409c0f85,40c00000,420c7e0f,4284fc1e",
  )
  assert_eq(
