///|
test "117 random 60" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x42BC0000U), f(0x41D80000U))
  pb.quad_to(f(0x43425588U), f(0x4313DFBFU), f(0x432B774EU), f(0x42A5EB94U))
  pb.line_to(f(0x432BFAE4U), f(0x42A4EB94U))
  pb.cubic_to(
    f(0xC298BB6DU),
    f(0x432C7DAEU),
    f(0x433E5EE6U),
    f(0x43398CE8U),
    f(0x429E0000U),
    f(0x43130000U),
  )
  pb.close()
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 42bc0000,41d80000 Q 43425588,4313dfbf 432b774e,42a5eb94 L 432bfae4,42a4eb94 C c298bb6d,432c7dae 433e5ee6,43398ce8 429e0000,43130000 Z | b c298bb6d,41d80000,43425588,43398ce8",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "4278bdd6,41d80000,432fb5ef,43276e02",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 4304199a,429a6666 Q 4345fd46,43ae862d 43512080,43545c2c L 43523f7c,435383a5 C c3614af2,439e8939 4325abb6,43d39b24 41cccccc,439c599a Z | b c3614af2,429a6666,43523f7c,43d39b24",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
