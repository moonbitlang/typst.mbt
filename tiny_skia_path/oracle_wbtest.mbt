    "409c0f85,40c00000,420c7e0f,4284fc1e",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "#443 1af274326de6e7eb M 415e16d0,41107a4c L 41bf0b68,42441e93 L 41a00000,42480000 L 4180f498,42441e93 L 41d0f498,41107a4c ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
