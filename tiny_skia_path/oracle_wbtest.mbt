///|
test "15 oval" {
  let pb = PathBuilder::new()
  if Rect::from_ltrb(
      f(0xC1A00000U),
      f(0x40A00000U),
      f(0x42720000U),
      f(0x42350000U),
    )
    is Some(r) {
    pb.push_oval(r)
  }
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "#669 e894a6958cb4876c M 42720000,41c90000 Q 4271ffff,41e9065d 4265be9d,42034e56 Q 42597d3b,4212197e 4242d81c,421d6c0e Q 42",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c1a00000,40a00000,42720000,42350000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "#669 c3445ee167c0353c M 42a65333,427d999a Q 42a0b87c,428ecffb 429259f2,429bc487 Q 4283fb66,42a8b914 425e1220,42b0a612 Q 42",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c21ce192,4114c518,42a9972f,42bab428",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "#669 a7cef32c894f272f M 421438d8,425816cb Q 420b8045,426584a8 41f254d0,426b4016 Q 41cda916,4270fb86 419b57fe,426e2520 Q 41",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c200c7d7,408dc20b,421b2c3d,426f15a4",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "#669 6d44da01ef95143e M 42f88000,40a20000 Q 42f87fff,40e20cba 42ec3e9d,410e9cac Q 42dffd3b,412c32fc 42c9581c,4142d81c Q 42",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c2130000,c0a00000,42f88000,41720000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1299 fe71d263016c6791 M 42740000,41c90000 Q 42740000,41ea7778 426748e4,420494f8 Q 425ac2a0,4213b338 4243bd15,421f3600 Q 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c1a40000,40900000,42740000,42370000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1299 edaa43e868fa6e01 M 42830000,41c90002 Q 4282ffff,41f770fb 42752567,421010a7 Q 426633d3,42221a8a 424bc9d8,422f4f86 Q 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41200000U), f(0x40800000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c1c80000,00000000,42830000,42490000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "#2259 6a17814cca792ec4 M 427e0000,41c90001 Q 427dfffe,41f1acb9 426efc49,420af620 L 4265be9d,42034e56 L 426efc4a,420af620 Q ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
