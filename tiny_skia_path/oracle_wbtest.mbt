    "bedbcf83,c1d1ff52,428c2048,405e4ef8",
  )
  let d = StrokeDash::new([f(0x40A00000U), f(0x40400000U)], f(0x00000000U)).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
    "#639 2b7f6b596d7ae1b4 M 00000000,00000000 L 38d1b717,00000000 Q 402d0248,beab0f11 40a97e2b,bf2b4b86 M 4105e87a,bf892681 Q ",
