test "185 random 128" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x3F533334U), f(0xBF000000U))
  pb.cubic_to(
    f(0x3F5339C2U),
    f(0xBF000000U),
    f(0xC25B36F9U),
    f(0x42B8515CU),
    f(0x42BC0000U),
    f(0x42A60000U),
  )
  pb.line_to(f(0xC2A3539EU), f(0xC2671A4CU))
  pb.quad_to(f(0x431F948AU), f(0xC29CC5B4U), f(0xC104E968U), f(0x4264EAFCU))
  pb.cubic_to(
    f(0xC1900000U),
    f(0x42580000U),
    f(0xC18FFFCCU),
    f(0x42580000U),
    f(0x42E8C89EU),
    f(0x3F62F500U),
  )
  pb.cubic_to(
    f(0x42E8C89EU),
    f(0x3F62F500U),
    f(0x42040000U),
    f(0x42AC0000U),
    f(0x42040000U),
    f(0x42AC0000U),
  )
  pb.quad_to(f(0x42E00000U), f(0x00000000U), f(0x42E1BBE7U), f(0xBF000000U))
  pb.close()
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 3f533334,bf000000 C 3f5339c2,bf000000 c25b36f9,42b8515c 42bc0000,42a60000 L c2a3539e,c2671a4c Q 431f948a,c29cc5b4 c104e968,4264eafc C c1900000,42580000 c18fffcc,42580000 42e8c89e,3f62f500 C 42e8c89e,3f62f500 42040000,42ac0000 42040000,42ac0000 Q 42e00000,00000000 42e1bbe7,bf000000 Z | b c2a3539e,c29cc5b4,431f948a,42b8515c",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c2a3539e,c271faa2,42e8c89e,42ac0000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40E00000U), f(0x40000000U), 1, 3),
          f(0x40400000U),
        ),
      ),
    ),
    "#2849 cbb662e68e6f5c51 M 3f533334,c0800000 Q 40272e94,c07ffffe 406a4048,c0235851 Q 40882f12,bfdd5ff6 408a2fe4,bf3738de Q 40",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40E00000U), f(0x40000000U), 1, 3), f(0x40400000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c2a7b442,c27ff930,42edc8a2,42b0e620",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3DCCCCCDU), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "#2299 bcaedc53e072d7d9 M 3f533334,bf0ccccd Q 3f5f3be7,bf0ccccd 3f5ff9c6,bf00c9f5 Q 3f601adb,befd646a 3f5f8f46,bef957cd Q 3f",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3DCCCCCDU), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c2a363a0,c2722ff3,42e8dae7,42ac11eb",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40E00000U), f(0x40000000U), 1, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "#2555 abf673dc855629ab M 3f533334,c0800000 Q 4083b288,c07fffff 408a2fe4,bf3738de Q 408b515c,be12e948 40868c04,3ed1fe10 Q 40",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40E00000U), f(0x40000000U), 1, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c2b1491f,c27fc5ca,42f6c234,42bad1e3",
  )
}

///|
test "186 random 129" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x38D1B717U), f(0x00000000U))
  pb.line_to(f(0x431C9108U), f(0x4313117EU))
  pb.line_to(f(0xC1AAFBE4U), f(0x413857F8U))
  pb.line_to(f(0x42D60000U), f(0x42DC0000U))
  pb.cubic_to(
    f(0x430C0F9CU),
    f(0x431F01D2U),
    f(0x430C0F9CU),
    f(0x431F01D2U),
    f(0xC2409651U),
    f(0xC1563900U),
  )
  pb.quad_to(f(0xC1C80000U), f(0x42E80000U), f(0x424FCB5CU), f(0x42BE457AU))
  pb.cubic_to(
    f(0x432ED326U),
    f(0x41CCB188U),
    f(0x430F0000U),
    f(0xC2180000U),
    f(0x429F2442U),
    f(0x41E88CA8U),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 38d1b717,00000000 L 431c9108,4313117e L c1aafbe4,413857f8 L 42d60000,42dc0000 C 430c0f9c,431f01d2 430c0f9c,431f01d2 c2409651,c1563900 Q c1c80000,42e80000 424fcb5c,42be457a C 432ed326,41ccb188 430f0000,c2180000 429f2442,41e88ca8 | b c2409651,c2180000,432ed326,431f01d2",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c2409651,c1563900,431c9108,4313117e",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40E00000U), f(0x40000000U), 0, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#2017 ec2121002b3181e7 M 40195e5c,c023444b L 431ef67b,4310846d Q 432004fc,43118286 43201097,4312f57a Q 43201c31,4314686e 43",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40E00000U), f(0x40000000U), 0, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c24e9775,c1871d8a,43201119,431691d8",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x42700000U), f(0x41F00000U), 0, 0),
          f(0x40400000U),
        ),
      ),
    ),
    "#2213 b9b68ef11ea5e023 M 41a45143,c1aeedbe L 44162e98,4402c7fe L c21e3553,420d8b62 L c0473d80,c14480a8 L 43012315,42b257c2 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x42700000U), f(0x41F00000U), 0, 0), f(0x40400000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c2ba999a,c2bedd2e,44162e98,4402c7fe",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 2, 0),
          f(0x41800000U),
        ),
      ),
    ),
    "#2275 7781a705bbaa34f0 M 3eaf5281,beba9731 L 431ce8ab,4312b432 L 431c4378,43137751 L c1ad6867,413eb521 L c1a88c9f,4131ff06 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 2, 0), f(0x41800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c24398ee,c16c19cf,431ce8ab,43137751",
  )
}

///|
test "187 random 130" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x42A40924U), f(0x43132155U))
  pb.line_to(f(0xC2000000U), f(0xC2200000U))
  pb.quad_to(f(0x42F32980U), f(0x42B23DA4U), f(0xBF975280U), f(0xC057A460U))
  pb.close()
  pb.cubic_to(
    f(0x42212E00U),
    f(0x429AFF6EU),
    f(0x42221D9EU),
    f(0x4299FF6EU),
    f(0xC1DDC878U),
    f(0xC1197C28U),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 42a40924,43132155 L c2000000,c2200000 Q 42f32980,42b23da4 bf975280,c057a460 Z M 42a40924,43132155 C 42212e00,429aff6e 42221d9e,4299ff6e c1ddc878,c1197c28 | b c2000000,c2200000,42f32980,43132155",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c2000000,c2200000,42a40924,43132155",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41f048fc,439ceed1 L c1200000,c2bd3333 Q 4301fcc0,4351b711 41295d4c,c1417ee2 Z M 41f048fc,439ceed1 C 41818b9a,43221614 41872740,4321280d c1c6f472,c202028c | b c1c6f472,c2bd3333,4301fcc0,439ceed1",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c1c6f472,c2bd3333,428318c6,439ceed1",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M c1358ce0,4328105b L c0a1a920,c24be6ae Q 4255b648,430cf5df 3f57f828,c05e0f89 Z M c1358ce0,4328105b C c106a2d8,42ade26b c0fe4728,42ad4cf8 c19034bc,c1b92745 | b c19034bc,c24be6ae,4255b648,4328105b",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c19034bc,c24be6ae,41cdebe1,4328105b",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 43274924,42842155 L c2730000,c1dc0000 Q 43766980,42143da4 3f62b600,c112f48c Z M 43274924,42842155 C 42a7ae00,41f9fedc 42a89d9e,41f7fedc c250c878,c144be14 | b c2730000,c1dc0000,43766980,42842155",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c2730000,c1dc0000,43274924,42842155",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3DCCCCCDU), f(0x40800000U), 0, 2),
          f(0x41800000U),
        ),
      ),
    ),
    "#1713 766c689ef865c8ee M 42a3f347,431327fe L c2002bb9,c21fe55c Q c20036c2,c21ff778 c20031c0,c2200c13 Q c2002cbf,c22020af c2",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3DCCCCCDU), f(0x40800000U), 0, 2), f(0x41800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c2003350,c2203336,42a422ce,43132e29",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41700000U), f(0x3F000000U), 0, 3),
          f(0x40400000U),
        ),
      ),
    ),
    "#1357 b0f0323f4bc98e67 M 429739e5,43170859 L c2199e7e,c21063ee L c1d96388,c236f67f Q 42487358,4199e3e0 4268efab,41e71da9 Q ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41700000U), f(0x3F000000U), 0, 3), f(0x40400000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c2199e7e,c236f67f,42b129cb,43170859",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x3F99999AU), 1, 3),
          f(0x41800000U),
        ),
      ),
    ),
    "#1753 f3f271579fa6a053 M 42a32e86,431363ef L c201b53c,c21ef598 L c1fd6d09,c22187e6 Q 42349380,41c1a100 425382a6,42059574 Q ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x3F99999AU), 1, 3), f(0x41800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c201b53c,c22187e6,42a509bd,4313a1a0",
  )
  let d = StrokeDash::new([f(0x40A00000U), f(0x40400000U)], f(0x00000000U)).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
    "#5157 97ef68ebd4458a37 M 429bb5e7,430c4c67 L 429681e1,43080752 M 429362ab,43057778 L 428e2ea5,43013263 M 428b0f6e,42fd4514 ",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3F800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#35569 936eda79d47b99d1 M 429a00ab,430cd19b L 4294cca5,43088c86 Q 42945e4b,430831f7 42949054,4307caec Q 4294c25d,430763e0 42",
  )
  assert_eq(
    dg(dpath(path.dash(d, f(0x3E800000U)))),
    "#5157 bf945d4be575dbaa M 429bb5e7,430c4c67 L 429681e1,43080752 M 429362ab,43057778 L 428e2ea5,43013263 M 428b0f6e,42fd4514 ",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3E800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#35721 af8b9798963d122d M 429a00ab,430cd19b L 4294cca5,43088c86 Q 42945e4b,430831f7 42949054,4307caec Q 4294c25d,430763e0 42",
  )
  let d = StrokeDash::new(
    [f(0x3F800000U), f(0x40000000U), f(0x40400000U), f(0x40800000U)],
    f(0x40200000U),
  ).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
    "#8251 be07b2644dffcf08 M 42a383f0,4312b406 L 42a064b9,4310242d M 429c3b1b,430cb9b5 L 429b30b4,430bdf18 M 42991be4,430a29dc ",
  )
