///|
test "28 cubic cusp" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.cubic_to(
    f(0x42C80000U),
    f(0x42C80000U),
    f(0x00000000U),
    f(0x42C80000U),
    f(0x42C80000U),
    f(0x00000000U),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 C 42c80000,42c80000 00000000,42c80000 42c80000,00000000 | b 00000000,00000000,42c80000,42c80000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "00000000,00000000,42c80000,42960000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 C 42b40000,43610000 c2700000,43430000 43200000,41c80001 | b c2700000,c0a00000,43200000,43610000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41200000,c0a00000,43200000,43200000",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 C 41eb39a8,430a54ba c259db0a,42a7bbef 42a7bbef,4259db0a | b c259db0a,00000000,42a7bbef,430a54ba",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "00000000,00000000,42a7bbef,42b443b6",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 C 434b4000,422a0000 40500000,422a0000 434b4000,c0f00000 | b 40500000,c0f00000,434b4000,422a0000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40500000,c0f00000,434b4000,41f00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1787 e99f9747623b7abc M 3eb504f3,beb504f3 Q 41fd4992,41f7a16a 4230c9f2,42601b07 Q 424a0000,428943a0 424a0000,42960000 L 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "beb504f3,beb504f3,42c8b505,42970000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#2125 ad635dfbd78dc180 M 40624630,c0624630 Q 420d6fe7,41e24e42 4240e378,42580e44 Q 425c0000,428723aa 425c0000,42960000 L 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41200000U), f(0x40800000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c09fffff,c09fffff,42d1ffff,42a00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1903 7b381f5234e4bde4 M 4007c3b6,c007c3b6 Q 4206dcbe,41ebc88e 4239bbae,425ba229 Q 42540000,42881568 42540000,42960000 L 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c087c3b6,c087c3b6,42d07c3c,429c0000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x41200000U), 0, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1841 4c5d5de35424ee74 M 403504f3,c03504f3 Q 420a2659,41e70b74 423d4f93,4259d837 Q 42580000,42879c8a 42580000,42960000 L 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41000000U), f(0x41200000U), 0, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c03504f3,c03504f3,42cda828,429e0000",
  )
  assert_eq(
    dg(
