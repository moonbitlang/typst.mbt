  assert_eq(dg(hx(round_f32(f(0x4F32D05EU)))), "4f32d05e")
  assert_eq(dg(f32_as_u32(f(0x4F32D05EU)).to_string()), "3000000000")
  assert_eq(dg(f32_as_i32(f(0x4F32D05EU)).to_string()), "2147483647")
  assert_eq(
    dg(hx(NormalizedF32::new_clamped(f(0x4F32D05EU)).get())),
    "3f800000",
  )
  assert_eq(dg(hx(fmin(f(0xCF32D05EU), f(0x00000000U)))), "cf32d05e")
  assert_eq(dg(hx(fmax(f(0xCF32D05EU), f(0x00000000U)))), "00000000")
  assert_eq(dg(hx(fmin(f(0xCF32D05EU), f(0x80000000U)))), "cf32d05e")
  assert_eq(dg(hx(fmax(f(0xCF32D05EU), f(0x80000000U)))), "80000000")
