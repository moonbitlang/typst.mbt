///|
test "57 random 0" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x42C263F2U), f(0x423BF3D4U))
  pb.quad_to(f(0x431613D3U), f(0x41A86878U), f(0x431337ACU), f(0xC2C79C7EU))
  pb.cubic_to(
    f(0x4330925AU),
    f(0xC29AE14CU),
    f(0xC2626E6DU),
    f(0xC2C12512U),
    f(0xC2626E6DU),
    f(0xC2C12512U),
  )
  pb.cubic_to(
    f(0x42CC362AU),
    f(0x42E52FEEU),
    f(0x43140000U),
    f(0x42820000U),
    f(0x41C00000U),
    f(0x41E80000U),
  )
  pb.cubic_to(
    f(0xC2480000U),
    f(0xC1C00000U),
    f(0x41C00000U),
    f(0x430E0000U),
    f(0x41C34189U),
    f(0x430D8000U),
  )
  pb.move_to(f(0xC2644848U), f(0x433404C0U))
  pb.line_to(f(0xC264482EU), f(0x433404C0U))
  pb.line_to(f(0xC264482EU), f(0x433404C0U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 42c263f2,423bf3d4 Q 431613d3,41a86878 431337ac,c2c79c7e C 4330925a,c29ae14c c2626e6d,c2c12512 c2626e6d,c2c12512 C 42cc362a,42e52fee 43140000,42820000 41c00000,41e80000 C c2480000,c1c00000 41c00000,430e0000 41c34189,430d8000 M c2644848,433404c0 L c264482e,433404c0 L c264482e,433404c0 | b c2644848,c2c79c7e,4330925a,433404c0",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c2644848,c2c79c7e,4315c5fb,433404c0",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
