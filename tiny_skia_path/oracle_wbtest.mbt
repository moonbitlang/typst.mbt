    "None",
  )
  let d = StrokeDash::new([f(0x40A00000U), f(0x40400000U)], f(0x00000000U)).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
    "M 424c1086,44bcf0cb C 424c107c,44bcf0cb 424c10c2,44bcf0cb 424c1119,44bcf0ca | b 424c107c,44bcf0ca,424c1119,44bcf0cb",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3F800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#937 0d4cd34d08cb8e2d M 424c1086,44bd10cb Q 424b1b50,44bd10cb 424a40c9,44bd0d53 Q 42470b02,44bd0047 424853f3,44bce55f Q 42",
  )
  assert_eq(
    dg(dpath(path.dash(d, f(0x3E800000U)))),
    "M 424c1086,44bcf0cb C 424c107c,44bcf0cb 424c10c2,44bcf0cb 424c1119,44bcf0ca | b 424c107c,44bcf0ca,424c1119,44bcf0cb",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3E800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#937 0d4cd34d08cb8e2d M 424c1086,44bd10cb Q 424b1b50,44bd10cb 424a40c9,44bd0d53 Q 42470b02,44bd0047 424853f3,44bce55f Q 42",
  )
  let d = StrokeDash::new(
    [f(0x3F800000U), f(0x40000000U), f(0x40400000U), f(0x40800000U)],
    f(0x40200000U),
  ).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
  let d = StrokeDash::new([f(0x41200000U), f(0x40A00000U)], f(0xC0400000U)).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
  let d = StrokeDash::new([f(0x00000000U), f(0x40800000U)], f(0x00000000U)).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
    "M 424c1086,44bcf0cb L 424c1086,44bcf0cb | b 424c1086,44bcf0cb,424c1086,44bcf0cb",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3F800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#405 e9f18be105727fd7 M 42501086,44bcf0cb L 42501086,44bcf0cb Q 42501085,44bcfe0b 424ee499,44bd076b Q 424db8ac,44bd10ca 42",
  )
  assert_eq(
    dg(dpath(path.dash(d, f(0x3E800000U)))),
    "M 424c1086,44bcf0cb L 424c1086,44bcf0cb | b 424c1086,44bcf0cb,424c1086,44bcf0cb",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3E800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#405 e9f18be105727fd7 M 42501086,44bcf0cb L 42501086,44bcf0cb Q 42501085,44bcfe0b 424ee499,44bd076b Q 424db8ac,44bd10ca 42",
  )
}

///|
test "35 quad_stroker_one_off" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x43C99223U), f(0x42B7417EU))
  pb.quad_to(f(0x4285D839U), f(0x43ED6645U), f(0x43C941C8U), f(0x42B3ACE3U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 43c99223,42b7417e Q 4285d839,43ed6645 43c941c8,42b3ace3 | b 4285d839,42b3ace3,43c99223,43ed6645",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "436adffa,42b3ace3,43c99223,438d622b",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 4409a4ac,43959963 Q c35df9cf,44712b2e 4409b89c,4393b6fa | b c35df9cf,4393b6fa,4409b89c,44712b2e",
  )
