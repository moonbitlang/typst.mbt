///|
test "41 near 180 turn" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.line_to(f(0x42C80000U), f(0x00000000U))
  pb.line_to(f(0x00000000U), f(0x3DCCCCCDU))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 L 42c80000,00000000 L 00000000,3dcccccd | b 00000000,00000000,42c80000,3dcccccd",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "00000000,00000000,42c80000,3dcccccd",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 L 43200000,41c80001 L 411ee148,c099999a | b 411ee148,c0a00000,43200000,41c80001",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "411ee148,c0a00000,43200000,41c80001",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 L 42a7bbef,4259db0a L bd5f158b,3dabc27e | b bd5f158b,00000000,42a7bbef,4259db0a",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "bd5f158b,00000000,42a7bbef,4259db0a",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 L 434b4000,c0f00000 L 40500000,c0ee6666 | b 40500000,c0f00000,434b4000,c0ee6666",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40500000,c0f00000,434b4000,c0ee6666",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 00000000,bf000000 L 42c80000,bf000000 L 42c80042,3efffff8 L 3a03126b,3f199996 L ba03126b,beccccc5 L 42c7ffbe,befffff8 L 42c80000,00000000 L 42c80000,3f000000 L 00000000,3f000000 L 00000000,bf000000 Z | b ba03126b,bf000000,42c80042,3f199996",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "ba03126b,bf000000,42c80042,3f199996",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#637 e3801403cd5f0d28 M 00000000,c0a00000 L 42c80000,c0a00000 Q 42cc2462,c09fffff 42cf1231,c062462f Q 42d1ffff,c0048c5f 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41200000U), f(0x40800000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0a00001,c0a00000,42d20000,40a33334",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
