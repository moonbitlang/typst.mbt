///|
test "20 quad closed" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x41200000U), f(0x42A00000U))
  pb.quad_to(f(0x42BE0000U), f(0x41200000U), f(0x43340000U), f(0x42A00000U))
  pb.close()
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 41200000,42a00000 Q 42be0000,41200000 43340000,42a00000 Z | b 41200000,41200000,43340000,42a00000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "41200000,42340000,43340000,42a00000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M c1f80000,431e0000 Q 43118000,422e0000 43600000,43510000 Z | b c1f80000,422e0000,43600000,43510000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c1f80000,42de5af8,43600000,43510000",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M c20cbcd8,4291147f Q 42947463,4270827a 42d6c776,432520f0 Z | b c20cbcd8,4270827a,42d6c776,432520f0",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c20cbcd8,428e74a4,42d6c776,432520f0",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41ba0000,42020000 Q 43414000,c0200000 43b5a000,42020000 Z | b 41ba0000,c0200000,43b5a000,42020000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41ba0000,41700000,43b5a000,42020000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 411aea12,429f3a63 Q 42bdffa0,4115a800 4334515f,429f3a63 L 433564c7,42a10000 L 4109b389,42a10000 Z M 412515ee,42a0c59d L 41200000,42a00000 L 41200000,429f0000 L 43340000,429f0000 L 43340000,42a00000 L 4333aea1,42a0c59d Q 42bdffa0,412a5800 412515ee,42a0c59d Z | b 4109b389,4115a800,433564c7,42a10000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "4109b389,4231ef63,433564c7,42a10000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#583 4de1e5b7987aa193 M 40da496e,429847dc Q 42be0004,40617400 43372db5,429847dc Q 4338c6fa,429ae9f3 4338fa0c,429f0969 Q 43",
