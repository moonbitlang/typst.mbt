    "40a0fb26,40c00000,420be09b,42600000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40800000U), f(0x40800000U), 1, 0),
          f(0x40200000U),
        ),
