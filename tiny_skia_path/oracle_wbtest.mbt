///|
test "45 double move" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x3F800000U), f(0x3F800000U))
  pb.move_to(f(0x40000000U), f(0x40000000U))
  pb.line_to(f(0x41F00000U), f(0x40000000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 40000000,40000000 L 41f00000,40000000 | b 40000000,40000000,41f00000,40000000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "40000000,40000000,41f00000,40000000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 4139999a,beccccd0 L 42566666,41000000 | b 4139999a,beccccd0,42566666,41000000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "4139999a,beccccd0,42566666,41000000",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 3f168b4c,4031104a L 41c09114,419021d2 | b 3f168b4c,4031104a,41c09114,419021d2",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "3f168b4c,4031104a,41c09114,419021d2",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40e80000,c0d00000 L 427d0000,c0d00000 | b 40e80000,c0d00000,427d0000,c0d00000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40e80000,c0d00000,427d0000,c0d00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 40000000,3fc00000 L 41f00000,3fc00000 L 41f00000,40200000 L 40000000,40200000 L 40000000,3fc00000 Z | b 40000000,3fc00000,41f00000,40200000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "40000000,3fc00000,41f00000,40200000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#405 9590be8f7d358fd9 M 40000000,c0400000 L 41f00000,c0400000 Q 420048c5,c03fffff 42062462,bfc48c5f Q 420bffff,bd918bf8 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41200000U), f(0x40800000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0400000,c0400000,420c0000,40e00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 40000000,bf800000 L 42040000,bf800000 L 42040000,40a00000 L bf800000,40a00000 L bf800000,bf800000 Z | b bf800000,bf800000,42040000,40a00000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "bf800000,bf800000,42040000,40a00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x41200000U), 0, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 40000000,c0000000 L 41f00000,c0000000 L 41f00000,40c00000 L 40000000,40c00000 L 40000000,c0000000 Z | b 40000000,c0000000,41f00000,40c00000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41000000U), f(0x41200000U), 0, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "40000000,c0000000,41f00000,40c00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 40000000,c0000000 L 42080000,c0000000 L 42080000,40c00000 L c0000000,40c00000 L c0000000,c0000000 Z | b c0000000,c0000000,42080000,40c00000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0000000,c0000000,42080000,40c00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40800000U), f(0x40800000U), 1, 0),
          f(0x40200000U),
        ),
      ),
    ),
    "#405 77b400f59e3488f0 M 40000000,00000000 L 41f00000,00000000 Q 41f6a09e,00000000 41fb504f,3f15f619 Q 41ffffff,3f95f619 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40800000U), f(0x40800000U), 1, 0), f(0x40200000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,00000000,42000000,40800000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F000000U), f(0x40800000U), 0, 2),
          f(0x3E99999AU),
        ),
      ),
    ),
    "M 40000000,3fe00000 L 41f00000,3fe00000 L 41f00000,40100000 L 40000000,40100000 L 40000000,3fe00000 Z | b 40000000,3fe00000,41f00000,40100000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F000000U), f(0x40800000U), 0, 2), f(0x3E99999AU))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "40000000,3fe00000,41f00000,40100000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41A00000U), f(0x3F800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 40000000,c1000000 L 41f00000,c1000000 L 41f00000,41400000 L 40000000,41400000 L 40000000,c1000000 Z | b 40000000,c1000000,41f00000,41400000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41A00000U), f(0x3F800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "40000000,c1000000,41f00000,41400000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40400000U), f(0x40800000U), 2, 2),
          f(0x41200000U),
        ),
      ),
    ),
    "M 40000000,3f000000 L 41fc0000,3f000000 L 41fc0000,40600000 L 3f000000,40600000 L 3f000000,3f000000 Z | b 3f000000,3f000000,41fc0000,40600000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40400000U), f(0x40800000U), 2, 2), f(0x41200000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "3f000000,3f000000,41fc0000,40600000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x00000000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  let d = StrokeDash::new([f(0x40A00000U), f(0x40400000U)], f(0x00000000U)).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
    "M 40000000,40000000 L 40e00000,40000000 M 41200000,40000000 L 41700000,40000000 M 41900000,40000000 L 41b80000,40000000 M 41d00000,40000000 L 41f00000,40000000 | b 40000000,40000000,41f00000,40000000",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3F800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#1503 dce2cf3814a95868 M 40000000,3f800000 L 40e00000,3f800000 Q 40ed413c,3f800000 40f6a09e,3fa57d86 Q 40ffffff,3fcafb0c 41",
  )
  assert_eq(
    dg(dpath(path.dash(d, f(0x3E800000U)))),
    "M 40000000,40000000 L 40e00000,40000000 M 41200000,40000000 L 41700000,40000000 M 41900000,40000000 L 41b80000,40000000 M 41d00000,40000000 L 41f00000,40000000 | b 40000000,40000000,41f00000,40000000",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3E800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#1503 dce2cf3814a95868 M 40000000,3f800000 L 40e00000,3f800000 Q 40ed413c,3f800000 40f6a09e,3fa57d86 Q 40ffffff,3fcafb0c 41",
  )
  let d = StrokeDash::new(
    [f(0x3F800000U), f(0x40000000U), f(0x40400000U), f(0x40800000U)],
    f(0x40200000U),
  ).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
    "M 40200000,40000000 L 40b00000,40000000 M 41180000,40000000 L 41280000,40000000 M 41480000,40000000 L 41780000,40000000 M 419c0000,40000000 L 41a40000,40000000 M 41b40000,40000000 L 41cc0000,40000000 M 41ec0000,40000000 L 41f00000,40000000 | b 40200000,40000000,41f00000,40000000",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3F800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#2235 807b12f0044cbb5e M 40200000,3f800000 L 40b00000,3f800000 Q 40bd413b,3f800000 40c6a09d,3fa57d86 Q 40cffffe,3fcafb0c 40",
  )
  assert_eq(
    dg(dpath(path.dash(d, f(0x3E800000U)))),
    "M 40200000,40000000 L 40b00000,40000000 M 41180000,40000000 L 41280000,40000000 M 41480000,40000000 L 41780000,40000000 M 419c0000,40000000 L 41a40000,40000000 M 41b40000,40000000 L 41cc0000,40000000 M 41ec0000,40000000 L 41f00000,40000000 | b 40200000,40000000,41f00000,40000000",
  )
  assert_eq(
