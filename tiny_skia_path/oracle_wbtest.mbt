///|
test "17 tiny circle" {
  let pb = PathBuilder::new()
  pb.push_circle(f(0x3F000000U), f(0x3F000000U), f(0x3C23D70AU))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 3f028f5c,3f000000 Q 3f028f5b,3f010f75 3f01cf68,3f01cf68 Q 3f010f75,3f028f5b 3f000000,3f028f5c Q 3efde114,3f028f5b 3efc612e,3f01cf68 Q 3efae147,3f010f75 3efae148,3f000000 Q 3efae147,3efde114 3efc612e,3efc612e Q 3efde114,3efae148 3f000000,3efae148 Q 3f010f75,3efae148 3f01cf68,3efc612e Q 3f028f5b,3efde114 3f028f5c,3f000000 Z | b 3efae147,3efae148,3f028f5c,3f028f5c",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "3efae148,3efae148,3f028f5c,3f028f5c",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 4126a3d7,c0763540 Q 412697f7,c075ad85 41267d92,c0755bf1 Q 4126632d,c0750a5d 412649ba,c0751eb8 Q 41263047,c0753315 412626ae,c075a174 Q 41261d15,c0760fd3 412628f6,c076978d Q 412634d6,c0771f48 41264f3b,c07770dc Q 4126699f,c077c270 41268312,c077ae14 Q 41269c85,c07799b8 4126a61e,c0772b5a Q 4126afb7,c076bcfa 4126a3d7,c0763540 Z | b 41261d15,c077c270,4126afb7,c0750a5d",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41262264,c077b225,4126aa68,c0751aa7",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 3e1f21d2,3f327539 Q 3e1cd26c,3f3358e2 3e18ac52,3f339152 Q 3e148638,3f33c9c3 3e10f790,3f3335ec Q 3e0d68e8,3f32a212 3e0c8726,3f31988b Q 3e0ba562,3f308f04 3e0df4c6,3f2fab5b Q 3e104428,3f2ec7b0 3e146a44,3f2e8f40 Q 3e18905e,3f2e56d0 3e1c1f08,3f2eeaa8 Q 3e1fadae,3f2f7e81 3e208f70,3f308808 Q 3e217132,3f31918e 3e1f21d2,3f327539 Z | b 3e0ba562,3f2e56d0,3e217132,3f33c9c3",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "3e0c48c6,3f2e7fa8,3e20cdcf,3f33a0ea",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 4088a3d7,c0e80000 Q 4088a3d7,c0e7ef09 408873da,c0e7e30a Q 408843dd,c0e7d70a 40880000,c0e7d70a Q 4087bc22,c0e7d70a 40878c26,c0e7e30a Q 40875c29,c0e7ef09 40875c29,c0e80000 Q 40875c29,c0e810f7 40878c26,c0e81cf7 Q 4087bc22,c0e828f6 40880000,c0e828f6 Q 408843dd,c0e828f6 408873da,c0e81cf7 Q 4088a3d7,c0e810f7 4088a3d7,c0e80000 Z | b 40875c29,c0e828f6,4088a3d7,c0e7d70a",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40875c29,c0e828f6,4088a3d7,c0e7d70a",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#691 8590d7ba22b2cd96 M 3f8147ae,3f000079 Q 3f814795,3f36149b 3f5c51e2,3f5c51e2 Q 3f36149b,3f814795 3f000079,3f8147ae Q 3e",
