    dg(dpath(path)),
    "M 43229480,43073c6c L 432a54a4,c22bd7cf C c1800000,42be0000 c174cccd,42bd0000 c1675c29,42bc0000 L 41880000,42b20000 | b c1800000,c22bd7cf,432a54a4,43073c6c",
