        .stroke(stroke_of(f(0x40200000U), f(0x40800000U), 2, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c24cc4b0,c236b155,4305ce24,433dd921",
  )
}

