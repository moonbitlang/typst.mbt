///|
test "188 random 131" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x429F1E7EU), f(0xC21E3B1DU))
  pb.line_to(f(0x425793ECU), f(0xC24C651FU))
  pb.line_to(f(0x428BD370U), f(0x4291778AU))
  pb.cubic_to(
    f(0x426C0000U),
    f(0x43030000U),
    f(0x41CD1CA8U),
    f(0x431CA42EU),
    f(0x430B256BU),
    f(0xC2C55472U),
  )
  pb.line_to(f(0x430BF06DU), f(0xC2C65472U))
  pb.line_to(f(0x42F65FD8U), f(0x41C785C0U))
  pb.cubic_to(
    f(0x42880000U),
    f(0xC1200000U),
    f(0x428CE37EU),
    f(0x42CE40D0U),
    f(0x430BE1A3U),
    f(0x4291CC3EU),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 429f1e7e,c21e3b1d L 425793ec,c24c651f L 428bd370,4291778a C 426c0000,43030000 41cd1ca8,431ca42e 430b256b,c2c55472 L 430bf06d,c2c65472 L 42f65fd8,41c785c0 C 42880000,c1200000 428ce37e,42ce40d0 430be1a3,4291cc3e | b 41cd1ca8,c2c65472,430bf06d,431ca42e",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "425793ec,c2c65472,430bf06d,42dedd2c",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3DCCCCCDU), f(0x40000000U), 2, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1441 97c552a457b3ef28 M 429f13fe,c21e0c6b L 42577eec,c24c366d L 425793ec,c24c651f L 4257c6b3,c24c6bb0 L 428bed58,42917845 ",
  )
  assert_eq(
    dg(
      drect(
