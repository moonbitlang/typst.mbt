        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c28784d1,bf10654a,4236c0aa,42ea516d",
  )
}

///|
test "206 random 149" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x3F641894U), f(0xBF000000U))
  pb.quad_to(f(0x42E80000U), f(0x42600000U), f(0x42E80000U), f(0x42600000U))
  pb.quad_to(f(0x42E8178DU), f(0x425E0000U), f(0x431C337CU), f(0x41D5B728U))
  pb.quad_to(f(0x43462AE0U), f(0xC107A2E8U), f(0xC28B2E02U), f(0x41FB18F0U))
  pb.quad_to(f(0x42BB57ECU), f(0x43402A6CU), f(0x42780000U), f(0x422C0000U))
  pb.line_to(f(0xC1880000U), f(0x42C60000U))
  pb.close()
  pb.line_to(f(0x4336E2FEU), f(0x432FB45AU))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 3f641894,bf000000 Q 42e80000,42600000 42e80000,42600000 Q 42e8178d,425e0000 431c337c,41d5b728 Q 43462ae0,c107a2e8 c28b2e02,41fb18f0 Q 42bb57ec,43402a6c 42780000,422c0000 L c1880000,42c60000 Z M 3f641894,bf000000 L 4336e2fe,432fb45a | b c28b2e02,c107a2e8,43462ae0,43402a6c",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c28b2e02,bf000000,4336e2fe,432fb45a",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41700000U), f(0x3F99999AU), 2, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1693 0d51d2348e96f5fb M 408642ec,c0e77239 L 42ee9bfe,424511b9 L 42e80000,42600000 L 42d91026,425d4073 Q 42d9b1fa,424f8250 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41700000U), f(0x3F99999AU), 2, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c295b46a,c131aef7,43417ded,433a4f49",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x42700000U), f(0x3F000000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1997 aaaef3b59d85cb87 M 4161c13d,c1db7239 L 430137fb,41e88dc7 L 42e80000,42600000 L 42ac4096,425501ca Q 42ae9b3c,4221d412 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x42700000U), f(0x3F000000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c2b547a0,c1db7239,434bc113,43454202",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x41F00000U), 0, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1273 04d136c5ab86aa8a M 3f8e3f73,bf72e796 L 42e870cd,425e3462 L 42e80000,42600000 L 42e70114,425fd119 Q 42e7235a,425ce81e ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x41F00000U), 0, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c28d4f3e,bf9ed74a,43373c07,43301050",
  )
}

