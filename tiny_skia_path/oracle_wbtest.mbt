///|
test "40 teeny line" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x40A00000U), f(0x40A00000U))
  pb.line_to(f(0x40A00015U), f(0x40A00000U))
  pb.line_to(f(0x42200000U), f(0x40A00000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 40a00000,40a00000 L 40a00015,40a00000 L 42200000,40a00000 | b 40a00000,40a00000,42200000,40a00000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "40a00000,40a00000,42200000,40a00000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41600000,40d00000 L 41600010,40d00006 L 42850000,41880000 | b 41600000,40d00000,42850000,41880000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41600000,40d00000,42850000,41880000",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 3fbc2e1e,40dd545c L 3fbc2e66,40dd5468 L 41f696c9,41cfd4d2 | b 3fbc2e1e,40dd545c,41f696c9,41cfd4d2",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "3fbc2e1e,40dd545c,41f696c9,41cfd4d2",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41540000,c0a00000 L 41540015,c0a00000 L 42a68000,c0a00000 | b 41540000,c0a00000,42a68000,c0a00000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41540000,c0a00000,42a68000,c0a00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 40a00000,40900000 L 42200000,40900000 L 42200000,40b00000 L 40a00000,40b00000 L 40a00000,40900000 Z | b 40a00000,40900000,42200000,40b00000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "40a00000,40900000,42200000,40b00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#445 83d4239d32eef3eb M 40a00000,00000000 L 40a00015,00000000 L 42200000,00000000 Q 422848c6,00000000 422e2463,3fbb739f Q ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41200000U), f(0x40800000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,00000000,42340000,41200000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 40a00000,40000000 L 40a00015,40000000 L 40a00015,40a00000 L 40a00015,40000000 L 422c0000,40000000 L 422c0000,41000000 L 40a00015,41000000 L 40a00015,41000000 L 40000000,41000000 L 40000000,40000000 Z | b 40000000,40000000,422c0000,41000000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "40000000,40000000,422c0000,41000000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x41200000U), 0, 1),
          f(0x3F800000U),
        ),
      ),
