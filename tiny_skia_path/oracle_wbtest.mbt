///|
test "148 random 91" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x432475C8U), f(0x432C6AD2U))
  pb.quad_to(f(0x429E0000U), f(0xC1A80000U), f(0x430C0000U), f(0xC1D00000U))
  pb.quad_to(f(0xC290AA88U), f(0x40CD1670U), f(0xC290AA7BU), f(0x40CD1670U))
  pb.line_to(f(0x431EF824U), f(0xC234626DU))
  pb.cubic_to(
    f(0x431FD5D6U),
    f(0xC236626DU),
    f(0x431FD5DDU),
    f(0xC236626DU),
    f(0x42235584U),
    f(0x4342343CU),
  )
  pb.cubic_to(
    f(0x42B49242U),
    f(0x430BC043U),
    f(0x4316F792U),
    f(0xC24AC08BU),
    f(0xC1F00000U),
    f(0x43090000U),
  )
  pb.quad_to(f(0x42BC0000U), f(0x430D0000U), f(0xC255176FU), f(0x432DB6E6U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 432475c8,432c6ad2 Q 429e0000,c1a80000 430c0000,c1d00000 Q c290aa88,40cd1670 c290aa7b,40cd1670 L 431ef824,c234626d C 431fd5d6,c236626d 431fd5dd,c236626d 42235584,4342343c C 42b49242,430bc043 4316f792,c24ac08b c1f00000,43090000 Q 42bc0000,430d0000 c255176f,432db6e6 | b c290aa88,c24ac08b,432475c8,4342343c",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c290aa7c,c2348e2a,432475c8,4342343c",
  )
  assert_eq(
    dg(
      dpath(
