test "100 random 43" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x42740000U), f(0xC2140000U))
  pb.cubic_to(
    f(0x42CA6810U),
    f(0x428A37AAU),
    f(0x42CA681DU),
    f(0x428A37AAU),
    f(0xC1D6BFA4U),
    f(0x4324E0F4U),
  )
  pb.close()
  pb.line_to(f(0xC1D6BFA4U), f(0x4324E0F4U))
  pb.cubic_to(
    f(0xC23FFC53U),
    f(0x430DDA14U),
    f(0x42D3D7F4U),
    f(0xC2C0F2BBU),
    f(0xC25C7517U),
    f(0xC1AEB918U),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 42740000,c2140000 C 42ca6810,428a37aa 42ca681d,428a37aa c1d6bfa4,4324e0f4 Z M 42740000,c2140000 L c1d6bfa4,4324e0f4 C c23ffc53,430dda14 42d3d7f4,c2c0f2bb c25c7517,c1aeb918 | b c25c7517,c2c0f2bb,42d3d7f4,4324e0f4",
  )
