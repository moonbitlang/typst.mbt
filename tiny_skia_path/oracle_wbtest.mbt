///|
test "31 cubic collinear" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.cubic_to(
    f(0xC1200000U),
    f(0x00000000U),
    f(0x42F00000U),
    f(0x00000000U),
    f(0x42C80000U),
    f(0x00000000U),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 C c1200000,00000000 42f00000,00000000 42c80000,00000000 | b c1200000,00000000,42f00000,00000000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "bf0cba46,00000000,42cc30e5,00000000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 C c0a00000,c1000000 433e0000,41f80000 43200000,41c80001 | b c0a00000,c1000000,433e0000,41f80000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "4112ce89,c0a546fc,432324ac,41cd077b",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 C c1062ff2,c0ae48d5 42c947eb,4282b6a0 42a7bbef,4259db0a | b c1062ff2,c0ae48d5,42c947eb,4282b6a0",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "beec0c58,be994aa2,42ab3fc0,425e6bb8",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 C c1860000,c0f00000 43734000,c0f00000 434b4000,c0f00000 | b c1860000,c0f00000,43734000,c0f00000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
