///|
test "168 random 111" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.cubic_to(
    f(0x42E792A8U),
    f(0x42DCB5D8U),
    f(0xC22B76B8U),
    f(0x4307C42CU),
    f(0xC23921C1U),
    f(0x43101C00U),
  )
  pb.quad_to(f(0x431C7AE4U), f(0xBFD1C100U), f(0xC2C742D1U), f(0x42E43FC0U))
  pb.cubic_to(
    f(0xC2C687F0U),
    f(0x42E33FC0U),
    f(0x42640000U),
    f(0xC2180000U),
    f(0x4264001AU),
    f(0xC2180000U),
  )
  pb.line_to(f(0x4264001AU), f(0xC2180000U))
  pb.quad_to(f(0x4199A4C0U), f(0xC2105830U), f(0x4199A4F4U), f(0xC2105830U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 C 42e792a8,42dcb5d8 c22b76b8,4307c42c c23921c1,43101c00 Q 431c7ae4,bfd1c100 c2c742d1,42e43fc0 C c2c687f0,42e33fc0 42640000,c2180000 4264001a,c2180000 L 4264001a,c2180000 Q 4199a4c0,c2105830 4199a4f4,c2105830 | b c2c742d1,c2180000,431c7ae4,43101c00",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c2c742d1,c2180000,4264001a,43101c00",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40E00000U), f(0x3F000000U), 2, 2),
          f(0x3F800000U),
        ),
      ),
