  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 40a00000,3f800000 L 40a00015,3f800000 L 42300000,3f800000 L 42300000,41100000 L 40a00015,41100000 L 3f800000,41100000 L 3f800000,3f800000 Z | b 3f800000,3f800000,42300000,41100000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "3f800000,3f800000,42300000,41100000",
  )
  assert_eq(
    dg(
