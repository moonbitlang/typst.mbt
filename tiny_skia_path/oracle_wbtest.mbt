  assert_eq(dg(hx(fmin(f(0x7F800000U), f(0x00000000U)))), "00000000")
  assert_eq(dg(hx(fmax(f(0x7F800000U), f(0x00000000U)))), "7f800000")
  assert_eq(dg(hx(fmin(f(0x7F800000U), f(0x80000000U)))), "80000000")
  assert_eq(dg(hx(fmax(f(0x7F800000U), f(0x80000000U)))), "7f800000")
  assert_eq(dg(hx(fmin(f(0x7F800000U), f(0x3F800000U)))), "3f800000")
  assert_eq(dg(hx(fmax(f(0x7F800000U), f(0x3F800000U)))), "7f800000")
  assert_eq(dg(hx(fmin(f(0x7F800000U), f(0xBF800000U)))), "bf800000")
  assert_eq(dg(hx(fmax(f(0x7F800000U), f(0xBF800000U)))), "7f800000")
  assert_eq(dg(hx(fmin(f(0x7F800000U), f(0x3F000000U)))), "3f000000")
  assert_eq(dg(hx(fmax(f(0x7F800000U), f(0x3F000000U)))), "7f800000")
  assert_eq(dg(hx(fmin(f(0x7F800000U), f(0xBF000000U)))), "bf000000")
  assert_eq(dg(hx(fmax(f(0x7F800000U), f(0xBF000000U)))), "7f800000")
  assert_eq(dg(hx(round_f32(f(0x7F800000U)))), "7f800000")
  assert_eq(dg(f32_as_u32(f(0x7F800000U)).to_string()), "4294967295")
  assert_eq(dg(f32_as_i32(f(0x7F800000U)).to_string()), "2147483647")
  assert_eq(
    dg(hx(NormalizedF32::new_clamped(f(0x7F800000U)).get())),
    "00000000",
  )
  assert_eq(dg(hx(fmin(f(0xFF800000U), f(0x00000000U)))), "ff800000")
  assert_eq(dg(hx(fmax(f(0xFF800000U), f(0x00000000U)))), "00000000")
  assert_eq(dg(hx(fmin(f(0xFF800000U), f(0x80000000U)))), "ff800000")
  assert_eq(dg(hx(fmax(f(0xFF800000U), f(0x80000000U)))), "80000000")
  assert_eq(dg(hx(fmin(f(0xFF800000U), f(0x3F800000U)))), "ff800000")
  assert_eq(dg(hx(fmax(f(0xFF800000U), f(0x3F800000U)))), "3f800000")
  assert_eq(dg(hx(fmin(f(0xFF800000U), f(0xBF800000U)))), "ff800000")
  assert_eq(dg(hx(fmax(f(0xFF800000U), f(0xBF800000U)))), "bf800000")
  assert_eq(dg(hx(fmin(f(0xFF800000U), f(0x3F000000U)))), "ff800000")
  assert_eq(dg(hx(fmax(f(0xFF800000U), f(0x3F000000U)))), "3f000000")
  assert_eq(dg(hx(fmin(f(0xFF800000U), f(0xBF000000U)))), "ff800000")
  assert_eq(dg(hx(fmax(f(0xFF800000U), f(0xBF000000U)))), "bf000000")
  assert_eq(dg(hx(round_f32(f(0xFF800000U)))), "ff800000")
  assert_eq(dg(f32_as_u32(f(0xFF800000U)).to_string()), "0")
  assert_eq(dg(f32_as_i32(f(0xFF800000U)).to_string()), "-2147483648")
  assert_eq(
    dg(hx(NormalizedF32::new_clamped(f(0xFF800000U)).get())),
    "00000000",
  )
  assert_eq(dg(hx(fmin(f(0x4F32D05EU), f(0x00000000U)))), "00000000")
  assert_eq(dg(hx(fmax(f(0x4F32D05EU), f(0x00000000U)))), "4f32d05e")
  assert_eq(dg(hx(fmin(f(0x4F32D05EU), f(0x80000000U)))), "80000000")
  assert_eq(dg(hx(fmax(f(0x4F32D05EU), f(0x80000000U)))), "4f32d05e")
