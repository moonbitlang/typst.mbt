///|
test "1 constants" {
  assert_eq(dg(hx(scalar_max)), "7f7fffff")
  assert_eq(dg(hx(scalar_nearly_zero)), "39800000")
  assert_eq(dg(hx(scalar_root_2_over_2)), "3f3504f3")
  assert_eq(dg(hx(float_pi)), "40490fdb")
  assert_eq(dg(hx(f32_1e_8)), "322bcc77")
  assert_eq(dg(hx(curvature_slop)), "36a7c5ac")
  assert_eq(dg(hx(cubic_line_slop)), "3727c5ac")
  assert_eq(dg(hx((0.3333333 : Float))), "3eaaaaaa")
  assert_eq(dg(hx(float_pi / 180.0)), "3c8efa35")
  assert_eq(dg(hx((1.0 : Float) / 3.0)), "3eaaaaab")
  assert_eq(dg(hx((2.0 : Float) / 3.0)), "3f2aaaab")
}

