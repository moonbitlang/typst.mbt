///|
test "47 single move" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x41F00000U), f(0x41A00000U))
  let path = pb.finish()
  assert_eq(dg(dpath(path)), "None")
}

///|
test "48 small curves" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x3A83126FU), f(0x3B03126FU))
  pb.cubic_to(
    f(0x3B449BA6U),
    f(0x3A83126FU),
    f(0x3B83126FU),
    f(0x3BA3D70AU),
    f(0x3B03126FU),
    f(0x3BC49BA6U),
  )
  pb.quad_to(f(0x00000000U), f(0x3B83126FU), f(0x3A83126FU), f(0x3A83126FU))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 3a83126f,3b03126f C 3b449ba6,3a83126f 3b83126f,3ba3d70a 3b03126f,3bc49ba6 Q 00000000,3b83126f 3a83126f,3a83126f | b 00000000,3a83126f,3b83126f,3bc49ba6",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "3a2ec33e,3a83126f,3b4a8472,3bc49ba6",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200069,c09fdcc6 C 41200f91,c09fe83e 41200a3d,c09fa440 411ffb16,c09f98c8 Q 411ff488,c09fbe77 41200347,c09fed29 | b 411ff488,c09fed29,41200f91,c09f98c8",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "411ff912,c09fed29,41200975,c09f98c8",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M b98363fa,3b119ea4 C 3b013225,3b220b24 3a258a64,3bd0cb72 bad07819,3bc89533 Q bb0ec61c,3b5bda3b 399a283e,3ab5502c | b bb0ec61c,3ab5502c,3b013225,3bd0cb72",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "badf475c,3ab5502c,3a6920b1,3bc8f64b",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 405020c5,c0eff7cf C 4050624e,c0effbe7 40508312,c0efeb85 40504189,c0efe76d Q 40500000,c0efef9e 405020c5,c0effbe7 | b 40500000,c0effbe7,40508312,c0efe76d",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "405015d9,c0effbe7,40506542,c0efe76d",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#485 7de0cc15acbdd620 M be63f30b,bee3f309 Q 3d4cae86,bf14dd5a 3e97bd6d,becdfaff Q 3ee33a9a,be971453 3ef9e479,bdf1b352 Q 3f",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "bf00fda5,bf010c0b,3f024a33,3f1d4806",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#785 9956d0e670459f61 M c00f0b5c,c08f0b5b Q 3ef7fae4,c0ba8e09 403c5c65,c08154f0 Q 408d366a,c03e40d6 409b519d,bf9ace8b Q 40",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41200000U), f(0x40800000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0a1c366,c0a1d68e,40a1f68d,40a1f4aa",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "#545 d071bcbf51486519 M bfab9a1f,c02b9a1d Q 3e952354,c05fd2db 3fe22661,c01b2535 Q 402986d5,bfe42dd9 403a7599,bf396f74 Q 40",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
