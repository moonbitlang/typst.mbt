///|
test "67 random 10" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.line_to(f(0x38D1B717U), f(0x00000000U))
  pb.quad_to(f(0x42B20000U), f(0xC1300000U), f(0x426C0000U), f(0xC1B80000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 L 38d1b717,00000000 Q 42b20000,c1300000 426c0000,c1b80000 | b 00000000,c1b80000,42b20000,00000000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "00000000,c1b80000,42852046,00000000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 L 4120009d,c09fffc1 Q 43173333,be999980 42e53333,c2053333 | b 41200000,c2053333,43173333,be999980",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41200000,c2053333,42f444a8,c08d3fc7",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 L 38afe1c8,3864702c Q 42a143f2,421cfd70 42780876,414d822e | b 00000000,00000000,42a143f2,421cfd70",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "00000000,00000000,4283017f,41bbb45a",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 L 40500347,c0f00000 Q 43354000,c1500000 42f28000,c1980000 | b 40500000,c1980000,43354000,c0f00000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40500000,c1980000,43086046,c0f00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3DCCCCCDU), f(0x40000000U), 0, 2),
          f(0x3DCCCCCDU),
        ),
      ),
    ),
    "M bbc8f83e,bd4b40e3 Q 4231f406,c0b190e0 426ced67,c134bed0 Q 42852600,c1628b00 42850668,c1887dd2 Q 4284e6c0,c19fba00 426becfc,c1b7a0ed L 426c1304,c1b85f13 Q 42851960,c1a045c0 42853998,c188822e Q 42855a00,c1617580 426d1299,c1334130 Q 42320d47,c0ae7070 3bc8f83e,3d4b40e3 L bbc8f83e,bd4b40e3 Z | b bbc8f83e,c1b85f13,42855a00,3d4b40e3",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3DCCCCCDU), f(0x40000000U), 0, 2), f(0x3DCCCCCDU))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "bbc8f83e,c1b85f13,428539de,3d4b40e3",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41700000U), f(0x41F00000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#505 90a21465de21c457 M 00000000,c0f00000 L 38d1b717,c0f00000 L 38d1b717,00000000 L bf6b7c6d,c0ee3009 Q 422a9925,c14d40f0 ",
  )
  assert_eq(
