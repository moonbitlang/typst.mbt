///|
test "157 random 100" {
  let pb = PathBuilder::new()
  pb.move_to(f(0xC2C5F589U), f(0x42C9F3AEU))
  pb.line_to(f(0x432BF6BCU), f(0x423D099CU))
  pb.line_to(f(0x41DFD45CU), f(0x40645720U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M c2c5f589,42c9f3ae L 432bf6bc,423d099c L 41dfd45c,40645720 | b c2c5f589,40645720,432bf6bc,42c9f3ae",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c2c5f589,40645720,432bf6bc,42c9f3ae",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M c351270a,4327420d L 436add38,430d1ba0 L 4245e1dc,412877c8 | b c351270a,412877c8,436add38,4327420d",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c351270a,412877c8,436add38,4327420d",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
