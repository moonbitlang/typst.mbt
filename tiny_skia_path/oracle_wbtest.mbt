///|
test "16 circle" {
  let pb = PathBuilder::new()
  pb.push_circle(f(0x42480000U), f(0x42480000U), f(0x42200000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "#669 c97588625f7ec2f3 M 42b40000,42480000 Q 42b40000,4267d372 42ade90d,42829d5a Q 42a7d21b,429150fc 429c918c,429c918c Q 42",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "41200000,41200000,42b40000,42b40000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "#669 71bef3b327d8d4bb M 42dc0000,42f40000 Q 42d0dc65,4309e9b9 42bd6f6e,4317b382 Q 42aa0278,43257d4d 4291413d,432f0dc8 Q 42",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c181b5c9,41e8bb63,42e86d71,433ee893",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "#669 13dcd85e6afb1b0d M 4240fe5b,42b5e6ef Q 422fa8f0,42c33f72 42156e6b,42cc42d3 Q 41f667c4,42d54636 41b824f4,42d89531 Q 41",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c1ca7275,41e9439c,425ad60e,42da588b",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "#669 a9653adf03180eb9 M 43374000,418c0000 Q 43374000,41abd372 4331290d,41c93ab4 Q 432b121b,41e6a1f8 431fd18c,41fd2318 Q 43",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41ba0000,c0200000,43374000,42160000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1299 a5fbbcce4a5dce9c M 42b50000,42480000 Q 42b50000,42683970 42aed590,4282ff52 Q 42a8ab10,4291e210 429d4691,429d4691 Q 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "41180000,41180000,42b50000,42b50000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1299 9718e5d1e6756f3a M 42be0000,42480000 Q 42be0000,426bcddf 42b7262e,42867106 Q 42b04c5f,4296fb1a 42a3a3be,42a3a3bd Q 42",
  )
  assert_eq(
    dg(
