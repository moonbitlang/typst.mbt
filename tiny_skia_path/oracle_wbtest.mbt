///|
test "29 cubic degenerate ab" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x41200000U), f(0x41200000U))
  pb.cubic_to(
    f(0x41200000U),
    f(0x41200000U),
    f(0x42480000U),
    f(0x42B40000U),
    f(0x42B40000U),
    f(0x41200000U),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 41200000,41200000 C 41200000,41200000 42480000,42b40000 42b40000,41200000 | b 41200000,41200000,42b40000,42b40000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "41200000,41200000,42b40000,423638e4",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41900000,41900000 C 41900000,41900000 41b00000,433e0000 430a0000,42280000 | b 41900000,41900000,430a0000,433e0000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41900000,41900000,430a0000,42cc2b2f",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 403c2e1e,415d545c C 403c2e1e,415d545c c0e2b000,42cd6cb2 428c1163,42659dec | b c0e2b000,415d545c,428c1163,42cd6cb2",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "4020de01,415d545c,428c1163,428c8c24",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41ba0000,c0200000 C 41ba0000,c0200000 42ce8000,42160000 43374000,c0200000 | b 41ba0000,c0200000,43374000,42160000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41ba0000,c0200000,43374000,417471c8",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#405 9af9f9761d665f68 M 412727c9,411c6c1b Q 414ee468,416be550 418a46e5,41a7b4c6 Q 41cfd840,42058b50 420d1c02,421e55fe Q 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "4118d837,411c6c1b,42b4e4f9,42384903",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#669 64b9b4f13525c20f M 41678dde,40f87222 Q 4186758d,4146f388 41a7c4f0,41930fbf Q 41e973b8,41f0e4dc 42171811,420f5be7 Q 42",
  )
