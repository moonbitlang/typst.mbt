///|
test "107 random 50" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x430AF891U), f(0x42E56ED6U))
  pb.close()
  pb.quad_to(f(0x4313F40BU), f(0xC2444631U), f(0x433658BEU), f(0x431D37FCU))
  pb.move_to(f(0x42FFC094U), f(0x4331F3D0U))
  pb.close()
  pb.line_to(f(0x432F65C0U), f(0x42994604U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 430af891,42e56ed6 Z M 430af891,42e56ed6 Q 4313f40b,c2444631 433658be,431d37fc M 42ffc094,4331f3d0 Z M 42ffc094,4331f3d0 L 432f65c0,42994604 | b 42ffc094,c2444631,433658be,4331f3d0",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "42ffc094,4228eab2,433658be,4331f3d0",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 430a27a9,43850fe7 Z M 430a27a9,43850fe7 Q 43852393,c26b0121 432d7786,43b61219 M 429a7ebb,43c2a242 Z M 429a7ebb,43c2a242 L 435b7352,4348e48a | b 429a7ebb,c26b0121,43852393,43c2a242",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "429a7ebb,42f9f52c,435b7352,43c2a242",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
