    "#9523 d54a18898d4ab7d3 M 413cf2b3,429a7c9f Q 417e29ac,4293f73c 419fb224,428e158c Q 41a26221,428d9979 41a5a78a,428dbb5d Q 41",
  )
  let d = StrokeDash::new([f(0x00000000U), f(0x40800000U)], f(0x00000000U)).unwrap()
