        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "40a00000,40a00000,42be0000,42be0000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
