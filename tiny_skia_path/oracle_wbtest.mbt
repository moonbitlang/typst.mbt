  )
}

///|
test "27 cubic loop" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.cubic_to(
    f(0x42F00000U),
    f(0x42C80000U),
    f(0xC1A00000U),
    f(0x42C80000U),
    f(0x42C80000U),
    f(0x00000000U),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 C 42f00000,42c80000 c1a00000,42c80000 42c80000,00000000 | b c1a00000,00000000,42f00000,42c80000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "00000000,00000000,42c80000,42960000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 C 42f00000,43670000 c2b40000,433d0000 43200000,41c80001 | b c2b40000,c0a00000,43200000,43670000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41200000,c0a00000,43200000,4320089f",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 C 4238b4cc,43153948 c28e7982,4291f2d4 42a7bbef,4259db0a | b c28e7982,00000000,42a7bbef,43153948",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "00000000,00000000,42a7bbef,42b4c6f0",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 C 43734000,422a0000 c2130000,422a0000 434b4000,c0f00000 | b c2130000,c0f00000,43734000,422a0000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40500000,c0f00000,434b4000,41f00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#557 d95de8c257901e66 M 3ea3e320,bec4aa26 Q 421ba283,41fe2f3e 424752e7,42602de5 Q 4256aaa0,42812308 4254ee91,428cb325 Q 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "bea3e320,bec4aa26,42c8a3e3,42970000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
