///|
test "44 multi contour" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.line_to(f(0x42200000U), f(0x00000000U))
  pb.line_to(f(0x42200000U), f(0x42200000U))
  pb.close()
  pb.line_to(f(0xC1A00000U), f(0x41200000U))
  pb.move_to(f(0x42C80000U), f(0x42C80000U))
  pb.quad_to(f(0x43160000U), f(0x42480000U), f(0x43480000U), f(0x42C80000U))
  pb.cubic_to(
    f(0x435C0000U),
    f(0x43160000U),
    f(0x42F00000U),
    f(0x43340000U),
    f(0x42C80000U),
    f(0x42C80000U),
  )
  pb.close()
  pb.move_to(f(0x43960000U), f(0x00000000U))
  pb.line_to(f(0x439B0000U), f(0x40A00000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 L 42200000,00000000 L 42200000,42200000 Z M 00000000,00000000 L c1a00000,41200000 M 42c80000,42c80000 Q 43160000,42480000 43480000,42c80000 C 435c0000,43160000 42f00000,43340000 42c80000,42c80000 Z M 43960000,00000000 L 439b0000,40a00000 | b c1a00000,00000000,439b0000,43340000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c1a00000,00000000,439b0000,431561fa",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 L 428c0000,40e00000 L 42280000,42ae0000 Z M 41200000,c0a00000 L c1d80000,41100000 M 42b40000,43610000 Q 43480000,430c0000 43700000,437f0000 C 436b0000,43b48000 42800000,43c38000 42b40000,43610000 Z M 43e60000,42aa0000 L 43ebc000,42c40000 | b c1d80000,c0a00000,43ebc000,43c38000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c1d80000,c0a00000,43ebc000,43ab0000",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 L 42062ff2,41ae48d5 L 413c2e1e,425d545c Z M 00000000,00000000 L c1b1c227,c020638c M 41eb39a8,430a54ba Q 42c52324,42f7423e 42e28a59,4340cb7c C 42cd9f93,43759f06 4026bf80,43585140 41eb39a8,430a54ba Z M 437b99e6,43236447 L 4380a1e1,432d080e | b c1b1c227,c020638c,4380a1e1,43759f06",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c1b1c227,c020638c,4380a1e1,435b8465",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 L 42a68000,c0f00000 L 42a68000,41480000 Z M 40500000,c0f00000 L c2130000,c0200000 M 434b4000,422a0000 Q 4397a000,418c0000 43c9a000,422a0000 C 43dda000,42870000 43734000,42a50000 434b4000,422a0000 Z M 4416d000,c0f00000 L 441bd000,c0a00000 | b c2130000,c0f00000,441bd000,42a50000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c2130000,c0f00000,441bd000,428661fa",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1187 75e2816b0192a836 M 00000000,bf000000 L 42220000,bf000000 L 42220000,4224d414 L bf9a827b,bf000001 Z M 00000000,3f00000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
