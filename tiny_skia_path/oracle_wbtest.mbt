    dg(dpath(path.dash(d, f(0x3E800000U)))),
    "#1253 66458e7ac0940dac M 4146f15a,429c0c70 Q 4183ec78,42958efc 41a46044,428fb4ca M 41c4d40e,428a0369 Q 41e5d7eb,42846248 42",
  )
