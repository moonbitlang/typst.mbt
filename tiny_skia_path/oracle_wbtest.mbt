    "#1935 0b3b73e6c1c0b730 M c2493c41,430d9393 Q 42796700,41e60800 42d430dd,4220bfbb Q 431647e0,424ef220 42f804c5,433bb569 L 42",
  )
  assert_eq(
    dg(
      drect(
