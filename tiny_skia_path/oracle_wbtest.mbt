    "M 42880000,42180000 Q 4288cbc7,42160000 4288cbd4,42160000 L 4288cbe1,42160000 C 4288cbe1,42160000 c2183972,c2a66ff8 433a2f46,434058c6 M 433de7c6,c21ea04d C 433de7cd,c21ea04d 42ed30ea,4333b114 42ed30f7,4333b114 M 42920000,41200000 Z | b c2183972,c2a66ff8,433de7cd,434058c6",
