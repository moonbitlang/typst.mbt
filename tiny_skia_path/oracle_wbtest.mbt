    "#7225 8f6837770b8b0701 M 00000000,bf800000 L 40a00000,bf800000 Q 40ad413c,bf7fffff 40b6a09d,bf3504f3 Q 40bfffff,bed413cc 40",
  )
  let d = StrokeDash::new(
