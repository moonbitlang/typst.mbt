///|
test "30 cubic degenerate cd" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x41200000U), f(0x41200000U))
  pb.cubic_to(
    f(0x42480000U),
    f(0x42B40000U),
    f(0x42B40000U),
    f(0x41200000U),
    f(0x42B40000U),
    f(0x41200000U),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 41200000,41200000 C 42480000,42b40000 42b40000,41200000 42b40000,41200000 | b 41200000,41200000,42b40000,42b40000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "41200000,41200000,42b40000,423638e3",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41900000,41900000 C 41b00000,433e0000 430a0000,42280000 430a0000,42280000 | b 41900000,41900000,430a0000,433e0000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41900000,41900000,430a0000,42ca689d",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 403c2e1e,415d545c C c0e2b000,42cd6cb2 428c1163,42659dec 428c1163,42659dec | b c0e2b000,415d545c,428c1163,42cd6cb2",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "4002a586,415d545c,428c1163,4289e72c",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41ba0000,c0200000 C 42ce8000,42160000 43374000,c0200000 43374000,c0200000 | b 41ba0000,c0200000,43374000,42160000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41ba0000,c0200000,43374000,417471c6",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#405 668589eb3cc9a97d M 412727c9,411c6c1b Q 41c0e5c0,42146cf0 421e3e27,422d249f Q 424f4420,4240c0a0 428171ff,421e55fe Q 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "4118d837,411c6c1b,42b4e4f9,423848f4",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#669 cd7218361cf3f292 M 41678dde,40f87222 Q 41daf9d8,4206412a 4224ed85,421c6e33 Q 424d28e0,422c85f1 4278e7ef,420f5be7 Q 42",
