///|
test "51 star" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x42480000U), f(0x00000000U))
  pb.line_to(f(0x42740000U), f(0x420C0000U))
  pb.line_to(f(0x42C40000U), f(0x420C0000U))
  pb.line_to(f(0x42880000U), f(0x42640000U))
  pb.line_to(f(0x429E0000U), f(0x42B60000U))
  pb.line_to(f(0x42480000U), f(0x428C0000U))
  pb.line_to(f(0x41A80000U), f(0x42B60000U))
  pb.line_to(f(0x42000000U), f(0x42640000U))
  pb.line_to(f(0x40000000U), f(0x420C0000U))
  pb.line_to(f(0x421C0000U), f(0x420C0000U))
  pb.close()
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 42480000,00000000 L 42740000,420c0000 L 42c40000,420c0000 L 42880000,42640000 L 429e0000,42b60000 L 42480000,428c0000 L 41a80000,42b60000 L 42000000,42640000 L 40000000,420c0000 L 421c0000,420c0000 Z | b 40000000,00000000,42c40000,42b60000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "40000000,00000000,42c40000,42b60000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 42aa0000,41200001 L 429a0000,42a6999a L 43048000,42bccccd L 42903334,43016666 L 4281999a,4348b333 L 42100000,43160000 L c1b1999a,43374ccd L 4190ccce,42ed3333 L c1380000,42833333 L 42300000,42996666 Z | b c1b1999a,41200001,43048000,4348b333",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c1b1999a,41200001,43048000,4348b333",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 4227bbef,41d9db0a L 420062db,427a4e49 L 427c8267,42a574c9 L 41cfe1a2,42a9adea L 41858ae6,42eeb0e6 L 4073c350,42abe0b6 L c1ff99bf,42af834c L c0869f7c,42827721 L c18b1488,41f38abf L 415a5524,424a60a8 Z | b c1ff99bf,41d9db0a,427c8267,42eeb0e6",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c1ff99bf,41d9db0a,427c8267,42eeb0e6",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 42ce8000,c0f00000 L 42fa8000,41200000 L 43474000,41200000 L 430b4000,41a80000 L 43214000,42180000 L 42ce8000,41dc0000 L 42350000,42180000 L 42868000,41a80000 L 40e80000,41200000 L 42a28000,41200000 Z | b 40e80000,c0f00000,43474000,42180000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40e80000,c0f00000,43474000,42180000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#883 8fe3d77ccc0aa9b7 M 4249e872,be1982df L 4275e872,420b667d L 42740000,420c0000 L 42740000,420a0000 L 42c70dfd,420a0000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "3ef202e8,bfd574ed,42c70dfd,42b89b3b",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
