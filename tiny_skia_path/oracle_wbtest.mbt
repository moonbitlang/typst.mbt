///|
test "205 random 148" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x3F35C290U), f(0xBF000000U))
  pb.cubic_to(
    f(0x425D9F34U),
    f(0x423BB890U),
    f(0xC25B369EU),
    f(0x432FBBEEU),
    f(0xC2876904U),
    f(0x421A18B4U),
  )
  pb.line_to(f(0xC2427C3FU), f(0x42102764U))
  pb.close()
  pb.cubic_to(
    f(0x42317F40U),
    f(0x40A0F7A0U),
    f(0x4101E348U),
    f(0x433DC994U),
    f(0x42367F34U),
    f(0x42A9FFACU),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 3f35c290,bf000000 C 425d9f34,423bb890 c25b369e,432fbbee c2876904,421a18b4 L c2427c3f,42102764 Z M 3f35c290,bf000000 C 42317f40,40a0f7a0 4101e348,433dc994 42367f34,42a9ffac | b c2876904,bf000000,425d9f34,433dc994",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c2876904,bf000000,42367f34,42ea37d5",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x42700000U), f(0x40800000U), 2, 2),
          f(0x40400000U),
        ),
      ),
    ),
    "#2515 acfcaca484aba15d M 41a2ea56,c1b951fe Q 4213c289,c10ca8d8 422b83d5,41449480 Q 423f8bdc,41f07a5a 4231ea67,4247dbbf Q 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x42700000U), f(0x40800000U), 2, 2), f(0x40400000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c2c36a70,c208207d,42a7f553,43131deb",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x42700000U), f(0x40000000U), 1, 3),
          f(0x3DCCCCCDU),
        ),
      ),
    ),
    "#1885 d15cd541ee61237e M 41a2ea56,c1b951fd Q 42510d48,408fe295 4231ea67,4247dbbf Q 42196e09,42ab713c 41464c45,42dc3b46 Q c1",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x42700000U), f(0x40000000U), 1, 3), f(0x3DCCCCCDU))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c2c3258a,c1f408cb,42974027,43146219",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3DCCCCCDU), f(0x40000000U), 2, 0),
          f(0x40400000U),
        ),
      ),
    ),
    "#1661 37a596012e05e7bf M 3f3e2559,bf09aba0 Q 4128b440,40fec560 4160d19b,41a344f9 Q 4189cc80,41fd6100 416f5590,4233a49a Q 41",
  )
  assert_eq(
