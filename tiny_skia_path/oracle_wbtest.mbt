///|
test "77 random 20" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x3F800000U), f(0x42380000U))
  pb.cubic_to(
    f(0xC243B865U),
    f(0xBF6F6E80U),
    f(0x423350F4U),
    f(0x432F153CU),
    f(0x433BD0D6U),
    f(0x43405DFCU),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 3f800000,42380000 C c243b865,bf6f6e80 423350f4,432f153c 433bd0d6,43405dfc | b c243b865,bf6f6e80,433bd0d6,43405dfc",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c148e55d,4218481f,433bd0d6,43405dfc",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M c1a5999a,42ae999a C c27af630,c1ac658c c2354206,43b34eac 431d1110,43da0a1c | b c27af630,c1ac658c,431d1110,43da0a1c",
  )
