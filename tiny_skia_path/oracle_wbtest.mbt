  assert_eq(
    dg(dpath(t)),
    "M 42f68000,418c0000 L 425f70b8,42b0e6bc L 425406c0,42772c1a Q c328bc01,c24cffc1 42a1d058,41cd1814 Z M 42f68000,418c0000 C 439981fe,41d25f0c 439981fe,41d25f0c c31e4e8c,420561aa | b c328bc01,c24cffc1,439981fe,42b0e6bc",
