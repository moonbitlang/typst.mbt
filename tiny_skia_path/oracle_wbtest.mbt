///|
test "52 rounded rect like" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x41200000U), f(0x00000000U))
  pb.line_to(f(0x42B40000U), f(0x00000000U))
  pb.cubic_to(
    f(0x42BF0000U),
    f(0x00000000U),
    f(0x42C80000U),
    f(0x40900000U),
    f(0x42C80000U),
    f(0x41200000U),
  )
  pb.line_to(f(0x42C80000U), f(0x42200000U))
  pb.quad_to(f(0x42C80000U), f(0x42480000U), f(0x42B40000U), f(0x42480000U))
  pb.line_to(f(0x41200000U), f(0x42480000U))
  pb.cubic_to(
    f(0x40900000U),
    f(0x42480000U),
    f(0x00000000U),
    f(0x42360000U),
    f(0x00000000U),
    f(0x42200000U),
  )
  pb.line_to(f(0x00000000U), f(0x41200000U))
  pb.cubic_to(
    f(0x00000000U),
    f(0x40900000U),
    f(0x40900000U),
    f(0x00000000U),
    f(0x41200000U),
    f(0x00000000U),
  )
  pb.close()
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 41200000,00000000 L 42b40000,00000000 C 42bf0000,00000000 42c80000,40900000 42c80000,41200000 L 42c80000,42200000 Q 42c80000,42480000 42b40000,42480000 L 41200000,42480000 C 40900000,42480000 00000000,42360000 00000000,42200000 L 00000000,41200000 C 00000000,40900000 40900000,00000000 41200000,00000000 Z | b 00000000,00000000,42c80000,42480000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "00000000,00000000,42c80000,42480000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41c80000,c0000000 L 43110000,41b00001 C 43194000,41bd3334 431cd99a,42080000 43190000,42340000 L 43040000,42d20000 Q 42fa0000,42fa0000 42dc0000,42f40000 L c1200000,42c40000 C c1920000,42c0b333 c1aecccd,42ac0000 c1900000,42960000 L 40400000,41700000 C 40db3334,40800000 41860000,c069999a 41c80000,c0000000 Z | b c1aecccd,c069999a,431cd99a,42fa0000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c19c5af2,c00e5450,431a8b5e,42f4c859",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41062ff2,40ae48d5 L 4296f5f0,424411ef C 42a02fa3,42500d58 42a2d516,4268f3a2 429cd762,427b6706 L 42785374,42b0057e Q 42628a59,42c0cb7c 4240fe5b,42b5e6ef L c196c311,423d850a C c1bba9da,423189a1 c1c63fa5,4218a357 c1ae48d5,42062ff2 L c0ae48d5,41062ff2 C c01cdb26,40718981 40718981,401cdb26 41062ff2,40ae48d5 Z | b c1c63fa5,401cdb26,42a2d516,42c0cb7c",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c1bb1e20,4075e74a,42a00cb5,42ba30d9",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41ba0000,c0f00000 L 43374000,c0f00000 C 43424000,c0f00000 434b4000,c0a80000 434b4000,c0200000 L 434b4000,41480000 Q 434b4000,418c0000 43374000,418c0000 L 41ba0000,418c0000 C 41440000,418c0000 40500000,41740000 40500000,41480000 L 40500000,c0200000 C 40500000,c0a80000 41440000,c0f00000 41ba0000,c0f00000 Z | b 40500000,c0f00000,434b4000,418c0000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40500000,c0f00000,434b4000,418c0000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#775 0ed4f2e8bef7d062 M 41200000,bf000000 L 42b40000,bf000000 Q 42bcaa08,bf000000 42c2d505,40255f62 Q 42c90000,40b55f58 42",
