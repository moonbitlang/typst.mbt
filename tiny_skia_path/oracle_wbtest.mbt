///|
test "14 rect" {
  let pb = PathBuilder::new()
  if Rect::from_ltrb(
      f(0x41200000U),
      f(0x41A00000U),
      f(0x42DC0000U),
      f(0x428C0000U),
    )
    is Some(r) {
    pb.push_rect(r)
  }
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 41200000,41a00000 L 42dc0000,41a00000 L 42dc0000,428c0000 L 41200000,428c0000 Z | b 41200000,41a00000,42dc0000,428c0000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "41200000,41a00000,42dc0000,428c0000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41300000,42180000 L 43210000,42880000 L 42fc0000,43280000 L c1c00000,430a0000 Z | b c1c00000,42180000,43210000,43280000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c1c00000,42180000,43210000,43280000",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M c020638c,41b1c227 L 42a2b8d2,42995e0f L 42588420,42ed3c06 L c1ede77b,42804e81 Z | b c1ede77b,41b1c227,42a2b8d2,42ed3c06",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c1ede77b,41b1c227,42a2b8d2,42ed3c06",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41ba0000,40200000 L 435f4000,40200000 L 435f4000,41dc0000 L 41ba0000,41dc0000 Z | b 41ba0000,40200000,435f4000,41dc0000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41ba0000,40200000,435f4000,41dc0000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#403 78e0de70e7e36a79 M 41200000,419c0000 L 42dd0000,419c0000 L 42dd0000,428d0000 L 41180000,428d0000 L 41180000,419c0000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "41180000,419c0000,42dd0000,428d0000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#707 7d4816a2e6afd57a M 41200000,41700000 L 42dc0000,41700000 Q 42e02462,41700000 42e31230,4183b739 Q 42e5ffff,418f6e73 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41200000U), f(0x40800000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "40a00000,41700000,42e60000,42960000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "#483 b182fc13119b2bf9 M 41200000,41880000 L 42dc0000,41880000 L 42e20000,41a00000 L 42e20000,428c0000 L 42dc0000,42920000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "40e00000,41880000,42e20000,42920000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x41200000U), 0, 1),
          f(0x3F800000U),
        ),
      ),
    ),
