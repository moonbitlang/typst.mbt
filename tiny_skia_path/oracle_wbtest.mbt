///|
test "13 bug_26 polyline" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x4426628FU), f(0x438FA666U))
  pb.line_to(f(0x4428EAE1U), f(0x4388851FU))
  pb.line_to(f(0x4428E148U), f(0x4387A8F6U))
  pb.line_to(f(0x4428B28FU), f(0x4386CE14U))
  pb.line_to(f(0x44288333U), f(0x4386051FU))
  pb.line_to(f(0x44283852U), f(0x43853C29U))
  pb.line_to(f(0x4427D148U), f(0x43847333U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 4426628f,438fa666 L 4428eae1,4388851f L 4428e148,4387a8f6 L 4428b28f,4386ce14 L 44288333,4386051f L 44283852,43853c29 L 4427d148,43847333 | b 4426628f,43847333,4428eae1,438fa666",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "4426628f,43847333,4428eae1,438fa666",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 4449cccc,444050c4 L 44501821,4439f1fc L 445056c9,443912f2 L 44505d4f,44382a0c L 44505c9b,443752e2 L 445032a0,44367375 L 444fde67,44358b96 | b 4449cccc,44358b96,44505d4f,444050c4",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "4449cccc,44358b96,44505d4f,444050c4",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 43c8d8d4,4416db76 L 43d0fa66,44153f29 L 43d16236,4414dd9c L 43d18b0e,44146861 L 43d1a910,4413fa51 L 43d198eb,44137d44 L 43d1598a,4412f0e0 | b 43c8d8d4,4412f0e0,43d1a910,4416db76",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "43c8d8d4,4412f0e0,43d1a910,4416db76",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 44a6ca8f,43082666 L 44a952e1,4301051f L 44a94948,430028f6 L 44a91a8f,42fe9c28 L 44a8eb33,42fd0a3e L 44a8a052,42fb7852 L 44a83948,42f9e666 | b 44a6ca8f,42f9e666,44a952e1,43082666",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "44a6ca8f,42f9e666,44a952e1,43082666",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
