  )
}

///|
test "42 exact 180 turn" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.line_to(f(0x42C80000U), f(0x00000000U))
  pb.line_to(f(0x42480000U), f(0x00000000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 L 42c80000,00000000 L 42480000,00000000 | b 00000000,00000000,42c80000,00000000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "00000000,00000000,42c80000,00000000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 L 43200000,41c80001 L 42aa0000,41200001 | b 41200000,c0a00000,43200000,41c80001",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41200000,c0a00000,43200000,41c80001",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 L 42a7bbef,4259db0a L 4227bbef,41d9db0a | b 00000000,00000000,42a7bbef,4259db0a",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "00000000,00000000,42a7bbef,4259db0a",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 L 434b4000,c0f00000 L 42ce8000,c0f00000 | b 40500000,c0f00000,434b4000,c0f00000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40500000,c0f00000,434b4000,c0f00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 00000000,bf000000 L 42c80000,bf000000 L 42c80000,3f000000 L 42480000,3f000000 L 42480000,bf000000 L 42c80000,bf000000 L 42c80000,00000000 L 42c80000,3f000000 L 00000000,3f000000 L 00000000,bf000000 Z | b 00000000,bf000000,42c80000,3f000000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,bf000000,42c80000,3f000000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#637 220bb5b68c8c07ae M 00000000,c0a00000 L 42c80000,c0a00000 L 42c80000,00000000 L 42c80000,40a00000 L 42480000,40a00000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41200000U), f(0x40800000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0a00000,c0a00000,42d20000,40a00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 00000000,c0400000 L 42c80000,c0400000 L 42c80000,00000000 L 42c80000,40400000 L 423c0000,40400000 L 423c0000,c0400000 L 42c80000,c0400000 L 42c80000,40400000 L c0400000,40400000 L c0400000,c0400000 Z | b c0400000,c0400000,42c80000,40400000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0400000,c0400000,42c80000,40400000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x41200000U), 0, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 00000000,c0800000 L 430c0000,c0800000 L 430c0000,40800000 L 42c80000,40800000 L 42480000,40800000 L 42480000,c0800000 L 42c80000,c0800000 L 42c80000,00000000 L 42c80000,40800000 L 00000000,40800000 L 00000000,c0800000 Z | b 00000000,c0800000,430c0000,40800000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41000000U), f(0x41200000U), 0, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,c0800000,430c0000,40800000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 00000000,c0800000 L 42d40000,c0800000 L 42d40000,40800000 L 42c80000,40800000 L 42380000,40800000 L 42380000,c0800000 L 42c80000,c0800000 L 42c80000,00000000 L 42c80000,40800000 L c0800000,40800000 L c0800000,c0800000 Z | b c0800000,c0800000,42d40000,40800000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0800000,c0800000,42d40000,40800000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40800000U), f(0x40800000U), 1, 0),
          f(0x40200000U),
        ),
      ),
    ),
    "#505 8f0180ed81a93e0e M 00000000,c0000000 L 42c80000,c0000000 L 42c80000,40000000 L 42480000,40000000 Q 4244afb0,3fffffff ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40800000U), f(0x40800000U), 1, 0), f(0x40200000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0000000,c0000000,42c80000,40000000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F000000U), f(0x40800000U), 0, 2),
          f(0x3E99999AU),
        ),
      ),
    ),
    "M 00000000,be800000 L 42c80000,be800000 L 42c80000,00000000 L 42c80000,3e800000 L 42480000,3e800000 L 42480000,be800000 L 42c80000,be800000 Q 42c83504,be7fffff 42c85a81,be3504f3 Q 42c87fff,bdd413cc 42c88000,00000000 Q 42c87fff,3dd413cc 42c85a81,3e3504f3 Q 42c83504,3e7fffff 42c80000,3e800000 L 00000000,3e800000 L 00000000,be800000 Z | b 00000000,be800000,42c88000,3e800000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F000000U), f(0x40800000U), 0, 2), f(0x3E99999AU))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,be800000,42c88000,3e800000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41A00000U), f(0x3F800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 00000000,c1200000 L 42c80000,c1200000 L 42c80000,00000000 L 42c80000,41200000 L 42480000,41200000 L 42480000,c1200000 L 42c80000,c1200000 L 42c80000,41200000 L 00000000,41200000 L 00000000,c1200000 Z | b 00000000,c1200000,42c80000,41200000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41A00000U), f(0x3F800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,c1200000,42c80000,41200000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40400000U), f(0x40800000U), 2, 2),
          f(0x41200000U),
        ),
      ),
    ),
    "M 00000000,bfc00000 L 42c80000,bfc00000 L 42c80000,00000000 L 42c80000,3fc00000 L 42420000,3fc00000 L 42420000,bfc00000 L 42c80000,bfc00000 Q 42c93e1c,bfbfffff 42ca1f0e,bf87c3b6 Q 42caffff,bf1f0ed9 42cb0000,00000000 Q 42caffff,3f1f0ed9 42ca1f0e,3f87c3b6 Q 42c93e1c,3fbfffff 42c80000,3fc00000 L bfc00000,3fc00000 L bfc00000,bfc00000 Z | b bfc00000,bfc00000,42cb0000,3fc00000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40400000U), f(0x40800000U), 2, 2), f(0x41200000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "bfc00000,bfc00000,42cb0000,3fc00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x00000000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  let d = StrokeDash::new([f(0x40A00000U), f(0x40400000U)], f(0x00000000U)).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
    "#819 428481b6b0eb6877 M 00000000,00000000 L 40a00000,00000000 M 41000000,00000000 L 41500000,00000000 M 41800000,00000000 ",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3F800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#7225 8f6837770b8b0701 M 00000000,bf800000 L 40a00000,bf800000 Q 40ad413c,bf7fffff 40b6a09d,bf3504f3 Q 40bfffff,bed413cc 40",
  )
  assert_eq(
    dg(dpath(path.dash(d, f(0x3E800000U)))),
    "#819 428481b6b0eb6877 M 00000000,00000000 L 40a00000,00000000 M 41000000,00000000 L 41500000,00000000 M 41800000,00000000 ",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3E800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
