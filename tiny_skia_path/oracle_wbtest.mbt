    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40400000U), f(0x40800000U), 2, 2),
          f(0x41200000U),
        ),
      ),
    ),
    "#1983 8fa5692126f11a3f M 00000000,bfc00000 L 42200000,bfc00000 Q 42227c3b,bfbfffff 42243e1d,bf87c3b6 Q 42260000,bf1f0ed9 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40400000U), f(0x40800000U), 2, 2), f(0x41200000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c1b01985,c000cc2a,439c0198,4316e405",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x00000000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  let d = StrokeDash::new([f(0x40A00000U), f(0x40400000U)], f(0x00000000U)).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
    "#3405 4d0ce03323f55f1b M 41000000,00000000 L 41500000,00000000 M 41800000,00000000 L 41a80000,00000000 M 41c00000,00000000 ",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3F800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#22647 8735b12876098ce6 M 41000000,bf800000 L 41500000,bf800000 Q 4156a09d,bf7fffff 415b504e,bf3504f3 Q 415fffff,bed413cc 41",
  )
  assert_eq(
