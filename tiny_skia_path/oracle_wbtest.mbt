  assert_eq(dg(hx(fmax(f(0xCF32D05EU), f(0x3F800000U)))), "3f800000")
  assert_eq(dg(hx(fmin(f(0xCF32D05EU), f(0xBF800000U)))), "cf32d05e")
  assert_eq(dg(hx(fmax(f(0xCF32D05EU), f(0xBF800000U)))), "bf800000")
  assert_eq(dg(hx(fmin(f(0xCF32D05EU), f(0x3F000000U)))), "cf32d05e")
  assert_eq(dg(hx(fmax(f(0xCF32D05EU), f(0x3F000000U)))), "3f000000")
  assert_eq(dg(hx(fmin(f(0xCF32D05EU), f(0xBF000000U)))), "cf32d05e")
  assert_eq(dg(hx(fmax(f(0xCF32D05EU), f(0xBF000000U)))), "bf000000")
  assert_eq(dg(hx(round_f32(f(0xCF32D05EU)))), "cf32d05e")
  assert_eq(dg(f32_as_u32(f(0xCF32D05EU)).to_string()), "0")
  assert_eq(dg(f32_as_i32(f(0xCF32D05EU)).to_string()), "-2147483648")
  assert_eq(
    dg(hx(NormalizedF32::new_clamped(f(0xCF32D05EU)).get())),
    "00000000",
  )
  assert_eq(dg(hx(fmin(f(0x4F861C46U), f(0x00000000U)))), "00000000")
  assert_eq(dg(hx(fmax(f(0x4F861C46U), f(0x00000000U)))), "4f861c46")
  assert_eq(dg(hx(fmin(f(0x4F861C46U), f(0x80000000U)))), "80000000")
  assert_eq(dg(hx(fmax(f(0x4F861C46U), f(0x80000000U)))), "4f861c46")
  assert_eq(dg(hx(fmin(f(0x4F861C46U), f(0x3F800000U)))), "3f800000")
  assert_eq(dg(hx(fmax(f(0x4F861C46U), f(0x3F800000U)))), "4f861c46")
  assert_eq(dg(hx(fmin(f(0x4F861C46U), f(0xBF800000U)))), "bf800000")
  assert_eq(dg(hx(fmax(f(0x4F861C46U), f(0xBF800000U)))), "4f861c46")
  assert_eq(dg(hx(fmin(f(0x4F861C46U), f(0x3F000000U)))), "3f000000")
  assert_eq(dg(hx(fmax(f(0x4F861C46U), f(0x3F000000U)))), "4f861c46")
  assert_eq(dg(hx(fmin(f(0x4F861C46U), f(0xBF000000U)))), "bf000000")
  assert_eq(dg(hx(fmax(f(0x4F861C46U), f(0xBF000000U)))), "4f861c46")
  assert_eq(dg(hx(round_f32(f(0x4F861C46U)))), "4f861c46")
  assert_eq(dg(f32_as_u32(f(0x4F861C46U)).to_string()), "4294967295")
  assert_eq(dg(f32_as_i32(f(0x4F861C46U)).to_string()), "2147483647")
  assert_eq(
    dg(hx(NormalizedF32::new_clamped(f(0x4F861C46U)).get())),
    "3f800000",
  )
}

///|
test "3 approx_eq_ulps" {
  assert_eq(
    dg(approx_eq_ulps(f(0x00000000U), f(0x80000000U), 4).to_string()),
    "true",
  )
  assert_eq(
    dg(approx_eq_ulps(f(0x3F800000U), f(0x3F800001U), 4).to_string()),
    "true",
  )
  assert_eq(
    dg(approx_eq_ulps(f(0x3F800000U), f(0x3F800004U), 4).to_string()),
    "true",
  )
  assert_eq(
    dg(approx_eq_ulps(f(0x3F800000U), f(0x3F800008U), 4).to_string()),
    "false",
  )
  assert_eq(
    dg(approx_eq_ulps(f(0xBF800000U), f(0xBF800002U), 1).to_string()),
    "false",
  )
  assert_eq(
    dg(approx_eq_ulps(f(0x00000001U), f(0x80000001U), 4).to_string()),
    "false",
  )
  assert_eq(
    dg(approx_eq_ulps(f(0x00000000U), f(0x00000001U), 4).to_string()),
    "true",
  )
  assert_eq(
    dg(approx_eq_ulps(f(0x00000000U), f(0x00000007U), 4).to_string()),
    "false",
  )
  assert_eq(
    dg(approx_eq_ulps(f(0x7FC00000U), f(0x7FC00000U), 4).to_string()),
    "true",
  )
  assert_eq(
    dg(approx_eq_ulps(f(0x7F800000U), f(0x7F7FFFFFU), 1).to_string()),
    "true",
  )
  assert_eq(
    dg(approx_eq_ulps(f(0x40400000U), f(0x40400001U), 0).to_string()),
    "false",
  )
}

///|
test "4 transform" {
  assert_eq(
    dg(dts(Transform::from_rotate(f(0x00000000U)))),
    "3f800000,00000000,80000000,3f800000,00000000,00000000",
  )
  assert_eq(
    dg(dts(Transform::from_rotate_at(f(0x00000000U), 10.5, -3.0))),
    "3f800000,00000000,00000000,3f800000,00000000,00000000",
  )
  assert_eq(
    dg(dts(Transform::from_rotate(f(0x41F00000U)))),
    "3f5db3d7,3f000000,bf000000,3f5db3d7,00000000,00000000",
  )
  assert_eq(
    dg(dts(Transform::from_rotate_at(f(0x41F00000U), 10.5, -3.0))),
    "3f5db3d7,3f000000,bf000000,3f5db3d7,bdbf0280,c0b4dc90",
  )
  assert_eq(
    dg(dts(Transform::from_rotate(f(0x42040000U)))),
    "3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000",
  )
  assert_eq(
    dg(dts(Transform::from_rotate_at(f(0x42040000U), 10.5, -3.0))),
    "3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,3d75ef00,c0c67c82",
  )
  assert_eq(
    dg(dts(Transform::from_rotate(f(0x42340000U)))),
    "3f3504f3,3f3504f3,bf3504f3,3f3504f3,00000000,00000000",
  )
  assert_eq(
    dg(dts(Transform::from_rotate_at(f(0x42340000U), 10.5, -3.0))),
    "3f3504f3,3f3504f3,bf3504f3,3f3504f3,3f743d30,c104da52",
  )
  assert_eq(
    dg(dts(Transform::from_rotate(f(0x42B40000U)))),
    "b33bbd2e,3f800000,bf800000,b33bbd2e,00000000,00000000",
  )
  assert_eq(
    dg(dts(Transform::from_rotate_at(f(0x42B40000U), 10.5, -3.0))),
    "b33bbd2e,3f800000,bf800000,b33bbd2e,40f00001,c1580000",
  )
  assert_eq(
    dg(dts(Transform::from_rotate(f(0x43340000U)))),
    "bf800000,b3bbbd2e,33bbbd2e,bf800000,00000000,00000000",
  )
  assert_eq(
    dg(dts(Transform::from_rotate_at(f(0x43340000U), 10.5, -3.0))),
    "bf800000,b3bbbd2e,33bbbd2e,bf800000,41a80000,c0bffffe",
  )
  assert_eq(
    dg(dts(Transform::from_rotate(f(0xC29B6666U)))),
    "3e5a24ab,bf7a1fa8,3f7a1fa8,3e5a24ab,00000000,00000000",
  )
  assert_eq(
    dg(dts(Transform::from_rotate_at(f(0xC29B6666U), 10.5, -3.0))),
    "3e5a24ab,bf7a1fa8,3f7a1fa8,3e5a24ab,41331beb,40fcbcfc",
  )
  assert_eq(
    dg(dts(Transform::from_rotate(f(0x43870000U)))),
    "324cde2e,bf800000,3f800000,324cde2e,00000000,00000000",
  )
  assert_eq(
    dg(dts(Transform::from_rotate_at(f(0x43870000U), 10.5, -3.0))),
    "324cde2e,bf800000,3f800000,324cde2e,41580000,40f00000",
  )
  assert_eq(
    dg(dts(Transform::from_rotate(f(0x449A5000U)))),
    "bf670fd1,3edc6c01,bedc6c01,bf670fd1,00000000,00000000",
  )
  assert_eq(
    dg(dts(Transform::from_rotate_at(f(0x449A5000U), 10.5, -3.0))),
    "bf670fd1,3edc6c01,bedc6c01,bf670fd1,41957c20,c123a668",
  )
  let a = ts_of("3f800000,00000000,00000000,3f800000,00000000,00000000")
  assert_eq(
    dg(dts_opt(a.invert())),
    "3f800000,00000000,00000000,3f800000,00000000,00000000",
  )
  assert_eq(dg(a.is_valid().to_string()), "true")
  assert_eq(dg(hx(PathStroker::compute_resolution_scale(a))), "3f800000")
  assert_eq(dg(hx(a.get_scale().0) + hx(a.get_scale().1)), "3f8000003f800000")
  let b = ts_of("3f99999a,4059999a,c0b33333,c0f9999a,3f99999a,4059999a")
  assert_eq(
    dg(dts(a.pre_concat(b))),
    "3f99999a,4059999a,c0b33333,c0f9999a,3f99999a,4059999a",
  )
  assert_eq(
    dg(dts(a.post_concat(b))),
    "3f99999a,4059999a,c0b33333,c0f9999a,3f99999a,4059999a",
  )
  assert_eq(
    dg(dts(a.pre_scale(1.5, -2.0))),
    "3fc00000,00000000,00000000,c0000000,00000000,00000000",
  )
  assert_eq(
    dg(dts(a.post_rotate(15.0))),
    "3f7746ea,3e8483ee,be8483ee,3f7746ea,00000000,00000000",
  )
  assert_eq(
    dg(dts(a.pre_rotate_at(15.0, 3.0, 4.0))),
    "3f7746ea,3e8483ee,be8483ee,3f7746ea,3f91998f,bf23e190",
  )
  assert_eq(
    dg(dpt(a.map_point(Point::from_xy(3.7, -1.9)))),
    "406ccccd,bff33333",
  )
  assert_eq(
    dg(drect(Rect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a))),
    "c0600000,40100000,41880000,411c0000",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a),
      ),
    ),
    "c0600000,40100000,41880000,411c0000",
  )
  let a = ts_of("3f99999a,4059999a,c0b33333,c0f9999a,3f99999a,4059999a")
  assert_eq(
    dg(dts_opt(a.invert())),
    "bf4e47f0,beb3d5b0,3f141964,3dfde263,bf800000,00000000",
  )
  assert_eq(dg(a.is_valid().to_string()), "true")
  assert_eq(dg(hx(PathStroker::compute_resolution_scale(a))), "4108241f")
  assert_eq(dg(hx(a.get_scale().0) + hx(a.get_scale().1)), "40b744a34108241f")
  let b = ts_of("3f800000,be4ccccd,3e99999a,3f800000,00000000,00000000")
  assert_eq(
    dg(dts(a.pre_concat(b))),
    "40147ae1,409eb852,c0a7ae14,c0d8f5c3,3f99999a,4059999a",
  )
  assert_eq(
    dg(dts(a.post_concat(b))),
    "400e147b,404a3d71,c0fe147b,c0d5c290,400e147b,404a3d71",
  )
  assert_eq(
    dg(dts(a.pre_scale(1.5, -2.0))),
    "3fe66667,40a33334,41333333,4179999a,3f99999a,4059999a",
  )
  assert_eq(
    dg(dts(a.post_rotate(15.0))),
    "3e8ee9a3,40661011,c058fc3f,c10fbcdc,3e8ee9a3,40661011",
  )
  assert_eq(
    dg(dts(a.pre_rotate_at(15.0, 3.0, 4.0))),
    "be949f01,3fa1f74b,c0b70855,c106a097,40c4cbf6,41442c06",
  )
  assert_eq(
    dg(dpt(a.map_point(Point::from_xy(3.7, -1.9)))),
    "41823d71,41f66667",
  )
  assert_eq(
    dg(drect(Rect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a))),
    "c2666666,c2a9199a,41100002,422e999a",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a),
      ),
    ),
    "c2666666,c2a9199a,41100000,422e999c",
  )
  let a = ts_of("40000000,00000000,00000000,c0800000,00000000,00000000")
  assert_eq(
    dg(dts_opt(a.invert())),
    "3f000000,00000000,00000000,be800000,80000000,00000000",
  )
  assert_eq(dg(a.is_valid().to_string()), "true")
  assert_eq(dg(hx(PathStroker::compute_resolution_scale(a))), "40800000")
  assert_eq(dg(hx(a.get_scale().0) + hx(a.get_scale().1)), "4000000040800000")
  let b = ts_of("3f800000,40000000,40000000,40800000,00000000,00000000")
  assert_eq(
    dg(dts(a.pre_concat(b))),
    "40000000,c1000000,40800000,c1800000,00000000,00000000",
  )
  assert_eq(
    dg(dts(a.post_concat(b))),
    "40000000,40800000,c1000000,c1800000,00000000,00000000",
  )
  assert_eq(
    dg(dts(a.pre_scale(1.5, -2.0))),
    "40400000,00000000,00000000,41000000,00000000,00000000",
  )
  assert_eq(
    dg(dts(a.post_rotate(15.0))),
    "3ff746ea,3f0483ee,3f8483ee,c07746ea,00000000,00000000",
  )
  assert_eq(
    dg(dts(a.pre_rotate_at(15.0, 3.0, 4.0))),
    "3ff746ea,bf8483ee,bf0483ee,c07746ea,4011998f,4023e190",
  )
  assert_eq(
    dg(dpt(a.map_point(Point::from_xy(3.7, -1.9)))),
    "40eccccd,40f33333",
  )
  assert_eq(
    dg(drect(Rect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a))),
    "c0e00000,c21c0000,42080000,c1100000",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a),
      ),
    ),
    "c0e00000,c21c0000,42080000,c1100000",
  )
  let a = ts_of("3f800000,00000000,00000000,3f800000,40b00000,c0c80000")
  assert_eq(
    dg(dts_opt(a.invert())),
    "3f800000,00000000,00000000,3f800000,c0b00000,40c80000",
  )
  assert_eq(dg(a.is_valid().to_string()), "true")
  assert_eq(dg(hx(PathStroker::compute_resolution_scale(a))), "3f800000")
  assert_eq(dg(hx(a.get_scale().0) + hx(a.get_scale().1)), "3f8000003f800000")
  let b = ts_of("3f800000,00000000,00000000,3f800000,00000000,00000000")
  assert_eq(
    dg(dts(a.pre_concat(b))),
    "3f800000,00000000,00000000,3f800000,40b00000,c0c80000",
  )
  assert_eq(
    dg(dts(a.post_concat(b))),
    "3f800000,00000000,00000000,3f800000,40b00000,c0c80000",
  )
  assert_eq(
    dg(dts(a.pre_scale(1.5, -2.0))),
    "3fc00000,00000000,00000000,c0000000,40b00000,c0c80000",
  )
  assert_eq(
    dg(dts(a.post_rotate(15.0))),
    "3f7746ea,3e8483ee,be8483ee,3f7746ea,40ddc44a,c093a20d",
  )
  assert_eq(
    dg(dts(a.pre_rotate_at(15.0, 3.0, 4.0))),
    "3f7746ea,3e8483ee,be8483ee,3f7746ea,40d46664,c0dc7c32",
  )
  assert_eq(
    dg(dpt(a.map_point(Point::from_xy(3.7, -1.9)))),
    "41133333,c1026666",
  )
  assert_eq(
    dg(drect(Rect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a))),
    "40000000,c0800000,41b40000,40600000",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a),
      ),
    ),
    "40000000,c0800000,41b40000,40600000",
  )
  let a = ts_of("3f800000,be4ccccd,3e99999a,3f800000,00000000,00000000")
  assert_eq(
    dg(dts_opt(a.invert())),
    "3f71826a,3e413522,be90e7da,3f71826a,00000000,80000000",
  )
  assert_eq(dg(a.is_valid().to_string()), "true")
  assert_eq(dg(hx(PathStroker::compute_resolution_scale(a))), "3f85a2cc")
  assert_eq(dg(hx(a.get_scale().0) + hx(a.get_scale().1)), "3f85a2cc3f8288ef")
  let b = ts_of("3f800000,00000000,00000000,3f800000,40b00000,c0c80000")
  assert_eq(
    dg(dts(a.pre_concat(b))),
    "3f800000,be4ccccd,3e99999a,3f800000,40680000,c0eb3333",
  )
  assert_eq(
    dg(dts(a.post_concat(b))),
    "3f800000,be4ccccd,3e99999a,3f800000,40b00000,c0c80000",
  )
  assert_eq(
    dg(dts(a.pre_scale(1.5, -2.0))),
    "3fc00000,be99999a,bf19999a,c0000000,00000000,00000000",
  )
  assert_eq(
    dg(dts(a.post_rotate(15.0))),
    "3f8243a7,3d866b0e,3cfd9d20,3f8593c0,00000000,00000000",
  )
  assert_eq(
    dg(dts(a.pre_rotate_at(15.0, 3.0, 4.0))),
    "3f8593c0,3d866b0e,3cfd9d20,3f8243a7,3f72090c,bf5e1efc",
  )
  assert_eq(
    dg(dpt(a.map_point(Point::from_xy(3.7, -1.9)))),
    "404851ec,c028f5c2",
  )
  assert_eq(
    dg(drect(Rect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a))),
    "c034cccd,bf933334,419f6666,41273333",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a),
      ),
    ),
    "c034cccd,bf933334,419f6666,41273334",
  )
  let a = ts_of("3dcccccd,3e4ccccd,3e99999a,3f19999a,40e00000,41000000")
  assert_eq(dg(dts_opt(a.invert())), "None")
  assert_eq(dg(a.is_valid().to_string()), "true")
  assert_eq(dg(hx(PathStroker::compute_resolution_scale(a))), "3f21e89b")
  assert_eq(dg(hx(a.get_scale().0) + hx(a.get_scale().1)), "3ea1e89b3f21e89b")
  let b = ts_of("3a83126f,00000000,00000000,3a83126f,3f800000,3f800000")
  assert_eq(
    dg(dts(a.pre_concat(b))),
    "38d1b718,3951b718,399d4952,3a1d4952,40eccccd,410ccccd",
  )
  assert_eq(
    dg(dts(a.post_concat(b))),
    "38d1b718,3951b718,399d4952,3a1d4952,3f80e560,3f810625",
  )
  assert_eq(
    dg(dts(a.pre_scale(1.5, -2.0))),
    "3e19999a,3e99999a,bf19999a,bf99999a,40e00000,41000000",
  )
  assert_eq(
    dg(dts(a.post_rotate(15.0))),
    "3d379e60,3e60531e,3e09b6c8,3f283e57,40961c16,4118a051",
  )
  assert_eq(
    dg(dts(a.pre_rotate_at(15.0, 3.0, 4.0))),
    "3e326b86,3eb26b86,3e871d5b,3f071d5b,40dd7e95,40fafd29",
  )
  assert_eq(
    dg(dpt(a.map_point(Point::from_xy(3.7, -1.9)))),
    "40d9999a,40f33333",
  )
  assert_eq(
    dg(drect(Rect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a))),
    "40ea6666,410a6666,413a0000,418a0000",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a),
      ),
    ),
    "40ea6666,410a6666,413a0000,418a0000",
  )
  let a = ts_of("3a83126f,00000000,00000000,3a83126f,3f800000,3f800000")
  assert_eq(
    dg(dts_opt(a.invert())),
    "4479ffff,00000000,00000000,4479ffff,c479ffff,c479ffff",
  )
  assert_eq(dg(a.is_valid().to_string()), "true")
  assert_eq(dg(hx(PathStroker::compute_resolution_scale(a))), "3a83126f")
  assert_eq(dg(hx(a.get_scale().0) + hx(a.get_scale().1)), "3a83126f3a83126f")
  let b = ts_of("40195689,3fe718d2,be9a108c,3ecc7361,00000000,00000000")
  assert_eq(
    dg(dts(a.pre_concat(b))),
    "3b1d04a5,3aeca4af,b99dc31f,39d15b87,3f800000,3f800000",
  )
  assert_eq(
    dg(dts(a.post_concat(b))),
    "3b1d04a5,3aeca4af,b99dc31f,39d15b87,40061478,400d1ad5",
  )
  assert_eq(
    dg(dts(a.pre_scale(1.5, -2.0))),
    "3ac49ba6,00000000,00000000,bb03126f,3f800000,3f800000",
  )
  assert_eq(
    dg(dts(a.post_rotate(15.0))),
    "3a7d3630,3987b21b,b987b21b,3a7d3630,3f3504f3,3f9cc470",
  )
  assert_eq(
    dg(dts(a.pre_rotate_at(15.0, 3.0, 4.0))),
    "3a7d3630,3987b21b,b987b21b,3a7d3630,3f802546,3f7fd60c",
  )
  assert_eq(
    dg(dpt(a.map_point(Point::from_xy(3.7, -1.9)))),
    "3f80793e,3f7f837b",
  )
  assert_eq(
    dg(drect(Rect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a))),
    "3f7f1aa0,3f8049ba,3f822d0e,3f813f7d",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a),
      ),
    ),
    "3f7f1aa0,3f8049ba,3f822d0e,3f813f7d",
  )
  let a = ts_of("3f800000,40000000,40000000,40800000,00000000,00000000")
  assert_eq(dg(dts_opt(a.invert())), "None")
  assert_eq(dg(a.is_valid().to_string()), "true")
  assert_eq(dg(hx(PathStroker::compute_resolution_scale(a))), "408f1bbd")
  assert_eq(dg(hx(a.get_scale().0) + hx(a.get_scale().1)), "400f1bbd408f1bbd")
  let b = ts_of("40000000,00000000,00000000,c0800000,00000000,00000000")
  assert_eq(
    dg(dts(a.pre_concat(b))),
    "40000000,40800000,c1000000,c1800000,00000000,00000000",
  )
  assert_eq(
    dg(dts(a.post_concat(b))),
    "40000000,c1000000,40800000,c1800000,00000000,00000000",
  )
  assert_eq(
    dg(dts(a.pre_scale(1.5, -2.0))),
    "3fc00000,40400000,c0800000,c1000000,00000000,00000000",
  )
  assert_eq(
    dg(dts(a.post_rotate(15.0))),
    "3ee585f8,400c33f3,3f6585f8,408c33f3,00000000,00000000",
  )
  assert_eq(
    dg(dts(a.pre_rotate_at(15.0, 3.0, 4.0))),
    "3fbde56c,403de56c,3fd625ee,405625ee,be124008,be924008",
  )
  assert_eq(
    dg(dpt(a.map_point(Point::from_xy(3.7, -1.9)))),
    "bdccccc0,be4cccc0",
  )
  assert_eq(
    dg(drect(Rect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a))),
    "3f800000,40000000,42120000,42920000",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a),
      ),
    ),
    "3f800000,40000000,42120000,42920000",
  )
  let a = ts_of("00000000,00000000,00000000,00000000,3f800000,3f800000")
  assert_eq(
    dg(dts_opt(a.invert())),
    "7f800000,00000000,00000000,7f800000,ff800000,ff800000",
  )
  assert_eq(dg(a.is_valid().to_string()), "false")
  assert_eq(dg(hx(PathStroker::compute_resolution_scale(a))), "3f800000")
  assert_eq(dg(hx(a.get_scale().0) + hx(a.get_scale().1)), "0000000000000000")
  let b = ts_of("3dcccccd,3e4ccccd,3e99999a,3f19999a,40e00000,41000000")
  assert_eq(
    dg(dts(a.pre_concat(b))),
    "00000000,00000000,00000000,00000000,3f800000,3f800000",
  )
  assert_eq(
    dg(dts(a.post_concat(b))),
    "00000000,00000000,00000000,00000000,40eccccd,410ccccd",
  )
  assert_eq(
    dg(dts(a.pre_scale(1.5, -2.0))),
    "00000000,00000000,00000000,80000000,3f800000,3f800000",
  )
  assert_eq(
    dg(dts(a.post_rotate(15.0))),
    "00000000,00000000,00000000,00000000,3f3504f3,3f9cc470",
  )
  assert_eq(
    dg(dts(a.pre_rotate_at(15.0, 3.0, 4.0))),
    "00000000,00000000,00000000,00000000,3f800000,3f800000",
  )
  assert_eq(
    dg(dpt(a.map_point(Point::from_xy(3.7, -1.9)))),
    "3f800000,3f800000",
  )
  assert_eq(
    dg(drect(Rect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a))),
    "3f800000,3f800000,3f800000,3f800000",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a),
      ),
    ),
    "None",
  )
  let a = ts_of("40195689,3fe718d2,be9a108c,3ecc7361,00000000,00000000")
  assert_eq(
    dg(dts_opt(a.invert())),
    "3e884ceb,bf9a108c,3e4d6b65,3fcc7361,80000000,00000000",
  )
  assert_eq(dg(a.is_valid().to_string()), "true")
  assert_eq(dg(hx(PathStroker::compute_resolution_scale(a))), "401a8aea")
  assert_eq(dg(hx(a.get_scale().0) + hx(a.get_scale().1)), "401a8aea3fecae8f")
  let b = ts_of("00000000,00000000,00000000,00000000,3f800000,3f800000")
  assert_eq(
    dg(dts(a.pre_concat(b))),
    "00000000,00000000,00000000,00000000,40061478,400d1ad5",
  )
  assert_eq(
    dg(dts(a.post_concat(b))),
    "00000000,00000000,00000000,00000000,3f800000,3f800000",
  )
  assert_eq(
    dg(dts(a.pre_scale(1.5, -2.0))),
    "406601ce,402d529e,3f1a108c,bf4c7361,00000000,00000000",
  )
  assert_eq(
    dg(dts(a.post_rotate(15.0))),
    "3fec69fe,40174c4e,bec9bb12,3e9d9bfe,00000000,00000000",
  )
  assert_eq(
    dg(dts(a.pre_rotate_at(15.0, 3.0, 4.0))),
    "400f20f9,3fec7392,bf69279b,bda70f53,403ac005,3fe626f5",
  )
  assert_eq(
    dg(dpt(a.map_point(Point::from_xy(3.7, -1.9)))),
    "4116fc3a,40bd7c75",
  )
  assert_eq(
    dg(drect(Rect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a))),
    "c1351cc3,c0ad757e,422036a8,420a57f9",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(-3.5, 2.25, 17.0, 9.75).unwrap().transform(a),
      ),
    ),
    "c1351cc3,c0ad757e,422036a8,420a57f9",
  )
}

///|
test "5 rect" {
  assert_eq(
    dg(
      drect(
        Rect::from_ltrb(
          f(0x00000000U),
          f(0x00000000U),
          f(0x41200000U),
          f(0x41200000U),
        ),
      ),
    ),
    "00000000,00000000,41200000,41200000",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(
          f(0x00000000U),
          f(0x00000000U),
          f(0x41200000U),
          f(0x41200000U),
        ),
      ),
    ),
    "00000000,00000000,41200000,41200000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_xywh(
          f(0x00000000U),
          f(0x00000000U),
          f(0x41200000U),
          f(0x41200000U),
        ),
      ),
    ),
    "00000000,00000000,41200000,41200000",
  )
  let r = Rect::from_ltrb(
    f(0x00000000U),
    f(0x00000000U),
    f(0x41200000U),
    f(0x41200000U),
  ).unwrap()
  assert_eq(dg(dintrect(r.round())), "0,0,10,10")
  assert_eq(dg(dintrect(r.round_out())), "0,0,10,10")
  assert_eq(
    dg(dnzrect(r.to_non_zero_rect())),
    "00000000,00000000,41200000,41200000",
  )
  assert_eq(dg(drect(r.inset(1.5, 2.0))), "3fc00000,40000000,41080000,41000000")
  assert_eq(
    dg(drect(r.outset(1.5, 2.0))),
    "bfc00000,c0000000,41380000,41400000",
  )
  assert_eq(
    dg(drect(r.intersect(Rect::from_ltrb(2.0, -1.0, 8.5, 30.0).unwrap()))),
    "40000000,00000000,41080000,41200000",
  )
  assert_eq(
    dg(drect(r.join(Rect::from_ltrb(2.0, -1.0, 8.5, 30.0).unwrap()))),
    "00000000,bf800000,41200000,41f00000",
  )
  assert_eq(
    dg(
      drect(
        Some(
          r.bbox_transform(
            NonZeroRect::from_xywh(5.0, 7.0, 0.3, 120.0).unwrap(),
          ),
        ),
      ),
    ),
    "40a00000,40e00000,41000002,4496e000",
  )
  assert_eq(
    dg(dintrect(Some(r.to_non_zero_rect().unwrap().to_int_rect()))),
    "0,0,10,10",
  )
  assert_eq(
    dg(
      dnzrect(
        Some(
          r
          .to_non_zero_rect()
          .unwrap()
          .bbox_transform(NonZeroRect::from_xywh(5.0, 7.0, 0.3, 120.0).unwrap()),
        ),
      ),
    ),
    "40a00000,40e00000,41000002,4496e000",
  )
  assert_eq(
    dg(dts(Transform::from_bbox(r.to_non_zero_rect().unwrap()))),
    "41200000,00000000,00000000,41200000,00000000,00000000",
  )
  assert_eq(
    dg(dsize(Some(r.to_non_zero_rect().unwrap().size()))),
    "41200000,41200000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_ltrb(
          f(0x41200000U),
          f(0x41200000U),
          f(0x40A00000U),
          f(0x41200000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(
          f(0x41200000U),
          f(0x41200000U),
          f(0x40A00000U),
          f(0x41200000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_xywh(
          f(0x41200000U),
          f(0x41200000U),
          f(0x40A00000U),
          f(0x41200000U),
        ),
      ),
    ),
    "41200000,41200000,41700000,41a00000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_ltrb(
          f(0xC1F00000U),
          f(0x41A00000U),
          f(0xC1200000U),
          f(0x42200000U),
        ),
      ),
    ),
    "c1f00000,41a00000,c1200000,42200000",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(
          f(0xC1F00000U),
          f(0x41A00000U),
          f(0xC1200000U),
          f(0x42200000U),
        ),
      ),
    ),
    "c1f00000,41a00000,c1200000,42200000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_xywh(
          f(0xC1F00000U),
          f(0x41A00000U),
          f(0xC1200000U),
          f(0x42200000U),
        ),
      ),
    ),
    "None",
  )
  let r = Rect::from_ltrb(
    f(0xC1F00000U),
    f(0x41A00000U),
    f(0xC1200000U),
    f(0x42200000U),
  ).unwrap()
  assert_eq(dg(dintrect(r.round())), "-29,20,20,20")
  assert_eq(dg(dintrect(r.round_out())), "-30,20,20,20")
  assert_eq(
    dg(dnzrect(r.to_non_zero_rect())),
    "c1f00000,41a00000,c1200000,42200000",
  )
  assert_eq(dg(drect(r.inset(1.5, 2.0))), "c1e40000,41b00000,c1380000,42180000")
  assert_eq(
    dg(drect(r.outset(1.5, 2.0))),
    "c1fc0000,41900000,c1080000,42280000",
  )
  assert_eq(
    dg(drect(r.intersect(Rect::from_ltrb(2.0, -1.0, 8.5, 30.0).unwrap()))),
    "None",
  )
  assert_eq(
    dg(drect(r.join(Rect::from_ltrb(2.0, -1.0, 8.5, 30.0).unwrap()))),
    "c1f00000,bf800000,41080000,42200000",
  )
  assert_eq(
    dg(
      drect(
        Some(
          r.bbox_transform(
            NonZeroRect::from_xywh(5.0, 7.0, 0.3, 120.0).unwrap(),
          ),
        ),
      ),
    ),
    "c080000c,45167000,3ffffff0,45963800",
  )
  assert_eq(
    dg(dintrect(Some(r.to_non_zero_rect().unwrap().to_int_rect()))),
    "-30,20,20,20",
  )
  assert_eq(
    dg(
      dnzrect(
        Some(
          r
          .to_non_zero_rect()
          .unwrap()
          .bbox_transform(NonZeroRect::from_xywh(5.0, 7.0, 0.3, 120.0).unwrap()),
        ),
      ),
    ),
    "c080000c,45167000,3ffffff0,45963800",
  )
  assert_eq(
    dg(dts(Transform::from_bbox(r.to_non_zero_rect().unwrap()))),
    "41a00000,00000000,00000000,41a00000,c1f00000,41a00000",
  )
  assert_eq(
    dg(dsize(Some(r.to_non_zero_rect().unwrap().size()))),
    "41a00000,41a00000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_ltrb(
          f(0x3E99999AU),
          f(0x3F333333U),
          f(0x41280000U),
          f(0x41380000U),
        ),
      ),
    ),
    "3e99999a,3f333333,41280000,41380000",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(
          f(0x3E99999AU),
          f(0x3F333333U),
          f(0x41280000U),
          f(0x41380000U),
        ),
      ),
    ),
    "3e99999a,3f333333,41280000,41380000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_xywh(
          f(0x3E99999AU),
          f(0x3F333333U),
          f(0x41280000U),
          f(0x41380000U),
        ),
      ),
    ),
    "3e99999a,3f333333,412ccccd,41433333",
  )
  let r = Rect::from_ltrb(
    f(0x3E99999AU),
    f(0x3F333333U),
    f(0x41280000U),
    f(0x41380000U),
  ).unwrap()
  assert_eq(dg(dintrect(r.round())), "0,0,10,11")
  assert_eq(dg(dintrect(r.round_out())), "0,0,11,12")
  assert_eq(
    dg(dnzrect(r.to_non_zero_rect())),
    "3e99999a,3f333333,41280000,41380000",
  )
  assert_eq(dg(drect(r.inset(1.5, 2.0))), "3fe66666,402ccccd,41100000,41180000")
  assert_eq(
    dg(drect(r.outset(1.5, 2.0))),
    "bf99999a,bfa66666,41400000,41580000",
  )
  assert_eq(
    dg(drect(r.intersect(Rect::from_ltrb(2.0, -1.0, 8.5, 30.0).unwrap()))),
    "40000000,3f333333,41080000,41380000",
  )
  assert_eq(
    dg(drect(r.join(Rect::from_ltrb(2.0, -1.0, 8.5, 30.0).unwrap()))),
    "3e99999a,bf800000,41280000,41f00000",
  )
  assert_eq(
    dg(
      drect(
        Some(
          r.bbox_transform(
            NonZeroRect::from_xywh(5.0, 7.0, 0.3, 120.0).unwrap(),
          ),
        ),
      ),
    ),
    "40a2e148,42b60000,41026668,44ad6000",
  )
  assert_eq(
    dg(dintrect(Some(r.to_non_zero_rect().unwrap().to_int_rect()))),
    "0,0,11,11",
  )
  assert_eq(
    dg(
      dnzrect(
        Some(
          r
          .to_non_zero_rect()
          .unwrap()
          .bbox_transform(NonZeroRect::from_xywh(5.0, 7.0, 0.3, 120.0).unwrap()),
        ),
      ),
    ),
    "40a2e148,42b60000,41026668,44ad6000",
  )
  assert_eq(
    dg(dts(Transform::from_bbox(r.to_non_zero_rect().unwrap()))),
    "41233333,00000000,00000000,412ccccd,3e99999a,3f333333",
  )
  assert_eq(
    dg(dsize(Some(r.to_non_zero_rect().unwrap().size()))),
    "41233333,412ccccd",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_ltrb(
          f(0xBF000000U),
          f(0xBFC00000U),
          f(0x40200000U),
          f(0x40600000U),
        ),
      ),
    ),
    "bf000000,bfc00000,40200000,40600000",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(
          f(0xBF000000U),
          f(0xBFC00000U),
          f(0x40200000U),
          f(0x40600000U),
        ),
      ),
    ),
    "bf000000,bfc00000,40200000,40600000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_xywh(
          f(0xBF000000U),
          f(0xBFC00000U),
          f(0x40200000U),
          f(0x40600000U),
        ),
      ),
    ),
    "bf000000,bfc00000,40000000,40000000",
  )
  let r = Rect::from_ltrb(
    f(0xBF000000U),
    f(0xBFC00000U),
    f(0x40200000U),
    f(0x40600000U),
  ).unwrap()
  assert_eq(dg(dintrect(r.round())), "0,-1,2,4")
  assert_eq(dg(dintrect(r.round_out())), "-1,-2,4,6")
  assert_eq(
    dg(dnzrect(r.to_non_zero_rect())),
    "bf000000,bfc00000,40200000,40600000",
  )
  assert_eq(dg(drect(r.inset(1.5, 2.0))), "3f800000,3f000000,3f800000,3fc00000")
  assert_eq(
    dg(drect(r.outset(1.5, 2.0))),
    "c0000000,c0600000,40800000,40b00000",
  )
  assert_eq(
    dg(drect(r.intersect(Rect::from_ltrb(2.0, -1.0, 8.5, 30.0).unwrap()))),
    "40000000,bf800000,40200000,40600000",
  )
  assert_eq(
    dg(drect(r.join(Rect::from_ltrb(2.0, -1.0, 8.5, 30.0).unwrap()))),
    "bf000000,bfc00000,41080000,41f00000",
  )
  assert_eq(
    dg(
      drect(
        Some(
          r.bbox_transform(
            NonZeroRect::from_xywh(5.0, 7.0, 0.3, 120.0).unwrap(),
          ),
        ),
      ),
    ),
    "409b3333,c32d0000,40b80001,43d58000",
  )
  assert_eq(
    dg(dintrect(Some(r.to_non_zero_rect().unwrap().to_int_rect()))),
    "-1,-2,3,5",
  )
  assert_eq(
    dg(
      dnzrect(
        Some(
          r
          .to_non_zero_rect()
          .unwrap()
          .bbox_transform(NonZeroRect::from_xywh(5.0, 7.0, 0.3, 120.0).unwrap()),
        ),
      ),
    ),
    "409b3333,c32d0000,40b80001,43d58000",
  )
  assert_eq(
    dg(dts(Transform::from_bbox(r.to_non_zero_rect().unwrap()))),
    "40400000,00000000,00000000,40a00000,bf000000,bfc00000",
  )
  assert_eq(
    dg(dsize(Some(r.to_non_zero_rect().unwrap().size()))),
    "40400000,40a00000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_ltrb(
          f(0x3F800000U),
          f(0x3F800000U),
          f(0x3F800000U),
          f(0x40A00000U),
        ),
      ),
    ),
    "3f800000,3f800000,3f800000,40a00000",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(
          f(0x3F800000U),
          f(0x3F800000U),
          f(0x3F800000U),
          f(0x40A00000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_xywh(
          f(0x3F800000U),
          f(0x3F800000U),
          f(0x3F800000U),
          f(0x40A00000U),
        ),
      ),
    ),
    "3f800000,3f800000,40000000,40c00000",
  )
  let r = Rect::from_ltrb(
    f(0x3F800000U),
    f(0x3F800000U),
    f(0x3F800000U),
    f(0x40A00000U),
  ).unwrap()
  assert_eq(dg(dintrect(r.round())), "1,1,1,4")
  assert_eq(dg(dintrect(r.round_out())), "1,1,1,4")
  assert_eq(dg(dnzrect(r.to_non_zero_rect())), "None")
  assert_eq(dg(drect(r.inset(1.5, 2.0))), "None")
  assert_eq(
    dg(drect(r.outset(1.5, 2.0))),
    "bf000000,bf800000,40200000,40e00000",
  )
  assert_eq(
    dg(drect(r.intersect(Rect::from_ltrb(2.0, -1.0, 8.5, 30.0).unwrap()))),
    "None",
  )
  assert_eq(
    dg(drect(r.join(Rect::from_ltrb(2.0, -1.0, 8.5, 30.0).unwrap()))),
    "40000000,bf800000,41080000,41f00000",
  )
  assert_eq(
    dg(
      drect(
        Some(
          r.bbox_transform(
            NonZeroRect::from_xywh(5.0, 7.0, 0.3, 120.0).unwrap(),
          ),
        ),
      ),
    ),
    "40a9999a,42fe0000,40a9999a,4417c000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_ltrb(
          f(0xFF61B1E6U),
          f(0x00000000U),
          f(0x7F61B1E6U),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(
          f(0xFF61B1E6U),
          f(0x00000000U),
          f(0x7F61B1E6U),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_xywh(
          f(0xFF61B1E6U),
          f(0x00000000U),
          f(0x7F61B1E6U),
          f(0x3F800000U),
        ),
      ),
    ),
    "ff61b1e6,00000000,00000000,3f800000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_ltrb(
          f(0x4EFFFFFFU),
          f(0x00000000U),
          f(0x4F32D05EU),
          f(0x3F800000U),
        ),
      ),
    ),
    "4effffff,00000000,4f32d05e,3f800000",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(
          f(0x4EFFFFFFU),
          f(0x00000000U),
          f(0x4F32D05EU),
          f(0x3F800000U),
        ),
      ),
    ),
    "4effffff,00000000,4f32d05e,3f800000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_xywh(
          f(0x4EFFFFFFU),
          f(0x00000000U),
          f(0x4F32D05EU),
          f(0x3F800000U),
        ),
      ),
    ),
    "4effffff,00000000,4f99682f,3f800000",
  )
  let r = Rect::from_ltrb(
    f(0x4EFFFFFFU),
    f(0x00000000U),
    f(0x4F32D05EU),
    f(0x3F800000U),
  ).unwrap()
  assert_eq(dg(dintrect(r.round())), "2147483520,0,1,1")
  assert_eq(dg(dintrect(r.round_out())), "2147483520,0,1,1")
  assert_eq(
    dg(dnzrect(r.to_non_zero_rect())),
    "4effffff,00000000,4f32d05e,3f800000",
  )
  assert_eq(dg(drect(r.inset(1.5, 2.0))), "None")
  assert_eq(
    dg(drect(r.outset(1.5, 2.0))),
    "4effffff,c0000000,4f32d05e,40400000",
  )
  assert_eq(
    dg(drect(r.intersect(Rect::from_ltrb(2.0, -1.0, 8.5, 30.0).unwrap()))),
    "None",
  )
  assert_eq(
    dg(drect(r.join(Rect::from_ltrb(2.0, -1.0, 8.5, 30.0).unwrap()))),
    "40000000,bf800000,4f32d05e,41f00000",
  )
  assert_eq(
    dg(
      drect(
        Some(
          r.bbox_transform(
            NonZeroRect::from_xywh(5.0, 7.0, 0.3, 120.0).unwrap(),
          ),
        ),
      ),
    ),
    "4e19999f,40e00000,4e5693ac,42fe0000",
  )
  assert_eq(
    dg(
      dnzrect(
        Some(
          r
          .to_non_zero_rect()
          .unwrap()
          .bbox_transform(NonZeroRect::from_xywh(5.0, 7.0, 0.3, 120.0).unwrap()),
        ),
      ),
    ),
    "4e19999f,40e00000,4e5693ac,42fe0000",
  )
  assert_eq(
    dg(dts(Transform::from_bbox(r.to_non_zero_rect().unwrap()))),
    "4e4b417a,00000000,00000000,3f800000,4effffff,00000000",
  )
  assert_eq(
    dg(dsize(Some(r.to_non_zero_rect().unwrap().size()))),
    "4e4b417a,3f800000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_ltrb(
          f(0x7FC00000U),
          f(0x00000000U),
          f(0x3F800000U),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(
          f(0x7FC00000U),
          f(0x00000000U),
          f(0x3F800000U),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_xywh(
          f(0x7FC00000U),
          f(0x00000000U),
          f(0x3F800000U),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_ltrb(
          f(0x00000000U),
          f(0x00000000U),
          f(0x7F800000U),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      dnzrect(
        NonZeroRect::from_ltrb(
          f(0x00000000U),
          f(0x00000000U),
          f(0x7F800000U),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_xywh(
          f(0x00000000U),
          f(0x00000000U),
          f(0x7F800000U),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(dg(drect(Rect::from_points([][:]))), "None")
  assert_eq(
    dg(
      drect(
        Rect::from_points([Point::from_xy(f(0x3F800000U), f(0x40000000U))][:]),
      ),
    ),
    "3f800000,40000000,3f800000,40000000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_points(
          [
            Point::from_xy(f(0x40400000U), f(0x40000000U)),
            Point::from_xy(f(0x3F800000U), f(0x40A00000U)),
          ][:],
        ),
      ),
    ),
    "3f800000,40000000,40400000,40a00000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_points(
          [
            Point::from_xy(f(0x40400000U), f(0x40000000U)),
            Point::from_xy(f(0x3F800000U), f(0x7FC00000U)),
          ][:],
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_points(
          [
            Point::from_xy(f(0x40400000U), f(0x40000000U)),
            Point::from_xy(f(0x3F800000U), f(0x40A00000U)),
            Point::from_xy(f(0xC0800000U), f(0x3F000000U)),
          ][:],
        ),
      ),
    ),
    "c0800000,3f000000,40400000,40a00000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_points(
          [
            Point::from_xy(f(0x40400000U), f(0x40000000U)),
            Point::from_xy(f(0x3F800000U), f(0x40A00000U)),
            Point::from_xy(f(0xC0800000U), f(0x3F000000U)),
            Point::from_xy(f(0x40E00000U), f(0x80000000U)),
          ][:],
        ),
      ),
    ),
    "c0800000,80000000,40e00000,40a00000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_points(
          [
            Point::from_xy(f(0x00000000U), f(0x80000000U)),
            Point::from_xy(f(0x80000000U), f(0x00000000U)),
            Point::from_xy(f(0x00000000U), f(0x00000000U)),
          ][:],
        ),
      ),
    ),
    "80000000,80000000,00000000,00000000",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_points(
          [
            Point::from_xy(f(0x40400000U), f(0x40000000U)),
            Point::from_xy(f(0x3F800000U), f(0x40A00000U)),
            Point::from_xy(f(0x7F800000U), f(0x3F000000U)),
            Point::from_xy(f(0x40E00000U), f(0x3F800000U)),
            Point::from_xy(f(0x00000000U), f(0x00000000U)),
          ][:],
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      drect(
        Rect::from_points(
          [
            Point::from_xy(f(0x7149F2CAU), f(0x7149F2CAU)),
            Point::from_xy(f(0xF149F2CAU), f(0x40000000U)),
            Point::from_xy(f(0x00000000U), f(0x00000000U)),
          ][:],
        ),
      ),
    ),
    "f149f2ca,00000000,7149f2ca,7149f2ca",
  )
  assert_eq(dg(dintrect(IntRect::from_xywh(0, 0, 0U, 0U))), "None")
  assert_eq(dg(dintrect(IntRect::from_xywh(0, 0, 1U, 0U))), "None")
  assert_eq(dg(dintrect(IntRect::from_xywh(0, 0, 4294967295U, 1U))), "None")
  assert_eq(dg(dintrect(IntRect::from_xywh(2147483647, 0, 1U, 1U))), "None")
  assert_eq(dg(dintrect(IntRect::from_xywh(1, 2, 30U, 40U))), "1,2,30,40")
  let ir = IntRect::from_xywh(1, 2, 30U, 40U).unwrap()
  assert_eq(
    dg(dintrect(ir.intersect(IntRect::from_xywh(11, 12, 50U, 60U).unwrap()))),
    "11,12,20,30",
  )
  assert_eq(dg(dintrect(ir.inset(2, 3))), "3,5,26,34")
  assert_eq(dg(dintrect(ir.make_outset(2, 3))), "-1,-1,34,46")
  assert_eq(
    dg(drect(Some(ir.to_rect()))),
    "3f800000,40000000,41f80000,42280000",
  )
  assert_eq(
    dg(ir.contains(IntRect::from_xywh(11, 12, 5U, 6U).unwrap()).to_string()),
    "true",
  )
  assert_eq(dg(dintrect(IntRect::from_xywh(-5, -6, 7U, 8U))), "-5,-6,7,8")
  let ir = IntRect::from_xywh(-5, -6, 7U, 8U).unwrap()
  assert_eq(
    dg(dintrect(ir.intersect(IntRect::from_xywh(11, 12, 50U, 60U).unwrap()))),
    "None",
  )
  assert_eq(dg(dintrect(ir.inset(2, 3))), "-3,-3,3,2")
  assert_eq(dg(dintrect(ir.make_outset(2, 3))), "-7,-9,11,14")
  assert_eq(
    dg(drect(Some(ir.to_rect()))),
    "c0a00000,c0c00000,40000000,40000000",
  )
  assert_eq(
    dg(ir.contains(IntRect::from_xywh(11, 12, 5U, 6U).unwrap()).to_string()),
    "false",
  )
}

///|
test "6 size" {
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x42C80000U), f(0x42480000U))
          .unwrap()
          .scale_to(Size::from_wh(f(0x42C80000U), f(0x42480000U)).unwrap()),
        ),
      ),
    ),
    "42c80000,42480000",
  )
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x42C80000U), f(0x42480000U))
          .unwrap()
          .expand_to(Size::from_wh(f(0x42C80000U), f(0x42480000U)).unwrap()),
        ),
      ),
    ),
    "42c80000,42480000",
  )
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x42C80000U), f(0x42480000U))
          .unwrap()
          .scale_to(Size::from_wh(f(0x40400000U), f(0x40E00000U)).unwrap()),
        ),
      ),
    ),
    "40400000,3fc00000",
  )
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x42C80000U), f(0x42480000U))
          .unwrap()
          .expand_to(Size::from_wh(f(0x40400000U), f(0x40E00000U)).unwrap()),
        ),
      ),
    ),
    "41600000,40e00000",
  )
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x42C80000U), f(0x42480000U))
          .unwrap()
          .scale_to(Size::from_wh(f(0x3ECCCCCDU), f(0x3F19999AU)).unwrap()),
        ),
      ),
    ),
    "3ecccccd,3e4ccccd",
  )
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x42C80000U), f(0x42480000U))
          .unwrap()
          .expand_to(Size::from_wh(f(0x3ECCCCCDU), f(0x3F19999AU)).unwrap()),
        ),
      ),
    ),
    "3f99999a,3f19999a",
  )
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x42C80000U), f(0x42480000U))
          .unwrap()
          .scale_to(Size::from_wh(f(0x3A83126FU), f(0x40200000U)).unwrap()),
        ),
      ),
    ),
    "3a83126f,3a03126f",
  )
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x42C80000U), f(0x42480000U))
          .unwrap()
          .expand_to(Size::from_wh(f(0x3A83126FU), f(0x40200000U)).unwrap()),
        ),
      ),
    ),
    "40a00000,40200000",
  )
  assert_eq(
    dg(
      dsize(
        Size::from_wh(f(0x42C80000U), f(0x42480000U)).unwrap().scale_by(1.7),
      ),
    ),
    "432a0000,42aa0000",
  )
  assert_eq(
    dg(
      dsize(
        Size::from_wh(f(0x42C80000U), f(0x42480000U))
        .unwrap()
        .scale_to_width(33.3),
      ),
    ),
    "42053333,41853333",
  )
  assert_eq(
    dg(
      dsize(
        Size::from_wh(f(0x42C80000U), f(0x42480000U))
        .unwrap()
        .scale_to_height(0.1),
      ),
    ),
    "3e4ccccd,3dcccccd",
  )
  assert_eq(
    dg(
      dintsize(
        Some(
          Size::from_wh(f(0x42C80000U), f(0x42480000U)).unwrap().to_int_size(),
        ),
      ),
    ),
    "100,50",
  )
  assert_eq(
    dg(
      drect(
        Size::from_wh(f(0x42C80000U), f(0x42480000U))
        .unwrap()
        .to_rect(1.5, -2.0),
      ),
    ),
    "3fc00000,c0000000,42cb0000,42400000",
  )
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x40400000U), f(0x40E00000U))
          .unwrap()
          .scale_to(Size::from_wh(f(0x42C80000U), f(0x42480000U)).unwrap()),
        ),
      ),
    ),
    "41ab6db7,42480000",
  )
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x40400000U), f(0x40E00000U))
          .unwrap()
          .expand_to(Size::from_wh(f(0x42C80000U), f(0x42480000U)).unwrap()),
        ),
      ),
    ),
    "42c80000,43695555",
  )
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x40400000U), f(0x40E00000U))
          .unwrap()
          .scale_to(Size::from_wh(f(0x40400000U), f(0x40E00000U)).unwrap()),
        ),
      ),
    ),
    "40400000,40e00000",
  )
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x40400000U), f(0x40E00000U))
          .unwrap()
          .expand_to(Size::from_wh(f(0x40400000U), f(0x40E00000U)).unwrap()),
        ),
      ),
    ),
    "40400000,40e00000",
  )
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x40400000U), f(0x40E00000U))
          .unwrap()
          .scale_to(Size::from_wh(f(0x3ECCCCCDU), f(0x3F19999AU)).unwrap()),
        ),
      ),
    ),
    "3e83a83b,3f19999a",
  )
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x40400000U), f(0x40E00000U))
          .unwrap()
          .expand_to(Size::from_wh(f(0x3ECCCCCDU), f(0x3F19999AU)).unwrap()),
        ),
      ),
    ),
    "3ecccccd,3f6eeeef",
  )
  assert_eq(
    dg(
      dsize(
        Some(
          Size::from_wh(f(0x40400000U), f(0x40E00000U))
