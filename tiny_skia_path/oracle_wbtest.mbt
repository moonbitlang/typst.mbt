///|
test "160 random 103" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x41B80000U), f(0x421C0000U))
  pb.quad_to(f(0x428FDE4AU), f(0x431874F7U), f(0x4265EFB8U), f(0x3FBAA140U))
  pb.move_to(f(0x4269EEB2U), f(0x3F754280U))
  pb.line_to(f(0x42598CC4U), f(0x40DBDEF0U))
  pb.quad_to(f(0x42CBCD1EU), f(0x432CE8C6U), f(0x42CBF71AU), f(0x432C68C6U))
  pb.close()
  let path = pb.finish()
