///|
test "53 big wide" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x46380000U), f(0xC6380000U))
  pb.line_to(f(0x46A00000U), f(0xC6A00000U))
  pb.line_to(f(0x468C0000U), f(0xC68C0000U))
  pb.line_to(f(0x46100000U), f(0xC6100000U))
  pb.line_to(f(0x46380000U), f(0xC6380000U))
  pb.close()
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 46380000,c6380000 L 46a00000,c6a00000 L 468c0000,c68c0000 L 46100000,c6100000 L 46380000,c6380000 Z | b 46100000,c6a00000,46a00000,c6100000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "46100000,c6a00000,46a00000,c6100000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x505F0A09U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "M cf9db651,cf9db67f L cf9db640,cf9db690 L 4f9db691,4f9db641 L 4f9db68c,4f9db646 L 4f9db67a,4f9db656 L cf9db657,cf9db67b L cf9db652,cf9db680 Z M 4f9db680,4f9db652 L 4f9db67b,4f9db657 L 46100000,c6100000 L cf9db656,cf9db67a L cf9db646,cf9db68c L cf9db641,cf9db691 L 46a00000,c6a00000 L 4f9db690,4f9db640 L 4f9db67f,4f9db651 Z | b cf9db657,cf9db691,4f9db691,4f9db657",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x505F0A09U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "cf9db657,cf9db691,4f9db691,4f9db657",
  )
}

///|
test "54 quad_stroker_one_off wide" {
