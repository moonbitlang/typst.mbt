///|
test "138 random 81" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x38D1B717U), f(0x00000000U))
  pb.close()
  pb.cubic_to(
    f(0x38D1B717U),
    f(0x00000000U),
    f(0x43010000U),
    f(0x42680000U),
    f(0x42B47C4CU),
    f(0xC261F06EU),
  )
  pb.line_to(f(0xC16E5E18U), f(0x433AE26EU))
  pb.cubic_to(
    f(0xC1700000U),
    f(0x41F80000U),
    f(0x42CBCF32U),
    f(0x401A6C80U),
    f(0x41980000U),
    f(0x42920000U),
  )
  pb.cubic_to(
    f(0x41980000U),
    f(0x42920000U),
    f(0x421C0000U),
    f(0x42DE0000U),
    f(0x421C001AU),
    f(0x42DE0000U),
  )
  pb.cubic_to(
    f(0x43450B44U),
    f(0x42C1A9D8U),
    f(0x43140000U),
    f(0x40800000U),
    f(0x43140000U),
    f(0x40800000U),
  )
  pb.move_to(f(0x43140000U), f(0x40800000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 38d1b717,00000000 Z M 38d1b717,00000000 C 38d1b717,00000000 43010000,42680000 42b47c4c,c261f06e L c16e5e18,433ae26e C c1700000,41f80000 42cbcf32,401a6c80 41980000,42920000 C 41980000,42920000 421c0000,42de0000 421c001a,42de0000 C 43450b44,42c1a9d8 43140000,40800000 43140000,40800000 M 43140000,40800000 | b c1700000,c261f06e,43450b44,433ae26e",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c16e5e5e,c261f06e,431b3153,433ae26e",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x3F800000U), 1, 1),
          f(0x3DCCCCCDU),
        ),
      ),
    ),
    "#2087 2bb6c85b9c219fc4 M 3f00068e,00000000 L 3f00068e,00000000 Q 3f00068d,3e5413cc 3eb5120e,3eb504f3 Q 3e542e03,3effffff 38",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x3F800000U), 1, 1), f(0x3DCCCCCDU))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c1765e6f,c263fe4f,431c1c9d,433b74db",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40E00000U), f(0x3F800000U), 1, 3),
          f(0x3DCCCCCDU),
        ),
      ),
    ),
    "#1983 6c6d10e8efe73ac0 M 406001a3,00000000 L 406001a3,00000000 Q 406001a2,3fb99153 401e65f7,401e6454 Q 3fb99498,405fffff 38",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40E00000U), f(0x3F800000U), 1, 3), f(0x3DCCCCCDU))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c1932f38,c2677dd2,431f1ea6,433c45c7",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x3F000000U), 0, 3),
          f(0x3DCCCCCDU),
        ),
      ),
    ),
    "#1317 df98dcd5d9c23eff M 3e520f0a,bee97c58 Q 42016f9b,4160031a 426ea2ac,416307d5 Q 42a6b7c0,4165a6c0 42b8232f,3ebfe627 Q 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x3F000000U), 0, 3), f(0x3DCCCCCDU))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c1765e6f,c262bb7c,431c1c9d,433b1532",
  )
}

///|
test "139 random 82" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x38D1B717U), f(0x00000000U))
  pb.line_to(f(0x4317C1CDU), f(0x41F69CD8U))
  pb.cubic_to(
    f(0x4317C1CDU),
    f(0x41F69CD8U),
    f(0x43130000U),
    f(0x41A00000U),
    f(0x4206C698U),
    f(0x41B48024U),
  )
  pb.line_to(f(0x4206C698U), f(0x41B48024U))
  pb.line_to(f(0x42D836BAU), f(0x408F1CF0U))
  pb.cubic_to(
    f(0xC25E7E6DU),
    f(0xC2B4AC67U),
    f(0x4313D407U),
    f(0x42790E18U),
    f(0x4313D407U),
    f(0x42790E18U),
  )
  pb.cubic_to(
    f(0x4313D40EU),
    f(0x42790E18U),
