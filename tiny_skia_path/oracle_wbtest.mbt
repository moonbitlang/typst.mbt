          f(0x3F800000U),
        ),
      ),
    ),
    "#441 ef95dfb2f9b0c4d0 M 40da496e,429847dc Q 42be0004,40617400 43372db5,429847dc Q 4338c6fa,429ae9f3 4338fa0c,429f0969 Q 43",
  )
