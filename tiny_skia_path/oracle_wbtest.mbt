  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 426cfecc,428c1b30 C c2872622,c28fae5d c2872622,c28fae5d c2872622,c28fae5d C c1299e70,42bb16f0 42b0af14,41f3f530 40495e00,431409d3 | b c2872622,c28fae5d,42b0af14,431409d3",
