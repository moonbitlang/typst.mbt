        path
        .dash(d, f(0x3F800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#4107 fc790ce88ee9171b M 00000000,bf800000 L 38d1b717,bf800000 L 38d1b717,00000000 L be003dad,bf7dfb36 L 40a57b6c,bfd4a35e ",
  )
  assert_eq(
    dg(dpath(path.dash(d, f(0x3E800000U)))),
    "#639 0fbdfa0a14fdf547 M 00000000,00000000 L 38d1b717,00000000 Q 403dfb94,bebbd78c 40b9be58,bf3c2073 M 41128fc8,bf96a3a4 Q ",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3E800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#4107 2b4bd5a10a7cf01d M 00000000,bf800000 L 38d1b717,bf800000 L 38d1b717,00000000 L be0083f4,bf7df8fd L 40b5b967,bfdd0cb8 ",
  )
  let d = StrokeDash::new(
    [f(0x3F800000U), f(0x40000000U), f(0x40400000U), f(0x40800000U)],
    f(0x40200000U),
  ).unwrap()
