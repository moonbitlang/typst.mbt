    dg(dpath(path.dash(d, f(0x3E800000U)))),
    "#41259655 98b474ac97e72bf2 M 49742405,c9f423e8 L 49742415,c9f42399 M 4974241d,c9f42371 L 4974242d,c9f42321 M 49742435,c9f422f9 ",
  )
