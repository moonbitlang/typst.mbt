        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#973 f3e0820b6e858059 M 3fc147ae,3f0000f1 Q 3fc1477c,3f6b19c1 3f9b6a2e,3f9b6a2e Q 3f6b19c1,3fc1477c 3f0000f1,3fc147ae Q 3d",
  )
  assert_eq(
    dg(dpath(path.dash(d, f(0x3E800000U)))),
    "M 3f028f5c,3f000000 Q 3f028f5b,3f010f75 3f01cf68,3f01cf68 Q 3f010f75,3f028f5b 3f000000,3f028f5c Q 3efde114,3f028f5b 3efc612e,3f01cf68 Q 3efae147,3f010f75 3efae148,3f000000 Q 3efae147,3efde114 3efc612e,3efc612e Q 3efde114,3efae148 3f000000,3efae148 Q 3f010f75,3efae148 3f01cf68,3efc612e Q 3f028f5b,3efde114 3f028f5c,3f000000 | b 3efae147,3efae148,3f028f5c,3f028f5c",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3E800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#973 f3e0820b6e858059 M 3fc147ae,3f0000f1 Q 3fc1477c,3f6b19c1 3f9b6a2e,3f9b6a2e Q 3f6b19c1,3fc1477c 3f0000f1,3fc147ae Q 3d",
  )
  let d = StrokeDash::new(
    [f(0x3F800000U), f(0x40000000U), f(0x40400000U), f(0x40800000U)],
    f(0x40200000U),
  ).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
  let d = StrokeDash::new([f(0x41200000U), f(0x40A00000U)], f(0xC0400000U)).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
  let d = StrokeDash::new([f(0x00000000U), f(0x40800000U)], f(0x00000000U)).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
    "M 3f028f5c,3f000000 L 3f028f5c,3f000000 | b 3f028f5c,3f000000,3f028f5c,3f000000",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3F800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#405 d3c4154244713dd6 M 3fc147ae,3f000000 L 3fc147ae,3f000000 Q 3fc147ad,3f6a09e5 3f9bca27,3f9a8279 Q 3f6c9942,3fbfffff 3f",
  )
  assert_eq(
    dg(dpath(path.dash(d, f(0x3E800000U)))),
    "M 3f028f5c,3f000000 L 3f028f5c,3f000000 | b 3f028f5c,3f000000,3f028f5c,3f000000",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3E800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#405 d3c4154244713dd6 M 3fc147ae,3f000000 L 3fc147ae,3f000000 Q 3fc147ad,3f6a09e5 3f9bca27,3f9a8279 Q 3f6c9942,3fbfffff 3f",
  )
}

///|
test "18 zero circle" {
  let pb = PathBuilder::new()
  pb.push_circle(f(0x40A00000U), f(0x40A00000U), f(0x00000000U))
  pb.move_to(f(0x3F800000U), f(0x3F800000U))
  pb.line_to(f(0x40000000U), f(0x40000000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "#405 040334242aec55bf M 40a00000,40a00000 Q 409fffff,40a00000 409fffff,40a00000 Q 409fffff,40a00000 40a00000,40a00000 Q 40",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "3f800000,3f800000,40a00000,40a00000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "#405 2c5094f48197b223 M 41600000,40d00000 Q 415fffff,40d00000 415fffff,40d00000 Q 415fffff,40d00000 41600000,40d00000 Q 41",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "412ccccd,c02ccccd,41600000,40d00000",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "#405 299a8e55e3e6e55a M 3fbc2e1e,40dd545c Q 3fbc2e1a,40dd545c 3fbc2e1a,40dd545c Q 3fbc2e1a,40dd545c 3fbc2e1e,40dd545c Q 3f",
  )
  assert_eq(
