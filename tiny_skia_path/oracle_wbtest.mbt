}

///|
test "46 line without move" {
  let pb = PathBuilder::new()
  pb.line_to(f(0x41F00000U), f(0x41A00000U))
  pb.line_to(f(0x41F00000U), f(0x42200000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 L 41f00000,41a00000 L 41f00000,42200000 | b 00000000,00000000,41f00000,42200000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "00000000,00000000,41f00000,42200000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 L 42240000,42300000 L 41d80000,42a80000 | b 41200000,c0a00000,42240000,42a80000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41200000,c0a00000,42240000,42a80000",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 L 41644701,42047349 L 4057f8b0,42478b42 | b 00000000,00000000,41644701,42478b42",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "00000000,00000000,41644701,42478b42",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 L 427d0000,40200000 L 427d0000,41480000 | b 40500000,c0f00000,427d0000,41480000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40500000,c0f00000,427d0000,41480000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 3e8e00d5,bed50140 L 41f40000,419ddbf9 L 41f40000,42200000 L 41ec0000,42200000 L 41ec0000,41a00000 L 41f00000,41a00000 L 41edc7fd,41a35405 L be8e00d5,3ed50140 L 3e8e00d5,bed50140 Z | b be8e00d5,bed50140,41f40000,42200000",
