///|
test "23 quad control equals start" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.quad_to(f(0x00000000U), f(0x00000000U), f(0x42C80000U), f(0x42480000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 Q 00000000,00000000 42c80000,42480000 | b 00000000,00000000,42c80000,42480000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "00000000,00000000,42c80000,42480000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 Q 41200000,c0a00000 42fa0000,42fa0000 | b 41200000,c0a00000,42fa0000,42fa0000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41200000,c0a00000,42fa0000,42fa0000",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 Q 00000000,00000000 42628a59,42c0cb7c | b 00000000,00000000,42628a59,42c0cb7c",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "00000000,00000000,42628a59,42c0cb7c",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 Q 40500000,c0f00000 434b4000,418c0000 | b 40500000,c0f00000,434b4000,418c0000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40500000,c0f00000,434b4000,418c0000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 3e64f92e,bee4f92e L 42c8727d,4246360e L 42c78d83,4249c9f2 L be64f92e,3ee4f92e L 3e64f92e,bee4f92e Z | b be64f92e,bee4f92e,42c8727d,4249c9f2",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "be64f92e,bee4f92e,42c8727d,4249c9f2",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#405 fc7dcb0f4a9ca8df M 400f1bbd,c08f1bbd L 42cc78de,42361c88 Q 42d02d4d,4239d0f8 42d17ca0,4241ace9 Q 42d2cbf4,424988db 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41200000U), f(0x40800000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0a07866,c0a07866,42d20786,425c0f0c",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 3fabbae2,c02bbae2 L 42caaeec,423d4452 L 42d00cc3,4242a229 L 42caaeeb,42581985 L 42c55114,4252bbae L c080cc2a,3fabbae2 L bfabbae2,c080cc2a Z | b c080cc2a,c080cc2a,42d00cc3,42581985",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c080cc2a,c080cc2a,42d00cc3,42581985",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x41200000U), 0, 1),
