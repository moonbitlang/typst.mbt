///|
test "130 random 73" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x41800000U), f(0x43130000U))
  pb.quad_to(f(0xC281F4D8U), f(0x42868B0AU), f(0xC281F4D8U), f(0x42868B0AU))
  pb.quad_to(f(0x4261BFA0U), f(0x42A348C0U), f(0x4261BFBAU), f(0x42A348C0U))
  pb.close()
  pb.quad_to(f(0x432481E2U), f(0x42B20B9AU), f(0x429E0000U), f(0x42380000U))
  pb.close()
  pb.close()
  pb.line_to(f(0x427D385CU), f(0x4333AD1CU))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 41800000,43130000 Q c281f4d8,42868b0a c281f4d8,42868b0a Q 4261bfa0,42a348c0 4261bfba,42a348c0 Z M 41800000,43130000 Q 432481e2,42b20b9a 429e0000,42380000 Z M 41800000,43130000 L 427d385c,4333ad1c | b c281f4d8,42380000,432481e2,4333ad1c",
  )
