  )
}

///|
test "21 quad degenerate (control outside ends)" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.quad_to(f(0x43160000U), f(0x00000000U), f(0x42C80000U), f(0x00000000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 Q 43160000,00000000 42c80000,00000000 | b 00000000,00000000,43160000,00000000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "00000000,00000000,42e10000,00000000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 Q 436b0000,42200000 43200000,41c80001 | b 41200000,c0a00000,436b0000,42200000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41200000,c0a00000,4332c000,41e60000",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 Q 42fb99e6,42a36447 42a7bbef,4259db0a | b 00000000,00000000,42fb99e6,42a36447",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "00000000,00000000,42bcb36d,4275166a",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 Q 4397a000,c0f00000 434b4000,c0f00000 | b 40500000,c0f00000,4397a000,c0f00000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40500000,c0f00000,43644000,c0f00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 00000000,bf000000 L 42e10000,bf000000 L 42e10000,00000000 L 42e10000,3f000000 L 42c80000,3f000000 L 42c80000,bf000000 L 42e10000,bf000000 Q 42e16a0a,beffffff 42e1b505,beb504f3 Q 42e20000,be5413cc 42e20000,00000000 Q 42e20000,3e5413cc 42e1b505,3eb504f3 Q 42e16a0a,3effffff 42e10000,3f000000 L 00000000,3f000000 L 00000000,bf000000 Z | b 00000000,bf000000,42e20000,3f000000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,bf000000,42e20000,3f000000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#637 1583a3a5c0a22897 M 00000000,c0a00000 L 42e10000,c0a00000 L 42e10000,00000000 L 42e10000,40a00000 L 42c80000,40a00000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41200000U), f(0x40800000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0a00000,c0a00000,42eb0000,40a00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "#413 0cb3b82fb3e9f7ff M 00000000,c0400000 L 42e10000,c0400000 L 42e10000,00000000 L 42e10000,40400000 L 42c80000,40400000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0400000,c0400000,42e70000,40400000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x41200000U), 0, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 00000000,c0800000 L 42e10000,c0800000 L 42e10000,00000000 L 42e10000,40800000 L 42c80000,40800000 L 42c80000,c0800000 L 42e10000,c0800000 Q 42e4504e,c07fffff 42e6a826,c03504f3 Q 42e8fffe,bfd413cc 42e90000,00000000 Q 42e8fffe,3fd413cc 42e6a826,403504f3 Q 42e4504e,407fffff 42e10000,40800000 L 00000000,40800000 L 00000000,c0800000 Z | b 00000000,c0800000,42e90000,40800000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41000000U), f(0x41200000U), 0, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,c0800000,42e90000,40800000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "#413 56e2c2d54fdf3a97 M 00000000,c0800000 L 42e10000,c0800000 L 42e10000,00000000 L 42e10000,40800000 L 42c80000,40800000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0800000,c0800000,42e90000,40800000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40800000U), f(0x40800000U), 1, 0),
          f(0x40200000U),
        ),
      ),
    ),
    "#637 2f261a64b4afdaaa M 00000000,c0000000 L 42e10000,c0000000 L 42e10000,00000000 L 42e10000,40000000 L 42c80000,40000000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40800000U), f(0x40800000U), 1, 0), f(0x40200000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0000000,c0000000,42e50000,40000000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F000000U), f(0x40800000U), 0, 2),
          f(0x3E99999AU),
        ),
      ),
    ),
    "M 00000000,be800000 L 42e10000,be800000 L 42e10000,00000000 L 42e10000,3e800000 L 42c80000,3e800000 L 42c80000,be800000 L 42e10000,be800000 Q 42e13504,be7fffff 42e15a81,be3504f3 Q 42e17fff,bdd413cc 42e18000,00000000 Q 42e17fff,3dd413cc 42e15a81,3e3504f3 Q 42e13504,3e7fffff 42e10000,3e800000 L 00000000,3e800000 L 00000000,be800000 Z | b 00000000,be800000,42e18000,3e800000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F000000U), f(0x40800000U), 0, 2), f(0x3E99999AU))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,be800000,42e18000,3e800000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41A00000U), f(0x3F800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 00000000,c1200000 L 42e10000,c1200000 L 42e10000,00000000 L 42e10000,41200000 L 42c80000,41200000 L 42c80000,c1200000 L 42e10000,c1200000 Q 42e948c5,c11fffff 42ef2462,c0e2462f Q 42f4ffff,c0848c5f 42f50000,00000000 Q 42f4ffff,40848c5f 42ef2462,40e2462f Q 42e948c5,411fffff 42e10000,41200000 L 00000000,41200000 L 00000000,c1200000 Z | b 00000000,c1200000,42f50000,41200000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41A00000U), f(0x3F800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,c1200000,42f50000,41200000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40400000U), f(0x40800000U), 2, 2),
          f(0x41200000U),
        ),
      ),
    ),
    "#413 1413c97318266fdb M 00000000,bfc00000 L 42e10000,bfc00000 L 42e10000,00000000 L 42e10000,3fc00000 L 42c80000,3fc00000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40400000U), f(0x40800000U), 2, 2), f(0x41200000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "bfc00000,bfc00000,42e40000,3fc00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x00000000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  let d = StrokeDash::new([f(0x40A00000U), f(0x40400000U)], f(0x00000000U)).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
