    "#2235 807b12f0044cbb5e M 40200000,3f800000 L 40b00000,3f800000 Q 40bd413b,3f800000 40c6a09d,3fa57d86 Q 40cffffe,3fcafb0c 40",
  )
  let d = StrokeDash::new([f(0x41200000U), f(0x40A00000U)], f(0xC0400000U)).unwrap()
  assert_eq(
