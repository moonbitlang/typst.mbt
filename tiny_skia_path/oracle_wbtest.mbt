  )
  let d = StrokeDash::new([f(0x41200000U), f(0x40A00000U)], f(0xC0400000U)).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
    "#619 3389465f896100e9 M 40400000,00000000 L 41500000,00000000 M 41900000,00000000 L 41e00000,00000000 M 42040000,00000000 ",
