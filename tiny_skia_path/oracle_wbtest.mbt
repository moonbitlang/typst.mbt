    "#771 9df240420be25cd1 M 40c00000,40a00000 L 40c00000,40a00000 Q 40bfffff,40ad413c 40b6a09d,40b6a09d Q 40ad413c,40bfffff 40",
  )
}

///|
test "19 quad" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x41200000U), f(0x42A00000U))
  pb.quad_to(f(0x42BE0000U), f(0x41200000U), f(0x43340000U), f(0x42A00000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 41200000,42a00000 Q 42be0000,41200000 43340000,42a00000 | b 41200000,41200000,43340000,42a00000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "41200000,42340000,43340000,42a00000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M c1f80000,431e0000 Q 43118000,422e0000 43600000,43510000 | b c1f80000,422e0000,43600000,43510000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c1f80000,42de5af8,43600000,43510000",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M c20cbcd8,4291147f Q 42947463,4270827a 42d6c776,432520f0 | b c20cbcd8,4270827a,42d6c776,432520f0",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c20cbcd8,428e74a4,42d6c776,432520f0",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41ba0000,42020000 Q 43414000,c0200000 43b5a000,42020000 | b 41ba0000,c0200000,43b5a000,42020000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41ba0000,41700000,43b5a000,42020000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
