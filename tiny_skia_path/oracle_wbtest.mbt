///|
test "43 right angles open" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.line_to(f(0x42480000U), f(0x00000000U))
  pb.line_to(f(0x42480000U), f(0x42480000U))
  pb.line_to(f(0x00000000U), f(0x42480000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 L 42480000,00000000 L 42480000,42480000 L 00000000,42480000 | b 00000000,00000000,42480000,42480000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "00000000,00000000,42480000,42480000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 L 42aa0000,41200001 L 42480000,42dc0000 L c1c80000,42be0000 | b c1c80000,c0a00000,42aa0000,42dc0000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c1c80000,c0a00000,42aa0000,42dc0000",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 L 4227bbef,41d9db0a L 416b39a8,428a54ba L c1d9db0a,4227bbef | b c1d9db0a,00000000,4227bbef,428a54ba",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c1d9db0a,00000000,4227bbef,428a54ba",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 L 42ce8000,c0f00000 L 42ce8000,418c0000 L 40500000,418c0000 | b 40500000,c0f00000,42ce8000,418c0000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40500000,c0f00000,42ce8000,418c0000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
