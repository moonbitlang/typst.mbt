        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#265155213 fa6171c6020cd742 M 49742415,c9f423e9 L 49742425,c9f4239a Q 49742424,c9f42395 49742421,c9f42393 Q 4974241d,c9f42391 49",
  )
  let d = StrokeDash::new([f(0x00000000U), f(0x40800000U)], f(0x00000000U)).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
}

///|
test "50 big" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x46380000U), f(0xC6380000U))
  pb.line_to(f(0x46A00000U), f(0xC6A00000U))
  pb.line_to(f(0x468C0000U), f(0xC68C0000U))
  pb.line_to(f(0x46100000U), f(0xC6100000U))
  pb.line_to(f(0x46380000U), f(0xC6380000U))
  pb.close()
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 46380000,c6380000 L 46a00000,c6a00000 L 468c0000,c68c0000 L 46100000,c6100000 L 46380000,c6380000 Z | b 46100000,c6a00000,46a00000,c6100000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "46100000,c6a00000,46a00000,c6100000",
  )
  let t = path.transform(
