///|
test "32 cubic collinear 3" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.cubic_to(
    f(0x43480000U),
    f(0x00000000U),
    f(0xC2C80000U),
    f(0x00000000U),
    f(0x42C80000U),
    f(0x00000000U),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 C 43480000,00000000 c2c80000,00000000 42c80000,00000000 | b c2c80000,00000000,43480000,00000000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "00000000,00000000,42c80000,00000000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 C 439b0000,425c0001 c30c0000,c20c0000 43200000,41c80001 | b c30c0000,c20c0000,439b0000,425c0001",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41200000,c0a00000,43200000,41c80001",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 C 4327bbef,42d9db0a c2a7bbef,c259db0a 42a7bbef,4259db0a | b c2a7bbef,c259db0a,4327bbef,42d9db0a",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "00000000,00000000,42a7bbef,4259db0a",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 C 43c9a000,c0f00000 c344c000,c0f00000 434b4000,c0f00000 | b c344c000,c0f00000,43c9a000,c0f00000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40500000,c0f00000,434b4000,c0f00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#645 b526f400e71c1abb M 00000000,bf000000 L 4290b8ab,bf000000 L 4290b8ab,00000000 L 4290b8ab,3f000000 L 42480007,3f000000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,bf000000,42c80000,3f000000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#909 1bd760c9aeaa2c98 M 00000000,c0a00000 L 4290b8ab,c0a00000 L 4290b8ab,00000000 L 4290b8ab,40a00000 L 42480007,40a00000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41200000U), f(0x40800000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0a00000,c0a00000,42d20000,40a00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "#685 671594933d1f4469 M 00000000,c0400000 L 4290b8ab,c0400000 L 4290b8ab,00000000 L 4290b8ab,40400000 L 42480007,40400000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0400000,c0400000,42ce0000,40400000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x41200000U), 0, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "#645 55e1455bb03c94ce M 00000000,c0800000 L 4290b8ab,c0800000 L 4290b8ab,00000000 L 4290b8ab,40800000 L 42480007,40800000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41000000U), f(0x41200000U), 0, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,c0800000,42c80000,40800000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "#685 8b05038c4e70340d M 00000000,c0800000 L 4290b8ab,c0800000 L 4290b8ab,00000000 L 4290b8ab,40800000 L 42480007,40800000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c0800000,c0800000,42d00000,40800000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40800000U), f(0x40800000U), 1, 0),
          f(0x40200000U),
        ),
      ),
    ),
    "#909 bcbc642928f8e4ef M 00000000,bfffffff L 4290b8ab,bfffffff L 4290b8ab,00000000 L 4290b8ab,40000000 L 42480007,40000000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40800000U), f(0x40800000U), 1, 0), f(0x40200000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "bfffffff,c0000000,42cc0000,40000000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F000000U), f(0x40800000U), 0, 2),
          f(0x3E99999AU),
        ),
      ),
    ),
    "#645 fa3c06f71f8d8e2f M 00000000,be800000 L 4290b8ab,be800000 L 4290b8ab,00000000 L 4290b8ab,3e7fffff L 42480007,3e7fffff ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F000000U), f(0x40800000U), 0, 2), f(0x3E99999AU))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,be800000,42c80000,3e800000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41A00000U), f(0x3F800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#645 dc6f1a0306654c89 M 00000000,c1200000 L 4290b8ab,c1200000 L 4290b8ab,00000000 L 4290b8ab,41200000 L 42480007,41200000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41A00000U), f(0x3F800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,c1200000,42c80000,41200000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40400000U), f(0x40800000U), 2, 2),
          f(0x41200000U),
        ),
      ),
    ),
    "#685 8cb23e396a35d671 M 00000000,bfbfffff L 4290b8ab,bfbfffff L 4290b8ab,00000000 L 4290b8ab,3fc00000 L 42480007,3fc00000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40400000U), f(0x40800000U), 2, 2), f(0x41200000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "bfbfffff,bfc00000,42cb0000,3fc00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x00000000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  let d = StrokeDash::new([f(0x40A00000U), f(0x40400000U)], f(0x00000000U)).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
    "#1863 a00b46910b5aa125 M 00000000,00000000 C 3fe7012c,00000000 40646622,00000000 40a95e57,00000000 M 4105a5ea,00000000 C 41",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3F800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
