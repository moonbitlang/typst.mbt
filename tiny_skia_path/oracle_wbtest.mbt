  pb.line_to(f(0x424C0000U), f(0x42B40000U))
  pb.line_to(f(0xC0A5B9D0U), f(0xC273EA6DU))
  pb.line_to(f(0x428306F0U), f(0x42BD4ACCU))
  pb.quad_to(f(0x428306FDU), f(0x42BD4ACCU), f(0x428306FDU), f(0x42BD4ACCU))
