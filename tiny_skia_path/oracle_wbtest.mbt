        ),
      ),
    ),
    "M 00000000,c0400000 L 42c80000,c0400000 L 42c80189,403ffffa L c03fced3,40469787 L c0403121,c039686d L 42c7fe77,c03ffffa L 42c80000,00000000 L 42c80000,40400000 L c0400000,40400000 L c0400000,c0400000 Z | b c0403121,c0400000,42c80189,40469787",
  )
  assert_eq(
