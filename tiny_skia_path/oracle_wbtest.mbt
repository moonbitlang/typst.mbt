///|
test "33 cubic_1" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x424C1086U), f(0x44BCF0CBU))
  pb.cubic_to(
    f(0x424C1086U),
    f(0x44BCF0CBU),
    f(0x424C1086U),
    f(0x44BCF0CBU),
    f(0x424C1086U),
    f(0x44BCF0CBU),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 424c1086,44bcf0cb C 424c1086,44bcf0cb 424c1086,44bcf0cb 424c1086,44bcf0cb | b 424c1086,44bcf0cb,424c1086,44bcf0cb",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "424c1086,44bcf0cb,424c1086,44bcf0cb",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M c472e2c4,453d95ac C c472e2c4,453d95ac c472e2c4,453d95ac c472e2c4,453d95ac | b c472e2c4,453d95ac,c472e2c4,453d95ac",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c472e2c4,453d95ac,c472e2c4,453d95ac",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M c4431cc8,44a1ee9d C c4431cc8,44a1ee9d c4431cc8,44a1ee9d c4431cc8,44a1ee9d | b c4431cc8,44a1ee9d,c4431cc8,44a1ee9d",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c4431cc8,44a1ee9d,c4431cc8,44a1ee9d",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 42d29086,443b10cb C 42d29086,443b10cb 42d29086,443b10cb 42d29086,443b10cb | b 42d29086,443b10cb,42d29086,443b10cb",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "42d29086,443b10cb,42d29086,443b10cb",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#405 45c3a40908e05205 M 42601086,44bcf0cb L 42601086,44bcf0cb Q 42601085,44bd3310 425a34e9,44bd61ee Q 4254594b,44bd90ca 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41200000U), f(0x40800000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "42381086,44bc50cb,42601086,44bd90cb",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 42581086,44bcf0cb L 42581086,44bcf0cb L 42581086,44bd50cb L 42401086,44bd50cb L 42401086,44bcf0cb L 42401086,44bc90cb L 42581086,44bc90cb Z | b 42401086,44bc90cb,42581086,44bd50cb",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "42401086,44bc90cb,42581086,44bd50cb",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x41200000U), 0, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 425c1086,44bcf0cb L 425c1086,44bcf0cb L 425c1086,44bd70cb L 423c1086,44bd70cb L 423c1086,44bcf0cb L 423c1086,44bc70cb L 425c1086,44bc70cb Z | b 423c1086,44bc70cb,425c1086,44bd70cb",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "423c1086,44bc70cb,425c1086,44bd70cb",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40800000U), f(0x40800000U), 1, 0),
          f(0x40200000U),
        ),
      ),
    ),
    "#405 cfff10975cd9d9a3 M 42541086,44bcf0cb L 42541086,44bcf0cb Q 42541085,44bd0b4d 4251b8ac,44bd1e0c Q 424f60d4,44bd30cb 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40800000U), f(0x40800000U), 1, 0), f(0x40200000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "42441086,44bcb0cb,42541086,44bd30cb",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F000000U), f(0x40800000U), 0, 2),
          f(0x3E99999AU),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41A00000U), f(0x3F800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40400000U), f(0x40800000U), 2, 2),
          f(0x41200000U),
        ),
      ),
    ),
    "M 42521086,44bcf0cb L 42521086,44bcf0cb L 42521086,44bd20cb L 42461086,44bd20cb L 42461086,44bcf0cb L 42461086,44bcc0cb L 42521086,44bcc0cb Z | b 42461086,44bcc0cb,42521086,44bd20cb",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40400000U), f(0x40800000U), 2, 2), f(0x41200000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "42461086,44bcc0cb,42521086,44bd20cb",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x00000000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  let d = StrokeDash::new([f(0x40A00000U), f(0x40400000U)], f(0x00000000U)).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
  let d = StrokeDash::new(
    [f(0x3F800000U), f(0x40000000U), f(0x40400000U), f(0x40800000U)],
    f(0x40200000U),
  ).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
  let d = StrokeDash::new([f(0x41200000U), f(0x40A00000U)], f(0xC0400000U)).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
  let d = StrokeDash::new([f(0x00000000U), f(0x40800000U)], f(0x00000000U)).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
}

///|
test "34 cubic_2" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x424C1086U), f(0x44BCF0CBU))
  pb.cubic_to(
    f(0x424C107CU),
    f(0x44BCF0CBU),
    f(0x424C10C2U),
    f(0x44BCF0CBU),
    f(0x424C1119U),
    f(0x44BCF0CAU),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 424c1086,44bcf0cb C 424c107c,44bcf0cb 424c10c2,44bcf0cb 424c1119,44bcf0ca | b 424c107c,44bcf0ca,424c1119,44bcf0cb",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "424c1085,44bcf0ca,424c1119,44bcf0cb",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M c472e2c4,453d95ac C c472e2c4,453d95ac c472e2be,453d95ac c472e2b4,453d95ab | b c472e2c4,453d95ab,c472e2b4,453d95ac",
  )
