  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40400000U), f(0x40800000U), 2, 2),
          f(0x41200000U),
        ),
      ),
    ),
    "#677 ded64d72ee7a01ad M bf2b795a,bfab7959 Q 3e160336,bfdfb7e4 3f627121,bf9b036a Q 3fa9b4a8,bf63ddf8 3fbaa6c0,beb89a76 Q 3f",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40400000U), f(0x40800000U), 2, 2), f(0x41200000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c000bbc8,bff2bc25,3ff2fdae,4000ecee",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x00000000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  let d = StrokeDash::new([f(0x40A00000U), f(0x40400000U)], f(0x00000000U)).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
    "M 3a83126f,3b03126f C 3b449ba6,3a83126f 3b83126f,3ba3d70a 3b03126f,3bc49ba6 Q 00000000,3b83126f 3a83126f,3a83126f | b 00000000,3a83126f,3b83126f,3bc49ba6",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3F800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#785 b67d9b0df60e83f4 M bee4761e,bf64761c Q 3dc92eea,bf951349 3f1727ec,bf4e822a Q 3f62834f,bf17b410 3f791fde,be75074a Q 3f",
  )
  assert_eq(
    dg(dpath(path.dash(d, f(0x3E800000U)))),
    "M 3a83126f,3b03126f C 3b449ba6,3a83126f 3b83126f,3ba3d70a 3b03126f,3bc49ba6 Q 00000000,3b83126f 3a83126f,3a83126f | b 00000000,3a83126f,3b83126f,3bc49ba6",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3E800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#785 b67d9b0df60e83f4 M bee4761e,bf64761c Q 3dc92eea,bf951349 3f1727ec,bf4e822a Q 3f62834f,bf17b410 3f791fde,be75074a Q 3f",
  )
  let d = StrokeDash::new(
    [f(0x3F800000U), f(0x40000000U), f(0x40400000U), f(0x40800000U)],
    f(0x40200000U),
  ).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
  let d = StrokeDash::new([f(0x41200000U), f(0x40A00000U)], f(0xC0400000U)).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
  let d = StrokeDash::new([f(0x00000000U), f(0x40800000U)], f(0x00000000U)).unwrap()
  assert_eq(
    dg(dpath(path.dash(d, f(0x3F800000U)))),
    "M 3a83126f,3b03126f L 3a83126f,3b03126f | b 3a83126f,3b03126f,3a83126f,3b03126f",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3F800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#405 e7753a82869498ee M 3f8020c5,3b03126f L 3f8020c5,3b03126f Q 3f8020c4,3ed519ef 3f35467c,3f358805 Q 3ed496df,3f804189 3a",
  )
  assert_eq(
    dg(dpath(path.dash(d, f(0x3E800000U)))),
    "M 3a83126f,3b03126f L 3a83126f,3b03126f | b 3a83126f,3b03126f,3a83126f,3b03126f",
  )
  assert_eq(
    dg(
      dpath(
        path
        .dash(d, f(0x3E800000U))
        .unwrap()
        .stroke(stroke_of(f(0x40000000U), f(0x40800000U), 1, 2), f(0x3F800000U)),
      ),
    ),
    "#405 e7753a82869498ee M 3f8020c5,3b03126f L 3f8020c5,3b03126f Q 3f8020c4,3ed519ef 3f35467c,3f358805 Q 3ed496df,3f804189 3a",
  )
}

///|
test "49 large coords" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x49742400U), f(0xC9F42400U))
  pb.line_to(f(0x49B71B00U), f(0x4A371B00U))
  pb.cubic_to(
    f(0x49F42400U),
    f(0x49742400U),
    f(0xC9742400U),
    f(0x00000000U),
    f(0x49742400U),
    f(0xC9F42400U),
  )
  pb.close()
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 49742400,c9f42400 L 49b71b00,4a371b00 C 49f42400,49742400 c9742400,00000000 49742400,c9f42400 Z | b c9742400,c9f42400,49f42400,4a371b00",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "4894a5e8,c9f42400,49be1543,4a371b00",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 4a3100a8,ca61d494 L 48127e80,4ac4d696 C 4a0c61a8,4a1eb0ec c9b71ab0,c8927ca0 4a3100a8,ca61d494 Z | b c9b71ab0,ca61d494,4a3100a8,4ac4d696",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "48127e80,ca61d494,4a3100a8,4ac4d696",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 49eb5866,c98a44f0 L c8b78ce8,4a4b6da9 C 498a44f0,49eb5866 c94cc0e9,c904f7f1 49eb5866,c98a44f0 Z | b c94cc0e9,c98a44f0,49eb5866,4a4b6da9",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c8b78ce8,c98a44f0,49eb5866,4a4b6da9",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 49f4241a,c9742478 L 4a371b0d,49b71ac4 C 4a74240d,48f42310 c9f423e6,c0f00000 49f4241a,c9742478 Z | b c9f423e6,c9742478,4a74240d,49b71ac4",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "4914a61c,c9742478,4a3e1550,49b71ac4",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#27597 a29017699f9ef3d2 M 49742408,c9f42400 L 49b71b04,4a371b00 L 49b71b00,4a371b00 L 49b71afc,4a371b00 L 49bb11dc,4a2d8c84 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "4894afcc,c9f42409,49bd5ca5,4a371b00",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#142933 37f247d40a3c7356 M 49742450,c9f42404 L 49b71b28,4a371afe L 49b71b00,4a371b00 L 49b71ad9,4a371afb L 49b76769,4a368031 ",
  )
