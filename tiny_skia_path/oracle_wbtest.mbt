///|
test "58 random 1" {
  let pb = PathBuilder::new()
  pb.move_to(f(0xC293EF29U), f(0x433A59CEU))
  pb.cubic_to(
    f(0x4286188EU),
    f(0x42887B38U),
    f(0x4286189BU),
    f(0x42887B38U),
    f(0x428618A8U),
    f(0x42887B38U),
  )
  pb.quad_to(f(0x41880000U), f(0x42B60000U), f(0x418A3958U), f(0x42B50000U))
  pb.cubic_to(
    f(0x40E00000U),
    f(0x41E80000U),
    f(0xC268FE89U),
    f(0x4344F134U),
    f(0xC0000000U),
    f(0x41700000U),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M c293ef29,433a59ce C 4286188e,42887b38 4286189b,42887b38 428618a8,42887b38 Q 41880000,42b60000 418a3958,42b50000 C 40e00000,41e80000 c268fe89,4344f134 c0000000,41700000 | b c293ef29,41700000,428618a8,4344f134",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c293ef29,41700000,428618a8,433a59ce",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x42700000U), f(0x41F00000U), 1, 1),
          f(0x40400000U),
        ),
      ),
