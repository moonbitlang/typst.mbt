///|
test "127 random 70" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x42700000U), f(0x42480000U))
  pb.line_to(f(0x41D270B8U), f(0x433FE6BCU))
  pb.line_to(f(0x41C706C0U), f(0x430A960DU))
  pb.quad_to(f(0xC2ABFC01U), f(0xC2AEFFC1U), f(0x421B5058U), f(0x42848C0AU))
  pb.close()
  pb.cubic_to(
    f(0x4317E1FEU),
    f(0x42872F86U),
    f(0x4317E1FEU),
    f(0x42872F86U),
    f(0xC2A18E8CU),
    f(0x42A361AAU),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 42700000,42480000 L 41d270b8,433fe6bc L 41c706c0,430a960d Q c2abfc01,c2aeffc1 421b5058,42848c0a Z M 42700000,42480000 C 4317e1fe,42872f86 4317e1fe,42872f86 c2a18e8c,42a361aa | b c2abfc01,c2aeffc1,4317e1fe,433fe6bc",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c2a18e8c,4080c1e0,42ea776d,433fe6bc",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 42820000,42e20000 L c2a9bf29,43c158d9 L c246c57a,438bd161 Q c266f45c,c34dcbf4 41aecf52,430b3211 Z M 42820000,42e20000 C 433e825b,432fc01f 433e825b,432fc01f c32859e4,430625e2 | b c32859e4,c34dcbf4,433e825b,43c158d9",
  )
