///|
test "167 random 110" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x3D75C290U), f(0xBF000000U))
  pb.cubic_to(
    f(0x3D75C290U),
    f(0xBF000000U),
    f(0x42F253AEU),
    f(0x42BC4C10U),
    f(0x42F253BBU),
