///|
test "68 random 11" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x41BB4548U), f(0xC21E49FCU))
  pb.close()
  pb.cubic_to(
    f(0x41BB457CU),
    f(0xC21E49FCU),
    f(0x432066A0U),
    f(0x42CE14F8U),
    f(0x432066A0U),
    f(0x42CE14F8U),
  )
  pb.quad_to(f(0x431CAFAEU), f(0x432746C4U), f(0x431CAFB5U), f(0x432746C4U))
  pb.cubic_to(
    f(0x4317D75CU),
    f(0xC2721EBEU),
    f(0x42740000U),
    f(0x42980000U),
    f(0x42FC3AFCU),
    f(0x432056EAU),
  )
  pb.line_to(f(0x42FC3B09U), f(0x432056EAU))
  pb.quad_to(f(0x40400000U), f(0x42900000U), f(0x405C7AE1U), f(0x428F0000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 41bb4548,c21e49fc Z M 41bb4548,c21e49fc C 41bb457c,c21e49fc 432066a0,42ce14f8 432066a0,42ce14f8 Q 431cafae,432746c4 431cafb5,432746c4 C 4317d75c,c2721ebe 42740000,42980000 42fc3afc,432056ea L 42fc3b09,432056ea Q 40400000,42900000 405c7ae1,428f0000 | b 40400000,c2721ebe,432066a0,432746c4",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "405c60a0,c21e49fc,432066a0,432746c4",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x3F000000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#2457 690143da2c3dc56b M 41bf4548,c21e49fc L 41bf4548,c21e49fc Q 41bf4548,c21d75e7 41be195c,c21cdff1 Q 41bced70,c21c49fc 41",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x3F000000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "403b7c37,c2204a00,4320e6a1,4327c6cc",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x42700000U), f(0x3F99999AU), 2, 0),
          f(0x41800000U),
        ),
      ),
    ),
    "#2661 a0d96313eae876fc M 4255a2a4,c21e49fc L 4255a2a4,c21e49fc L 4255a2a4,c11927f0 L c0d2eae0,c11927f0 L c0d2eae0,c21e49fc ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x42700000U), f(0x3F99999AU), 2, 0), f(0x41800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c1d47547,c2a3faed,433f1b53,433e56ea",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x3F99999AU), 2, 1),
          f(0x3DCCCCCDU),
        ),
