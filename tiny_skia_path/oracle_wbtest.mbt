///|
test "169 random 112" {
  let pb = PathBuilder::new()
  pb.move_to(f(0xC2287EECU), f(0x4331BF0EU))
  pb.line_to(f(0xC225A7E2U), f(0x43313F0EU))
  pb.cubic_to(
    f(0xC225A7C8U),
    f(0x43313F0EU),
    f(0x42F57BA8U),
    f(0x41E9A528U),
    f(0x42D00000U),
    f(0x42EA0000U),
  )
  pb.cubic_to(
    f(0x42D00000U),
    f(0x42EA0000U),
    f(0x42C80000U),
    f(0x42600000U),
    f(0xC20D3562U),
    f(0xC02D2680U),
  )
  pb.close()
  pb.cubic_to(
    f(0xC2040000U),
    f(0x43120000U),
    f(0xC2040000U),
    f(0x43120000U),
    f(0x423C0000U),
    f(0x425C0000U),
  )
  pb.line_to(f(0x423C001AU), f(0x425C0000U))
  pb.move_to(f(0x423ECEF3U), f(0x425A0000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
