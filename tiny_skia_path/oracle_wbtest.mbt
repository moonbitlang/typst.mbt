    "M bedbcf83,c05e4ef8 Q 422e8bb8,c10eb7ec 4267ea43,c1682cf7 Q 427c4b81,c183fa2b 427c40d0,c187e786 Q 427c3341,c18ce206 4266ccf0,c19e00ae L 42713310,c1d1ff52 Q 428be660,c1b31df7 428c1f98,c189187a Q 428c5a3e,c13c0ba8 427215bd,c0ffa612 Q 42357448,c0052060 3edbcf83,405e4ef8 L bedbcf83,c05e4ef8 Z | b bedbcf83,c1d1ff52,428c5a3e,405e4ef8",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40E00000U), f(0x40800000U), 0, 2), f(0x3DCCCCCDU))
        .unwrap()
        .compute_tight_bounds(),
      ),
