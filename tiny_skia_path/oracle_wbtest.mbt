  pb.cubic_to(
    f(0xC2C43682U),
    f(0xC0A098F0U),
    f(0xC28A82ECU),
    f(0x41297400U),
    f(0xC28A82ECU),
    f(0x41297400U),
  )
  pb.quad_to(f(0xC28A82DFU), f(0x41297400U), f(0x42B20000U), f(0x42EC0000U))
  pb.quad_to(f(0xC218922FU), f(0x427E2F84U), f(0xC23C0000U), f(0x42EE0000U))
