///|
test "22 quad control on line" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.quad_to(f(0x42480000U), f(0x42480000U), f(0x42C80000U), f(0x42C80000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 Q 42480000,42480000 42c80000,42c80000 | b 00000000,00000000,42c80000,42c80000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "00000000,00000000,42c80000,42c80000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 Q 42480000,42dc0000 42b40000,43610000 | b 41200000,c0a00000,42b40000,43610000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41200000,c0a00000,42b40000,43610000",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 Q 416b39a8,428a54ba 41eb39a8,430a54ba | b 00000000,00000000,41eb39a8,430a54ba",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "00000000,00000000,41eb39a8,430a54ba",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 Q 42ce8000,418c0000 434b4000,422a0000 | b 40500000,c0f00000,434b4000,422a0000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40500000,c0f00000,434b4000,422a0000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 3eb504f3,beb504f3 L 42c8b505,42c74afb L 42c74afb,42c8b505 L beb504f3,3eb504f3 L 3eb504f3,beb504f3 Z | b beb504f3,beb504f3,42c8b505,42c8b505",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "beb504f3,beb504f3,42c8b505,42c8b505",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#405 f327cbe39c03cb09 M 40624630,c0624630 L 42cf1232,42c0edce Q 42d1ffff,42c3db9c 42d1ffff,42c7ffff Q 42d1ffff,42cc2462 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41200000U), f(0x40800000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c09fffff,c09fffff,42d1ffff,42d1ffff",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 4007c3b6,c007c3b6 L 42cc3e1e,42c3c1e2 L 42d07c3c,42c80000 L 42c80000,42d07c3c L 42c3c1e2,42cc3e1e L c087c3b6,00000000 L 00000000,c087c3b6 Z | b c087c3b6,c087c3b6,42d07c3c,42d07c3c",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
