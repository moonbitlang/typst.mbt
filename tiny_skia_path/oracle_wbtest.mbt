///|
test "36 cubic_stroker_one_off" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x433F5370U), f(0x43D1F4B3U))
  pb.cubic_to(
    f(0x4331CB76U),
    f(0x43EA3340U),
    f(0x4388F498U),
    f(0x42F7F08DU),
    f(0x43F1CD32U),
    f(0x42802EC1U),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 433f5370,43d1f4b3 C 4331cb76,43ea3340 4388f498,42f7f08d 43f1cd32,42802ec1 | b 4331cb76,42802ec1,43f1cd32,43ea3340",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "433e1311,42802ec1,43f1cd32,43d44957",
  )
  let t = path.transform(
