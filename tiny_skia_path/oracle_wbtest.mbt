///|
test "87 random 30" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x38D1B717U), f(0x00000000U))
  pb.cubic_to(
    f(0xC253A8D0U),
    f(0x430C4D27U),
    f(0xC253A8B6U),
    f(0x430C4D27U),
    f(0x42D60000U),
    f(0x42FE0000U),
  )
  pb.cubic_to(
    f(0x42884A88U),
    f(0xC2B04665U),
    f(0x42884A88U),
    f(0xC2B04665U),
    f(0x424A15F0U),
    f(0x42DDB382U),
  )
  pb.move_to(f(0x43346E2AU), f(0x42D01BF6U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 38d1b717,00000000 C c253a8d0,430c4d27 c253a8b6,430c4d27 42d60000,42fe0000 C 42884a88,c2b04665 42884a88,c2b04665 424a15f0,42ddb382 M 43346e2a,42d01bf6 | b c253a8d0,c2b04665,43346e2a,430c4d27",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c1fcb813,c211b930,43346e2a,4304868d",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 4120009d,c09fffc1 C c3279550,4381dd39 c3279546,4381dd3a 42a33333,438c8ccd C 432dea23,c320d4d0 432dea23,c320d4d0 4102fcc8,4367db8e M 434fceaa,43809e81 | b c3279550,c320d4d0,434fceaa,438c8ccd",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c2e6bce0,c2631af0,434fceaa,438c8ccd",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 38afe1c8,3864702c C c2f1955e,42b1b1bc c2f19554,42b1b1c3 41a48c78,4324c99c C 42d24f42,c21336de 42d24f42,c21336de c190059a,42f0f755 M 42bd4c7f,43398975 | b c2f1955e,c21336de,42d24f42,43398975",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c2b0592a,3864702c,42bd4c7f,43398975",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500347,c0f00000 C c2cd28d0,427a9a4e c2cd28b6,427a9a4e 43594000,42600000 C 430b8a88,c24e4665 430b8a88,c24e4665 42d095f0,423fb382 M 43b60e2a,42321bf6 | b c2cd28d0,c24e4665,43b60e2a,427a9a4e",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c26fb813,c1cdb930,43b60e2a,426b0d1a",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3DCCCCCDU), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1001 1ee75fdb97301b68 M 3d4008ae,3c908b02 Q c1b8d02c,4275944e c1e05a89,42a1d514 Q c20dce00,42dc5a00 c1d22ed0,42f2233b Q c1",
  )
