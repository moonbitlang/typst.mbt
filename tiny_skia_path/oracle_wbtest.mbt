///|
test "158 random 101" {
  let pb = PathBuilder::new()
  pb.move_to(f(0xC037EE60U), f(0xBF7FBD80U))
  pb.close()
  pb.quad_to(f(0x42393580U), f(0xC2A910C0U), f(0x4239359AU), f(0xC2A910C0U))
  pb.close()
  pb.cubic_to(
    f(0xC1FC80A4U),
    f(0xC183A4BCU),
    f(0xC20046ECU),
    f(0xC2BC5F9CU),
    f(0xC20046D2U),
    f(0xC2BC5F9CU),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M c037ee60,bf7fbd80 Z M c037ee60,bf7fbd80 Q 42393580,c2a910c0 4239359a,c2a910c0 Z M c037ee60,bf7fbd80 C c1fc80a4,c183a4bc c20046ec,c2bc5f9c c20046d2,c2bc5f9c | b c20046ec,c2bc5f9c,4239359a,bf7fbd80",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c20046d2,c2bc5f9c,4239359a,bf7fbd80",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x42700000U), f(0x41F00000U), 1, 3),
