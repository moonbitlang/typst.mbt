///|
test "98 random 41" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.close()
  pb.line_to(f(0x42D60000U), f(0xC1100000U))
  pb.quad_to(f(0x42D60000U), f(0xC1100000U), f(0x42C36242U), f(0x42C88DA2U))
  pb.cubic_to(
    f(0x42C4E13CU),
    f(0x42C78DA2U),
    f(0xC2C34131U),
    f(0x4314BFB4U),
    f(0xC2C14B3BU),
    f(0x425187F8U),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 Z M 00000000,00000000 L 42d60000,c1100000 Q 42d60000,c1100000 42c36242,42c88da2 C 42c4e13c,42c78da2 c2c34131,4314bfb4 c2c14b3b,425187f8 | b c2c34131,c1100000,42d60000,4314bfb4",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c2c14d1e,c1100000,42d60000,42e08fac",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3DCCCCCDU), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1189 f01ab248a2a41bd1 M 3d4ccccd,00000000 L 3d4ccccd,00000000 L 3d4ccccd,3d4ccccd L bd4ccccd,3d4ccccd L bd4ccccd,00000000 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3DCCCCCDU), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c2c166b9,c110cc14,42d61982,42e0adce",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41700000U), f(0x3F99999AU), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1005 c8c29bd8152d1f4d M bf20ed55,c0ef27d0 L 42d4be25,c183c9f4 L 42e4f225,c105d0bd L 42d25467,42c9d38a L 42c36242,42c88da2 ",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41700000U), f(0x3F99999AU), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c2d04d35,c183c9f4,42e4f225,42ef947d",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40E00000U), f(0x3F000000U), 1, 2),
          f(0x3DCCCCCDU),
        ),
      ),
    ),
    "#1803 0ebf08ab31662286 M 40600000,00000000 L 40600000,00000000 Q 405fffff,3fb99153 401e6454,401e6454 Q 3fb99153,405fffff 00",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40E00000U), f(0x3F000000U), 1, 2), f(0x3DCCCCCDU))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c2c84d42,c14806c4,42dd0001,42e79482",
  )
}

///|
test "99 random 42" {
  let pb = PathBuilder::new()
  pb.move_to(f(0xC245B27FU), f(0x430E75AFU))
  pb.quad_to(f(0x432EE13CU), f(0xC2A45844U), f(0x42F59064U), f(0x433B78B4U))
  pb.cubic_to(
    f(0x42F762D3U),
    f(0x433AF8B4U),
    f(0x42CC0000U),
    f(0x41A00000U),
    f(0x42960000U),
    f(0x427C0000U),
  )
  pb.cubic_to(
    f(0xC1FCC988U),
    f(0xC285E92CU),
    f(0x42D00000U),
    f(0x42E40000U),
    f(0x42D00000U),
    f(0x42E40000U),
  )
  pb.move_to(f(0xC2013782U), f(0x43386D0CU))
  pb.line_to(f(0x40D1BA70U), f(0x42EED8E8U))
  pb.quad_to(f(0x43060000U), f(0x41400000U), f(0x42DEE7E8U), f(0xC2303019U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M c245b27f,430e75af Q 432ee13c,c2a45844 42f59064,433b78b4 C 42f762d3,433af8b4 42cc0000,41a00000 42960000,427c0000 C c1fcc988,c285e92c 42d00000,42e40000 42d00000,42e40000 M c2013782,43386d0c L 40d1ba70,42eed8e8 Q 43060000,41400000 42dee7e8,c2303019 | b c245b27f,c2a45844,432ee13c,433b78b4",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c245b27f,c2303019,43049a09,433b78b4",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40000000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#1565 3cc17e58370034d1 M c2471ccd,430e1b3d Q 427a5000,41ecb800 42d3cfc1,4223a6c4 Q 43156900,425122c0 42f68bbe,433b90fd L 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40000000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c2471ccd,c230ef2f,4305151f,433be8ea",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x3F000000U), 1, 3),
          f(0x3DCCCCCDU),
        ),
      ),
    ),
    "#1921 528cc540a58d93e9 M c2471ccd,430e1b3d Q 427a5000,41ecb800 42d3cfc1,4223a6c4 Q 43156900,425122c0 42f68bbe,433b90fd L 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x3F000000U), 1, 3), f(0x3DCCCCCDU))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "c247b27d,c23231b3,4305151f,433be8ea",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40200000U), f(0x40800000U), 2, 1),
          f(0x3F800000U),
        ),
      ),
