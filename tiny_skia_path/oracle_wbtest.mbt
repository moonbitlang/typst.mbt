///|
test "118 random 61" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x42D534EEU), f(0x42ECA2C8U))
  pb.quad_to(f(0x42137FF4U), f(0x431DBFF4U), f(0x42733A18U), f(0x4307A66DU))
  pb.quad_to(f(0x42746C45U), f(0x4307266DU), f(0x4180A6C4U), f(0xC187E008U))
  pb.cubic_to(
    f(0xC21AB504U),
    f(0xC2B51CAEU),
    f(0x42040000U),
    f(0x40400000U),
    f(0xC1100000U),
    f(0x42BE0000U),
  )
  pb.quad_to(f(0x42180000U), f(0x42A80000U), f(0x4341EF2EU), f(0xC29CE1DAU))
  pb.cubic_to(
    f(0x4341EF35U),
    f(0xC29CE1DAU),
    f(0x4341EF35U),
    f(0xC29CE1DAU),
    f(0x4341EF35U),
    f(0xC29CE1DAU),
  )
  pb.line_to(f(0x4341EF3CU), f(0xC29CE1DAU))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 42d534ee,42eca2c8 Q 42137ff4,431dbff4 42733a18,4307a66d Q 42746c45,4307266d 4180a6c4,c187e008 C c21ab504,c2b51cae 42040000,40400000 c1100000,42be0000 Q 42180000,42a80000 4341ef2e,c29ce1da C 4341ef35,c29ce1da 4341ef35,c29ce1da 4341ef35,c29ce1da L 4341ef3c,c29ce1da | b c21ab504,c2b51cae,4341ef3c,431dbff4",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c1100000,c29ce1da,4341ef3c,430f9663",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 3),
          f(0x41800000U),
        ),
