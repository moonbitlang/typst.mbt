///|
test "24 quad all same" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x40A00000U), f(0x40A00000U))
  pb.quad_to(f(0x40A00000U), f(0x40A00000U), f(0x40A00000U), f(0x40A00000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 40a00000,40a00000 Q 40a00000,40a00000 40a00000,40a00000 | b 40a00000,40a00000,40a00000,40a00000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "40a00000,40a00000,40a00000,40a00000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41600000,40d00000 Q 41600000,40d00000 41600000,40d00000 | b 41600000,40d00000,41600000,40d00000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41600000,40d00000,41600000,40d00000",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 3fbc2e1e,40dd545c Q 3fbc2e1e,40dd545c 3fbc2e1e,40dd545c | b 3fbc2e1e,40dd545c,3fbc2e1e,40dd545c",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "3fbc2e1e,40dd545c,3fbc2e1e,40dd545c",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41540000,c0a00000 Q 41540000,c0a00000 41540000,c0a00000 | b 41540000,c0a00000,41540000,c0a00000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41540000,c0a00000,41540000,c0a00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
    "#405 e3b32a9f174213d9 M 41200000,40a00000 L 41200000,40a00000 Q 411fffff,40e2462f 4108918b,4108918b Q 40e2462f,411fffff 40",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41200000U), f(0x40800000U), 1, 2), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "00000000,00000000,41200000,41200000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 41000000,40a00000 L 41000000,40a00000 L 41000000,41000000 L 40000000,41000000 L 40000000,40a00000 L 40000000,40000000 L 41000000,40000000 Z | b 40000000,40000000,41000000,41000000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40C00000U), f(0x40800000U), 2, 3), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "40000000,40000000,41000000,41000000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x41200000U), 0, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1),
          f(0x3F800000U),
        ),
      ),
    ),
    "M 41100000,40a00000 L 41100000,40a00000 L 41100000,41100000 L 3f800000,41100000 L 3f800000,40a00000 L 3f800000,3f800000 L 41100000,3f800000 Z | b 3f800000,3f800000,41100000,41100000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x41000000U), f(0x3FC00000U), 2, 1), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "3f800000,3f800000,41100000,41100000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40800000U), f(0x40800000U), 1, 0),
          f(0x40200000U),
        ),
      ),
    ),
    "#405 80337190c333be6a M 40e00000,40a00000 L 40e00000,40a00000 Q 40dfffff,40ba8278 40cd413c,40cd413c Q 40ba8278,40dfffff 40",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40800000U), f(0x40800000U), 1, 0), f(0x40200000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "40400000,40400000,40e00000,40e00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F000000U), f(0x40800000U), 0, 2),
          f(0x3E99999AU),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41A00000U), f(0x3F800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x40400000U), f(0x40800000U), 2, 2),
          f(0x41200000U),
        ),
      ),
    ),
    "M 40d00000,40a00000 L 40d00000,40a00000 L 40d00000,40d00000 L 40600000,40d00000 L 40600000,40a00000 L 40600000,40600000 L 40d00000,40600000 Z | b 40600000,40600000,40d00000,40d00000",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x40400000U), f(0x40800000U), 2, 2), f(0x41200000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "40600000,40600000,40d00000,40d00000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x00000000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "None",
  )
  let d = StrokeDash::new([f(0x40A00000U), f(0x40400000U)], f(0x00000000U)).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
  let d = StrokeDash::new(
    [f(0x3F800000U), f(0x40000000U), f(0x40400000U), f(0x40800000U)],
    f(0x40200000U),
  ).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
  let d = StrokeDash::new([f(0x41200000U), f(0x40A00000U)], f(0xC0400000U)).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
  let d = StrokeDash::new([f(0x00000000U), f(0x40800000U)], f(0x00000000U)).unwrap()
  assert_eq(dg(dpath(path.dash(d, f(0x3F800000U)))), "None")
  assert_eq(dg(dpath(path.dash(d, f(0x3E800000U)))), "None")
}

///|
test "25 quad sharp" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.quad_to(f(0x42C80000U), f(0x3F800000U), f(0x00000000U), f(0x40000000U))
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 Q 42c80000,3f800000 00000000,40000000 | b 00000000,00000000,42c80000,40000000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "00000000,00000000,42480000,40000000",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 Q 431f4ccd,41d80000 4109999a,bf800000 | b 4109999a,c0a00000,431f4ccd,41d80000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "4109999a,c0a00000,42a89a70,41411112",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 Q 42a6a514,425d35d6 bf8b6d77,3fd6b31d | b bf8b6d77,00000000,42a6a514,425d35d6",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "bf8b6d77,00000000,42259008,41e09ddb",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 Q 434b4000,c0e00000 40500000,c0d00000 | b 40500000,c0f00000,434b4000,c0d00000",
  )
