    ),
    "#11019 e6ef532a6f6b03d0 M 3f000000,bf800000 L 40600000,bf800000 Q 407a8278,bf7fffff 4086a09d,bf3504f3 Q 408fffff,bed413cc 40",
  )
  assert_eq(
    dg(dpath(path.dash(d, f(0x3E800000U)))),
    "#1239 16ab1fca40cf71b6 M 3f000000,00000000 L 40600000,00000000 M 40f00001,00000000 L 41080000,00000000 M 41280000,00000000 ",
  )
  assert_eq(
    dg(
