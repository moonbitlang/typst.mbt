///|
test "108 random 51" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x429AEA76U), f(0x427B4340U))
  pb.line_to(f(0x429AEA76U), f(0x427B4340U))
  pb.cubic_to(
    f(0x429AEA76U),
    f(0x427B4340U),
    f(0x422CAC40U),
    f(0x428A4E0EU),
    f(0x43090000U),
    f(0x42B20000U),
  )
  pb.close()
  pb.cubic_to(
    f(0x433EC52AU),
    f(0x418BB2B4U),
    f(0xC209A2ACU),
    f(0x433E0F2CU),
    f(0xC208FDCFU),
    f(0x433D8F2CU),
  )
  pb.cubic_to(
    f(0xC207AFFCU),
    f(0x433D0F2CU),
    f(0xC2075AFEU),
    f(0x433C8F2CU),
    f(0x4326DD6AU),
    f(0x42CF089EU),
