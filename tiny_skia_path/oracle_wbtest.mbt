///|
test "88 random 31" {
  let pb = PathBuilder::new()
  pb.move_to(f(0xC1C11EF8U), f(0xC2AD9638U))
  pb.cubic_to(
    f(0x41EA01A8U),
    f(0xC28CEBF9U),
    f(0x42880000U),
    f(0xC1D00000U),
    f(0x4289A45AU),
    f(0xC1D40000U),
  )
  pb.quad_to(f(0x4289A45AU), f(0xC1D40000U), f(0xC1500000U), f(0x40800000U))
  pb.cubic_to(
    f(0xC1443127U),
    f(0x40600000U),
    f(0x42340000U),
    f(0x42000000U),
    f(0x42FC0000U),
    f(0x42540000U),
  )
  pb.close()
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M c1c11ef8,c2ad9638 C 41ea01a8,c28cebf9 42880000,c1d00000 4289a45a,c1d40000 Q 4289a45a,c1d40000 c1500000,40800000 C c1443127,40600000 42340000,42000000 42fc0000,42540000 Z | b c1c11ef8,c2ad9638,42fc0000,42540000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "c1c11ef8,c2ad9638,42fc0000,42540000",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3DCCCCCDU), f(0x3F99999AU), 0, 2),
          f(0x41800000U),
