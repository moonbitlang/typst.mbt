///|
test "128 random 71" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x3F333334U), f(0xBF000000U))
  pb.move_to(f(0xC2B1DF19U), f(0xC2AA89CAU))
  pb.quad_to(f(0xC2B1DF0CU), f(0xC2AA89CAU), f(0xC2B1C2E3U), f(0xC2AB89CAU))
  pb.cubic_to(
    f(0x432A3516U),
    f(0x431E8CE8U),
    f(0x432A5E4DU),
    f(0x431E0CE8U),
    f(0x432A8CE5U),
    f(0x431D8CE8U),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M c2b1df19,c2aa89ca Q c2b1df0c,c2aa89ca c2b1c2e3,c2ab89ca C 432a3516,431e8ce8 432a5e4d,431e0ce8 432a8ce5,431d8ce8 | b c2b1df19,c2ab89ca,432a8ce5,431e8ce8",
