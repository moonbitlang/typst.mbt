///|
test "26 cubic s" {
  let pb = PathBuilder::new()
  pb.move_to(f(0x00000000U), f(0x00000000U))
  pb.cubic_to(
    f(0x41F00000U),
    f(0x42A00000U),
    f(0x428C0000U),
    f(0xC2200000U),
    f(0x42C80000U),
    f(0x41200000U),
  )
  let path = pb.finish()
  assert_eq(
    dg(dpath(path)),
    "M 00000000,00000000 C 41f00000,42a00000 428c0000,c2200000 42c80000,41200000 | b 00000000,c2200000,42c80000,42a00000",
  )
  let path = path.unwrap()
  assert_eq(
    dg(drect(path.compute_tight_bounds())),
    "00000000,c028dadd,42c80000,41e2cdf4",
  )
  let t = path.transform(
    ts_of("3fc00000,3e99999a,bf333333,40000000,41200000,c0a00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 41200000,c0a00000 C bf800000,43240000 430f0000,c2800000 43190000,42340000 | b bf800000,c2800000,43190000,43240000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "41166a28,c0a00000,43190000,426f13ca",
  )
  let t = path.transform(
    ts_of("3f56b31d,3f0b6d77,bf0b6d77,3f56b31d,00000000,00000000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 00000000,00000000 C c19349bf,42a6dd9a 42a0fc29,40927e40 429cd762,427b6706 | b c19349bf,00000000,42a0fc29,42a6dd9a",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "c0124f41,00000000,429ce7d1,427b6706",
  )
  let t = path.transform(
    ts_of("40000000,00000000,00000000,3f000000,40500000,c0f00000"),
  )
  assert_eq(
    dg(dpath(t)),
    "M 40500000,c0f00000 C 427d0000,42020000 430f4000,c1dc0000 434b4000,c0200000 | b 40500000,c1dc0000,434b4000,42020000",
  )
  assert_eq(
    dg(drect(t.bind(fn(p) { p.compute_tight_bounds() }))),
    "40500000,c10d1b5c,434b4000,40d59be8",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0),
          f(0x3F800000U),
        ),
      ),
    ),
    "#481 238495664a4a129f M 3eefb344,be33c673 Q 4132ef0c,41e32fb5 41d19177,41deb633 Q 4200cdf0,41dcec00 421fdd6d,41b6976a Q 42",
  )
  assert_eq(
    dg(
      drect(
        path
        .stroke(stroke_of(f(0x3F800000U), f(0x40800000U), 0, 0), f(0x3F800000U))
        .unwrap()
        .compute_tight_bounds(),
      ),
    ),
    "beefb344,c0475268,42c8db85,41e6cc5d",
  )
  assert_eq(
    dg(
      dpath(
        path.stroke(
          stroke_of(f(0x41200000U), f(0x40800000U), 1, 2),
          f(0x3F800000U),
        ),
      ),
    ),
