import {
  "moonbitlang/core/math",
  "moonbitlang/core/float",
  "moonbitlang/core/double",
}

// `core/math` is only used by `libm_other.mbt` (the non-native targets; native
// calls the C library), and moon.pkg has no per-target imports.

warnings = "-unused_package"

options(
  "native-stub": [ "sincos_stub.c" ],
  targets: {
    "libm_native.mbt": [ "native" ],
    "libm_other.mbt": [ "not", "native" ],
  },
)
